    <script>
      // A reusable function to add or remove the class
      function handleScrollClass() {
        if (window.scrollY > 5) {
          document.body.classList.add('body-scrolled');
        } else {
          document.body.classList.remove('body-scrolled');
        }
      }

      // 1. Run the check when the user scrolls
      window.addEventListener('scroll', handleScrollClass);

      // 2. Run the check once the page has loaded
      document.addEventListener('DOMContentLoaded', handleScrollClass);

      (function() {
        const userAgent = navigator.userAgent;
        
        // Check for Safari while excluding Chrome and other WebKit browsers
        const isSafari = userAgent.includes('Safari') && !userAgent.includes('Chrome');

        if (isSafari) {
          document.documentElement.classList.add('is-safari');
        }
      })();
    </script>



