    <script>
     
      function updateHeaderPositions() {
        const mainHead = document.querySelector('.gheader.sticky');
        const announcement = document.querySelector('.announcement-wrap-out');
        const topUsp = document.querySelector('.top_usp');
        const colModelSilvan = document.querySelector('.collection-modal-section');

        if (!mainHead || !announcement) return;

        const announcementHeight = announcement.getBoundingClientRect().height;
        const isMobile = window.innerWidth < 768;

        if (isMobile) {
          if (topUsp) {
            const topUspHeight = topUsp.getBoundingClientRect().height;
            topUsp.style.top = `${announcementHeight}px`;
            mainHead.style.top = `${announcementHeight + topUspHeight}px`;

            const mainHeadHeight = mainHead.getBoundingClientRect().height;
            if (colModelSilvan) {
              colModelSilvan.style.top = `${mainHeadHeight + announcementHeight + topUspHeight}px`;
            }
          } else {
            mainHead.style.top = `${announcementHeight}px`;
            const mainHeadHeight = mainHead.getBoundingClientRect().height;
            if (colModelSilvan) {
              colModelSilvan.style.top = `${mainHeadHeight + announcementHeight}px`;
            }
          }
        } else {
          mainHead.style.top = `${announcementHeight}px`;
          const mainHeadHeight = mainHead.getBoundingClientRect().height;
          if (colModelSilvan) {
            colModelSilvan.style.top = `${mainHeadHeight + announcementHeight}px`;
          }
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        setTimeout(updateHeaderPositions, 2000);
      });
