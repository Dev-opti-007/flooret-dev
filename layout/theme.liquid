    <script>
      // Watch for .pop-cart active class and update cart count
(function() {
  function updateCartCount() {
    fetch('/cart.js')
      .then(res => res.json())
      .then(cart => {
        document.querySelectorAll('.js-cart-count').forEach(el => {
          el.textContent = cart.item_count;
        });

        const cartCountWrapper = document.querySelector('.cart-count');
        if (cartCountWrapper) {
          if (cart.item_count > 0) {
            cartCountWrapper.classList.remove('cart-empty');
          } else {
            cartCountWrapper.classList.add('cart-empty');
          }
        }
      })
      .catch(err => {
        console.error('Failed to fetch cart count:', err);
      });
  }

  // ✅ Monitor .pop-cart for 'active' class changes
  const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
        const target = mutation.target;
        if (target.classList.contains('pop-cart') && target.classList.contains('active')) {
          updateCartCount();
        }
      }
    });
  });

  // Start observing .pop-cart element
  const popCart = document.querySelector('.pop-cart');
  if (popCart) {
    observer.observe(popCart, {
      attributes: true,
      attributeFilter: ['class']
    });
  }

  // Also watch for newly added .pop-cart elements
  const bodyObserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      mutation.addedNodes.forEach(function(node) {
        if (node.nodeType === 1) { // Element node
          if (node.matches && node.matches('.pop-cart')) {
            observer.observe(node, {
              attributes: true,
              attributeFilter: ['class']
            });
          }
          // Check children too
          node.querySelectorAll('.pop-cart').forEach(el => {
            observer.observe(el, {
              attributes: true,
              attributeFilter: ['class']
            });
          });
        }
      });
    });
  });

  bodyObserver.observe(document.body, {
    childList: true,
    subtree: true
  });

  // jQuery fallback (if you prefer)
  $(document).on('DOMNodeInserted', function(e) {
    if ($(e.target).hasClass('pop-cart') || $(e.target).find('.pop-cart').length) {
      $('.pop-cart').each(function() {
        if ($(this).hasClass('active')) {
          updateCartCount();
        }
      });
    }
  });

})();

    </script>

