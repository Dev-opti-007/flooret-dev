    <script>
       // Adjust input padding for installation service
      function adjustInputPaddingForUnits() {
        document.querySelectorAll('.sf-input-wrapper').forEach(wrapper => {
          const input = wrapper.querySelector('input[type="number"]');
          const unit = wrapper.querySelector('.unit');
      
          if (input && unit) {
            // Measure actual width of the unit span
            const unitWidth = unit.offsetWidth;
            const extraSpacing = 20; // Add some spacing to avoid touching
            input.style.paddingRight = `${unitWidth + extraSpacing}px`;
          }
        });
      }
    </script>
