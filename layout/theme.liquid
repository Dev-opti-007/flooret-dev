    <script>
    // Enhanced Global ScrollTrigger Manager
    (function() {
      'use strict';

      let scrollManagerInitialized = false;

      // Robust reveal for elements already in view
      function revealIfInViewAll(selector, sectionRoot = null) {
        const root = sectionRoot || document;
        const elements = root.querySelectorAll(selector);
        
        elements.forEach((el) => {
          if (!el) return;
          
          // Check if element is in viewport
          const rect = el.getBoundingClientRect();
          const inView = rect.top < window.innerHeight && rect.bottom > 0;
          
          // If in view, reveal immediately
          if (inView) {
            gsap.set(el, {
              opacity: 1,
              y: 0
            });
          }
        });
      }

      // Initialize ScrollTrigger with production settings
      function safeScrollTriggerInit() {
        if (scrollManagerInitialized) return;
        
        // Respect user's motion preferences
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          gsap.set('[class*="heading"], [class*="sub"], [class*="button"], [class*="btn"]', {
            opacity: 1,
            y: 0
          });
          return;
        }

        ScrollTrigger.config({
          autoRefreshEvents: 'visibilitychange,load,resize',
          ignoreMobileResize: true
        });

        // Normalize scroll behavior
        {% comment %} ScrollTrigger.normalizeScroll(true); {% endcomment %}

        scrollManagerInitialized = true;
      }

      // Enhanced safe refresh with forced recalculation
      function safeRefresh(delay = 0) {
        safeScrollTriggerInit();
        
        setTimeout(() => {
          ScrollTrigger.getAll().forEach((trigger) => {
            trigger.refresh(false, true); // refresh=false means don't kill, true=force update
          });
          ScrollTrigger.refresh(true);
        }, delay);
      }

      // Enhanced reveal with GSAP state check
      function revealIfInViewAllEnhanced(selector, sectionRoot = null) {
        const root = sectionRoot || document;
        const elements = root.querySelectorAll(selector);
        
        elements.forEach((el) => {
          if (!el) return;
          
          const rect = el.getBoundingClientRect();
          const inView = rect.top < window.innerHeight && rect.bottom > 0;
          
          // Check if element is already animated by ScrollTrigger
          const st = ScrollTrigger.getById(el);
          if (inView && (!st || !st.isActive())) {
            gsap.set(el, {
              opacity: 1,
              y: 0
            });
          }
        });
      }

      // Make available globally
      window.scrollTriggerManager = {
        safeScrollTriggerInit: safeScrollTriggerInit,
        safeRefresh: safeRefresh,
        revealIfInViewAll: revealIfInViewAll,
        revealIfInViewAllEnhanced: revealIfInViewAllEnhanced
      };

      // Initialize on DOM ready
      document.addEventListener('DOMContentLoaded', safeScrollTriggerInit);
    })();
    </script>
   
