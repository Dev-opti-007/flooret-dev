    "9178dccc-f21b-4b2e-8e9c-bf4c7136bb9a": {
      "type": "usp-block",
      "blocks": {
        "f604ec42-5eb6-4b51-a74a-0dabed9fcdf3": {
          "type": "USP",
          "settings": {
            "usp_title": "Direct-to-You Approach",
            "usp_content": "<p>When you work with us, you’ll connect with us directly—not a middleman. This allows us to ensure enhanced convenience and customized care every step of the way.</p>",
            "usp_icon": "shopify://shop_images/Flooret_Icon_Pack_Light_Mode-16_1_1.png"
          }
        },
        "d9bcca1d-cd20-4db3-9b0c-998f490afc3e": {
          "type": "USP",
          "settings": {
            "usp_title": "Unmatched Customer Service",
            "usp_content": "<p>Our customer support team is the best in the biz, and no matter what you’re envisioning for your floors, our expert staff is here to guide you through all of our outstanding options.</p>",
            "usp_icon": "shopify://shop_images/Flooret_Icon_Pack_Light_Mode-04_1.png"
          }
        },
        "f9ca192f-e029-4b21-a31a-afac1e1ca2bc": {
          "type": "USP",
          "settings": {
            "usp_title": "Thoughtful Principle",
            "usp_content": "<p>Do you know where your floors came from? We do—because we always insist on transparent sourcing, done as sustainably as possible.</p>",
            "usp_icon": "shopify://shop_images/Flooret_Icon_Pack_Light_Mode-16_1_1.png"
          }
        },
        "bbcfe134-e3b2-4d22-a309-5d728b91c7eb": {
          "type": "USP",
          "settings": {
            "usp_title": "Inspired Designs",
            "usp_content": "<p>With a wide range of elegant yet contemporary designs, we make sure that our floors are easy on your feet and on your eyes.</p>",
            "usp_icon": "shopify://shop_images/Flooret_Icon_Pack_Light_Mode_Designer_Curated_1.png"
          }
        }
      },
      "block_order": [
        "f604ec42-5eb6-4b51-a74a-0dabed9fcdf3",
        "d9bcca1d-cd20-4db3-9b0c-998f490afc3e",
        "f9ca192f-e029-4b21-a31a-afac1e1ca2bc",
        "bbcfe134-e3b2-4d22-a309-5d728b91c7eb"
