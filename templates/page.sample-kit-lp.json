        "custom_html": "<script>\n(function initKlaviyoModal() {\n    const FORM_SELECTOR = '.klaviyo-form';\n\n    const buildModal = (form) => {\n        // Prevent double init\n        if (document.getElementById('klaviyo-modal-overlay')) return;\n\n        const overlay = document.createElement('div');\n        overlay.id = 'klaviyo-modal-overlay';\n overlay.style.display = \"none\";\n        overlay.innerHTML = `\n            <div id=\"klaviyo-modal\">\n                <button id=\"klaviyo-modal-close\" aria-label=\"Close\">&times;</button>\n                <div id=\"klaviyo-modal-body\"></div>\n            </div>\n        `;\n\n        overlay.querySelector('#klaviyo-modal-body').appendChild(form);\n        document.body.appendChild(overlay);\n\n        const openModal = (e) => {\n            e.preventDefault();\n            overlay.style.display = 'flex';\n            document.body.style.overflow = 'hidden';\n        };\n\n        const closeModal = () => {\n            overlay.style.display = 'none';\n            document.body.style.overflow = '';\n        };\n\n        // Support both href=\"#openKlaviyoPopup\" and title=\"#openKlaviyoPopup\"\n        document.querySelectorAll('a[href=\"#openKlaviyoPopup\"], a[title=\"#openKlaviyoPopup\"]').forEach(trigger => {\n            trigger.addEventListener('click', openModal);\n        });\n\n        overlay.querySelector('#klaviyo-modal-close').addEventListener('click', closeModal);\n        overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });\n        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });\n\n        console.log('[KlaviyoModal] Modal ready.');\n    };\n\n    const init = () => {\n        const form = document.querySelector(FORM_SELECTOR);\n        if (form) {\n            buildModal(form);\n            return;\n        }\n\n        // Form not yet in DOM — wait for it\n        console.log('[KlaviyoModal] Waiting for Klaviyo form...');\n        const observer = new MutationObserver(() => {\n            const form = document.querySelector(FORM_SELECTOR);\n            if (form) {\n                observer.disconnect();\n                buildModal(form);\n            }\n        });\n\n        observer.observe(document.body, { childList: true, subtree: true });\n        setTimeout(() => {\n            observer.disconnect();\n            console.warn('[KlaviyoModal] Klaviyo form never appeared.');\n        }, 15000);\n    };\n\n    if (document.readyState === 'loading') {\n        document.addEventListener('DOMContentLoaded', init);\n    } else {\n        init();\n    }\n}());\n</script>\n<style>\ndiv#klaviyo-modal-overlay {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    background: #000000a8;\n    z-index: 99999;\n    align-items: center;\n    justify-content: center;\n}\nbutton#klaviyo-modal-close {\n    color: #fff;\n    background: no-repeat;\n    border: none;\n    padding: 0px;\n    font-size: 30px;\n    margin-left: auto;\n    display: flex;\n    cursor: pointer;\n}\n</style>",
        "padding_top": 0,
        "padding_bottom": 0,
        "mobile_padding_top": 0,
        "mobile_padding_bottom": 0
      }
    }
