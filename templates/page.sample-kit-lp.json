    "sample_kit_guide_mmjEkr": {
      "type": "sample-kit-guide",
      "blocks": {
        "step_7pR9kE": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Flooret.Jun26.HammyOlivia.1.webp",
            "step_label": "STEP 1 - START",
            "step_number": "01",
            "heading": "Which Collection is Right for You?",
            "description": "<p>High-traffic homes with kids and pets? <br/>Start with <a href=\"https://www.flooret.com/collections/modin-luxury-vinyl-plank\" target=\"_blank\" title=\"https://www.flooret.com/collections/modin-luxury-vinyl-plank\">Modin LVP</a> or <a href=\"https://www.flooret.com/collections/arista-laminate\" target=\"_blank\" title=\"https://www.flooret.com/collections/arista-laminate\">Arista Laminate</a>.</p><p>Want real wood that's DIY-friendly? <br/>Explore <a href=\"https://www.flooret.com/collections/silvan-hardwood\" target=\"_blank\" title=\"https://www.flooret.com/collections/silvan-hardwood\">Silvan Resilient Hardwood</a>.</p><p>Looking for the authentic look and feel of hardwood at a more accessible price? Discover <a href=\"https://www.flooret.com/collections/provence-natural-hardwood\" target=\"_blank\" title=\"https://www.flooret.com/collections/provence-natural-hardwood\">Provence Natural Hardwood</a>.</p>",
            "secondary_description": ""
          }
        },
        "step_47U3r4": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Sable_Signature_RS_8_Farah.webp",
            "step_label": "STEP 2 - EXPLORE",
            "step_number": "02",
            "heading": "Explore Models and Colors",
            "description": "<p>Shop by color family, plank size, or explore our Bestsellers Kits featuring a range of customer favorites.</p><p>Not sure which collection is right for your space? Our Model Comparison Kits make it easy to compare options side by side. To see the full grain, variation, and character of a color, we also recommend ordering a Full Plank Sample.</p>",
            "secondary_description": "<p><a href=\"https://www.flooret.com/collections/sample-kits\" title=\"https://www.flooret.com/collections/sample-kits\">Shop Kits Now</a></p><p><a href=\"#openKlaviyoPopup\" title=\"#openKlaviyoPopup\">Get 50% off Full Plank Samples</a></p>"
          }
        },
        "step_KBNgTn": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Balboa_7_2.webp",
            "step_label": "STEP 3 - CHOOSE",
            "step_number": "03",
            "heading": "Bring Your Vision to Life",
            "description": "<p>Test samples throughout your home alongside your wall colors, furniture, textiles, and natural light.</p><p>Questions along the way? Our team is here to help, from your first sample to your finished installation.</p>",
            "secondary_description": "<p><a href=\"/pages/contact\" title=\"Contact\">Contact Us</a></p>"
          }
        }
      },
      "block_order": [
        "step_7pR9kE",
        "step_47U3r4",
        "step_KBNgTn"
      ],
