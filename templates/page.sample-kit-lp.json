        "faq_6iKkk3": {
          "type": "faq",
          "settings": {
            "question": "How many samples are in a kit?",
            "answer": "<p>Depending on the selected collection or comparison, your sample kit can include 2-6 curated cut samples. </p>"
          }
        },
        "faq_Pk79Dm": {
          "type": "faq",
          "settings": {
            "question": "Which collection is the best?",
            "answer": "<p>The \"best\" is determined by your lifestyle, your favorite color palette, and your budget. We have the best product for nearly every combination. Our team is always happy to help you find what's best for you.</p>"
          }
        },
        "faq_wn4mRT": {
          "type": "faq",
          "settings": {
            "question": "When will my samples arrive?",
            "answer": "<p>Cut samples and sample kits arrive in 2 - 3 business days from the date of order. Full plank samples arrive in 4-8 business days.</p>"
          }
        },
        "faq_GDkUpk": {
          "type": "faq",
          "settings": {
            "question": "How do I contact Flooret if I have questions?",
            "answer": "<p>You can give us a call or text at 1-800-700-8122, reach out via live chat on our website, or send us an email at support@flooret.com</p>"
          }
        },
        "faq_PCLpTm": {
          "type": "faq",
