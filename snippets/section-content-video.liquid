<div class="content-video-row {% if _settings.row_reverse %}content-video-reverse{% endif %} ">
  <div class="content-video-row__col">
    {% if _settings.video != blank %}
      {{ _settings.video }}
    {% endif %}
  </div>
  <div class="content-video-row__col">
    <div class="content-video-wrap">
      {% if _settings.video_heading != blank %}
        <h2 class="h1">{{ _settings.video_heading }}</h2>
      {% endif %}

      {% if _settings.video_content != blank %}
        {{ _settings.video_content }}
      {% endif %}

      {% if _settings.link_text != blank and _settings.link_url != blank %}
        <a
          href="{{ _settings.video_link_url }}"
          class="btn btn--primary btn--purple {% if _settings.text_color == "#ffffff" %}btn--white{% endif %}"
        >
          {{- _settings.video_link_text -}}
        </a>
      {% endif %}
    </div> <!-- /.content-video-wrap -->
  </div>
</div>
