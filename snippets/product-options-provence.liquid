<div class="pdp-atc__variants" id="pdp-atc__variants">
  {% if product.title == 'Elmstead' or product.title == 'Brenwick' or product.title == 'Modin Reducer' or product.title == 'Concorde' %}
      <script type="text/javascript">
    console.log('Inline script starting for handle: {{ product.handle }}');
    window.productInfo = window.productInfo || {};
    window.productInfo["{{ product.handle }}"] = {{ product.variants | json }};
    window.productInfo['selectedVariant'] = {{ product.selected_or_first_available_variant | json }};
    console.log('window.productInfo set for {{ product.handle }} with ' + window.productInfo["{{ product.handle }}"].length + ' variants');

    // Your forloop for preorder_message and msrp...
    {%- for variant in product.variants -%}
    {% assign preorder_message = variant.metafields.flooret.preorder_message
                                  | metafield_tag
                                  | json %}
    {% if preorder_message != 'null' %}
      window.productInfo["{{ product.handle }}"][{{ forloop.index0 }}]
        .preorder_message = {{ preorder_message }};
    {% endif %}

          {%- if msrp != blank -%}
            window.productInfo["{{product.handle}}"][{{ forloop.index0 }}]["msrp"] = {{ msrp | times: 100 }};
          {%- endif -%}

      {%- endfor -%}

      // Rest of your script (updateVariantInURL, etc.)...
      console.log('Inline script completed for {{ product.handle }}');
  </script>

  {% else %}

  <script type="text/javascript">
    window.productInfo =  window.productInfo || {};

    window.productInfo["{{product.handle}}"] = {{ product.variants | json }};

    window.productInfo['selectedVariant'] = {{ product.selected_or_first_available_variant | json }};
    
    function updateVariantInURL() {
      const currentVariant = {{ product.selected_or_first_available_variant | json }};
      const formElement = document.querySelector(".mproduct__form");
      
      const idInput = formElement.querySelector("[name='id']");
      const modelInput = formElement.querySelector("[name='model']"); 
      const bevelInput = formElement.querySelector("[name='bevel']");   
      const typeInput = formElement.querySelector("[name='type']");   

      if (idInput) {
        idInput.value = currentVariant.id;
      }

      if (modelInput) {
        modelInput.value = currentVariant.option1 
      }
      
      if (bevelInput && typeInput) {
        bevelInput.value = currentVariant.option2 
        typeInput.value = currentVariant.option3 
      } else if (typeInput) {
        typeInput.value = currentVariant.option2 
      }

      const currentUrl = new URL(window.location.href);
    
      currentUrl.searchParams.set("variant", currentVariant.id);
      window.history.replaceState(null, null, currentUrl.toString());
    }
    
    const urlParams = new URLSearchParams(new URL(window.location.href).search);

    if (!urlParams?.has("select-color")) {
      setTimeout(() => updateVariantInURL(), 500);
    }
    
    {%- for variant in product.variants -%}

      {%- assign preorder_message = variant.metafields.flooret.preorder_message | metafield_tag | escape -%}

      {%- assign msrp = variant.metafields.flooret.msrp -%}

      {%- if preorder_message != blank -%}
        window.productInfo["{{ product.handle }}"][{{ forloop.index0 }}]["preorder_message"] = "{{ preorder_message  }}";
      {%- endif -%}

      {%- if msrp != blank -%}
        window.productInfo["{{product.handle}}"][{{ forloop.index0 }}]["msrp"] = {{ msrp | times: 100 }};
      {%- endif -%}


    {%- endfor -%}

    document.addEventListener('DOMContentLoaded', () => {
      const waitForInputs = setInterval(() => {
        const currentVariant = {{ product.selected_or_first_available_variant | json }};
        const formElement = document.querySelector(".mproduct__form");
        if (!formElement) return;
      
        const bevelInput = formElement.querySelector("[name='bevel']");
        const signatureRadioInputs = [
          'nakan',
          'kingswood',
          'soho',
          'palka', 
          'arbor',
          'brenwick'
        ].map(name => document.getElementById(`${name}__option1__signature`));

        const bevelRadios = document.querySelectorAll('input[name="Bevel"]');

        signatureRadioInputs.forEach(radioInput => {
          if (radioInput && bevelInput) {
            clearInterval(waitForInputs); // Stop polling once we found the inputs
            
            radioInput.addEventListener('click', function(event) {
              if (event.target.checked) {
                const enhancedBevel = Array.from(bevelRadios).find(b => b.value === 'Enhanced');
                if (enhancedBevel) {
                  enhancedBevel.checked = true;
                  bevelInput.value = 'Enhanced';
                  enhancedBevel.dispatchEvent(new Event('change')); // trigger any listeners
                }
              }
            });

            // Optional: Fire change handler on first load
            radioInput.dispatchEvent(new Event('change'));
          }
        });
      }, 200);
    });
    
  </script>

  {% endif %}

  <style>
    .pdp-atc__group__buttons.Bevel {
      flex-direction: column-reverse !important;
    }
  </style>

  <div class="select-menu hidden">
    <select class="js-product-form__main-select" name="id" autocomplete="off">
      {% for variant in product.variants %}
        <option
          {% unless variant.available %}
            class="disabled"
          {% endunless %}
          value="{{ variant.id }}"
          {% if variant.option1 != blank %}
            data-option1="{{ variant.option1 | escape }}"
          {% endif %}
          {% if variant.option2 != blank %}
            data-option2="{{ variant.option2 | escape }}"
          {% endif %}
          {% if variant.option3 != blank %}
            data-option3="{{ variant.option3 | escape }}"
          {% endif %}
          {% if variant.id == product.selected_or_first_available_variant.id %}
            selected
          {% endif %}
        >
          {{ variant.title }} - {{ variant.price | money }} -
          {{- variant.compare_at_price | money -}} - 
          {%- assign savings = variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round -%}
          {{ savings }}% OFF
          {% unless variant.available %}(Soldout){% endunless %}
        </option>
      {% endfor %}
    </select>
  </div>

  <div class="pdp-atc__groups">
    {% for product_option in product.options_with_values %}
      {%- liquid
        assign optionIndex = forloop.index
        assign optionSelector = 'option' | append: optionIndex
        assign first_available_option = product.selected_or_first_available_variant[optionSelector]
      %}

      {% unless product_option.name == 'Title' %}


       {% liquid
          assign swatch = false
          assign swatchHandles = 'color' | split: ','
          assign optionHandle = product_option.name | handleize
          if swatchHandles contains optionHandle
            assign swatch = true
          endif
        %} 

        {% comment %} New changes {% endcomment %}
        {% liquid
          if product.title == 'Copy Dev Modin LVP 4-Model Comparison Kit' or product.title == "Modin LVP 4-Model Comparison Kit" or product.title == "Modin LVP 3-Model Comparison Kit" or product.title == "Modin LVP 2-Model Comparison Kit" or product.title == "Silvan Hardwood 2-Width Comparison Kit" or product.title == "Modin LVP Signature Sample Kits" or product.title == "Bestsellers Sample Kits"
            assign swatch = false
            assign optionHandle = product_option.name | handleize
          endif
        %}

               {% comment %} {% liquid
          if product.tags contains 'sample-v2'
            assign swatch = false
            assign optionHandle = product_option.name | handleize
          endif
        %} {% endcomment %}
        {% comment %} New changes {% endcomment %}

        {%- if isAddSamplePopup and optionHandle == 'type' -%}
        {%- endif -%}

        {% if product_option.name == 'Type' %}
        <div class="js-product-form__group pdp-atc__group pdp-atc__group--{{ product_option.name | handleize }} {% if swatch %}pdp-atc__group--swatches{% endif %}">
          <div class="pdp-atc__group__title {% if product_option.name == 'Type' %}type-d-flex{% endif %} {% if product_option.name == 'Model' and product.tags contains 'Cat--Modin LVP' %}flex-fix{% endif %}">
            <label for="{{ product_option.name | handleize }}" class=" {% if product_option.name == 'Color' or product_option.name == 'Kit' %}color-label-ds{% endif %}">
              {% if product_option.name == 'Color' %}
                Choose your color:
              {% elsif product_option.name == 'Kit' %}
                Choose your collection:
              {% else %}
              {{ product_option.name }}
              {% endif %}
            </label>
            {% if product_option.name == 'Type' %}
              <div class="pdp_type--tab_list">
                  <div data-items="sample" class="pdp_type--tab pdp_tab--active"><span>Order by Sample</span></div>
                  <div data-items="box" class="pdp_type--tab"><span>Order by Box</span></div>
              </div>
            {% endif %}
            
               {% if product_option.name == 'Model' and product.tags contains 'Cat--Modin LVP' %}
            <span id="compareModel" >Compare Models</span>
            {% endif %}
            
          {% if product.title == 'Modin LVP 2-Model Comparison Kit' or product.title == 'Modin LVP 3-Model Comparison Kit' or product.title == 'Modin LVP 4-Model Comparison Kit' %}
              <span id="compareModel" >Compare Models</span>
            {% endif %}
          </div>

          <div class="select-menu {% unless swatch %} hidden{% endunless %}">
            <select
              id="option-{{ product_option.name | handleize }}"
              class="js-product-form__select"
              name="{{ product_option.name | handleize }}"
              autocomplete="off"
              required
            >
              {% if product_option.name == 'Color' %}
                <option id="placeholder-option" value="Please select a color" disabled selected></option>
              {% endif %}
              {% for value in product_option.values %}
                <option
                  data-option-index="{{ optionIndex }}"
                  value="{{ value | escape }}"
                >
                  {{ value }}
                </option>
              {% endfor %}
            </select>
          </div>

          <ul class="pdp-atc__group__buttons {{ product_option.name }} {% if swatch %}hidden{% endif %}">
            {% for value in product_option.values %}
              {%- liquid
                assign product_handle = value | handleize

                assign product_meta_namespace = optionHandle | prepend: 'product_'

                if optionHandle == 'width'
                  assign product_meta_namespace = 'product_model'
                endif

                assign product_meta = shop.metaobjects[product_meta_namespace][product_handle]

                assign product_description = product_meta.description
                assign product_option_icon = product_meta.image

                assign cost_per_sqft = product_meta.cost_per_sqft
                assign type_cost = product_meta.cost
                assign compare_cost_per_sqft = product_meta.compare_cost_per_sqft
                if value contains '(Archive)'
                  continue
                endif
              -%}

               {% assign val_handle = value | handleize %}
                {% assign meta_ogj_handle = product_meta.name | handleize %}

              <li style="{% if value == 'Box' %}display:none;{% endif %}" class="{% if product_option.name == 'Type' %}{{ product_option.name | downcase }} {{ value | downcase }}{% endif %}">
               

                

                <input
                  class="js-product-form__button {{ product_option.name | handleize }} reset"
                  data-option-index="{{ optionIndex }}"
                  name="{{ product_option.name }}"
                  id="{{ product.handle }}__option{{ optionIndex }}__{{ value | handleize }}"
                  {% if first_available_option == value %}
                    checked
                  {% endif %}
                  value="{{ value | escape }}"
                  title="{{ product_option.name }}: {{ value }}"
                  type="radio"
                  data_value="{{ value.variant.id }}"
                  data-cost-per-sqft="{{ cost_per_sqft.value }}"
                  data-compare-cost-per-sqft="{{ compare_cost_per_sqft.value }}"
                >
                <label
                  for="{{ product.handle }}__option{{ optionIndex }}__{{ value | handleize }}"
                  class="product-option product-option--{{ value | handleize }} {% if val_handle contains 'sample' %}show_free_shipping{% endif %}"
                >


                  {%- comment -%} Find variant with exact option match {%- endcomment -%}
                  {%- liquid
                    assign current_variant = null
                    assign current_selections = product.selected_or_first_available_variant.options
                    
                    for variant in product.variants
                      assign match = true
                      for i in (1..3)
                        assign option_key = 'option' | append: i
                        if i == optionIndex
                          unless variant[option_key] == value
                            assign match = false
                            break
                          endunless
                        else
                          unless variant[option_key] == current_selections[forloop.index0]
                            assign match = false  
                            break
                          endunless
                        endif
                      endfor
                      
                      if match
                        assign current_variant = variant
                        break
                      endif
                    endfor
                  -%}

                  {%- comment -%} Display swatch image {%- endcomment -%}
                  {%- if current_variant.metafields.custom.swatch_image != blank -%}
                    <span class="product-option__swatch">
                      <img 
                        src="{{ current_variant.metafields.custom.swatch_image.value | img_url: '100x' }}" 
                        alt="{{ value }}" 
                        width="100%" 
                        height="100%"
                        loading="lazy"
                      >
                    </span>
                  {%- endif -%}

                   {% comment %}Tags in model options{% endcomment %}
                  {%- if value == 'Base' or value == 'Signature' or value == 'Craftsman' or value == 'Herringbone' %}
                    <span class="tags-float">
                    {%- if value == 'Base' %}Best Value{% endif -%}
                    {%- if value == 'Signature' %}Most Popular{% endif -%}
                    {%- if value == 'Craftsman' %}Designer's Choice{% endif -%}
                    {%- if value == 'Herringbone' %}New Design{% endif -%}
                    </span>
                  {% endif -%}
               
                    {% comment %} <span class="sample_free_shipping">Free Shipping</span> {% endcomment %}
                  {% if product.template_suffix == 'pdp-variation-2' and optionHandle == 'type'  %} {% endif %}

                  {%- if product_option_icon != blank -%}
                    <span class="product-option__icon">
                      <img src="{{ product_option_icon | img_url: '50x' }}" width="" height="" alt="{{ value }}">
                    </span>
                  {%- endif -%}
                  <div class="product-option__details 123123123">
                    <span class="product-option__name">
                      

                       
                       {%- comment -%} Inline Add to Cart for this specific option {%- endcomment -%}
                        <button
                          type="button"
                          class="option-atc-btn"
                          data-option-index="{{ optionIndex }}"
                          data-option-value="{{ value | escape }}"
                        >
                          <span class="dynamic-option-price"></span>
                          {% if value == 'Cut Sample' %}
                            Cut Sample
                          {% elsif value == 'Plank Sample' %}
                            Full Length Plank Sample
                          {% endif %}
                        </button>

                      {% comment %} {% if type_cost %}<span class="prd_type_cost">{{ type_cost.value | money }}</span>{% endif %} {% endcomment %}
                    </span>
                    {%- if product_meta.width != blank
                      or product_meta.bevel_style != blank
                    -%}
                      <ul class="product-option__meta">
                        {%- if product_meta.width != blank -%}
                          <li>
                            {{-
                              product_meta.width.value
                              | append: ' x '
                              | append: product_meta.length_text_only.value
                              | replace: ' in', '"'
                            -}}
                             {% comment %} | append: product_meta.length.value {% endcomment %}
                          </li>
                        {%- endif -%}

                        {%- if product_meta.thickness != blank -%}
                          <li>{{ product_meta.thickness | append: ' Mil' }}</li>
                        {%- endif -%}

                        {%- if product_meta.bevel_style != blank -%}
                          {% comment %} <li>{{ product_meta.bevel_style | append: ' Bevels' }}</li> {% endcomment %}
                          <li>{{ product_meta.bevel_style }}</li>
                        {%- endif -%}
                      </ul>
                    {%- endif -%}

                    
                  </div>

                  {%- if cost_per_sqft and false -%}
                    <div class="label--const_per_sq_ft">
                      <span class="product-option__cost-per-sqft"> {{ cost_per_sqft.value | money }} / SF </span>
                      {% if product.template_suffix == 'pdp-variation-2' %}<span class="for_box">(for box)</span>{% endif %}
                    </div>
                  {%- endif -%}
                </label>
              </li>
            {% endfor %}
          </ul>
          {% if product_option.name == 'Model' %}
            {% assign base_model = false %}
            {% for value in product_option.values %}
              {% if value == 'Base Glue Down' %}
                {% assign base_model = true %}
              {% endif %}
            {% endfor %}
            {% if base_model %}
              <div class="base_available">*Base Glue Down - Available 12/6/24</div>
            {% endif %}
          {% endif %}
        </div>
