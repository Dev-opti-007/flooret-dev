<script>
{% comment %} document.addEventListener('DOMContentLoaded', () => {
  const productForm = document.querySelector('.pdp-atc__variants');
  if (!productForm) return;

  const allVariants = window.productInfo["{{product.handle}}"];
  if (!allVariants) return;

  const numOptions = {{ product.options.size }};

  function updateAllOptionPrices() {
    // 1. Get the currently selected options as an ordered array
    const currentSelections = new Array(numOptions);
    productForm.querySelectorAll('input[type="radio"]:checked').forEach(radio => {
      const index = parseInt(radio.dataset.optionIndex, 10) - 1;
      if (index >= 0) {
        currentSelections[index] = radio.value;
      }
    });

    // 2. Loop through every single radio button on the page
    productForm.querySelectorAll('input[type="radio"]').forEach(input => {
      const pricePlaceholder = input.closest('li').querySelector('.dynamic-option-price');
      console.log('aaaaaaaaaaaaaaaaaaaa')
      console.log(pricePlaceholder)
      if (!pricePlaceholder) return;

      // 3. Create a "potential" selection array as if this input were clicked
      const potentialSelections = [...currentSelections];
      const inputIndex = parseInt(input.dataset.optionIndex, 10) - 1;
      potentialSelections[inputIndex] = input.value;

      // 4. Find the variant that matches this potential combination
      const variant = findVariantByOptions(potentialSelections);

      // 5. Update the price display for this specific option
      if (variant) {
        // THIS IS THE KEY LOGIC: Only show prices for these specific values
        if (input.value === 'Plank Sample' || input.value === 'Plank Samples' || input.value === 'Cut Sample') {
          let priceHTML = '';
          priceHTML += `<span class="price-main">${formatMoney(variant.price)}</span>`;

          if (variant.compare_at_price > variant.price) {
            priceHTML += `<s class="price-compare">${formatMoney(variant.compare_at_price)}</s>`;
            const savings = Math.round(((variant.compare_at_price - variant.price) * 100) / variant.compare_at_price);
            priceHTML += `<span class="price-savings">(${savings}% off)</span>`;
          }
          pricePlaceholder.innerHTML = priceHTML;
        } else {
          // For all other options (like 'Box'), keep the price area empty.
          pricePlaceholder.innerHTML = '';
        }
      } else {
        pricePlaceholder.innerHTML = '';
      }
    });
  }

  function findVariantByOptions(selectedOptions) {
    if (selectedOptions.includes(undefined)) {
      return null;
    }
    return allVariants.find(variant => {
      return selectedOptions.every((value, index) => {
        return variant.options[index] === value;
      });
    });
  }

  function formatMoney(cents) {
    // Basic money formatting, you can customize the currency symbol
    const amount = (cents / 100).toFixed(2);
    return `$${amount}`;
  }

  // --- Attach listener and run on page load ---
  productForm.addEventListener('change', updateAllOptionPrices);
  setTimeout(updateAllOptionPrices, 200);
}); {% endcomment %}


</script>

