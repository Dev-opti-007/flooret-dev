                    <span class="remaining-info">Remaining {{ bundle_remaining | money }} to be collected after installation</span>
                  </div>
  
                  <button type="button" class="cart-remove-bundle" data-bundle-id="{{ bundle_id }}">
                    <img src="https://cdn.shopify.com/s/files/1/0698/3761/9475/files/thrash.png" width="33" height="42" alt="Remove"/>
                  </button>
  
                </div>
                </div>
            
                  <details class="cart-installation-details">
                    <summary>Details <img class="chevron" src="https://cdn.shopify.com/s/files/1/0698/3761/9475/files/chevron_blue.png" width="20" height="20"/></summary>
            
                    <div class="bundle-summary">
                      {% comment %}
                        Detailed Summary Printout
                      {% endcomment %}
                      <ul class="bundle-breakdown">
                        {% for bundle_item in cart.items %}
                            {% if bundle_item.properties._bundle_id == bundle_id %}
                              {% assign raw_items = bundle_item.properties._bundle_items | split: ";" %}
                              
                                {% for line in raw_items reversed %}
                                  {% assign parts = line | split: "::" %}
                                  {% assign name_price = parts[0] %}
                                  {% assign price = parts[2] | times: 100 %}
                                  <li><div class="breakdown-item"><span>{{ name_price }}</span><span class="price">{{ price | money }}</span></div></li>
                                {% endfor %}
                            {% endif %}
                          {% endfor %}   
                      </ul>        
                    </div>
                  </details>
              </div>
            </div>
          {% endif %}
        {% endunless %}
      

      {% else %}
      <!-- Regular product display (existing code) -->
        <div class="cart-card js-cart-card {% if item.product.title == 'Flooret Installation Service' %}fix_install_item_card{% endif %}" data-id="{{ item.variant.id }}" data-price="{{ item.price }}">
            <div class="cart-card__wrap">

                <a class="cart-card__image" href="{{ item.url }}" >
                    <div class="spacer">
                        {% render 'lazy-image', image:item.image, width: 200 %}
                    </div>
                </a>
                
                <div class="cart-card__content {% if item.product.title == 'Flooret Installation Service' %}fix_install_item{% endif %}">
                   
                    <span class="cart-card__title">
                        <a href="{{ item.url }}">{{ item.product.title }} {% if item.selling_plan_allocation != blank %}(Subscription){% endif %}</a>
                    </span>
    
                    <a class="cart-card__remove {% unless drawer == false %}js-remove-cart-item{% endunless %}" href="/cart/change?line={{ forloop.index }}&amp;quantity=0">{% render 'svg-trash' %}</a>
                    
                    {% unless item.variant.title contains "Default" %}
                        <ul class="cart-card__meta">
                            {% for option in item.variant.options %}
                                <li>{{ option }}</li> 
                            {% endfor %}
                        </ul> 
                    {% endunless %}
                    
                    {% unless item.properties == empty %}
                        <ul class="cart-card__meta">
                            {% for property in item.properties %}
                                {% unless property.last == empty %}
                                    {%- liquid
                                        assign class = ''
                                    -%}
                                    <li class="{{ class }} {{ property.last | handleize }}">{{ property.last }}</li>
                                {% endunless %}
                            {% endfor %}
                        </ul>
                    {% endunless %}

                      {% if item.variant.compare_at_price and item.variant.compare_at_price > item.variant.price %}
                      {% assign float_difference = item.variant.compare_at_price | minus: item.variant.price | times: 100.0 %}
                      {% assign raw_save = float_difference | divided_by: item.variant.compare_at_price %}
                      {% assign save_percent = raw_save | round %}
                      <p class="cart-price-item">
                        {{ item.price | money }}
                        <del>{{ item.variant.compare_at_price | money }}</del>
                        <span class="save-percentage">{{ save_percent }}% Off</span>
                      </p>
                    {% else %}
                      <p>{{ item.price | money }}</p>
                    {% endif %}

                    <div class="cart-card__quantity">
                        <label for="updates_{{ item.id }}">Quantity:</label>
                        <div class="js-qty">
                            <button type="button" class="js-qty__button" data-action="subtract">-</button>
                            <input class="js-qty__input" id="updates_{{item.id}}" name="updates[]" size="2" value="{{ item.quantity }}" data-min="0">
                            <button type="button" class="js-qty__button" data-action="add">+</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
      {% endif %}
    {% endfor %}
</div> {% endcomment %}
<script>
  // Handle bundle removal
  document.querySelectorAll('.cart-remove-bundle').forEach(button => {
    button.addEventListener('click', async (e) => {
      e.preventDefault();
      const button = e.target.closest('.cart-remove-bundle');
      const bundleId = button?.dataset.bundleId;
      
      if (!confirm('Remove the service bundle?')) return;
      
      try {
        // Get current cart
        const cartResponse = await fetch('/cart.js');
        const cart = await cartResponse.json();
        
        // Find all items with this bundle ID and set quantity to 0
        const updates = {};
        cart.items.forEach((item, index) => {
          if (item.properties && item.properties._bundle_id === bundleId) {
            updates[item.key] = 0;
          }
        });

        // Remove all bundle items
        for (const [key, quantity] of Object.entries(updates)) {
          await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: key, quantity: quantity })
          });
        }
        
        window.location.reload();
      } catch (error) {
        console.error('Error removing bundle:', error);
        alert('Error removing installation service. Please try again.');
      }
    });
  });
</script>
