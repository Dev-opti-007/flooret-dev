{% for block in blocks %}
  {% assign menu = block.settings %}
  <div class="mega-menu desk-only {% if menu.hide-name-and-center-align == true %}only-image-grid{% endif %}" data-menu="{{ menu.menu_name | handleize }}">
    <div class="mega-menu__wrap">
      {% if menu.hide-name-and-center-align == false %}
        <div class="mega-menu__menu">
          <span class="h3">{{ menu.menu_name_one }}</span>
         {% assign showNew = "false" %} 

          {% if menu.menu_name_one == 'Modin Luxury Vinyl Plank' %}
            {% assign showNew = "true" %}
          {% endif %}
          {% render 'menu-list-footer', menu: menu.mobile_menu, showNew:showNew %}
          {% if menu.cta != blank and menu.cta_link != blank %}
            <a href="{{ menu.cta_link }}" class="mega-menu__cta">{{ menu.cta }}</a>
          {% endif %}
        </div>
      {% endif %}
      <div class="mega-menu__cards">
        {% for i in (1..8) %}
          {% liquid
            assign imageSelect = 'feat_image_' | append: i
            assign headingSelect = 'feat_heading_' | append: i
            assign ctaSelect = 'feat_cta_' | append: i
            assign ctaLinkSelect = 'feat_cta_link_' | append: i
            assign tag1Select = 'feat_tag_' | append: i | append: '_1'
            assign tag2Select = 'feat_tag_' | append: i | append: '_2'
            assign imageSize = 600
            if menu['feat_image_2'] == blank
              assign imageSize = 1100
            endif
          %}
          {% if menu[imageSelect] != blank and menu[ctaLinkSelect] != blank %}
            <a class="mmcard {% if menu.large_image %}mmcard--large{% endif %}" href="{{ menu[ctaLinkSelect] }}">
                {% if menu[tag1Select] or menu[tag2Select] %}
                  <div class="mmcard__tags">
                    {% if menu[tag1Select] %}
                      <span class="mmcard__tag mmcard__tag--1">{{ menu[tag1Select] }}</span>
                    {% endif %}
                    {% if menu[tag2Select] %}
                      <span class="mmcard__tag mmcard__tag--2">{{ menu[tag2Select] }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              <div class="mmcard__image">
                {% render 'lazy-image', image: menu[imageSelect], width:imageSize %}
              </div>
              <div class="mmcard__content">
                {% if menu[headingSelect] %}
                  <span class="h5">{{ menu[headingSelect] }}</span>
                {% endif %}

              

                {% if menu[ctaSelect] %}
                  <span class="mmcard__cta">{{ menu[ctaSelect] }}</span>
                {% endif %}
              </div>
            </a>
          {% endif %}
        {% endfor %}
        {% if menu.shop-all-text != blank %}
        <a class="mmcard text-only" href="{{ menu.shop-all-url }}">
          <span>{{ menu.shop-all-text }}</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="11" height="10" viewBox="0 0 11 10" fill="none">
          <path d="M10.5 4.66665L0.5 4.66665M10.5 4.66665L6.33333 8.83331M10.5 4.66665L6.33333 0.49998" stroke="black" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {% endif %}
      </div>
    </div>
  </div>
{% endfor %}
