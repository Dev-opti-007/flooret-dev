(function() {
  // Global prices object to be populated by Liquid and the fetch function
  const prices = {
    {% for variant in product_service.variants %}
      {{ variant.id }}: {{ variant.price }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  // =================================================================
  // 1. DATA FETCHING & HELPER FUNCTIONS
  // =================================================================

  async function fetchProductVariantsGrouped() {
    const catalogueEl = document.querySelector('#install-catalogue');
    if (!catalogueEl) {
        console.error("Installation catalogue not found. Please ensure the #install-catalogue element exists.");
        return null;
    }
    const catalogue = JSON.parse(catalogueEl.textContent);
    const serviceProduct = catalogue.find(v => v.handle === 'custom-service');
    const { productType, variants = [] } = serviceProduct;
    const grouped = {
      Installation: [],
      Demolition: [],
      "Add-Ons": [],
      productType: productType
    };
    variants.forEach(v => {
      const key = v.installationType ? v.installationType.trim() : null;
      if (key && grouped[key]) {
        grouped[key].push(v);
        // Populate the global prices object with cents
        prices[v.id] = Math.round(v.price * 100);
      }
    });
    return grouped;
  }

  function formatMoney(cents) {
    const locale = window.shopSettings?.locale || 'en-US';
    const currency = window.shopSettings?.currency || 'USD';
    return (cents / 100).toLocaleString(locale, {
      style: 'currency',
      currency: currency
    });
  }

  // =================================================================
  // 2. RENDERING FUNCTIONS FOR EACH PACKAGE
  // =================================================================

  function renderInstallationPackage(installVariants = [], productType) {
    const tierSection = document.querySelector('.tier__section .tier-grid');
    const tierInstallSection = document.querySelector('.tier_install .service-selector');
    const additionalTierInstall = document.querySelector('.tier_install .additional-service-install');
    if (!tierSection || !tierInstallSection) return;
    
    const createInputHtml = (v, hidden = false) => `
        <div class="service-item ${hidden ? 'additional-tier-install hidden' : ''}">
          <label for="service-${v.id}">${v.title}</label>
          <div class="sf-input-wrapper">
            <input type="text" id="service-${v.id}" name="service-quantity[${v.id}]" value="" min="0" placeholder="0" class="service-quantity" data-variant-id="${v.id}" data-price-cents="${prices[v.id] || 0}">
            <span class="unit">${v?.installationInfo?.unit || 'SQ FT'}</span>
          </div>
        </div>`;

    const skuTitleMap = { 'IS-FL-THRE': 'lvp', 'IS-FL-HERR': 'lvp', 'IS-FL-LAMI': 'Laminate', 'IS-FL-HARD': 'hardwood', 'IS-FL-HARD-G': 'hardwood-g' };
    let hasHiddenItems = false;
    installVariants.forEach(v => {
        const isHidden = productType && skuTitleMap[v.sku] !== productType;
        tierInstallSection.insertAdjacentHTML('beforeend', createInputHtml(v, isHidden));
        if (isHidden) hasHiddenItems = true;
    });
    
    if (hasHiddenItems) {
      additionalTierInstall.insertAdjacentHTML('beforeend', `
        <div class='additional-flooring'>
          <span class="toggle-text">Add additional flooring types</span>
          <img class="chevron-icon" src="https://cdn.shopify.com/s/files/1/0698/3761/9475/files/chevron_blue.png" width="20" height="20" alt="chevron"/>
        </div>`);
      document.querySelector('.additional-flooring').addEventListener('click', function () {
        const additionalItems = document.querySelectorAll('.additional-tier-install');
        const isHidden = additionalItems[0]?.classList.contains('hidden');
        additionalItems.forEach(el => el.classList.toggle('hidden', !isHidden));
        this.querySelector('.toggle-text').textContent = isHidden ? 'Hide additional flooring types' : 'Add additional flooring types';
        this.querySelector('.chevron-icon').style.transform = isHidden ? 'rotate(0deg)' : 'rotate(180deg)';
      });
    }
  }

  function renderDemolitionPackage(demolitionVariants = []) {
    const demoSection = document.querySelector('.demolition__section .service-selector');
    if (!demoSection) return;

    const createInputHtml = (v) => `
        <div class="service-item">
          <label for="service-${v.id}">${v.title}</label>
          <div class="sf-input-wrapper">
            <input type="text" id="service-${v.id}" name="service-quantity[${v.id}]" value="" min="0" placeholder="0" class="service-quantity" data-variant-id="${v.id}" data-price-cents="${prices[v.id] || 0}">
            <span class="unit">${v?.installationInfo?.unit || 'SQ FT'}</span>
          </div>
        </div>`;

    demolitionVariants.forEach(v => demoSection.insertAdjacentHTML('beforeend', createInputHtml(v)));
  }

  function renderAddonsPackage(addOnsVariants = []) {
    const addonsSection = document.querySelector('.additional_services_addons .service-selector');
    const warrantySection = document.querySelector('.additional_services_warranty .service-selector');
    if (!addonsSection || !warrantySection) return;

    const createRadioHtml = (v) => `<label><input type="radio" name="warranty" class="warranty-input" value="${v.id}">${v.title}</label>`;
    const createInputHtml = (v) => `
        <div class="service-item">
          <label for="service-${v.id}">${v.title}</label>
          <div class="sf-input-wrapper">
            <input type="text" id="service-${v.id}" name="service-quantity[${v.id}]" value="" min="0" placeholder="0" class="service-quantity" data-variant-id="${v.id}" data-price-cents="${prices[v.id] || 0}">
            <span class="unit">${v?.installationInfo?.unit || 'SQ FT'}</span>
          </div>
        </div>`;

    addOnsVariants.forEach(v => {
      if(v.title.toLowerCase().includes('warranty')) {
        warrantySection.insertAdjacentHTML('beforeend', createRadioHtml(v));
      } else {
        addonsSection.insertAdjacentHTML('beforeend', createInputHtml(v));
      }
    });
  }

  // =================================================================
  // 3. EVENT BINDING & PRICE CALCULATION
  // =================================================================
  
  function updateDetailedSubtotal() {
    const installationList = document.getElementById('installation_summary');
    const demolitionList = document.getElementById('demolition_summary');
    const addonsList = document.getElementById('addons_summary');
    

    installationList.innerHTML = '';
    demolitionList.innerHTML = '';
    addonsList.innerHTML = '';
    let totalCents = 0;
    const summary = {
      installation: false,
      demolition: false,
      addons: false
    }

    document.querySelectorAll('.service-quantity').forEach(input => {
        const id  = parseInt(input.dataset.variantId, 10);
        const serviceType = input.closest('.demolition__section') ? 'demolition' :
                           input.closest('.additional_services_addons') ? 'addons' : 'installation';
        const qty = parseInt(input.value, 10) || 0;
        if (qty > 0 && prices[id]) {
            const lineCents = prices[id] * qty;
            totalCents += lineCents;
            const label = document.querySelector(`label[for="service-${id}"]`).innerText.trim();
            if (installationList && serviceType === 'installation') {
              installationList.innerHTML += `<div class="summary-row">
                    <div class="label">${label} </div>
                    <div class="qty" >${qty}</div>
                    {% comment %} <div class="price">${formatMoney(lineCents)}</div> {% endcomment %}
                  </div>`;
              summary.installation = true;
            }
            if (demolitionList && serviceType === 'demolition') {
              demolitionList.innerHTML += `<div class="summary-row">
                    <div class="label">${label} </div>
                    <div class="qty" >${qty}</div>
                    {% comment %} <div class="price">${formatMoney(lineCents)}</div> {% endcomment %}
                  </div>`;
              summary.demolition = true;
            }
            if (addonsList && serviceType === 'addons') {
              addonsList.innerHTML += `<div class="summary-row">
                    <div class="label">${label} </div>
                    <div class="qty" >${qty}</div>
                    {% comment %} <div class="price">${formatMoney(lineCents)}</div> {% endcomment %}
                  </div>`;
              summary.addons = true;
            }

        }
    });


    // installation_summary, demolition_summary, addons_summary

    const warEl = document.querySelector('input[name="warranty"]:checked');
    if (warEl) {
        const id = parseInt(warEl.value, 10);
        if (id !== 0 && prices[id]) {
            const lineCents = prices[id] || 0;
            totalCents += lineCents;
            const warLabel = warEl.parentNode.innerText.split(':')[0].trim();
            if (addonsList) {
              addonsList.innerHTML += `<div class="summary-row">
                    <div class="label">${warLabel}</div>
                    {% comment %} <div class="price">${formatMoney(lineCents)}</div> {% endcomment %}
                  </div>`;
              summary.addons = true;
            }

        }
    }

    if (summary.installation) {
      installationList.closest('.product-summary-container').style.display = 'flex';
    } else {
      installationList.closest('.product-summary-container').style.display = 'none';
    }
    if (summary.demolition) {
      demolitionList.closest('.product-summary-container').style.display = 'flex';
    } else {
      demolitionList.closest('.product-summary-container').style.display = 'none';
    }
    if (summary.addons) {
      addonsList.closest('.product-summary-container').style.display = 'flex';
    } else {
      addonsList.closest('.product-summary-container').style.display = 'none';
    }
    // totalEl.innerText = formatMoney(totalCents);
  }

  function bindSubtotalListeners() {
    const inputs = document.querySelectorAll('.service-quantity, input[name="warranty"]');
    inputs.forEach(el => {
      if (el.name === 'warranty' && el.type === 'radio') {
        el.addEventListener('click', function () {
          if (this.previousChecked) {
            this.checked = false;
            this.previousChecked = false;
            updateDetailedSubtotal(); // Re-trigger since "change" won't fire when unchecked
          } else {
            // Reset all radios in this group
            document.querySelectorAll('input[name="warranty"]').forEach(r => r.previousChecked = false);
            this.previousChecked = true;
          }
        });
      }
       el.addEventListener('input', updateDetailedSubtotal);
       el.addEventListener('change', updateDetailedSubtotal);
    });
  }

  function getFormattedAddress() {
    if (!document.getElementById('toggle-install-address')?.checked) return '';
    const fields = ['AddressFirstName', 'AddressLastName', 'AddressCompany', 'AddressAddress1', 'AddressAddress2', 'AddressCity', 'AddressProvince', 'AddressZip', 'AddressPhone'];
    const values = fields.map(id => document.getElementById(id)?.value || '');
    const country = document.getElementById('AddressCountry')?.options[document.getElementById('AddressCountry').selectedIndex]?.text || '';
    
    return [`${values[0]} ${values[1]}`, values[2], values[3], values[4], `${values[5]} ${values[6]} ${values[7]}`, country, values[8]]
        .filter(line => line && line.trim()).join('\n');
  }

  const packageBundles = {
    installation: {},
    demolition: {},
    addons: {}
  };

  // =================================================================
  // 4. MAIN EXECUTION
  // =================================================================
  document.addEventListener('DOMContentLoaded', async () => {
    try {
        const grouped = await fetchProductVariantsGrouped();
        if (grouped) {
            renderInstallationPackage(grouped.Installation.filter(g => g.sku !== ''), grouped.productType);
            renderDemolitionPackage(grouped.Demolition.filter(g => g.sku !== ''));
            renderAddonsPackage(grouped['Add-Ons'].filter(g => g.sku !== ''));
            packageBundles.installation = grouped['Installation'].find(ins => ins.title === 'Installation - 1 Year Warranty Included');
            packageBundles.demolition = grouped['Demolition'].find(ins => ins.title === 'Demolition - 1 Year Warranty Included');
            packageBundles.addons = grouped['Add-Ons'].find(ins => ins.title === 'Addons - 1 Year Warranty Included');

            bindSubtotalListeners();
            updateDetailedSubtotal();
            
            const serviceQuantities = document.querySelectorAll('.service-quantity');

            serviceQuantities.forEach((serviceQuantity) => {
              serviceQuantity.addEventListener('input', function () {
                this.value = this.value.replace(/\D/g, ''); // Remove non-digits
              });
            })
        }
    } catch (error) {
        console.error("Failed to initialize installation packages:", error);
    }

    
  });
})();
</script>


<script>
  const isTermChecked = () => {
    const termsCheckbox = document.getElementById('agree_terms');
    return termsCheckbox.checked;
  }
  const scrollToTerms = () => {
    const termsCheckbox = document.getElementById('agree_terms');
    termsCheckbox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  document.addEventListener('DOMContentLoaded', function() {
    // Terms & Conditions Checkbox
    const termsCheckbox = document.getElementById('agree_terms');
    termsCheckbox.addEventListener('change', function () {
        const warningElements = document.querySelectorAll('.addCartWarning');
        warningElements.forEach(el => {
          el.style.display = 'none';
        });
    });

    // Total Square Footage Listener
    function setupInstallListener() {
      const section = document.querySelector('.tier_install');
      if (!section) return;
      const inputs = section.querySelectorAll('.service-quantity');
      const totalEl = section.querySelector('.total-square-foot .qty');
      const updateSqFt = () => {
          let total = 0;
          inputs.forEach(i => { total += parseFloat(i.value) || 0; });
          totalEl.textContent = total.toFixed(2);
      };
      inputs.forEach(input => input.addEventListener('input', updateSqFt));
    }
    const observer = new MutationObserver(() => {
        if (document.querySelector('.tier_install .service-quantity')) {
            setupInstallListener();
            observer.disconnect();
        }
    });
    observer.observe(document.body, { childList: true, subtree: true });

    // Accordion setup
    document.querySelectorAll('.tier__section, .demolition__section, .additional_services__section').forEach(section => {
      const header = section.querySelector('.header');
      if (header) header.addEventListener('click', () => section.classList.toggle('is-collapsed'));
    });

    // Address control
    const toggleAddress = document.getElementById('toggle-install-address');
    const addressForm = document.getElementById('install-address-form');
    const countrySelect = document.getElementById('AddressCountry');
    const provinceSelect = document.getElementById('AddressProvince');
    if(toggleAddress && addressForm) {
      // Initialize provinces for the selected country
      function initializeProvinces(countryCode) {
        // Clear existing options
        provinceSelect.innerHTML = '<option value="">State</option>';

        const selectedOption = document.querySelector(`option[value="${countryCode}"]`);
        const provincesData = selectedOption.getAttribute('data-provinces');
        
        // Unescape HTML entities and parse as JSON
        const provinces = JSON.parse(provincesData.replace(/&quot;/g, '"'));

        if (provinces) {
          provinceSelect.parentElement.style.display = '';
          provinces.forEach(province => {
            const option = document.createElement('option');
            option.value = province[0];
            option.textContent = province[1];
            provinceSelect.appendChild(option);
          });
        } else {
          provinceSelect.parentElement.style.display = 'none';
        }
      }

      // Handle country change
      countrySelect.addEventListener('change', function() {
        initializeProvinces(this.value);
      });

        toggleAddress.addEventListener('change', function () {
            addressForm.style.display = this.checked ? 'flex' : 'none';
            if (this.checked && countrySelect.value) {
              initializeProvinces(countrySelect.value);
            }
        });

      // Initialize provinces for default country if one is selected
      if (countrySelect.value) {
        initializeProvinces(countrySelect.value);
      }
    }
  });
</script>


