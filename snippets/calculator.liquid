  }


  /* Loader styles */
  .gallery-loader {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #0a66c2;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    z-index: 1;
  }

  @keyframes spin {
    0% { transform: translate(-50%, -50%) rotate(0deg); }
    100% { transform: translate(-50%, -50%) rotate(360deg); }
  }
</style>

<style>
    .carousel-container {
      width: 420px;
      margin: 30px auto;
      font-family: Arial, sans-serif;
    }
    .main-image {
      width: 100%;
      object-fit: cover;
      border: 1px solid #ccc;
      display: none;
    }
    .main-image.active {
      display: block;
    }
    .thumbnail-strip-wrapper {
      display: flex;
      align-items: center;
      margin-top: 10px;
    }
    .arrow {
      background: white;
      border: 1px solid #ccc;
      cursor: pointer;
      font-size: 20px;
      padding: 18px 5px;
      user-select: none;
    }
    .thumbnails {
      display: flex;
      overflow-x: auto;
      gap: 8px;
      flex: 1;
      scroll-behavior: smooth;
      padding: 5px 0;
    }
    .thumbnails::-webkit-scrollbar {
      display: none;
    }
    .thumbnail {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border: 1px solid transparent;
      cursor: pointer;
      flex-shrink: 0;
    }
    .thumbnail.active {
      border-color: black;
    }
  .loader {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 30px;
    height: 30px;
    border: 4px solid #ccc;
    border-top: 4px solid #333;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    transform: translate(-50%, -50%);
    z-index: 1;
  }
  
  @keyframes spin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  .additional-flooring {
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .additional-flooring img {
    transform: rotate(180deg);
  }

  @media (max-width:640px){
    .carousel-container .install-guarantee, .carousel-container .install-next, .carousel-container .install-help {
      display:none;
    }
    #detailed-subtotal .install-guarantee, #detailed-subtotal .install-next, #detailed-subtotal .install-help {
      display: flex;
      margin: 15px 0px;
      padding: 15px 15px;
      background: #F4F3F1;
      flex-direction: column;
      gap: 10px;
      border-radius: 8px;
    }
    .tier-grid ul.slick-dots {
        display: flex;
        list-style: none;
        gap: 7px;
        width: fit-content;
        margin: 14px auto 0px;
    }

    .tier-grid ul.slick-dots li {list-style: none;margin: 0px;}

    .tier-grid ul.slick-dots li button {
        font-size: 0;
        width: 13px;
        height: 13px;
        display: block;
        padding: 0px;
        border-radius: 8px;
        border: none;
        background-color: #D9D9D9;
    }

    .tier-grid ul.slick-dots li.slick-active button {background-color: #236A99;}
    .tier_card:hover {
      border-color:var(--c-accent);
      box-shadow:inset 0 0 0 2px var(--c-accent-light);
    }
    
    .tier_card.active {
      border-color:var(--c-accent);
      box-shadow:inset 0 0 0 2px var(--c-accent-light);
    }
    .tier-grid .slick-list.draggable .slick-slide {
        margin: 0px 2px 0px 0px;
    }
  }
</style>

