    document.addEventListener('DOMContentLoaded', async () => {
        try {
            const grouped = await fetchProductVariantsGrouped();
            if (grouped) {
                renderInstallationPackage(grouped.Installation.filter(g => g.sku !== ''), grouped.productType);
                renderDemolitionPackage(grouped.Demolition.filter(g => g.sku !== ''));
                renderAddonsPackage(grouped['Add-Ons'].filter(g => g.sku !== ''));
                
                // This part can be removed if you are hardcoding the ID, but it's better to keep it dynamic.
                const allVariants = [...grouped.Installation, ...grouped.Demolition, ...grouped['Add-Ons']];
                const depositVariant = allVariants.find(v => v.sku === DEPOSIT_SKU);
                if (depositVariant) {
                    depositVariantId = depositVariant.id;
                } else {
                    console.error(`CRITICAL: Deposit variant with SKU "${DEPOSIT_SKU}" not found in product data.`);
                }

                bindSubtotalListeners();
                updateMasterSummary();
            }
        } catch (error) {
            console.error("Failed to initialize installation packages:", error);
        }
    });

