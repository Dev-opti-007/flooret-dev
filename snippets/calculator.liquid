                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            if (!response.ok) throw new Error('Shopify API issue.');

            document.querySelectorAll('.service-quantity').forEach(input => input.value = '');
            if (warEl) warEl.checked = false;
            
            updateMasterSummary();
            refreshAndOpenDrawer();

        } catch (error) {
            console.error('Error adding to cart:', error);
            // alert('Could not add deposit to cart. Please try again.');
        } finally {
            button.textContent = "Reserve Installation – $250 Deposit";
            button.disabled = false;
        }
    });



