<script>
function animateCounter(element, targetNumber, duration = 1500) {
    if (!element) return;
    const start = 0;
    const end = targetNumber;
    const startTime = performance.now();

    function updateCounter(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const ease = progress < 1
            ? 1 - Math.pow(1 - progress, 2)
            : 1;
        const current = Math.round(start + (end - start) * ease);
        element.textContent = current.toLocaleString();
        if (progress < 1) {
            requestAnimationFrame(updateCounter);
        } else {
            element.textContent = end.toLocaleString();
        }
    }
    requestAnimationFrame(updateCounter);
}

// Intersection Observer to run animation when element appears
document.addEventListener('DOMContentLoaded', function() {
    const counterEl = document.querySelector('.counter');
    if (!counterEl) return;

    let hasAnimated = false;
    const observer = new IntersectionObserver(
        (entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !hasAnimated) {
                    animateCounter(counterEl, {{settings.install-number}}, 1500);
                    hasAnimated = true;
                    observer.unobserve(entry.target); // Stop observing after animation
                }
            });
        },
        { threshold: 0.5 } // 50% of element should be visible
    );

    observer.observe(counterEl);
});

</script>  

<script>
  // Add gallery images for each tier
  const tierGalleryImages = {
    bronze: [
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image-2_BRONZE.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image2_BRONZE_Installers_ICON_d49d33b9-1691-4c7e-9d90-b4a3f5e1b180.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image3_BRONZE_US_ICON_70dbe1ff-774f-4da0-9d46-91d8a5b23060.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image4_BRONZE_CleanWorksite_ICON_cfdb0985-6e10-4097-8710-0bbbf18bba5e.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image5_BRONZE_Guarantee_ICON_61f10393-6113-40c1-82b6-b3b44e5c7ac4.jpg'
    ],
    silver: [
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image-2_SILVER.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image2_SILVER_Installers_ICON_334c936e-b437-45bd-81a4-b1ea6f15dbb9.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image3_SILVER_30day_ICON_cb46c277-3add-429e-8c2e-d342deebc02b.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image4_SILVER_US_ICON_6350c7e0-3123-4a4f-b589-85fed4ad94dd.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image5_SILVER_CleanWorksite_ICON_6dc97b69-9015-4c65-a67c-0cccf0e75860.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image6_SILVER_Guarantee_ICON_b0a1e612-7a3f-4b84-8cc1-4c4d39a81558.jpg'
    ],
    gold: [
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image2_GOLD.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image3_GOLD_60day_ICON_999bd21c-37a2-4e51-957b-ea7bf2f4c02e.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image4_GOLD_Kit_ICON_6e211ad3-6ac7-4dfd-8bf3-d76bb212010f.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image5_GOLD.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image6_GOLD.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image7_GOLD_Guarantee_ICON_6e7aa378-3d4e-4032-a8d8-d3012fe4f7ea.jpg',
      'https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Image8_GOLD_Support_ICON_bf43ab89-62a2-4bfd-a499-43d4cc546485.jpg'
    ]
  };

  const thumbnailStrip = document.getElementById("thumbnailStrip");
  const mainImage = document.getElementById("mainImage");

  let currentThumbnails = [];

  function loadTier(tier) {
    const images = tierGalleryImages[tier];
    if (!images || !thumbnailStrip || !mainImage) return;

    thumbnailStrip.innerHTML = ""; // Clear previous
    currentThumbnails = [];

    images.forEach((src, index) => {
      const thumb = document.createElement("img");
      thumb.src = src;
      thumb.className = "thumbnail";
      thumb.onclick = () => selectThumb(thumb);
      thumbnailStrip.appendChild(thumb);
      currentThumbnails.push(thumb);
    });

    if (images.length > 0) {
      mainImage.classList.add("active");
    }

    // Select first image by default
    if (currentThumbnails.length > 0) {
        selectThumb(currentThumbnails[0]);
    }
  }

  function selectThumb(thumb) {
    if (!thumb) return;
    currentThumbnails.forEach(t => t.classList.remove("active"));
    thumb.classList.add("active");
    const loader = document.getElementById("imageLoader");
    loader.style.display = "block";
    mainImage.src = thumb.src;
    
    mainImage.onload = () => {
      loader.style.display = "none";
    };

    const rect = thumb.getBoundingClientRect();
    const containerRect = thumbnailStrip.getBoundingClientRect();
    const padding = 10;

    if (rect.right > containerRect.right - padding) {
      thumbnailStrip.scrollLeft += rect.right - containerRect.right + padding;
    } else if (rect.left < containerRect.left + padding) {
      thumbnailStrip.scrollLeft -= containerRect.left - rect.left + padding;
    }
  }

  function selectRelativeThumb(direction) {
    const index = currentThumbnails.findIndex(t => t.classList.contains("active"));
    let newIndex = index + direction;
    if (newIndex < 0) newIndex = 0;
    if (newIndex >= currentThumbnails.length) newIndex = currentThumbnails.length - 1;
    selectThumb(currentThumbnails[newIndex]);
  }

  // Load gold tier by default
  window.onload = () => {
    if(document.querySelector('.carousel-container')) {
        loadTier('gold');
    }
  };
</script>

<script>

function updateCartCount() {
  fetch('/cart.js')
    .then(res => res.json())
    .then(cart => {
      // This targets any element with the class 'js-cart-count' to update the number
      document.querySelectorAll('.js-cart-count').forEach(el => {
        el.textContent = cart.item_count;
      });

      // This handles showing/hiding the count if it's zero
      const cartCountWrapper = document.querySelector('.cart-count-bubble'); // Common selector in Dawn theme
      if (cartCountWrapper) {
        if (cart.item_count > 0) {
          cartCountWrapper.classList.remove('hidden');
        } else {
          cartCountWrapper.classList.add('hidden');
        }
      }
    })
    .catch(err => {
      console.error('Failed to fetch cart count:', err);
    });
}


async function refreshAndOpenDrawer() {
    console.log("Attempting to refresh cart with selectors from old code...");

    // --- Clue #1: We are now using 'pop-cart' as the section name ---
    const cartDrawerSectionName = 'pop-cart';

    // --- Clue #3: We are now using '.js-cart-drawer-trigger' as the trigger ---
    const cartTriggerSelector = '.js-cart-drawer-trigger';

    // --- Clue #2: We will TRY using '.pop-cart' as the main drawer element. ---
    // This is our best guess. If this doesn't work, we'll need to find the specific ID.
    const cartDrawerSelector = '.pop-cart';


    try {
        const res = await fetch(`/?sections=${cartDrawerSectionName}`);
        if (!res.ok) throw new Error(`Section '${cartDrawerSectionName}' not found.`);
        
        const sections = await res.json();
        const newCartDrawerHtml = sections[cartDrawerSectionName];

        const cartDrawerElement = document.querySelector(cartDrawerSelector);

        if (cartDrawerElement && newCartDrawerHtml) {
            console.log("Success: Found cart drawer element, updating its content.");
            const parser = new DOMParser();
            const newDOM = parser.parseFromString(newCartDrawerHtml, 'text/html');
            
            // Find the content inside the new HTML and replace the old content
            const newInnerContent = newDOM.querySelector(cartDrawerSelector);
            if (newInnerContent) {
                cartDrawerElement.innerHTML = newInnerContent.innerHTML;
            } else {
                cartDrawerElement.innerHTML = newCartDrawerHtml;
            }
        } else {
            console.error("Failed to find the cart drawer element with selector:", cartDrawerSelector);
        }

        const triggerElement = document.querySelector(cartTriggerSelector);
        if (triggerElement) {
            console.log("Success: Found trigger element, clicking to open drawer.");
            triggerElement.click();
        } else {
            console.error("Failed to find the cart trigger element with selector:", cartTriggerSelector);
        }
        console.log('dedededeeeededeeddeededed')
        // Assuming you have an updateCartCount function
        updateCartCount();

    } catch (error) {
        console.error("Error in refreshAndOpenDrawer:", error);
        alert("Sorry, there was an error updating the cart.");
    }
}


