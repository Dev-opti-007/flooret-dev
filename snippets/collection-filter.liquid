{%- liquid
  assign total_active_values = 0
  assign sort_by = collection.sort_by | default: 'manual'

  for filter in collection.filters
    assign total_active_values = total_active_values | plus: filter.active_values.size
    if filter.min_value.value != null or filter.max_value.value != null
      assign total_active_values = total_active_values | plus: 1
    endif
  endfor
-%}

<style>
  .col-facets__filters .filter {
    width: auto;
  }

  @media screen and (min-width: 960px){
    .col-facets__filters {
      gap: 26px;
    }
    .col-facets__filters, .col-facets__filters .filter__content ul {
      flex-direction: row;
    }
  }
</style>

<div class="col-filters js-header-sticky">
  <div class="container collection-filter">
    <button class="reset show-filters mob-only" type="button">
      {% render 'svg-filter' %}
      {{ 'global.show_all_filters' | t }}
    </button>

    <form class="col-facets js-adjust-to-header js-header-sticky" id="col-facets">
      <input id="sort_by" type="hidden" name="sort_by" value="{{ sort_by }}">
      {%- if collection.terms -%}
        <input type="hidden" name="q" value="{{ collection.terms | escape }}">
        <input name="options[prefix]" type="hidden" value="last">
      {%- endif -%}

      <button type="submit" class="col-facets__submit hidden">Submit</button>
      <div class="overflow">
        <div class="col-facets__mob-header mob-only">
          <span>{{ collection.products_count }} Results</span>
          <button class="reset col-facets__close show-filters" type="button">{% render 'svg-close' %}</button>
        </div>
        <div class="wrap-filter-inner">
          <div class="container">
            <div class="col-facets__filters devtest">
              {%- for filter in collection.filters -%}
                {% liquid
                  assign listClass = 'one-col'
                  if filter.values.size > 3 and filter.values < 7
                    assign listClass = 'two-col'
                  elsif filter.values.size > 6
                    assign listClass = 'three-col'
                  endif

                  if filter.values.size == 0
                    continue
                  endif
                  if filter.values.size == 1
                    continue
                  endif

                  # if filter.label == 'Model' and collection.handle != 'modin-luxury-vinyl-plank'
                  # continue
                  # endif

                  # if filter.label == 'Plank Width' and collection.handle != 'all'
                  # continue
                  # endif

                  if filter.label == 'Plank Width' and collection.handle == 'sample-kits'
                    continue
                  endif

                  assign showCollectionFilterIn = 'trim-accessories,inspiration' | split: ','
                %}
                {%- assign eligible_values = 0 -%}
                {%- for value in filter.values -%}
                  {%- if value.label != 'Hidden' and value.label != 'show-sqft-price-in-product' -%}
                    {%- assign eligible_values = eligible_values | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if eligible_values > 1 -%}
                  {% assign filter_label = filter.label | handleize %}
                  {% unless filter_label == 'character' %}
                    <fieldset class="filter filter--{{ filter.label | handleize }}">
                      <div class="wrap-filter-fieldset">
                        <legend data-label="{{ filter.label | handleize }}">
                          {% assign label = filter.label | handleize %}
                          {% if label == 'plank-width' %}
                            Size
                          {% else %}
                            {{ filter.label }}
                            {% render 'svg-chevron' %}
                          {% endif %}
                        </legend>
                        <div class="filter__content">
                          <div class="container">
                            {% if filter.type == 'price_range' %}
                              <div class="price-range">
                                <label for="Mobile-Filter-{{ filter.label | escape }}-GTE">
                                  Min
                                  <input
                                    class="field__input"
                                    name="{{ filter.min_value.param_name }}"
                                    id="Mobile-Filter-{{ filter.label | escape }}-GTE"
                                    {%- if filter.min_value.value -%}
                                      {%- if uses_comma_decimals -%}
                                        value="{{ filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                                      {%- else -%}
                                        value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                                      {%- endif %}
                                    {%- endif -%}
                                    type="number"
                                    placeholder="0"
                                    min="0"
                                    inputmode="decimal"
                                    {%- if uses_comma_decimals -%}
                                      max="{{ filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                                    {%- else -%}
                                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                    {% endif %}
                                  >
                                </label>
                                <label for="Mobile-Filter-{{ filter.label | escape }}-LTE">
                                  Max
                                  <input
                                    class="field__input"
                                    name="{{ filter.max_value.param_name }}"
                                    id="Mobile-Filter-{{ filter.label | escape }}-LTE"
                                    {%- if filter.max_value.value -%}
                                      {%- if uses_comma_decimals -%}
                                        value="{{ filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                                      {%- else -%}
                                        value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                                      {%- endif %}
                                    {%- endif -%}
                                    type="number"
                                    min="0"
                                    inputmode="decimal"
                                    {%- if uses_comma_decimals -%}
                                      placeholder="{{ filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                                      max="{{ filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.' }}"
                                    {%- else -%}
                                      placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                    {% endif %}
                                  >
                                </label>
                              </div>
                            {% elsif filter.label == 'Plank Size' %}
                              <ul class="filter-group--{{ filter.label | handleize }}" id="plank-size">
                                {% for value in filter.values %}
                                  {{ value }}
                                  {%- liquid
                                    assign filter_handle = blank
                                    assign filter_img = blank

                                    if value.label == 'Hidden'
                                      continue
                                    endif

                                    if value.display.type == 'image'
                                      assign filter_handle = value.display.value | handleize
                                      assign filter_img = value.display.value
                                    endif

                                    if filter.label == 'Plank Size' or filter.label == 'Model'
                                      assign filter_handle = value.label | handleize
                                      assign filter_img = shop.metaobjects.product_model[filter_handle].image
                                    endif
                                  -%}

                                  <li class="filter-option--{{ value.value | handleize }}">
                                    <input
                                      type="radio"
                                      id="{{ filter.param_name | escape }}-{{ forloop.index }}"
                                      class="hidden"
                                      name="{{ value.param_name }}"
                                      value="{{ value.value }}"
                                      {% if value.active %}
                                        checked
                                      {% endif %}
                                      {% if value.count == 0 and value.active == false %}
                                        disabled
                                      {% endif %}
                                    >
                                    <label
                                      class="col-facets__item"
                                      title="{{ value.label }}"
                                      for="{{ filter.param_name | escape }}-{{ forloop.index }}"
                                    >
                                      {%- if filter_img != blank -%}
                                        <span class="col-facets__icon {{ filter.param_name | escape }}-{{ forloop.index }}">
                                          <img
                                            src="{{ filter_img | image_url: width: 100, height: 100 }}"
                                            width="auto"
                                            height="auto"
                                          >
                                        </span>
                                      {%- endif -%}
                                      <span class="col-facets__label">
                                        
                                        {% if value.label == '4.2" herringbone' %}
                                          4.2"
                                        {% else %}
                                          {{- value.label }}
                                        {% endif %}
                                        <span class="count">({{ value.count }})</span></span
                                      >
                                    </label>
                                  </li>
                                {% endfor %}
                              </ul>
                            {% else %}
                              <ul class="filter-group--{{ filter.label | handleize }}">
                                {% for value in filter.values %}
                                  {%- liquid
                                    assign filter_handle = blank
                                    assign filter_img = blank

                                    if value.label == 'Hidden'
                                      continue
                                    endif

                                    if value.display.type == 'image'
                                      assign filter_handle = value.display.value | handleize
                                      assign filter_img = value.display.value
                                    endif

                                    if filter.label == 'Plank Size' or filter.label == 'Model'
                                      assign filter_handle = value.label | handleize
                                      assign filter_img = shop.metaobjects.product_model[filter_handle].image
                                    endif
                                  -%}
                                  {% unless value.value == 'Cat--Arista' or value.value == 'new color' %}
                                    <li
                                      id="plank_input"
                                      
                                      {% comment %} value="{{ value.value | handleize }}" {% endcomment %}
                                      value="{{ value.label | remove:'"' }}"
                                      123123
                                      class="filter-option--{{ value.value | handleize }}"
                                    >
                                      <input
                                        type="checkbox"
                                        id="{{ filter.param_name | escape }}-{{ forloop.index }}"
                                        class="hidden"
                                        name="{{ value.param_name }}"
                                        value="{{ value.value }}"
                                        {% comment %} value="{{ value.label | remove:'"' }}" {% endcomment %}
                                        {% if value.active %}
                                          checked
                                        {% endif %}
                                        {% if value.count == 0 and value.active == false %}
                                          disabled
                                        {% endif %}
                                      >
                                      <label
                                        class="col-facets__item"
                                        title="{{ value.label }}"
                                        for="{{ filter.param_name | escape }}-{{ forloop.index }}"
                                      >
                                        {%- if filter_img != blank -%}
                                          <span class="col-facets__icon {{ filter.param_name | escape }}-{{ forloop.index }}">
                                            <img src="{{ filter_img | image_url: width: 100, height: 100 }}" width="100" height="100">
                                          </span>
                                        {%- endif -%}
                                        <span class="col-facets__label">
                                           {% if value.label == '4.2" herringbone' %}
                                          4.2"
                                        {% else %}
                                          {{- value.label }}
                                        {% endif %}
                                          <span class="count">({{ value.count }})</span></span
                                        >
                                      </label>
                                    </li>
                                  {% endunless %}
                                {% endfor %}
                              </ul>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    </fieldset>
                  {% endunless %}
                {% endif %}
              {% endfor %}
            </div>
            <div class="filter filter--sortby">
              <label>Sort By </label>
              <div class="select-menu">
                <select
                  name="facet-filter__sort"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    {% comment %} {% unless option.value == 'price-ascending' or option.value == 'price-descending' %}   {% endcomment %}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                    {% comment %} {% endunless %} {% endcomment %}
                  {%- endfor -%}
                </select>
              </div>
            </div>
          </div>
        </div>
        {% if total_active_values > 0 %}
          <div class="selected-filters">
            <div class="container filter-group">
              {% comment %} <span class="selected-filters__label">My Filters: </span> {% endcomment %}
              <div class="selected-filters__selected">
                {%- for filter in collection.filters -%}
                  {%- for filter_value in filter.active_values -%}
                    <button
                      class="remove-filter"
                      type="button"
                      data-ftype="{{ filter_value }}"
                      data-remove="{{ filter_value.url_to_remove }}"
                    >
                      <span> x </span>
                      {{ filter_value.label | escape }}
                    </button>
                  {%- endfor -%}
                  {%- if filter.type == 'price_range' -%}
                    {%- if filter.min_value.value != null or filter.max_value.value != null -%}
                      <button class="remove-filter" type="button" data-remove="{{ filter.url_to_remove }}">
                        <span></span>
                        {%- liquid
                          if filter.min_value.value
                            echo filter.min_value.value | money
                          else
                            echo 0 | money
                          endif
                          echo '-'
                          if filter.max_value.value
                            echo filter.max_value.value | money
                          else
                            echo filter.range_max | money
                          endif
                        %}
                      </button>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </form>
  </div>
</div>

{% comment %} <script>
  let lastClickTime = 0;
  const DEBOUNCE_TIME = 100; // milliseconds

  function getSelectionOrder() {
    return JSON.parse(localStorage.getItem('TRACK_ORDER')) || [];
  }

  function saveSelectionOrder(order) {
    localStorage.setItem('TRACK_ORDER', JSON.stringify(order));
  }

  function handlePlankClick(value) {
    // Check if enough time has passed since last click
    const now = Date.now();
    if (now - lastClickTime < DEBOUNCE_TIME) {
      return; // Ignore clicks that are too close together
    }
    lastClickTime = now;

    let currentOrder = getSelectionOrder();
    const isAlreadySelected = currentOrder.includes(value);

    // Toggle the value
    if (isAlreadySelected) {
      currentOrder = currentOrder.filter((v) => v !== value);
    } else {
      currentOrder.push(value);
    }

    // Save immediately
    saveSelectionOrder(currentOrder);
  }

  // Use requestAnimationFrame to ensure we're not fighting with other handlers
  document.addEventListener('click', (e) => {
    const plank = e.target.closest('li[id^="plank_input"]');
    if (plank) {
      const value = plank.getAttribute('value');
      if (value) {
        requestAnimationFrame(() => {
          handlePlankClick(value.trim());
        });
      }
    }
  });

  // Function to check the filter.p.tag values and update the display styles for multiple model info elements
  function checkTagsAndUpdateDisplay() {
    // Get the query string from the current URL
    const queryString = window.location.search;

    // Create a URLSearchParams instance
    const urlParams = new URLSearchParams(queryString);

    // Get all values for filter.p.tag (if there are multiple values)
    const tags = urlParams.getAll('filter.p.tag');

    const parsedTags = tags
      .map((str) => parseFloat(str.match(/[\d.]+/)))
      .filter((num) => !isNaN(num))
      .map((num) => num.toString());

    // Get all product card elements
    const productMetaList = document.querySelectorAll('.product-card__meta.no-filter');
    const productMetaHasFilterList = document.querySelectorAll('.product-card__meta.has-filter');
    const productCardSwatchesList = document.querySelectorAll('.product-card-swatches');

    // Get all product card image elements
    const productImageHasFilterItems = document.querySelectorAll('.image-has-filter');
    //  const productImageHasNoFilterItems = document.querySelectorAll('.image-no-filter');

    // Get all .product -card__model-info elements with the 'has-filter' class
    const modelInfoElements = document.querySelectorAll('.product-card__model-info.has-filter');

    // Get all card image elements
    const cardImageElements = document.querySelectorAll('.model-card-image');

    // Check if filter.p.tag is present and has any value
    if (parsedTags.length > 0) {
      // Show all .product-card__meta.has-filter elements
      productMetaHasFilterList.forEach((element) => {
        //console.log("productMetaHasFilterList")
        element.classList.remove('hidden');
        element.classList.add('visible');
        //let elements = document.querySelectorAll('.product-card__image.image-no-filter ul.slick-dots');
        //elements.forEach((element)=>{
          //element.style.display = 'none';
        //});
        //$('.product-card__image.image-no-filter').css({'display':'none'})
      });

      // Hide all .product-card__meta elements (no filter case)
      productMetaList.forEach((element) => {
        element.classList.remove('visible');
        element.classList.add('hidden');
      });

      // Hide all .product-card-swatches elements (if needed)
      {% comment %} productCardSwatchesList.forEach((element) => {
        element.classList.remove('visible');
        element.classList.add('hidden');
      }); {% endcomment %}

      // Show all filtered elements (if needed)
      productImageHasFilterItems.forEach((element) => {
        element.classList.remove('hidden');
        element.classList.add('visible');
      });

      // Hide all no filtered elements (if needed)
      //      productImageHasNoFilterItems.forEach(element => {
      //        element.classList.remove('visible');
      //        element.classList.add('hidden');
      //      });

      // Loop through all .product-card__model-info elements with the 'has-filter' class
      modelInfoElements.forEach((modelInfoElement) => {
        // Get the target value from the element's target attribute, removing ' in'
        const targetValue = modelInfoElement.getAttribute('target').replace(' in', '');
        const sanitizedTags = tags.map((tag) => tag.replace(/"/g, ''));

        // Show the element if the target matches any of the filter.p.tag values
        if (sanitizedTags?.includes(targetValue)) {
          modelInfoElement.classList.remove('hidden');
          modelInfoElement.classList.add('visible');
        } else {
          // Hide the element if the target does not match
          modelInfoElement.classList.remove('visible');
          modelInfoElement.classList.add('hidden');
        }
      });

      cardImageElements.forEach((cardImageElement, index) => {
        const targetValue = cardImageElement.getAttribute('target').replace(' in', '');
        const sanitizedTags = parsedTags.map((tag) => tag.replace(/"/g, ''));

        const showElement = () => {
          cardImageElement.classList.remove('hidden');
          cardImageElement.classList.add('visible');
          cardImageElement.setAttribute('target-visible', 'true');
        };

        const hideElement = () => {
          cardImageElement.classList.remove('visible');
          cardImageElement.classList.add('hidden');
          cardImageElement.setAttribute('target-visible', 'false');
        };

        if (sanitizedTags?.length > 1) {
          const currentOrder = JSON.parse(localStorage.getItem('TRACK_ORDER')) || [];
          const parsedOrder = currentOrder
            .filter((item) => /^\d+(-\d+)?-quot$/.test(item))
            .map((item) => item.replace('-quot', '').replace('-', '.'));

          if (parsedOrder.at(-1) == targetValue) {
            showElement();
          } else {
            hideElement();
          }
        } else if (sanitizedTags[0]) {
          if (sanitizedTags[0] == targetValue || targetValue == '7.7') {
            showElement();
          } else {
            hideElement();
          }
        }
      });
    } else {
      // No filter tag, hide all .product-card__meta.has-filter elements and show all .product-card__meta elements
      productMetaHasFilterList.forEach((element) => {
        element.classList.remove('visible');
        element.classList.add('hidden');
      });

      productMetaList.forEach((element) => {
        element.classList.remove('hidden');
        element.classList.add('visible');
      });

      // Show all .product-card-swatches elements (if needed)
      productCardSwatchesList.forEach((element) => {
        element.classList.remove('hidden');
        element.classList.add('visible');
      });

      // Hide all filtered elements (if needed)
      productImageHasFilterItems.forEach((element) => {
        element.classList.remove('visible');
        element.classList.add('hidden');
      });

      // Show all no filtered elements (if needed)
      //        productImageHasNoFilterItems.forEach(element => {
      //        element.classList.remove('hidden');
      //        element.classList.add('visible');
      //      });

      // Hide all .product-card__model-info.has-filter elements if no filter is applied
      modelInfoElements.forEach((modelInfoElement) => {
        modelInfoElement.classList.remove('visible');
        modelInfoElement.classList.add('hidden');
      });
    }
  }

  // Set an interval to check every 0.5 seconds
  setInterval(checkTagsAndUpdateDisplay, 500);
</script> {% endcomment %}

<script>
  function normalizeValue(value = '') {
    return value
      .toString()
      .replace(/"/g, '')
      .replace(/\s+/g, ' ')
      .trim()
      .toLowerCase();
  }

  function getSelectedPlankValues() {
    const checkedInputs = document.querySelectorAll(
      '.filter-group--plank-width input[name="filter.p.tag"]:checked'
    );

    return Array.from(checkedInputs)
      .map((input) => input.closest('li'))
      .filter(Boolean)
      .map((li) => normalizeValue(li.getAttribute('value')))
      .filter(Boolean);
  }

  function updatePlankMatchedContent() {
    const selectedValues = getSelectedPlankValues();

    {% comment %} console.log('selectedValues:', selectedValues); {% endcomment %}

    const noFilterMeta = document.querySelectorAll('.product-card__meta.no-filter');
    const hasFilterMeta = document.querySelectorAll('.product-card__meta.has-filter');
    const allModelInfos = document.querySelectorAll('.product-card__model-info.has-filter');

    if (selectedValues.length === 0) {
      noFilterMeta.forEach((el) => {
        el.classList.remove('hidden');
        el.classList.add('visible');
      });

      hasFilterMeta.forEach((el) => {
        el.classList.remove('visible');
        el.classList.add('hidden');
      });

      allModelInfos.forEach((el) => {
        el.classList.remove('visible');
        el.classList.add('hidden');
      });

      return;
    }

    noFilterMeta.forEach((el) => {
      el.classList.remove('visible');
      el.classList.add('hidden');
    });

    hasFilterMeta.forEach((el) => {
      el.classList.remove('hidden');
      el.classList.add('visible');
    });

    allModelInfos.forEach((el) => {
      const targetValue = normalizeValue(el.getAttribute('target'));
      const matched = selectedValues.includes(targetValue);

      console.log('target:', targetValue, 'matched:', matched);

      el.classList.toggle('visible', matched);
      el.classList.toggle('hidden', !matched);
    });
  }

  document.addEventListener('change', function (e) {
    if (e.target.matches('.filter-group--plank-width input[name="filter.p.tag"]')) {
      setTimeout(updatePlankMatchedContent, 150);
    }
  });

  updatePlankMatchedContent();

  setInterval(updatePlankMatchedContent, 500);
</script>

{% comment %} 
{% assign active_collection_filter = '' %}
{% for filter in collection.filters %}
  {% if filter.param_name == 'filter.p.m.custom.product_collection' %}
    {% for value in filter.active_values %}
      {% assign active_collection_filter = value.value %}
    {% endfor %}
  {% endif %}
{% endfor %}

{% if active_collection_filter == 'Modin' %}
    {% for block in section.blocks  %}
      {% case block.type %}
          {% when 'true-plank' %}
            {%- liquid
  assign tab1_features_count = 3
  assign tab2_features_count = 3
-%}

<section class="pcs pcs--{{ section.id }}{% if block.settings.full_width %} pcs--full-width{% endif %}">

  {%- comment -%} ══ HEADER ROW ══ {%- endcomment -%}
  <div class="pcs__header">
