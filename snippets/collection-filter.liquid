        {{ block.settings.tab1_label | default: 'TrueStep' }}
      </button>
      <button
        class="pcs__tab pcs__tab--2"
        role="tab"
        aria-selected="false"
        aria-controls="pcs-panel-{{ section.id }}"
        data-tab="2"
        id="pcs-tab2-{{ section.id }}">
        {{ block.settings.tab2_label | default: 'TruePlank' }}
      </button>
    </div>
    {%- if block.settings.tabs_tagline != blank -%}
      <p class="pcs__tabs-tagline">{{ block.settings.tabs_tagline }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} ══ MAIN PANEL ══ {%- endcomment -%}
  <div class="pcs__panel" id="pcs-panel-{{ section.id }}" role="tabpanel">

    {%- comment -%} ── LEFT: Single image per tab ── {%- endcomment -%}
    <div class="pcs__image-col">

      <div class="pcs__slides" aria-live="polite">

        {%- comment -%} TAB 1 IMAGE {%- endcomment -%}
        <div class="pcs__slide pcs__slide--tab1 is-active" data-tab="1">
          {%- if block.settings.tab1_slide1_image != blank -%}
            <img
              src="{{ block.settings.tab1_slide1_image | image_url: width: block.settings.slide_image_width | default: 800 }}"
              alt="{{ block.settings.tab1_slide1_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="600">
          {%- else -%}
            <div class="pcs__slide-placeholder">
              <span>Image or drawings</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} TAB 2 IMAGE {%- endcomment -%}
        <div class="pcs__slide pcs__slide--tab2" data-tab="2" style="display:none;">
          {%- if block.settings.tab2_slide1_image != blank -%}
            <img
              src="{{ block.settings.tab2_slide1_image | image_url: width: block.settings.slide_image_width | default: 800 }}"
              alt="{{ block.settings.tab2_slide1_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="600">
          {%- else -%}
            <div class="pcs__slide-placeholder">
              <span>Image or drawings</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} TAB 1 HOTSPOTS {%- endcomment -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign dot_top_key  = 'tab1_s1_dot' | append: i | append: '_top'
            assign dot_left_key = 'tab1_s1_dot' | append: i | append: '_left'
          -%}
          <button
            class="pcs__hotspot pcs__hotspot--tab1"
            data-tab="1"
            style="top:{{ block.settings[dot_top_key] | default: 30 }}%;left:{{ block.settings[dot_left_key] | default: 25 }}%;"
            aria-label="Feature {{ i }}">
            {{ i }}
          </button>
        {%- endfor -%}

        {%- comment -%} TAB 2 HOTSPOTS {%- endcomment -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign dot_top_key  = 'tab2_s1_dot' | append: i | append: '_top'
            assign dot_left_key = 'tab2_s1_dot' | append: i | append: '_left'
          -%}
          <button
            class="pcs__hotspot pcs__hotspot--tab2"
            data-tab="2"
            style="top:{{ block.settings[dot_top_key] | default: 30 }}%;left:{{ block.settings[dot_left_key] | default: 25 }}%;"
            aria-label="Feature {{ i }}"
            hidden>
            {{ i }}
          </button>
        {%- endfor -%}

      </div>

      {%- comment -%} Pagination dots now switch tabs {%- endcomment -%}
      <div class="pcs__pagination" role="tablist" aria-label="Product navigation">
        <button
          class="pcs__dot is-active"
          data-tab-dot="1"
          role="tab"
          aria-selected="true"
          aria-label="Show {{ block.settings.tab1_label | default: 'Tab 1' }}">
        </button>
        <button
          class="pcs__dot"
          data-tab-dot="2"
          role="tab"
          aria-selected="false"
          aria-label="Show {{ block.settings.tab2_label | default: 'Tab 2' }}">
        </button>
      </div>

    </div>

    {%- comment -%} ── RIGHT: Product Info ── {%- endcomment -%}
    <div class="pcs__info-col">

      {%- comment -%} TAB 1 CONTENT {%- endcomment -%}
      <div class="pcs__tab-content pcs__tab-content--1 is-active" data-content="1">
        {%- if block.settings.tab1_product_title != blank -%}
          <h3 class="pcs__product-title">{{ block.settings.tab1_product_title }}</h3>
        {%- endif -%}
        {%- if block.settings.tab1_product_desc != blank -%}
          <p class="pcs__product-desc">{{ block.settings.tab1_product_desc }}</p>
        {%- endif -%}

        <div class="pcs__features">
          {%- for i in (1..3) -%}
            {%- liquid
              assign feat_img_key    = 'tab1_feat' | append: i | append: '_image'
              assign feat_title_key  = 'tab1_feat' | append: i | append: '_title'
              assign feat_detail_key = 'tab1_feat' | append: i | append: '_detail'
              assign feat_img        = block.settings[feat_img_key]
              assign feat_title      = block.settings[feat_title_key]
              assign feat_detail     = block.settings[feat_detail_key]
            -%}
            {%- if feat_title != blank -%}
              <div class="pcs__feature">
                <div class="pcs__feature-img">
                  {%- if feat_img != blank -%}
                    <img src="{{ feat_img | image_url: width: 160 }}" alt="{{ feat_img.alt | escape }}" loading="lazy" width="80" height="80">
                  {%- else -%}
                    <div class="pcs__feature-img-placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="pcs__feature-text">
                  <p class="pcs__feature-title">{{ feat_title }}</p>
                  {%- if feat_detail != blank -%}
                    <p class="pcs__feature-detail">{{ feat_detail }}</p>
                  {%- endif -%}
                </div>
                <span class="pcs__feature-badge" aria-hidden="true">{{ i }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if block.settings.tab1_btn_text != blank -%}
          <a class="pcs__cta" href="{{ block.settings.tab1_btn_url }}">
            {{ block.settings.tab1_btn_text }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} TAB 2 CONTENT {%- endcomment -%}
      <div class="pcs__tab-content pcs__tab-content--2" data-content="2" style="display:none;">
        {%- if block.settings.tab2_product_title != blank -%}
          <h3 class="pcs__product-title">{{ block.settings.tab2_product_title }}</h3>
        {%- endif -%}
        {%- if block.settings.tab2_product_desc != blank -%}
          <p class="pcs__product-desc">{{ block.settings.tab2_product_desc }}</p>
        {%- endif -%}

        <div class="pcs__features">
          {%- for i in (1..3) -%}
            {%- liquid
              assign feat_img_key    = 'tab2_feat' | append: i | append: '_image'
              assign feat_title_key  = 'tab2_feat' | append: i | append: '_title'
              assign feat_detail_key = 'tab2_feat' | append: i | append: '_detail'
              assign feat_img        = block.settings[feat_img_key]
              assign feat_title      = block.settings[feat_title_key]
              assign feat_detail     = block.settings[feat_detail_key]
            -%}
            {%- if feat_title != blank -%}
              <div class="pcs__feature">
                <div class="pcs__feature-img">
                  {%- if feat_img != blank -%}
                    <img src="{{ feat_img | image_url: width: 160 }}" alt="{{ feat_img.alt | escape }}" loading="lazy" width="80" height="80">
                  {%- else -%}
                    <div class="pcs__feature-img-placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="pcs__feature-text">
                  <p class="pcs__feature-title">{{ feat_title }}</p>
                  {%- if feat_detail != blank -%}
                    <p class="pcs__feature-detail">{{ feat_detail }}</p>
                  {%- endif -%}
                </div>
                <span class="pcs__feature-badge" aria-hidden="true">{{ i }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if block.settings.tab2_btn_text != blank -%}
          <a class="pcs__cta" href="{{ block.settings.tab2_btn_url }}">
            {{ block.settings.tab2_btn_text }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>

</section>

<style>
  .pcs--{{ section.id }} {
    --pcs-font-heading: '{{ block.settings.font_heading }}', sans-serif;
    --pcs-font-body: '{{ block.settings.font_body }}', sans-serif;
    --pcs-accent: {{ block.settings.accent_color | default: '#f5a623' }};
    --pcs-accent-hover: {{ block.settings.accent_hover_color | default: '#d48f0f' }};
    --pcs-bg: {{ block.settings.section_bg | default: '#ffffff' }};
    --pcs-panel-bg: {{ block.settings.panel_bg | default: '#f5f3ef' }};
    --pcs-feature-bg: {{ block.settings.feature_bg | default: '#ffffff' }};
    --pcs-text: {{ block.settings.text_color | default: '#1a1a1a' }};
    --pcs-text-muted: {{ block.settings.text_muted_color | default: '#000000' }};
    --pcs-step-number-color: {{ block.settings.step_number_color | default: '#e8e3db' }};
    --pcs-tab-active-bg: {{ block.settings.tab_active_bg | default: '#1a1a1a' }};
    --pcs-tab-active-text: {{ block.settings.tab_active_text | default: '#ffffff' }};
    --pcs-tab-inactive-bg: {{ block.settings.tab_inactive_bg | default: '#ffffff' }};
    --pcs-tab-inactive-text: {{ block.settings.tab_inactive_text | default: '#1a1a1a' }};
    --pcs-radius: {{ block.settings.panel_radius | default: 16 }}px;
    --pcs-feature-radius: {{ block.settings.feature_radius | default: 12 }}px;
  }

  .pcs--{{ section.id }} {
    width: 100%;
    background: var(--pcs-bg);
    font-family: var(--pcs-font-body, sans-serif);
    color: var(--pcs-text);
    {% unless block.settings.full_width %}
      max-width: {{ block.settings.section_max_width | default: 1200 }}px;
      margin-inline: auto;
    {% endunless %}
    padding: {{ block.settings.section_padding_top | default: 60 }}px
             {{ block.settings.section_padding_h | default: 24 }}px
             {{ block.settings.section_padding_bottom | default: 60 }}px;
  }

  .pcs--{{ section.id }} .pcs__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: {{ block.settings.header_gap | default: 40 }}px;
    margin-bottom: {{ block.settings.header_mb | default: 40 }}px;
  }

  .pcs--{{ section.id }} .pcs__header-left {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.step_gap | default: 20 }}px;
    flex: 1;
  }

  .pcs--{{ section.id }} .pcs__step-number {
    font-family: var(--pcs-font-heading, sans-serif);
    font-size: {{ block.settings.step_number_size | default: 110 }}px;
    font-weight: {{ block.settings.step_number_weight | default: 700 }};
    line-height: 0.85;
    color: var(--pcs-step-number-color);
    letter-spacing: -2px;
    user-select: none;
    flex-shrink: 0;
    font-family: Playfair;
    font-weight: 600;
    font-size: 200px;
    line-height: 50.4px;
    vertical-align: middle;
  }

  .pcs--{{ section.id }} .pcs__header-meta {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: 4px;
  }

  .pcs--{{ section.id }} .pcs__step-label {
    margin: 0 0 4px;
    font-size: {{ block.settings.step_label_size | default: 12 }}px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pcs-text-muted);
    font-family: Montserrat;
    font-weight: 700;
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 0.6px;
    color: #4A5565;
  }

  .pcs--{{ section.id }} .pcs__title {
    margin: 0;
    font-family: var(--pcs-font-heading, sans-serif);
    font-size: {{ block.settings.title_size_desktop | default: 36 }}px;
    font-weight: {{ block.settings.title_weight | default: 700 }};
    line-height: 1.1;
    color: var(--pcs-text);
    font-family: Montserrat;
    font-weight: 500;
    font-size: 30px;
    line-height: 36px;
    letter-spacing: 0.4px;
  }

  .pcs--{{ section.id }} .pcs__header-right {
    max-width: {{ block.settings.header_desc_max_width | default: 300 }}px;
    flex-shrink: 0;
  }

  .pcs--{{ section.id }} .pcs__header-desc {
    margin: 0;
    font-size: {{ block.settings.header_desc_size | default: 15 }}px;
    line-height: 1.6;
    color: var(--pcs-text-muted);
    text-align: left;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.31px;
  }

  .pcs--{{ section.id }} .pcs__tabs-row {
    display: flex;
    align-items: center;
    gap: {{ block.settings.tabs_gap | default: 20 }}px;
    margin-bottom: {{ block.settings.tabs_mb | default: 20 }}px;
  }

  .pcs--{{ section.id }} .pcs__tabs {
    display: flex;
    background: {{ block.settings.tabs_track_bg | default: '#eeebe5' }};
    border-radius: {{ block.settings.tab_radius | default: 50 }}px;
    padding: {{ block.settings.tabs_track_padding | default: 4 }}px;
    gap: 0;
  }

  .pcs--{{ section.id }} .pcs__tab {
    padding: {{ block.settings.tab_padding_v | default: 10 }}px {{ block.settings.tab_padding_h | default: 22 }}px;
    border-radius: {{ block.settings.tab_radius | default: 50 }}px;
    font-family: var(--pcs-font-body, sans-serif);
    font-size: {{ block.settings.tab_font_size | default: 15 }}px;
    font-weight: {{ block.settings.tab_font_weight | default: 500 }};
    background: var(--pcs-tab-inactive-bg);
    color: var(--pcs-tab-inactive-text);
    border: none;
    cursor: pointer;
    transition: background 0.22s ease, color 0.22s ease;
    outline: none;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 13px;
    line-height: 19.5px;
    text-align: center;
  }

  .pcs--{{ section.id }} .pcs__tab[aria-selected="true"],
  .pcs--{{ section.id }} .pcs__tab.is-active {
    background: var(--pcs-tab-active-bg);
    color: var(--pcs-tab-active-text);
  }

  .pcs--{{ section.id }} .pcs__tabs-tagline {
    margin: 0;
    font-size: {{ block.settings.tagline_size | default: 14 }}px;
    color: var(--pcs-text-muted);
    font-family: Montserrat;
    font-weight: 400;
    font-size: 14px;
    line-height: 21.6px;
  }

  .pcs--{{ section.id }} .pcs__panel {
    display: grid;
    grid-template-columns: {{ block.settings.panel_left_width | default: 47 }}% 1fr;
    gap: {{ block.settings.panel_gap | default: 0 }}px;
    background: var(--pcs-panel-bg);
    border-radius: var(--pcs-radius);
    overflow: hidden;
    min-height: {{ block.settings.panel_min_height | default: 560 }}px;
  }

  .pcs--{{ section.id }} .pcs__image-col {
    position: relative;
    background: {{ block.settings.image_col_bg | default: '#e8e4dc' }};
    border-radius: var(--pcs-radius) 0 0 var(--pcs-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .pcs--{{ section.id }} .pcs__slides {
    position: relative;
    flex: 1;
    overflow: hidden;
    margin: 15px 0 15px 15px;
  }

  .pcs--{{ section.id }} .pcs__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .pcs--{{ section.id }} .pcs__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .pcs--{{ section.id }} .pcs__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 10px;
  }

  .pcs--{{ section.id }} .pcs__slide-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ block.settings.slide_placeholder_bg | default: '#ddd8ce' }};
    color: {{ block.settings.slide_placeholder_text | default: '#999' }};
    font-size: 14px;
  }

  .pcs--{{ section.id }} .pcs__hotspot {
    position: absolute;
    width: {{ block.settings.hotspot_size | default: 36 }}px;
    height: {{ block.settings.hotspot_size | default: 36 }}px;
    border-radius: 50%;
    background: var(--pcs-accent);
    color: {{ block.settings.hotspot_text_color | default: '#ffffff' }};
    font-size: {{ block.settings.hotspot_font_size | default: 14 }}px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    transition: transform 0.2s ease, background 0.2s ease;
    transform: translate(-50%, -50%);
  }

  .pcs--{{ section.id }} .pcs__hotspot:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--pcs-accent-hover);
  }

  .pcs--{{ section.id }} .pcs__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.dot_gap | default: 8 }}px;
    padding: {{ block.settings.dot_padding | default: 16 }}px;
    background: transparent;
    flex-shrink: 0;
    position: absolute;
    bottom: 15px;
    left: 0;
    right: 0;
  }

  .pcs--{{ section.id }} .pcs__dot {
    width: {{ block.settings.dot_size | default: 32 }}px;
    height: {{ block.settings.dot_height | default: 4 }}px;
    border-radius: {{ block.settings.dot_radius | default: 4 }}px;
    background: {{ block.settings.dot_inactive_color | default: '#c0bab0' }};
    border: none;
    cursor: pointer;
    transition: background 0.22s ease, width 0.22s ease;
    padding: 0;
  }

  .pcs--{{ section.id }} .pcs__dot.is-active {
    background: var(--pcs-accent);
    width: {{ block.settings.dot_active_width | default: 36 }}px;
  }

  .pcs--{{ section.id }} .pcs__info-col {
    padding: {{ block.settings.info_padding_v | default: 40 }}px {{ block.settings.info_padding_h | default: 40 }}px;
    display: flex;
    flex-direction: column;
  }

  .pcs--{{ section.id }} .pcs__tab-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pcs--{{ section.id }} .pcs__product-title {
    margin: 0 0 {{ block.settings.product_title_mb | default: 12 }}px;
    font-family: var(--pcs-font-heading, sans-serif);
    font-size: {{ block.settings.product_title_size | default: 30 }}px;
    font-weight: {{ block.settings.product_title_weight | default: 700 }};
    line-height: 1.15;
    color: var(--pcs-text);
    font-family: Montserrat;
    font-weight: 500;
    font-size: 30px;
    line-height: 36px;
    letter-spacing: 0.4px;
  }

  .pcs--{{ section.id }} .pcs__product-desc {
    margin: 0 0 {{ block.settings.product_desc_mb | default: 24 }}px;
    font-size: {{ block.settings.product_desc_size | default: 15 }}px;
    line-height: 1.6;
    color: var(--pcs-text-muted);
    max-width: 56ch;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.31px;
  }

  .pcs--{{ section.id }} .pcs__features {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.feature_gap | default: 12 }}px;
    margin-bottom: {{ block.settings.features_mb | default: 28 }}px;
  }

  .pcs--{{ section.id }} .pcs__feature {
    display: grid;
    grid-template-columns: {{ block.settings.feature_img_size | default: 116 }}px 1fr {{ block.settings.badge_size | default: 36 }}px;
    align-items: center;
    gap: {{ block.settings.feature_inner_gap | default: 16 }}px;
    background: var(--pcs-feature-bg);
    border-radius: var(--pcs-feature-radius);
    padding: 10px 20px 10px 10px;
    border: 1px solid {{ block.settings.feature_border_color | default: '#eeebe5' }};
  }

  .pcs--{{ section.id }} .pcs__feature-img {
    width: {{ block.settings.feature_img_size | default: 116 }}px;
    height: {{ block.settings.feature_img_height | default: 116 }}px;
    border-radius: {{ block.settings.feature_img_radius | default: 8 }}px;
    overflow: hidden;
    flex-shrink: 0;
    background: {{ block.settings.feature_img_placeholder_bg | default: '#e8e4dc' }};
  }

  .pcs--{{ section.id }} .pcs__feature-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pcs--{{ section.id }} .pcs__feature-img-placeholder {
    width: 100%;
    height: 100%;
    background: {{ block.settings.feature_img_placeholder_bg | default: '#e8e4dc' }};
  }

  .pcs--{{ section.id }} .pcs__feature-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .pcs--{{ section.id }} .pcs__feature-title {
    margin: 0;
    font-size: {{ block.settings.feature_title_size | default: 15 }}px;
    font-weight: {{ block.settings.feature_title_weight | default: 600 }};
    color: var(--pcs-text);
    line-height: 1.3;
    font-family: Montserrat;
    font-weight: 600;
    font-size: 18px;
    line-height: 24px;
  }

  .pcs--{{ section.id }} .pcs__feature-detail {
    margin: 0;
    font-size: {{ block.settings.feature_detail_size | default: 13 }}px;
    color: var(--pcs-text-muted);
    line-height: 1.4;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 14px;
    line-height: 24px;
    color: #4A5565;
  }

  .pcs--{{ section.id }} .pcs__feature-badge {
    width: {{ block.settings.badge_size | default: 36 }}px;
    height: {{ block.settings.badge_size | default: 36 }}px;
    border-radius: 50%;
    background: #FAAF4F;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: Montserrat;
    line-height: 24px;
  }

  .pcs--{{ section.id }} .pcs__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    margin-top: auto;
    padding: {{ block.settings.cta_padding_v | default: 14 }}px {{ block.settings.cta_padding_h | default: 28 }}px;
    background: var(--pcs-accent);
    color: {{ block.settings.cta_text_color | default: '#111111' }};
    font-family: var(--pcs-font-body, sans-serif);
    font-size: {{ block.settings.cta_font_size | default: 16 }}px;
    font-weight: {{ block.settings.cta_font_weight | default: 600 }};
    border-radius: {{ block.settings.cta_border_radius | default: 50 }}px;
    text-decoration: none;
    min-height: 48px;
    transition: background 0.25s ease, transform 0.2s ease;
    font-family: Montserrat;
    font-weight: 600;
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.15px;
  }

  .pcs--{{ section.id }} .pcs__cta:hover {
    background: var(--pcs-accent-hover);
    color: {{ block.settings.cta_text_color | default: '#111111' }};
    transform: translateY(-2px);
  }

  .pcs__header:has(.pcs__header-meta:empty) {
    display: none;
  }
  .pcs__hotspot[hidden] {
      display: none;
  }

