<script>
(function () {
  const sec = document.querySelector('.pcs--{{ section.id }}');
  if (!sec) return;

  const tabs = sec.querySelectorAll('.pcs__tab');
  const contents = sec.querySelectorAll('.pcs__tab-content');
  const tabDots = sec.querySelectorAll('.pcs__dot');
  const tab1Slide = sec.querySelector('.pcs__slide--tab1');
  const tab2Slide = sec.querySelector('.pcs__slide--tab2');
  const tab1Hotspots = sec.querySelectorAll('.pcs__hotspot--tab1');
  const tab2Hotspots = sec.querySelectorAll('.pcs__hotspot--tab2');

  function switchTab(tabNumber) {
    tabs.forEach(tab => {
      const isActive = parseInt(tab.dataset.tab, 10) === tabNumber;
      tab.classList.toggle('is-active', isActive);
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    tabDots.forEach(dot => {
      const isActive = parseInt(dot.dataset.tabDot, 10) === tabNumber;
      dot.classList.toggle('is-active', isActive);
      dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    contents.forEach(content => {
      const isActive = parseInt(content.dataset.content, 10) === tabNumber;
      content.style.display = isActive ? 'flex' : 'none';
      content.classList.toggle('is-active', isActive);
    });

    if (tab1Slide) {
      const active = tabNumber === 1;
      tab1Slide.style.display = active ? '' : 'none';
      tab1Slide.classList.toggle('is-active', active);
    }

    if (tab2Slide) {
      const active = tabNumber === 2;
      tab2Slide.style.display = active ? '' : 'none';
      tab2Slide.classList.toggle('is-active', active);
    }

    tab1Hotspots.forEach(h => {
      if (tabNumber === 1) {
        h.removeAttribute('hidden');
      } else {
        h.setAttribute('hidden', '');
      }
    });

    tab2Hotspots.forEach(h => {
      if (tabNumber === 2) {
        h.removeAttribute('hidden');
      } else {
        h.setAttribute('hidden', '');
      }
    });
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      switchTab(parseInt(tab.dataset.tab, 10));
    });
  });

  tabDots.forEach(dot => {
    dot.addEventListener('click', () => {
      switchTab(parseInt(dot.dataset.tabDot, 10));
    });
  });

  sec.querySelectorAll('.pcs__hotspot').forEach(hs => {
    hs.addEventListener('click', () => {
      const idx = parseInt(hs.textContent.trim(), 10) - 1;
      const tab = parseInt(hs.dataset.tab, 10);
      const features = sec.querySelectorAll('.pcs__tab-content--' + tab + ' .pcs__feature');

      features.forEach((f, i) => {
        f.style.outline = i === idx ? '2px solid var(--pcs-accent)' : '';
      });

      setTimeout(() => {
        features.forEach(f => f.style.outline = '');
      }, 1800);
    });
  });

  switchTab(1);
})();
</script>

