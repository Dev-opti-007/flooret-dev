<script>
  (function () {
    function getGladlySessionId() {
      try {
        if (window.Gladly && typeof window.Gladly.getSessionId === 'function') {
          return String(window.Gladly.getSessionId());
        }
        if (window.Gladly && window.Gladly.sessionId) {
          return String(window.Gladly.sessionId);
        }
        const vLS = localStorage.getItem('gladly_session_id');
        if (vLS) return String(vLS);
        const m = document.cookie.match(/(?:^|;\s*)gladly_session_id=([^;]+)/);
        if (m) return decodeURIComponent(m[1]);
      } catch (e) {}
      return null;
    }

    function getOrderName() {
      try {
        if (window.Shopify && Shopify.checkout && Shopify.checkout.order_id) {
          // Use order_id or order_number / order_name depending on what you need
          return String(Shopify.checkout.order_id);
        }
      } catch (e) {}
      return null;
    }

    function addAttributesToNoibu() {
      try {
        const sid = getGladlySessionId();
        if (sid) {
          window.NOIBUJS.addCustomAttribute('gladlySessionId', sid);
        }

        const orderName = getOrderName();
        if (orderName) {
          window.NOIBUJS.addCustomAttribute('orderName', orderName);
        }
      } catch (e) {}
    }

    function init() {
      if (window.NOIBUJS && typeof window.NOIBUJS.addCustomAttribute === 'function') {
        addAttributesToNoibu();
      } else {
        window.addEventListener('noibuSDKReady', addAttributesToNoibu, { once: true });
      }
    }

    init();
  })();
</script> {% endcomment %}


