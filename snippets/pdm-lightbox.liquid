// Helper: find option index by option name (Model can be option1 or option2)
// Supports productData.options as ["Model","Type"] OR [{name:"Model"}, {name:"Type"}]
function getOptionIndexByName(productData, optionName) {
  const opts = (productData && Array.isArray(productData.options)) ? productData.options : [];
  const target = (optionName || '').toLowerCase();

  for (let i = 0; i < opts.length; i++) {
    const o = opts[i];

    if (typeof o === 'string') {
      if (o.toLowerCase() === target) return i;
      continue;
    }

    if (o && typeof o === 'object') {
      const name = (o.name != null) ? String(o.name).toLowerCase() : '';
      if (name === target) return i;
    }
  }
  return -1;
}

