<script>
// Make core refs/functions globally reachable
window.quickView = (function () {
  let modal, isUpdating = false;
  let currentProductData = null;
  let currentMetaObjectPrices = null;


  function init() {
    modal = document.getElementById('quick-view-modal');
    if (!modal) return;


    const closeModalBtn = modal.querySelector('.quick-view-modal__close');
    closeModalBtn?.addEventListener('click', closeAndResetModal);
    window.addEventListener('click', (e) => { if (e.target === modal) closeAndResetModal(); });


    // Delegated click survives DOM swaps from filter/sort
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.quick-view-btn');
      if (!btn) return;
      const handle = btn.dataset.productHandle;
      if (handle) openQuickView(handle);
    });
  }


  function openQuickView(handle) {
    if (!modal) return;
    modal.classList.add('quick-view--loading');
    modal.classList.remove('quick-view--loaded');
    modal.style.display = 'flex';
    document.documentElement.classList.add('quick-view-is-open');


    fetch(`/products/${handle}.js`)
      .then(r => r.json())
      .then(productJson => {
        currentProductData = productJson;


        const preloadedData = window.quickViewData?.[handle] || null;
        currentMetaObjectPrices = preloadedData ? preloadedData.metaobject_prices : {};


        populateQuickView(productJson, preloadedData ? preloadedData.html : null);
        console.log('------------');
        console.log(currentProductData);
      })
      .catch(err => {
        console.error('Quick view fetch error', err);
        closeAndResetModal();
      });
  }


  function buildImages(product, prevArrowHTML, nextArrowHTML) {
    const wrap = modal.querySelector('.quick-view-product__images');
    if (!wrap) return;


    // Clean re-init of Slick
    if ($(wrap).hasClass('slick-initialized')) $(wrap).slick('unslick');
    wrap.innerHTML = product.media
      .filter(m => m.media_type === 'image')
      .map(m => `<div class="pro-img" data-media-id="${m.id}"><img src="${m.src}" alt="${m.alt || product.title}"></div>`)
      .join('');


    const count = product.media.filter(m => m.media_type === 'image').length;
    if (count > 1) {
      $(wrap)
        .one('init', () => {
          modal.classList.remove('quick-view--loading');
          modal.classList.add('quick-view--loaded');
        })
        .slick({
          infinite: false,
          arrows: false,
          prevArrow: prevArrowHTML,
          nextArrow: nextArrowHTML,
          slidesToShow: 1,
          slidesToScroll: 1
        });
    } else {
      modal.classList.remove('quick-view--loading');
      modal.classList.add('quick-view--loaded');
    }
  }


  function populateQuickView(product, html) {
    const prevArrowHTML = `
      <div class="button-prev slick-button">…</div>
    `;
    const nextArrowHTML = `
      <div class="button-next slick-button">…</div>
    `;


    buildImages(product, prevArrowHTML, nextArrowHTML);


    modal.querySelector('.quick-view-product__title').textContent = product.title;


    // (You still have this line; it shows product.price initially, then updateVariantState overwrites it)
    modal.querySelector('.quick-view-product__price .main-price').textContent =
      new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(product.price / 100);


    modal.querySelector('.quick-view-product__view-details').href = product.url;


    const variantsContainer = modal.querySelector('.quick-view-product__variants');
    variantsContainer.innerHTML = html || '<p style="color:red;text-align:center;">Error: Variant options could not be loaded.</p>';


    setupVariantSelection();
  }


  function setupVariantSelection() {
    modal.querySelectorAll('.quick-view-product__variants .js-product-form__group').forEach(group => {
      const firstRadio = group.querySelector('input[type="radio"]');
      if (firstRadio) firstRadio.checked = true;
    });
    modal.querySelectorAll('.quick-view-product__variants input[type="radio"]').forEach(radio => {
      radio.addEventListener('change', () => updateVariantState());
    });
    updateVariantState();
  }


  // Helper: find option index by option name (Model can be option1 or option2)
  // Supports productData.options as ["Model","Type"] OR [{name:"Model"}, {name:"Type"}]
  function getOptionIndexByName(productData, optionName) {
    const opts = (productData && Array.isArray(productData.options)) ? productData.options : [];
    const target = (optionName || '').toLowerCase();


    for (let i = 0; i < opts.length; i++) {
      const o = opts[i];


      if (typeof o === 'string') {
        if (o.toLowerCase() === target) return i;
        continue;
      }


      if (o && typeof o === 'object') {
        const name = (o.name != null) ? String(o.name).toLowerCase() : '';
        if (name === target) return i;
      }
    }
    return -1;
  }


  // FULL: metaobject fallback + logs
  function updateVariantState() {
    console.log('%c=== QV updateVariantState() START ===', 'color: blue; font-weight: bold;');


    if (isUpdating) {
      console.log('%cQV blocked (isUpdating=true)', 'color: orange; font-weight: bold;');
      return;
    }
    isUpdating = true;


    try {
      if (!modal) {
        console.warn('%cQV modal missing', 'color: red; font-weight: bold;');
        return;
      }
      if (!currentProductData) {
        console.warn('%cQV currentProductData missing', 'color: red; font-weight: bold;');
        return;
      }


      const selectedOptions = Array
        .from(modal.querySelectorAll('.quick-view-product__variants input[type="radio"]:checked'))
        .map(r => r.value);


      console.log('%cQV selectedOptions:', 'color: purple; font-weight: bold;', selectedOptions);
      console.log('%cQV product handle:', 'color: purple; font-weight: bold;', currentProductData.handle);
      console.log('%cQV product options (raw):', 'color: purple; font-weight: bold;', currentProductData.options);


      const selectedVariant = (currentProductData.variants || []).find(v =>
        selectedOptions.every((opt, i) => v.options[i] === opt)
      );


      console.log('%cQV selectedVariant:', 'color: teal; font-weight: bold;', selectedVariant);


      const variantIdInput  = modal.querySelector('.quick-view-product__variant-id');
      const addToCartButton = modal.querySelector('.quick-view-product__add-to-cart');
      const priceContainer  = modal.querySelector('.quick-view-product__price');
      const priceDisplay    = modal.querySelector('.quick-view-product__price .main-price');


      console.log('%cQV DOM found:', 'color: gray; font-weight: bold;', {
        variantIdInput: !!variantIdInput,
        addToCartButton: !!addToCartButton,
        priceContainer: !!priceContainer,
        priceDisplay: !!priceDisplay
      });


      if (!priceDisplay) return;


      if (selectedVariant) {
        // Basic wiring
        if (variantIdInput) variantIdInput.value = selectedVariant.id;


        // 1) Variant metafields (dollars as strings)
        const variantMeta = (window.variantMetafields || {})[selectedVariant.id] || {};
        const rawSqftPrice   = variantMeta.sqft_price;
        const rawSqftCompare = variantMeta.sqft_compare_at_price;


        const variantSqftPriceCents =
          rawSqftPrice && !isNaN(parseFloat(rawSqftPrice))
            ? Math.round(parseFloat(rawSqftPrice) * 100)
            : 0;


        const variantSqftCompareCents =
          rawSqftCompare && !isNaN(parseFloat(rawSqftCompare))
            ? Math.round(parseFloat(rawSqftCompare) * 100)
            : 0;


        console.log('%cQV variantMeta:', 'color: brown; font-weight: bold;', variantMeta);
        console.log('%cQV variantSqft cents:', 'color: brown; font-weight: bold;', {
          rawSqftPrice,
          rawSqftCompare,
          variantSqftPriceCents,
          variantSqftCompareCents
        });


        // 1.5) Metaobject fallback (CENTS) from window.quickViewData[handle].metaobject_prices[modelValue]
        const modelIdx = getOptionIndexByName(currentProductData, 'Model');
        const modelValue =
          (modelIdx > -1 && selectedVariant.options && selectedVariant.options[modelIdx])
            ? selectedVariant.options[modelIdx]
            : '';


        // Prefer preloaded quickViewData but also allow currentMetaObjectPrices
        const qvHandle = currentProductData.handle;
        const qv = (window.quickViewData && window.quickViewData[qvHandle]) ? window.quickViewData[qvHandle] : null;
        const metaPricesMap = (qv && qv.metaobject_prices) ? qv.metaobject_prices : currentMetaObjectPrices;


        const keyRaw = modelValue || '';
        const moPrices = metaPricesMap ? (metaPricesMap[keyRaw] || null) : null;


        console.log('%cQV metaobject lookup:', 'color: darkgreen; font-weight: bold;', {
          modelIdx,
          modelValue,
          keyRaw,
          hasQuickViewData: !!qv,
          metaKeys: metaPricesMap ? Object.keys(metaPricesMap) : [],
          moPrices
        });


        // Metaobject prices must be cents in JS: { price_cents, compare_cents }
        const metaSqftPriceCents =
          (moPrices && moPrices.price_cents != null && moPrices.price_cents !== '')
            ? Number(moPrices.price_cents)
            : 0;


        const metaSqftCompareCents =
          (moPrices && moPrices.compare_cents != null && moPrices.compare_cents !== '')
            ? Number(moPrices.compare_cents)
            : 0;


        console.log('%cQV meta cents:', 'color: darkgreen; font-weight: bold;', {
          metaSqftPriceCents,
          metaSqftCompareCents
        });


        // 2) Final price/compare in cents:
        // Variant metafields -> Metaobject -> 0 (NO fallback to variant.price)
        let priceInCents =
          variantSqftPriceCents > 0
            ? variantSqftPriceCents
            : (metaSqftPriceCents > 0 ? metaSqftPriceCents : 0);


        let comparePriceInCents =
          variantSqftCompareCents > 0
            ? variantSqftCompareCents
            : (metaSqftCompareCents > 0 ? metaSqftCompareCents : 0);


        console.log('%cQV final cents:', 'color: teal; font-weight: bold;', {
          priceInCents,
          comparePriceInCents
        });


        // 3) Render HTML
        const priceFormatted = new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: 'USD'
        }).format(priceInCents / 100);


        let priceHtml = `<span class='p-r-ice'>${priceFormatted}`;


        if (comparePriceInCents > priceInCents && comparePriceInCents > 0) {
          const compareFormatted = new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD'
          }).format(comparePriceInCents / 100);


          const pct = Math.round(((comparePriceInCents - priceInCents) / comparePriceInCents) * 100);
          priceHtml += ` <del>${compareFormatted}</del> <span class="sqft-text">per sq ft</span> <span class="off-percent">${pct}% Off</span>`;
        } else {
          priceHtml += ' <span class="sqft-text">per sq ft</span>';
        }


        priceHtml += '</span>';
        priceDisplay.innerHTML = priceHtml;


        console.log('%cQV rendered priceHtml:', 'color: green; font-weight: bold;', priceHtml);


        // 4) Box label + ATC button
        const isBoxVariant = selectedOptions.some(o => (o || '').toLowerCase() === 'box');
        if (priceContainer) priceContainer.classList.toggle('is-box-variant', isBoxVariant);


        console.log('%cQV isBoxVariant:', 'color: gray; font-weight: bold;', isBoxVariant);


        if (addToCartButton) {
          addToCartButton.textContent = selectedVariant.available ? 'Add to Cart' : 'Sold Out';
          addToCartButton.disabled = !selectedVariant.available;
        }


        // 5) Sync gallery image (unchanged)
        if (selectedVariant.featured_media?.id) {
          const target = modal.querySelector(`.pro-img[data-media-id="${selectedVariant.featured_media.id}"]`);
          if (target) {
            const slide = target.closest('.slick-slide');
            const idx = $(slide).data('slick-index');
            if (idx !== undefined) {
              $('.quick-view-product__images').slick('slickGoTo', idx, true);
            }
          }
        }
      } else {
        console.warn('%cQV No matching variant for selectedOptions', 'color: orange; font-weight: bold;', selectedOptions);


        if (variantIdInput) variantIdInput.value = '';
        if (addToCartButton) {
          addToCartButton.textContent = 'Unavailable';
          addToCartButton.disabled = true;
        }
        if (priceContainer) priceContainer.classList.remove('is-box-variant');
      }


      updateOptionAvailability();
    } finally {
      isUpdating = false;
      console.log('%c=== QV updateVariantState() END ===', 'color: blue; font-weight: bold;');
    }
  }


  function updateOptionAvailability() {
    const optionGroups = modal.querySelectorAll('.quick-view-product__variants .js-product-form__group');
    const selectedOptions = Array.from(modal.querySelectorAll('.quick-view-product__variants input[type="radio"]:checked')).map(r => r.value);


    optionGroups.forEach((group, groupIndex) => {
      const radios = group.querySelectorAll('input[type="radio"]');
      radios.forEach(radio => {
        const test = [...selectedOptions];
        test[groupIndex] = radio.value;
        const match = currentProductData?.variants?.find(v => test.every((opt, i) => v.options[i] === opt));
        const optionEl = radio.closest('li') || radio.parentElement;
        if (match && match.available) {
          optionEl.style.display = '';
          radio.disabled = false;
        } else {
          optionEl.style.display = 'none';
          radio.disabled = true;
          if (radio.checked) radio.checked = false;
        }
      });


      const checked = group.querySelector('input[type="radio"]:checked');
      if (!checked) {
        const firstAvailable = group.querySelector('input[type="radio"]:not(:disabled)');
        if (firstAvailable) {
          firstAvailable.checked = true;
          firstAvailable.dispatchEvent(new Event('change', { bubbles: true })); // triggers updateVariantState
        }
      }
    });
  }


  function closeAndResetModal() {
    const $wrap = $('.quick-view-product__images');
    if ($wrap.hasClass('slick-initialized')) $wrap.slick('unslick');
    modal.style.display = 'none';
    document.documentElement.classList.remove('quick-view-is-open');
    modal.classList.remove('quick-view--loading', 'quick-view--loaded');
  }


  // expose only what is needed
  return { init, openQuickView };
})();


// Initialize once on page load
document.addEventListener('DOMContentLoaded', () => {
  window.quickView.init();
});
</script>




