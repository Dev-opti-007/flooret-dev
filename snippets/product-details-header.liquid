<script>
// Wait for DOM to be ready
document.addEventListener('DOMContentLoaded', function() {
  const subtotalElement = document.querySelector('.js-product__subtotal');
  const actualPriceElement = document.querySelector('.actual-price-new');
  
  if (subtotalElement && actualPriceElement) {
    // Initial sync
    actualPriceElement.innerHTML = subtotalElement.innerHTML;
    
    // Set up observer
    const observer = new MutationObserver(() => {
      actualPriceElement.innerHTML = subtotalElement.innerHTML;
    });
    
    observer.observe(subtotalElement, {
      childList: true,
      subtree: true,
      characterData: true
    });
  }
});

</script>
<style>
  .actual-price-new {
      white-space: nowrap;
  }
  .roomvo-slider-container:has(.swiper-wrapper:empty) {
      display: none;
  }
</style>
{% endif %}
