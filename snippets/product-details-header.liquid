{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign model_handle = product.title | handleize
  assign price_used = 0
  assign compare_used = 0
  assign found_match = false

  # Loop through metaobjects to find match based on handleized product title
  for product_model in shop.metaobjects.product_model.values
    assign current_model_handle = product_model.name | handleize
    if current_model_handle == model_handle
      assign price_used = product_model.cost_per_sqft.value
      # Assuming compare_cost_per_sqft exists on the metaobject; adjust if needed
      if product_model.compare_cost_per_sqft
        assign compare_used = product_model.compare_cost_per_sqft.value
      endif
      assign found_match = true
      break  # Stop looping once match is found
    endif
  endfor

  # Fallback to variant metafields if no metaobject match
  if found_match == false
    if current_variant.metafields.custom.sqft_price
      assign price_used = current_variant.metafields.custom.sqft_price.value
    endif
    if current_variant.metafields.custom.sqft_compare_at_price
      assign compare_used = current_variant.metafields.custom.sqft_compare_at_price.value
    endif
  endif
-%}

