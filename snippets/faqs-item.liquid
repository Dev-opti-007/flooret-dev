<div class="faq-section"  {% if section.block_id != blank %}id="{{ section.block_id }}"{% endif %}  >
  {% if section.heading != blank %}
    <h2>{{ section.heading }}</h2>
  {% endif %}      
  {% if blocks != blank %}
    {% for block in blocks %}
      {% if block.settings.accordion_title != blank and block.settings.accordion_content != blank %}
       <div class="faq-item">
          <div class="accordion js-dropdown {% if active == true %}active{% endif %}">
    		  <button class="accordion__label js-dropdown__trigger {% if active == true %}active{% endif %}" type="button">
    		    <span>{{ block.settings.accordion_title }}</span> {% render 'svg-chevron' %}
    		  </button>
    		  <div class="accordion__content js-dropdown__content">
    		    {{ block.settings.accordion_content }}
    		  </div>
    		  </div>
        </div> 
       {% endif %} 
    {% endfor %}
  {% endif %} 
</div>
