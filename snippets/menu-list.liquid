<script>
	document.addEventListener('DOMContentLoaded', () => {
  const root = document.querySelector('.mnav');
  if (!root) return;

  // L1 accordion (single open)
  root.querySelectorAll('[data-mnav1]').forEach(section => {
    const btn = section.querySelector('.mnav1__btn');
    const panel = section.querySelector('.mnav1__panel');
    if (!btn || !panel) return;

    btn.addEventListener('click', () => {
      const isOpen = section.classList.contains('is-open');

      root.querySelectorAll('[data-mnav1]').forEach(s => {
        s.classList.remove('is-open');
        const b = s.querySelector('.mnav1__btn');
        const p = s.querySelector('.mnav1__panel');
        if (b) b.setAttribute('aria-expanded', 'false');
        if (p) p.setAttribute('hidden', '');
      });

      if (!isOpen) {
        section.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        panel.removeAttribute('hidden');
      }
    });
  });

  // L2 accordion only for items that actually have children (data-mnav2)
  root.querySelectorAll('[data-mnav1]').forEach(section => {
    const rows = section.querySelectorAll('[data-mnav2]');

    rows.forEach(row => {
      const btn = row.querySelector('.mnav2__btn');
      const panel = row.querySelector('.mnav2__panel');
      if (!btn || !panel) return;

      btn.addEventListener('click', () => {
        const isOpen = btn.classList.contains('is-open');

        // close all L2 dropdowns within this L1
        rows.forEach(r => {
          const b = r.querySelector('.mnav2__btn');
          const p = r.querySelector('.mnav2__panel');
          if (b) { b.classList.remove('is-open'); b.setAttribute('aria-expanded', 'false'); }
          if (p) p.setAttribute('hidden', '');
        });

        if (!isOpen) {
          btn.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          panel.removeAttribute('hidden');
        }
      });
    });
  });
});

</script>

