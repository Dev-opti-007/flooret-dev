                  <li class="mnav2__item is-leaf {% if has_img %}has-menu-image{% endif %}">
                    <a class="mnav2__link" href="{{ child_link.url }}">
						 {% if has_img %}
                                <span class="mnavTile__img">
                                  {{ mo.image.value | image_url: width: 360 | image_tag: loading: 'lazy', alt: title_to_match }}
                                </span>
                              {% endif %}
                      {{ child_link.title }}
                    </a>
                  </li>

                {% else %}
                  {%- comment -%} L2 with children => accordion row + L3 grid {%- endcomment -%}
                  <li class="mnav2__item is-parent" data-mnav2>
                    <button type="button"
                      class="mnav2__btn"
                      aria-expanded="false">
                      <span class="mnav2__title">{{ child_link.title }}</span>
                      <span class="mnav2__chev" aria-hidden="true"></span>
                    </button>

                    <div class="mnav2__panel" hidden>
                      <ul class="mnavGrid">
                        {% for grandchild_link in child_link.links %}
                          {%- assign title_to_match = grandchild_link.title -%}

                          {%- assign mo_key = title_to_match | handleize -%}
                          {%- assign mo = metaobjects['menu_item_image'][mo_key] -%}

                          {%- if mo == blank -%}
                            {%- for entry in metaobjects.menu_item_image.values -%}
                              {%- if entry.menu_name.value != blank and entry.menu_name.value == title_to_match -%}
                                {%- assign mo = entry -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}

                          {%- assign has_img = false -%}
                          {%- if mo != blank and mo.image.value != blank -%}
                            {%- assign has_img = true -%}
                          {%- endif -%}

                          <li class="mnavTile {% if has_img %}has-menu-image{% endif %}">
                            <a class="mnavTile__link" href="{{ grandchild_link.url }}">
                              {% if has_img %}
                                <span class="mnavTile__img">
                                  {{ mo.image.value | image_url: width: 360 | image_tag: loading: 'lazy', alt: title_to_match }}
                                </span>
                              {% endif %}
                              <span class="mnavTile__title">{{ title_to_match }}</span>
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    </div>
                  </li>
                {% endif %}
              {% endfor %}

            </ul>
          {% endif %}
        </div>
	  </div>
    {%- endfor -%}

  </div>
</nav> {% endcomment %}

<nav class="mnav" aria-label="Mobile navigation">
  <div class="mnav__inner">

    {%- for link in linklists[menu].links -%}
      <div class="mnav1 {% if forloop.first %}is-open{% endif %}" data-mnav1>
        <button type="button"
          class="mnav1__btn"
          aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}">
          <span class="mnav1__title">{{ link.title }}
            {% comment %} {% if link.title == "Provence Natural Hardwood"%}
                                  <span class="custom-badge-new">New</span>
                        {% endif %} {% endcomment %}
                        {% assign showOnTrim = 'false' %}
                          {% if link.title == "Modin Luxury Vinyl Plank"%}
                                  <span class="custom-badge-new">New</span>
                                  {% assign showOnTrim = 'true' %}
                        {% endif %}
          </span>
          <span class="mnav1__chev" aria-hidden="true"></span>
        </button>

        <div class="mnav1__panel" {% unless forloop.first %}hidden{% endunless %}>
          {% if link.links != blank %}
            <ul class="mnav2">

              {% for child_link in link.links %}

                {%- comment -%} L2 leaf (no children) => simple link row {%- endcomment -%}
                {% if child_link.links == blank %}

                  {%- assign title_to_match = child_link.title -%}
                  {%- assign title_norm = title_to_match | strip | downcase -%} 

                  {%- assign mo = blank -%}
                  {%- assign mo_key = title_to_match | handleize -%} 
                  {%- assign mo = metaobjects['menu_item_image'][mo_key] -%}

                  {%- if mo == blank -%}
                    {%- assign found = blank -%}
                    {%- assign found_count = 0 -%}
                    {%- for entry in metaobjects.menu_item_image.values -%}
                      {%- if entry.menu_name.value != blank -%}
                        {%- assign entry_norm = entry.menu_name.value | strip | downcase -%}
                        {%- if entry_norm == title_norm -%}
                          {%- assign found = entry -%}
                          {%- assign found_count = found_count | plus: 1 -%}
                        {%- endif -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if found_count == 1 -%}
                      {%- assign mo = found -%}
                    {%- endif -%}
                  {%- endif -%}

                  {%- if mo == blank -%}
                    {%- assign found = blank -%}
                    {%- assign found_count = 0 -%}
                    {%- for entry in metaobjects.menu_item_image.values -%}
                      {%- assign handle_norm = entry.system.handle | strip | downcase -%}
                      {%- if handle_norm == title_norm -%}
                        {%- assign found = entry -%}
                        {%- assign found_count = found_count | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if found_count == 1 -%}
                      {%- assign mo = found -%}
                    {%- endif -%}
                  {%- endif -%}

                  {%- assign has_img = false -%}
                  {%- if mo != blank and mo.image.value != blank -%}
                    {%- assign has_img = true -%}
                  {%- endif -%}

                  <li class="mnav2__item is-leaf {% if has_img %}has-menu-image{% endif %}">
                    <a class="mnav2__link" href="{{ child_link.url }}">
                        
                        <div class="mmcard__tags">
                          {% if mo.tag_one.value %}
                            <span class="mmcard__tag mmcard__tag--1">{{ mo.tag_one.value }}</span>
                          {% endif %}
                          {% if mo.tag_two.value %}
                            <span class="mmcard__tag mmcard__tag--2">{{ mo.tag_two.value }}</span>
                          {% endif %}
                        </div>
                        
                      {% if has_img %}
                        <span class="mnavTile__img">
                          {{ mo.image.value | image_url: width: 360 | image_tag: loading: 'lazy', alt: title_to_match }}
                        </span>
                      {% endif %}
                      {{ child_link.title }}
                      {% if child_link.title == "Shop Floors" and showOnTrim == "true"%}
                        <span class="custom-badge-new">New</span>
                        {% endif %}
                    </a>
                  </li>

                {% else %}

                  {%- comment -%} L2 with children => accordion row + L3 grid {%- endcomment -%}
                  <li class="mnav2__item is-parent" data-mnav2>
                    <button type="button"
                      class="mnav2__btn"
                      aria-expanded="false">
                      <span class="mnav2__title">{{ child_link.title }}
                        {% if child_link.title == "Provence Natural Hardwood"%}
                                  <span class="custom-badge-new">New</span>
                        {% endif %}
                      </span>
                      <span class="mnav2__chev" aria-hidden="true"></span>
                    </button>

                    <div class="mnav2__panel" hidden>
                      <ul class="mnavGrid">

                        {% for grandchild_link in child_link.links %}

                          {%- assign title_to_match = grandchild_link.title -%}
                          {%- assign title_norm = title_to_match | strip | downcase -%}

                          {%- assign mo = blank -%}
                          {%- assign mo_key = title_to_match | handleize -%}
                          {%- assign mo = metaobjects['menu_item_image'][mo_key] -%}

                          {%- if mo == blank -%}
                            {%- assign found = blank -%}
                            {%- assign found_count = 0 -%}
                            {%- for entry in metaobjects.menu_item_image.values -%}
                              {%- if entry.menu_name.value != blank -%}
                                {%- assign entry_norm = entry.menu_name.value | strip | downcase -%}
                                {%- if entry_norm == title_norm -%}
                                  {%- assign found = entry -%}
                                  {%- assign found_count = found_count | plus: 1 -%}
                                {%- endif -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- if found_count == 1 -%}
                              {%- assign mo = found -%}
                            {%- endif -%}
                          {%- endif -%}

                          {%- if mo == blank -%}
                            {%- assign found = blank -%}
                            {%- assign found_count = 0 -%}
                            {%- for entry in metaobjects.menu_item_image.values -%}
                              {%- assign handle_norm = entry.system.handle | strip | downcase -%}
                              {%- if handle_norm == title_norm -%}
                                {%- assign found = entry -%}
                                {%- assign found_count = found_count | plus: 1 -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- if found_count == 1 -%}
                              {%- assign mo = found -%}
                            {%- endif -%}
                          {%- endif -%}

                          {%- assign has_img = false -%}
                          {%- if mo != blank and mo.image.value != blank -%}
                            {%- assign has_img = true -%}
                          {%- endif -%}

                          <li class="mnavTile {% if has_img %}has-menu-image{% endif %}">
                            <a class="mnavTile__link" href="{{ grandchild_link.url }}">
                                {% if title_to_match == "Provence Bestsellers Kits"%}
                                    <span class="custom-badge-new">New</span>
                          {% endif %}
                              {% if has_img %}
                                <span class="mnavTile__img">
                                  {{ mo.image.value | image_url: width: 360 | image_tag: loading: 'lazy', alt: title_to_match }}
                                </span>
                              {% endif %}
                              <span class="mnavTile__title">{{ title_to_match }}</span>
                            </a>
                          </li>

                        {% endfor %}
                      </ul>
                    </div>
                  </li>

                {% endif %}

              {% endfor %}

            </ul>
          {% endif %}
        </div>
      </div>
    {%- endfor -%}

  </div>
</nav>


