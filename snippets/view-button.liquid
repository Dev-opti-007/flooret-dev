<script>
  document.addEventListener('DOMContentLoaded', function () {
    const viewOne = document.querySelector('.view-one');
    const viewTwo = document.querySelector('.view-two');
    const galleryGrid = document.querySelector('.gallery__grid');

    if (viewOne && viewTwo && galleryGrid) {
      viewOne.addEventListener('click', function () {
        galleryGrid.classList.add('one-grid');
        viewOne.classList.add('active');
        viewTwo.classList.remove('active');
      });

      viewTwo.addEventListener('click', function () {
        galleryGrid.classList.remove('one-grid');
        viewTwo.classList.add('active');
        viewOne.classList.remove('active');
      });
    }
  });
</script>
