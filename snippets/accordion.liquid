<div class="accordion js-dropdown {% if active == true %}active{% endif %}">
  <button class="accordion__label js-dropdown__trigger {% if active == true %}active{% endif %}" type="button">
    <span>{{ label }}</span> {% render 'svg-chevron' %}
  </button>
  <div class="accordion__content js-dropdown__content">
    {{ content }}
  </div>
</div>
