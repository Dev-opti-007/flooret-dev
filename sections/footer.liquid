{% assign module = section.settings %}

<div class="container container--large">

	<div class="gfooter-main">
    <div class="gfooter-logo">
      {% render 'lazy-image', image: module.logo, width: '141' %}
    </div>

    <div class="gfooter-row">
  		<div class="gfooter-menus">
  			{% for block in section.blocks %}
  				{% assign _block = block.settings %}
  				<div class="accordion js-dropdown gfooter__menu">
  					<div class="accordion__trigger js-dropdown__trigger">
  						<h4>{{ _block.heading }}</h4>
  						{% render 'svg-chevron' %}
  					</div>
  					<div class="accordion__content js-dropdown__content">
  						<div class="spacer">
  							{% render 'menu-list-footer', menu: _block.menu, heading:_block.heading %}
  						</div>
  					</div>
            {% if forloop.index == 1 %}
                  {%- liquid
                    assign btn_text = section.settings.button_text | strip
                    assign btn_url  = section.settings.button_url
                  -%}

                  {%- if btn_text != blank -%}
                    <a
                      class="custom-btn"
                      {% if btn_url != blank %}href="{{ btn_url }}"{% else %}role="link" aria-disabled="true"{% endif %}
                    >
                      {{ btn_text }}
                    </a>
                  {%- endif -%}
        {% endif %}
  				</div>
  			{% endfor %}
  		</div>
      <div class="gfooter-email">
        <span class="h5">{{ module.email_heading }}</span>
        {% form "customer" %}
          <div class="input-group">
              <input placeholder="Email Address" type="email" required id="email" name="email">
          </div>
          <input type="submit" class="btn btn--black" value="Submit">
        {% endform %}

        <div class="gfooter-email__imgs">
            {% render 'lazy-image', image: module.image_1, width: '60' %}
            {% render 'lazy-image', image: module.image_2, width: '60' %}
            {% render 'lazy-image', image: module.image_3, width: '60' %}
        </div>
      </div>
    </div>

    <div class="gfooter-bottom">
      <p>Copyright {{ 'now' | date: '%Y' }} &copy; Flooret</p>
      {% include 'social-links' %}
      <nav class="legal">
        {% render 'menu-list-footer', menu: 'footer' %}
      </nav>
    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .custom-btn {
    display: inline-flex;
    align-items: center;
    position:absolute;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    border-radius:50px;
    margin-left: -10px;
    color: {{ section.settings.button_color }};
    background-color: {{ section.settings.button_bg_color }};
    margin-top:{{ section.settings.margin_top }}px;
    font-weight: {{ section.settings.name_weight }};
    line-height: {{ section.settings.name_line_height }};
    letter-spacing: {{ section.settings.name_letter_spacing }}px;

    font-size: {{ section.settings.button_size_desktop }}px;

    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;

    {% if section.settings.button_height and section.settings.button_height > 0 %}
      height: {{ section.settings.button_height }}px;
    {% endif %}

    transition: color 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
  }

  #shopify-section-{{ section.id }} .custom-btn:hover {
    color: {{ section.settings.button_hover_color }};
    background-color: {{ section.settings.button_bg_hover_color }};
  }

  #shopify-section-{{ section.id }} .custom-btn[aria-disabled="true"] {
    pointer-events: none;
    opacity: 0.6;
  }

    @media (max-width: 990px) {
        #shopify-section-{{ section.id }} .custom-btn {
        display:none;
      }
    }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} .custom-btn {
      font-size: {{ section.settings.button_size_mobile }}px;
    }
  }
{% endstyle %}



{% style %}
  .gfooter .gfooter-bottom .social-links li {
    margin-right: 0.5rem !important;
    margin-left: 0.5rem !important;
  }
  .gfooter .gfooter-bottom p,
  .gfooter .gfooter-bottom .social-links,
  .gfooter .gfooter-bottom nav {
    min-width: 315px;
    text-align: center;
    justify-content: center !important;
    display: flex;
  }
  .gfooter-bottom {
    flex-direction: column !important;
    gap: 10px;
  }
  @media (min-width: 1024px) {
    .gfooter-main .gfooter-bottom {
      flex-direction: row !important;
    }
    .gfooter .gfooter-bottom p {
      justify-content: flex-start !important;
    }
  }
{% endstyle %}


<!-- Start of HubSpot Embed Code -->
<script type="text/javascript" id="hs-script-loader" async defer src="//js-na2.hs-scripts.com/46941662.js"></script>
<!-- End of HubSpot Embed Code -->

{% schema %}
{
  "name": "Footer",
  "tag": "footer",
  "class": "gfooter",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "email_heading",
      "label": "Email Heading"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
      {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
      {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    { "type": "header", "content": "Button" },
    {
      "type":"text",
      "id":"button_text",
      "label":"Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    { "type": "header", "content": "Button typography" },
    { "type": "color", "id": "button_color", "label": "Button color", "default": "#111111" },
    { "type": "range", "id": "button_size_desktop", "min": 12, "max": 30, "step": 1, "label": "Button size desktop (px)", "default": 16 },
    { "type": "range", "id": "button_size_mobile", "min": 12, "max": 26, "step": 1, "label": "Button size mobile (px)", "default": 15 },
    {
      "type": "select",
      "id": "name_weight",
      "label": "Name weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    { "type": "range", "id": "name_line_height", "min": 1, "max": 2.2, "step": 0.1, "label": "Name line height", "default": 1.3 },
    { "type": "range", "id": "name_letter_spacing", "min": -1, "max": 4, "step": 0.1, "label": "Name letter spacing (px)", "default": 0 },
    { "type": "color", "id": "button_hover_color", "label": "Button hover color", "default": "#000000" },

    { "type": "range", "id": "margin_top", "min": 0, "max": 100, "step": 1, "label": "Magrin Top(px)", "default": 0 },
    { "type": "range", "id": "button_padding_y", "min": 0, "max": 40, "step": 1, "label": "Button padding top/bottom (px)", "default": 12 },
    { "type": "range", "id": "button_padding_x", "min": 0, "max": 60, "step": 1, "label": "Button padding left/right (px)", "default": 24 },

    { "type": "range", "id": "button_height", "min": 0, "max": 100, "step": 1, "label": "Button height (px, 0 = auto)", "default": 0 },

    { "type": "color", "id": "button_bg_color", "label": "Button background color", "default": "#ffffff" },
    { "type": "color", "id": "button_bg_hover_color", "label": "Button hover background color", "default": "#f2f2f2" }


  ],
  "blocks": [
    {
      "type": "blocks",
      "name": "Blocks",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Menu Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
