{% comment %}
  How it works / steps section
  Built with a settings style similar to the attached custom section:
  - section spacing controls
  - heading controls
  - card title/description controls
  - desktop/mobile columns
  - per-section colors
  - max width + full width toggle
{% endcomment %}

<section class="how-it-works how-it-works--{{ section.id }}{% if section.settings.full_width %} how-it-works--full{% endif %}">
  <div class="how-it-works__inner">
    {% if section.settings.heading != blank %}
      <div class="how-it-works__header">
        <h2 class="how-it-works__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="how-it-works__grid">
        {% for block in section.blocks %}
          <div class="how-it-works__item" {{ block.shopify_attributes }}>
            {% if block.settings.title != blank %}
              <h3 class="how-it-works__item-title">{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="how-it-works__item-text rte">
                {{ block.settings.text }}
              </div>
            {% endif %}
            {% if block.settings.cta-text != blank %}
                <a class="btn" href="{{ block.settings.cta-url }}" >
                    {{ block.settings.cta-text }}
                </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .how-it-works--{{ section.id }} {
    width: 100%;
    background: {{ section.settings.section_bg_color }};
    padding:
      {{ section.settings.section_padding_top }}px
      {% unless section.settings.full_width %}{{ section.settings.section_padding_horizontal }}px{% else %}0{% endunless %}
      {{ section.settings.section_padding_bottom }}px;
  }

  .how-it-works--{{ section.id }} .how-it-works__inner {
    {% unless section.settings.full_width %}
      max-width: {{ section.settings.section_max_width }}px;
      margin: 0 auto;
    {% endunless %}
  }

  .how-it-works--{{ section.id }} .how-it-works__header {
    text-align: {{ section.settings.alignment_desktop }};
    margin-bottom: {{ section.settings.heading_block_margin_bottom }}px;
  }

  .how-it-works--{{ section.id }} .how-it-works__heading {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    font-family: {{ section.settings.font_heading }};
  }

  .how-it-works--{{ section.id }} .how-it-works__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    column-gap: {{ section.settings.column_gap_desktop }}px;
    row-gap: {{ section.settings.row_gap_desktop }}px;
    align-items: start;
  }

  .how-it-works--{{ section.id }} .how-it-works__item {
    text-align: {{ section.settings.alignment_desktop }};
    max-width: 100%;
  }

  .how-it-works--{{ section.id }} .how-it-works__item-title {
    margin: 0 0 {{ section.settings.item_title_margin_bottom }}px;
    color: {{ section.settings.item_title_color }};
    font-size: {{ section.settings.item_title_size_desktop }}px;
    font-weight: {{ section.settings.item_title_weight }};
    line-height: {{ section.settings.item_title_line_height }};
    letter-spacing: {{ section.settings.item_title_letter_spacing }}px;
    font-family: {{ section.settings.font_heading }};
    text-transform: {{ section.settings.item_title_transform }};
  }

  .how-it-works--{{ section.id }} .how-it-works__item-text,
  .how-it-works--{{ section.id }} .how-it-works__item-text p {
    margin: 0;
    color: {{ section.settings.item_text_color }};
    font-size: {{ section.settings.item_text_size_desktop }}px;
    font-weight: {{ section.settings.item_text_weight }};
    line-height: {{ section.settings.item_text_line_height }};
    letter-spacing: {{ section.settings.item_text_letter_spacing }}px;
    font-family: {{ section.settings.font_body }};
  }

  .how-it-works--{{ section.id }} .how-it-works__item-text p + p {
    margin-top: 10px;
  }
    .how-it-works__item-text ul {
        font-size: {{ section.settings.item_text_size_desktop }}px;
        list-style: none;
        margin: 10px 0px 0px;
    }

    .how-it-works__item-text ul li {
        list-style: none;
    }
    .how-it-works__item .btn {
        margin-top: 15px;
    }

  @media screen and (max-width: 768px) {
    .how-it-works__item .btn {
        max-width: 160px;
        margin-bottom: 16px;
    }
    .how-it-works--{{ section.id }} {
      padding:
        {{ section.settings.section_padding_top_mobile }}px
        {% unless section.settings.full_width %}{{ section.settings.section_padding_horizontal_mobile }}px{% else %}0{% endunless %}
        {{ section.settings.section_padding_bottom_mobile }}px;
    }

    .how-it-works--{{ section.id }} .how-it-works__header {
      text-align: {{ section.settings.alignment_mobile }};
      margin-bottom: {{ section.settings.heading_block_margin_bottom_mobile }}px;
    }

    .how-it-works--{{ section.id }} .how-it-works__heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
      text-align: {{ section.settings.alignment_mobile }};
    }

    .how-it-works--{{ section.id }} .how-it-works__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      column-gap: {{ section.settings.column_gap_mobile }}px;
      row-gap: {{ section.settings.row_gap_mobile }}px;
    }

    .how-it-works--{{ section.id }} .how-it-works__item {
      text-align: {{ section.settings.alignment_mobile }};
    }

    .how-it-works--{{ section.id }} .how-it-works__item-title {
      font-size: {{ section.settings.item_title_size_mobile }}px;
      text-align: {{ section.settings.alignment_mobile }};
    }

    .how-it-works--{{ section.id }} .how-it-works__item-text,
    .how-it-works--{{ section.id }} .how-it-works__item-text p {
      font-size: {{ section.settings.item_text_size_mobile }}px;
      text-align: {{ section.settings.alignment_mobile }};
    }
  }
</style>

{% schema %}
{
  "name": "How it works steps",
  "settings": [
