                        <p>Add more box items to your cart to unlock gift card.</p>
                    {% elsif castlery_state == 'progress-500' %}
                        <h3>You’ve unlocked your $200 Castlery gift card. Spend {{ castlery_remaining | money }} more to upgrade to a $500 Castlery gift card</h3>
                        <p>Add more box items to your cart to unlock gift card.</p>
                    {% else %}
                        <h3>
                            <span class="castlery-gift-progress__eyebrow">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="21" viewBox="0 0 22 21" fill="none">
                                    <path d="M0 20.5L5 6.5L14 15.5L0 20.5ZM3.3 17.2L10.35 14.7L5.8 10.15L3.3 17.2ZM12.55 11.05L11.5 10L17.1 4.4C17.6333 3.86667 18.275 3.6 19.025 3.6C19.775 3.6 20.4167 3.86667 20.95 4.4L21.55 5L20.5 6.05L19.9 5.45C19.6667 5.21667 19.375 5.1 19.025 5.1C18.675 5.1 18.3833 5.21667 18.15 5.45L12.55 11.05ZM8.55 7.05L7.5 6L8.1 5.4C8.33333 5.16667 8.45 4.88333 8.45 4.55C8.45 4.21667 8.33333 3.93333 8.1 3.7L7.45 3.05L8.5 2L9.15 2.65C9.68333 3.18333 9.95 3.81667 9.95 4.55C9.95 5.28333 9.68333 5.91667 9.15 6.45L8.55 7.05ZM10.55 9.05L9.5 8L13.1 4.4C13.3333 4.16667 13.45 3.875 13.45 3.525C13.45 3.175 13.33333 2.88333 13.1 2.65L11.5 1.05L12.55 0L14.15 1.6C14.68333 2.13333 14.95 2.775 14.95 3.525C14.95 4.275 14.68333 4.91667 14.15 5.45L10.55 9.05ZM14.55 13.05L13.5 12L15.1 10.4C15.6333 9.86667 16.275 9.6 17.025 9.6C17.775 9.6 18.4167 9.86667 18.95 10.4L20.55 12L19.5 13.05L17.9 11.45C17.6667 11.2167 17.375 11.1 17.025 11.1C16.675 11.1 16.3833 11.2167 16.15 11.45L14.55 13.05Z" fill="#10B981"/>
                                </svg>
                                GIFT CARD UNLOCKED
                            </span>
                            <span class="castlery-gift-progress__title">$500 Castlery gift card unlocked</span>
                        </h3>
                        <p>Gift card is sent via email when your order ships.</p>
                        <p>They are not stackable and delivered when your order ships.</p>
                    {% endif %}

                    <div class="castlery-gift-progress__meta">
                        <span>PROGRESS TO GIFT CARD</span>
                        <span>{{ box_total | money }} / {{ castlery_500_threshold | money }}</span>
                    </div>

                    <div class="castlery-gift-progress__bar-wrap">
                        <div class="castlery-gift-progress__bar  {% if box_total >= castlery_500_threshold %}green-col{% endif %}">
                            <span class="castlery-gift-progress__fill" style="width: {{ castlery_progress }}%;"></span>

                            <span class="castlery-gift-progress__marker {% if box_total >= castlery_200_threshold %}is-active{% endif %}" style="left: {{ castlery_200_marker }}%;"></span>
                            <span class="castlery-gift-progress__marker {% if box_total >= castlery_500_threshold %}is-active{% endif %}" style="left: {{ castlery_500_marker }}%;"></span>
                        </div>

                        <div class="castlery-gift-progress__labels">
                            <div class="castlery-gift-progress__label castlery-gift-progress__label--500 is-active" style="left: {{ castlery_500_marker }}%;">
                                    {% comment %} <strong>$4,000</strong> {% endcomment %}
                                    <span>$500 gift card</span>
                                </div>
                                <div class="castlery-gift-progress__label castlery-gift-progress__label--200 is-active" style="left: {{ castlery_200_marker }}%;">
                                    {% comment %} <strong>$1,000</strong> {% endcomment %}
                                    <span>$200 gift card</span>
                                </div>
                            {% comment %} {% if box_total >= castlery_500_threshold %}
                                <div class="castlery-gift-progress__label castlery-gift-progress__label--500 is-active" style="left: {{ castlery_500_marker }}%;">
                                    {% comment %} <strong>$4,000</strong> {% endcomment %}
                                    <span>$500 gift card</span>
                                </div>
                            {% elsif box_total >= castlery_200_threshold %}
                                <div class="castlery-gift-progress__label castlery-gift-progress__label--200 is-active" style="left: {{ castlery_200_marker }}%;">
                                    {% comment %} <strong>$1,000</strong> {% endcomment %}
