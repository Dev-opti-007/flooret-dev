{% comment %} {% liquid
    assign module = section.settings
    assign samplesMissing = 6.0
    assign percentStep = 100 | divided_by: samplesMissing
    for item in cart.items
        for option in item.variant.options
            if option contains 'Cut Sample'
                assign samplesMissing = samplesMissing | minus: item.quantity
            endif
        endfor
    endfor
    if samplesMissing < 0
        assign samplesMissing = 0
    endif
    assign percentMissing = percentStep | times: samplesMissing
    assign percent = 100 | minus: percentMissing
%}

<section class="pop-cart">
    <form class="overflow" id="fr24-pop-cart-form" action="/checkout" method="post" novalidate>

        <div class="pop-cart__top">
            <div class="pop-cart__intro">
                <button class="pop-cart__close js-cart-drawer-close reset" type="button">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M3.825 9L9.425 14.6L8 16L-1.09896e-07 8L8 4.76837e-07L9.425 1.4L3.825 7H16V9H3.825Z" fill="#0F172A"/>
                    </svg>
                </button>
                <span class="h5">My Cart (<span class="cart-item__count js-cart-count">{{ cart.item_count }}</span>)</span>
                <button class="pop-cart__close js-cart-drawer-close reset" type="button">{% render 'svg-close' %}</button>
            </div>

            {% assign hideSample = false %}
            {% for item in cart.items %}
                {% if hideSample == false %}
                    {% for option in item.variant.options %}
                        {% if option == 'Box' %}
                            {% assign hideSample = true %}
                            {% break %}
                        {% endif %}
                    {% endfor %}
                {% endif %}
            {% endfor %}

            {% if hideSample == false %}
                {% if samplesMissing != 6 and module.show_sample_offer %}
                    <div class="pop-cart__samples">
                        {% if samplesMissing == 0 %}
                            <strong>You have earned 1 free cut sample! <br/> (Applied at Checkout)</strong>
                        {% else %}
                            <strong>You are {{ samplesMissing | ceil }} cut sample{% unless samplesMissing <= 1 %}s{% endunless %} away from getting 1 free.</strong>
                        {% endif %}
                        <div class="pop-cart__samples__bar">
                            <span class="percent" style="width:{{ percent }}%"></span>
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            {% assign box_total = 0 %}
            {% assign box_threshold = 100000 %}

            {% for item in cart.items %}
                {% assign is_box_item = false %}
                {% for option in item.variant.options %}
                    {% if option == 'Box' %}
                        {% assign is_box_item = true %}
                    {% endif %}
                {% endfor %}
                {% if is_box_item %}
                    {% assign box_total = box_total | plus: item.final_line_price %}
                {% endif %}
            {% endfor %}

            {% assign box_remaining = box_threshold | minus: box_total %}

            {% if box_total >= box_threshold %}
                {% assign box_progress = 100 %}
            {% else %}
                {% assign box_progress = box_total | times: 100.0 | divided_by: box_threshold | round %}
            {% endif %}

            {% if box_total > 0 %}
                <div class="trim-discount-progress {% if box_total >= box_threshold %}is-unlocked{% else %}is-locked{% endif %}">
                    {% if box_total >= box_threshold %}
                        <h3>
                            <span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="21" viewBox="0 0 22 21" fill="none">
                                    <path d="M0 20.5L5 6.5L14 15.5L0 20.5ZM3.3 17.2L10.35 14.7L5.8 10.15L3.3 17.2ZM12.55 11.05L11.5 10L17.1 4.4C17.6333 3.86667 18.275 3.6 19.025 3.6C19.775 3.6 20.4167 3.86667 20.95 4.4L21.55 5L20.5 6.05L19.9 5.45C19.6667 5.21667 19.375 5.1 19.025 5.1C18.675 5.1 18.3833 5.21667 18.15 5.45L12.55 11.05ZM8.55 7.05L7.5 6L8.1 5.4C8.33333 5.16667 8.45 4.88333 8.45 4.55C8.45 4.21667 8.33333 3.93333 8.1 3.7L7.45 3.05L8.5 2L9.15 2.65C9.68333 3.18333 9.95 3.81667 9.95 4.55C9.95 5.28333 9.68333 5.91667 9.15 6.45L8.55 7.05ZM10.55 9.05L9.5 8L13.1 4.4C13.3333 4.16667 13.45 3.875 13.45 3.525C13.45 3.175 13.3333 2.88333 13.1 2.65L11.5 1.05L12.55 0L14.15 1.6C14.6833 2.13333 14.95 2.775 14.95 3.525C14.95 4.275 14.6833 4.91667 14.15 5.45L10.55 9.05ZM14.55 13.05L13.5 12L15.1 10.4C15.6333 9.86667 16.275 9.6 17.025 9.6C17.775 9.6 18.4167 9.86667 18.95 10.4L20.55 12L19.5 13.05L17.9 11.45C17.6667 11.2167 17.375 11.1 17.025 11.1C16.675 11.1 16.3833 11.2167 16.15 11.45L14.55 13.05Z" fill="#10B981"/>
                                </svg>
                                CONGRATS!
                            </span>
                            <span class="unlockd-text">$200 OFF unlocked</span>
                        </h3>
                        <p>You've unlocked $200 OFF trim with this order. Select your trim below to apply the discount. <a id="scrollToBtn" href="#tripUpsell">Add trims</a></p>
                    {% else %}
                        <h3>You're {{ box_remaining | money }} away from $200 OFF your matching trim</h3>
                        <p>Add more box items to your cart to unlock discount.</p>
                    {% endif %}

                    <div class="trim-discount-progress__meta">
                        <span>PROGRESS TO DISCOUNT</span>
                        <span>{{ box_total | money }} / {{ box_threshold | money }}</span>
                    </div>

                    <div class="trim-discount-progress__bar">
                        <span class="trim-discount-progress__fill" style="width: {{ box_progress }}%;"></span>
                    </div>
                </div>
            {% endif %}

            <div class="pop-cart__items">
                {% render 'cart-items', drawer: true %}
            </div>
        </div>

        {% assign box_total = 0 %}
        {% assign trim_total = 0 %}
        {% assign box_threshold = 100000 %}
        {% assign trim_discount = 20000 %}

        {% for item in cart.items %}
            {% assign is_box_item = false %}
            {% for option in item.variant.options %}
                {% if option == 'Box' %}
                    {% assign is_box_item = true %}
                {% endif %}
            {% endfor %}
            {% if is_box_item %}
                {% assign box_total = box_total | plus: item.final_line_price %}
            {% endif %}
            {% assign product_type_downcase = item.product.type | downcase %}
            {% if product_type_downcase == 'trim' or product_type_downcase == 'accessories'  %}
                {% assign trim_total = trim_total | plus: item.final_line_price %}
            {% endif %}
        {% endfor %}

        {% assign applied_trim_discount = 0 %}
        {% if box_total >= box_threshold and trim_total > 0 %}
            {% if trim_total >= trim_discount %}
                {% assign applied_trim_discount = trim_discount %}
            {% else %}
                {% assign applied_trim_discount = trim_total %}
            {% endif %}
        {% endif %}

        {% assign original_subtotal = 0 %}
        {% for item in cart.items %}
            {% assign original_subtotal = original_subtotal | plus: item.original_line_price %}
        {% endfor %}

        {% assign revised_total = original_subtotal | minus: applied_trim_discount %}

        <div class="pop-cart__body" id="tripUpsell">
            {% render 'cart-trim-upsell' %}
        </div>
        {% assign unique_product_count = cart.items | map: 'product_id' | uniq | size %}
        <div class="pop-cart__footer js-pop-cart-actions {% if unique_product_count  >= 2 %}fix{% else %}{% endif %}">
            <div class="pop-cart__actions">
                <table>
                    {% if cart.items.size != 0 %}
                        <tr>
                            <td>{{ 'cart.subtotal' | t }}</td>
                            <td class="js-subtotal js-cart-subtotal">{{ original_subtotal | money_without_trailing_zeros }}</td>
                        </tr>
                        {% if trim_total > 0 and applied_trim_discount > 0 %}
                            <tr class="trim-subtotal-row">
                                <td>Trims Subtotal</td>
                                <td>{{ trim_total | money_without_trailing_zeros }}</td>
                            </tr>
                        {% endif %}
                        {% if applied_trim_discount > 0 %}
                            <tr class="trim-discount-row">
                                <td>Trim Promo Discount</td>
                                <td>-{{ applied_trim_discount | money_without_trailing_zeros }}</td>
                            </tr>
                        {% endif %}
                        <tr class="row text-only">
                            <td>Shipping & Tax</td>
                            <td>Calculated at checkout</td>
                        </tr>
                        <tr class="trim-revised-total-row">
                            <td>Total</td>
                            <td>{{ revised_total | money_without_trailing_zeros }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="center">Your cart is empty</td>
                        </tr>
                    {% endif %}
                </table>

                {% if cart.items.size != 0 %}
                    <button type="button" id="fr24-checkout-btn" class="btn btn--black js-fr24-checkout-btn">
                        {{ 'cart.checkout' | t }}
                    </button>
                {% else %}
                    <a href="/collections/all" class="btn btn--black">Shop All Products</a>
                {% endif %}
            </div>
        </div>

        {{- '<!-- Hidden original-order updates for correct Shopify checkout submission -->' -}}
        <div style="display:none;" aria-hidden="true">
            {% for item in cart.items %}
                <input
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    data-key="{{ item.key }}"
                    data-variant-id="{{ item.variant.id }}"
                    class="js-original-update">
            {% endfor %}
            {{- '<!-- Hidden submit — gives Minmaxify its real submit hook -->' -}}
            <button type="submit" class="js-hidden-submit" tabindex="-1" aria-hidden="true">Checkout</button>
        </div>

    </form>
</section>

<script src="{{ 'trim-upsell.js' | asset_url }}" defer></script>

<script>
(function () {
  document.addEventListener("click", function (e) {
    const btn = e.target.closest(".js-fr24-checkout-btn");
    if (!btn || btn.disabled) return;

    e.preventDefault();

    // Step 1: Sync visible qty inputs → hidden original-order inputs
    const visibleInputs = document.querySelectorAll(".js-qty__input");
    const hiddenInputs = document.querySelectorAll(".js-original-update");

    // Map by variant id so grouping order doesn't matter
    const qtyMap = {};
    visibleInputs.forEach((input) => {
      const card = input.closest(".js-cart-card");
      if (card) {
        const variantId = card.dataset.id;
        if (variantId) qtyMap[variantId] = input.value;
      }
    });

    hiddenInputs.forEach((input) => {
      const variantId = input.dataset.variantId;
      if (variantId && qtyMap[variantId] !== undefined) {
        input.value = qtyMap[variantId];
      }
    });

    // Step 2: Validate cart not empty
    fetch("/cart.js", {
      method: "GET",
      headers: { Accept: "application/json" }
    })
      .then((res) => res.json())
      .then((cart) => {
        if (!cart || cart.item_count === 0) return;

        // Step 3: Click hidden submit → triggers Minmaxify validation
        // Minmaxify will block here if quantities fail its rules
        const hiddenSubmit = document.querySelector(".js-hidden-submit");
        if (hiddenSubmit) {
          sessionStorage.setItem("fr24_came_from_checkout_flow", "true");
          hiddenSubmit.click();
        }
      })
      .catch(() => {
        const hiddenSubmit = document.querySelector(".js-hidden-submit");
        if (hiddenSubmit) {
          sessionStorage.setItem("fr24_came_from_checkout_flow", "true");
          hiddenSubmit.click();
        }
      });
  });
    
})();
</script>

