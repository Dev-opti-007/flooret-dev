{% comment %}
  History Timeline Slider
  - Uses blocks for timeline cards
  - Uses Slick Slider
  - Make sure Slick CSS/JS is loaded in theme
{% endcomment %}

<section
  id="HistoryTimeline-{{ section.id }}"
  class="history-timeline"
  style="
    --ht-bg: {{ section.settings.section_bg_color }};
    --ht-max: {{ section.settings.section_max_width }}px;

    --ht-pt: {{ section.settings.padding_top_desktop }}px;
    --ht-pr: {{ section.settings.padding_right_desktop }}px;
    --ht-pb: {{ section.settings.padding_bottom_desktop }}px;
    --ht-pl: {{ section.settings.padding_left_desktop }}px;

    --ht-pt-m: {{ section.settings.padding_top_mobile }}px;
    --ht-pr-m: {{ section.settings.padding_right_mobile }}px;
    --ht-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --ht-pl-m: {{ section.settings.padding_left_mobile }}px;

    --ht-heading-color: {{ section.settings.heading_color }};
    --ht-heading-size: {{ section.settings.heading_size_desktop }}px;
    --ht-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --ht-heading-weight: {{ section.settings.heading_weight }};
    --ht-heading-lh: {{ section.settings.heading_line_height }};
    --ht-heading-ls: {{ section.settings.heading_letter_spacing }}px;
    --ht-heading-mb: {{ section.settings.heading_margin_bottom }}px;

    --ht-year-color: {{ section.settings.year_color }};
    --ht-year-size: {{ section.settings.year_size_desktop }}px;
    --ht-year-size-m: {{ section.settings.year_size_mobile }}px;
    --ht-year-weight: {{ section.settings.year_weight }};
    --ht-year-lh: {{ section.settings.year_line_height }};
    --ht-year-ls: {{ section.settings.year_letter_spacing }}px;
    --ht-year-mb: {{ section.settings.year_margin_bottom }}px;

    --ht-text-color: {{ section.settings.text_color }};
    --ht-text-size: {{ section.settings.text_size_desktop }}px;
    --ht-text-size-m: {{ section.settings.text_size_mobile }}px;
    --ht-text-weight: {{ section.settings.text_weight }};
    --ht-text-lh: {{ section.settings.text_line_height }};
    --ht-text-ls: {{ section.settings.text_letter_spacing }}px;
    --ht-text-mb: {{ section.settings.text_margin_bottom }}px;

    --ht-card-gap: {{ section.settings.card_gap_desktop }}px;
    --ht-card-gap-m: {{ section.settings.card_gap_mobile }}px;
    --ht-card-width: {{ section.settings.card_width_desktop }}px;
    --ht-card-width-m: {{ section.settings.card_width_mobile }}px;

    --ht-line-color: {{ section.settings.divider_color }};
    --ht-line-width: {{ section.settings.divider_width }}px;
    --ht-line-height: {{ section.settings.divider_height }}px;

    --ht-img-radius: {{ section.settings.image_radius }}px;
    --ht-img-height: {{ section.settings.image_height_desktop }}px;
    --ht-img-height-m: {{ section.settings.image_height_mobile }}px;

    --ht-arrow-size: {{ section.settings.arrow_size }}px;
    --ht-arrow-icon-size: {{ section.settings.arrow_icon_size }}px;
    --ht-arrow-bg: {{ section.settings.arrow_bg }};
    --ht-arrow-color: {{ section.settings.arrow_color }};
    --ht-arrow-top: {{ section.settings.arrow_top_offset }}px;
  "
>
  <div class="history-timeline__wrap {% unless section.settings.full_width %}history-timeline__wrap--contained{% endunless %}">
    {% if section.settings.heading != blank %}
      <div class="history-timeline__head">
        <h2 class="history-timeline__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="history-timeline__slider-wrap">
      <div class="history-timeline__slider js-history-slider-{{ section.id }}">
        {% for block in section.blocks %}
          <div class="history-timeline__slide" {{ block.shopify_attributes }}>
            <div
              class="history-timeline__card"
              style="
                --ht-card-line-color: {{ block.settings.divider_color | default: section.settings.divider_color }};
                --ht-card-image-radius: {{ block.settings.image_radius | default: section.settings.image_radius }}px;
              "
            >
              <div class="history-timeline__inner">
                {% if block.settings.year != blank %}
                  <div class="history-timeline__year">{{ block.settings.year }}</div>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="history-timeline__text">{{ block.settings.text }}</div>
                {% endif %}

                {% if block.settings.image != blank %}
                  <div class="history-timeline__image-wrap">
                    {{ block.settings.image
                      | image_url: width: block.settings.image_render_width
                      | image_tag:
                        loading: 'lazy',
                        class: 'history-timeline__image',
                        alt: block.settings.image.alt | escape
                    }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      {% if section.settings.show_arrows %}
        <button class="history-timeline__arrow history-timeline__arrow--prev js-history-prev-{{ section.id }}" type="button" aria-label="Previous slide">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M8.75 2.5L4.25 7L8.75 11.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="history-timeline__arrow history-timeline__arrow--next js-history-next-{{ section.id }}" type="button" aria-label="Next slide">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M5.25 2.5L9.75 7L5.25 11.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #HistoryTimeline-{{ section.id }}{
    background: var(--ht-bg);
    padding: var(--ht-pt) var(--ht-pr) var(--ht-pb) var(--ht-pl);
    position: relative;
    overflow: hidden;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__wrap--contained{
    max-width: var(--ht-max);
    margin: 0 auto;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__head{
    margin-bottom: var(--ht-heading-mb);
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__heading{
    margin: 0;
    color: var(--ht-heading-color);
    font-size: var(--ht-heading-size);
    font-weight: var(--ht-heading-weight);
    line-height: var(--ht-heading-lh);
    letter-spacing: var(--ht-heading-ls);
    font-family: {{ section.settings.font_heading | json }}, sans-serif;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__slider-wrap{
    position: relative;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__slide{
    width: var(--ht-card-width);
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__card{
    height: 100%;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__inner{
    position: relative;
    padding-right: var(--ht-card-gap);
    min-height: 100%;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__inner::after{
    content: "";
    position: absolute;
    top: 0;
    right: calc(var(--ht-card-gap) / 2);
    width: var(--ht-line-width);
    height: var(--ht-line-height);
    background: var(--ht-card-line-color, var(--ht-line-color));
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__slide:last-child .history-timeline__inner::after{
    display: none;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__year{
    margin: 0 0 var(--ht-year-mb);
    color: var(--ht-year-color);
    font-size: var(--ht-year-size);
    font-weight: var(--ht-year-weight);
    line-height: var(--ht-year-lh);
    letter-spacing: var(--ht-year-ls);
    font-family: {{ section.settings.font_year | json }}, serif;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__text{
    margin: 0 0 var(--ht-text-mb);
    color: var(--ht-text-color);
    font-size: var(--ht-text-size);
    font-weight: var(--ht-text-weight);
    line-height: var(--ht-text-lh);
    letter-spacing: var(--ht-text-ls);
    max-width: 260px;
    font-family: {{ section.settings.font_text | json }}, sans-serif;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__image-wrap{
    border-radius: var(--ht-card-image-radius, var(--ht-img-radius));
    overflow: hidden;
    width: 100%;
    max-width: calc(var(--ht-card-width) - var(--ht-card-gap));
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__image{
    width: 100%;
    height: var(--ht-img-height);
    object-fit: cover;
    display: block;
    border-radius: var(--ht-card-image-radius, var(--ht-img-radius));
  }

  #HistoryTimeline-{{ section.id }} .slick-list{
    overflow: hidden;
  }

  #HistoryTimeline-{{ section.id }} .slick-track{
    display: flex;
  }

  #HistoryTimeline-{{ section.id }} .slick-slide{
    height: inherit;
  }

  #HistoryTimeline-{{ section.id }} .slick-slide > div{
    height: 100%;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__arrow{
    position: absolute;
    top: var(--ht-arrow-top);
    width: var(--ht-arrow-size);
    height: var(--ht-arrow-size);
    border-radius: 999px;
    border: none;
    background: var(--ht-arrow-bg);
    color: var(--ht-arrow-color);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 3;
    transition: opacity .2s ease, transform .2s ease;
    padding: 0;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__arrow svg{
    width: var(--ht-arrow-icon-size);
    height: var(--ht-arrow-icon-size);
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__arrow:hover{
    opacity: .9;
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__arrow--prev{
    right: calc(var(--ht-arrow-size) + 12px);
  }

  #HistoryTimeline-{{ section.id }} .history-timeline__arrow--next{
    right: 0;
  }

  #HistoryTimeline-{{ section.id }} .slick-disabled{
    opacity: .45;
    pointer-events: none;
  }

  .history-timeline__slide {
        border-right: 1.5px solid #FAAF4F;
    }

    .history-timeline__slide {
        padding-left: 30px;
    }
    .history-timeline__slider .slick-list.draggable {
        margin-left: -130px;
    }
    .history-timeline__text {
        min-height: 102px;
    }
    .history-timeline__arrow {
        top: -23% !important;
    }
  @media (max-width: 749px){
    .history-timeline__slider .slick-list.draggable {
        margin-left: 0px;
    }
    .history-timeline__slide {
        padding-left: 0px;
    }
    .history-timeline__arrow {
        position: relative !important;
        top: unset  !important;
        right: 0 !important;
        left: unset !important;
        display: inline-flex !important;
        margin-top: 40px;
    }
    .history-timeline__slider-wrap {
        text-align: end;
    }
    .history-timeline__inner {
        text-align: start;
    }
    .history-timeline__slider .slick-slide {
        opacity: 0;
    }
    .history-timeline__slider .slick-slide.slick-current.slick-active {
        opacity: 1;
    }
    #HistoryTimeline-{{ section.id }}{
      padding: var(--ht-pt-m) var(--ht-pr-m) var(--ht-pb-m) var(--ht-pl-m);
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__heading{
      font-size: var(--ht-heading-size-m);
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__slide{
      width: var(--ht-card-width-m);
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__inner{
      padding-right: var(--ht-card-gap-m);
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__inner::after{
      right: calc(var(--ht-card-gap-m) / 2);
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__year{
      font-size: var(--ht-year-size-m);
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__text{
      font-size: var(--ht-text-size-m);
      max-width: 100%;
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__image-wrap{
      max-width: calc(var(--ht-card-width-m) - var(--ht-card-gap-m));
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__image{
      height: var(--ht-img-height-m);
    }

    #HistoryTimeline-{{ section.id }} .history-timeline__arrow{
      top: 0;
    }
  }
</style>

<script>
  (function() {
    function initHistorySlider() {
      var $slider = $('.js-history-slider-{{ section.id }}');
      if (!$slider.length) return;

      if ($slider.hasClass('slick-initialized')) {
        return;
      }

      $slider.slick({
        slidesToShow: {{ section.settings.slides_to_show_desktop }},
        slidesToScroll: {{ section.settings.slides_to_scroll }},
        infinite: {{ section.settings.infinite }},
        arrows: {{ section.settings.show_arrows }},
        dots: {{ section.settings.show_dots }},
        speed: {{ section.settings.slider_speed }},
        adaptiveHeight: false,
        prevArrow: $('.js-history-prev-{{ section.id }}'),
        nextArrow: $('.js-history-next-{{ section.id }}'),
        centerMode: true,
        centerPadding: '100px',
        initialSlide: 2,
        responsive: [
          {
            breakpoint: 990,
            settings: {
              slidesToShow: {{ section.settings.slides_to_show_tablet }},
              slidesToScroll: 1
            }
          },
          {
            breakpoint: 750,
            settings: {
              slidesToShow: {{ section.settings.slides_to_show_mobile }},
              slidesToScroll: 1,
              centerMode: false,
              centerPadding: '0px',
            }
          }
        ]
      });
    }

    if (window.jQuery && window.jQuery.fn && window.jQuery.fn.slick) {
      initHistorySlider();
    } else {
      document.addEventListener('DOMContentLoaded', initHistorySlider);
    }

    document.addEventListener('shopify:section:load', function(event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initHistorySlider();
      }
    });
  })();
</script>

