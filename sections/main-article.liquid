{%- liquid
  assign meta = article.metafields.flooret
  assign full_url = request.host | append: request.path
  assign author = article.author | handleize
  assign author_meta = shop.metaobjects.authors[author]
%}

{% if article.image %}
  <section class="article-hero">
    <div class="container">
      <div class="row">
        <div class="col col--left">
          <div class="article-hero__image">
            {% render 'lazy-image', image: article.image, lazy: false, width: 720 %}
          </div>
        </div>
        <div class="col col--right">
          <div class="article-hero__content">
            <div class="article-hero__category">
              {%- for tag in article.tags -%}
                {%- if tag contains 'Cat - ' -%}
                  <a
                    href="/blogs/{{ blog.handle }}/tagged/{{ tag | handle }}"
                    class="btn btn--small btn--outline btn--orange"
                  >
                    {{- tag | remove: 'Cat - ' -}}
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="article-hero__meta">
              <span class="article-hero__date">{{ article.published_at | date: '%B %d, %Y' }}</span>
              &bull;
              <span class="article-hero__author">By {{ article.author }}</span>
            </div>
            <h1 class="h2 article-hero__heading">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h1>
          </div>
        </div>
      </div>
    </div>
  </section>
{% endif %}

<article class="longform-content article">
  <div class="container">
    <div class="content-wrap">
      <div class="article__main">
        {{ article.content }}
      </div>

      <div class="article__footer">
        <div class="article__section">
          {% render 'share-links', url: full_url %}
        </div>

        {%- if author_meta != blank -%}
          <div class="article__section">
            <div class="article-author">
              <div class="article-author__header">
                {%- if author_meta.image != blank -%}
                  <div class="article-author__image">
                    {% render 'lazy-image', image: author_meta.image, lazy: false, width: 100 %}
                  </div>
                {%- endif -%}
                <h6 class="article-author__name">{{ author_meta.name }}</h6>
              </div>
              <div class="article-author__content">
                <p class="article-author__bio">{{ author_meta.bio | metafield_text }}</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</article>

{%- if meta.shop_blog != blank and meta.shop_blog != '' -%}
  {%- assign prods = meta.shop_blog.value -%}
  {% if prods != blank %}
    <section class="shop-blog">
      <div class="container container--longform">
        <div class="section__header">
          <h3>Shop this Article</h3>
        </div>
        <div class="section__content">
          <div class="row">
            {%- for prod in prods -%}
              <div class="col">
                {%- render 'product-card', product: prod -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
{%- endif -%}

{% capture relatedPosts %}
{%- assign count = 0 -%}
{% paginate blog.articles by 100 %}
  {% for post in blog.articles %}
    {% unless post.handle == article.handle %}
      {% assign post_tags = post.tags %}
      {% assign article_tags = article.tags[0] %}

      {% if post_tags contains article_tags %}
        <div class="col">
          {% render 'article-card', article: post %}
        </div>

        {% assign count = count | plus: 1 %}
        {% if count > 3 %}
          {% break %}
        {% endif %}
      {% endif %}
    {% endunless %}
  {% endfor %}
{% endpaginate %}
{% endcapture %}

{% if relatedPosts != blank and relatedPosts != '' %}
<section class="related-articles">
  <div class="container">
    <div class="section__header">
      <h2>Related Articles</h2>
    </div>
    <div class="section__content">
      <div class="row">
        {{ relatedPosts }}
        <div class="col"></div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% schema %}
{
  "name": "Main Article",
  "settings": []
}
{% endschema %}
