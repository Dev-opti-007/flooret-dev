{% comment %}
  Product Comparison Section
  Layout:
  — Header row: step number + step label + title (left) | description (right)
  — Tab switcher: Tab 1 | Tab 2 + tagline
  — Two-column panel:
      Left  → single image with numbered hotspot dots
      Right → product title, description, feature rows (image + title + detail + badge), CTA button
{% endcomment %}

{%- liquid
  assign tab1_features_count = 3
  assign tab2_features_count = 3
-%}

<section class="pcs pcs--{{ section.id }}{% if section.settings.full_width %} pcs--full-width{% endif %}">

  {%- comment -%} ══ HEADER ROW ══ {%- endcomment -%}
  <div class="pcs__header">
    <div class="pcs__header-left">
      {%- if section.settings.step_number != blank -%}
        <span class="pcs__step-number" aria-hidden="true">{{ section.settings.step_number }}</span>
      {%- endif -%}
      <div class="pcs__header-meta">
        {%- if section.settings.step_label != blank -%}
          <p class="pcs__step-label">{{ section.settings.step_label }}</p>
        {%- endif -%}
        {%- if section.settings.section_title != blank -%}
          <h2 class="pcs__title">{{ section.settings.section_title }}</h2>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.header_description != blank -%}
      <div class="pcs__header-right">
        <p class="pcs__header-desc">{{ section.settings.header_description }}</p>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ══ TAB SWITCHER ══ {%- endcomment -%}
  <div class="pcs__tabs-row">
    <div class="pcs__tabs" role="tablist">
      <button
        class="pcs__tab pcs__tab--1 is-active"
        role="tab"
        aria-selected="true"
        aria-controls="pcs-panel-{{ section.id }}"
        data-tab="1"
        id="pcs-tab1-{{ section.id }}">
        {{ section.settings.tab1_label | default: 'TrueStep' }}
      </button>
      <button
        class="pcs__tab pcs__tab--2"
        role="tab"
        aria-selected="false"
        aria-controls="pcs-panel-{{ section.id }}"
        data-tab="2"
        id="pcs-tab2-{{ section.id }}">
        {{ section.settings.tab2_label | default: 'TruePlank' }}
      </button>
    </div>
    {%- if section.settings.tabs_tagline != blank -%}
      <p class="pcs__tabs-tagline">{{ section.settings.tabs_tagline }}</p>
    {%- endif -%}
  </div>

  {%- comment -%} ══ MAIN PANEL ══ {%- endcomment -%}
  <div class="pcs__panel" id="pcs-panel-{{ section.id }}" role="tabpanel">

    {%- comment -%} ── LEFT: Single image per tab ── {%- endcomment -%}
    <div class="pcs__image-col">

      <div class="pcs__slides" aria-live="polite">

        {%- comment -%} TAB 1 IMAGE {%- endcomment -%}
        <div class="pcs__slide pcs__slide--tab1 is-active" data-tab="1">
          {%- if section.settings.tab1_slide1_image != blank -%}
            <img
              src="{{ section.settings.tab1_slide1_image | image_url: width: section.settings.slide_image_width | default: 800 }}"
              alt="{{ section.settings.tab1_slide1_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="600">
          {%- else -%}
            <div class="pcs__slide-placeholder">
              <span>Image or drawings</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} TAB 2 IMAGE {%- endcomment -%}
        <div class="pcs__slide pcs__slide--tab2" data-tab="2" style="display:none;">
          {%- if section.settings.tab2_slide1_image != blank -%}
            <img
              src="{{ section.settings.tab2_slide1_image | image_url: width: section.settings.slide_image_width | default: 800 }}"
              alt="{{ section.settings.tab2_slide1_image.alt | escape }}"
              loading="lazy"
              width="800"
              height="600">
          {%- else -%}
            <div class="pcs__slide-placeholder">
              <span>Image or drawings</span>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} TAB 1 HOTSPOTS {%- endcomment -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign dot_top_key  = 'tab1_s1_dot' | append: i | append: '_top'
            assign dot_left_key = 'tab1_s1_dot' | append: i | append: '_left'
          -%}
          <button
            class="pcs__hotspot pcs__hotspot--tab1"
            data-tab="1"
            style="top:{{ section.settings[dot_top_key] | default: 30 }}%;left:{{ section.settings[dot_left_key] | default: 25 }}%;"
            aria-label="Feature {{ i }}">
            {{ i }}
          </button>
        {%- endfor -%}

        {%- comment -%} TAB 2 HOTSPOTS {%- endcomment -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign dot_top_key  = 'tab2_s1_dot' | append: i | append: '_top'
            assign dot_left_key = 'tab2_s1_dot' | append: i | append: '_left'
          -%}
          <button
            class="pcs__hotspot pcs__hotspot--tab2"
            data-tab="2"
            style="top:{{ section.settings[dot_top_key] | default: 30 }}%;left:{{ section.settings[dot_left_key] | default: 25 }}%;"
            aria-label="Feature {{ i }}"
            hidden>
            {{ i }}
          </button>
        {%- endfor -%}

      </div>

      {%- comment -%} Pagination dots now switch tabs {%- endcomment -%}
      <div class="pcs__pagination" role="tablist" aria-label="Product navigation">
        <button
          class="pcs__dot is-active"
          data-tab-dot="1"
          role="tab"
          aria-selected="true"
          aria-label="Show {{ section.settings.tab1_label | default: 'Tab 1' }}">
        </button>
        <button
          class="pcs__dot"
          data-tab-dot="2"
          role="tab"
          aria-selected="false"
          aria-label="Show {{ section.settings.tab2_label | default: 'Tab 2' }}">
        </button>
      </div>

    </div>

    {%- comment -%} ── RIGHT: Product Info ── {%- endcomment -%}
    <div class="pcs__info-col">

      {%- comment -%} TAB 1 CONTENT {%- endcomment -%}
      <div class="pcs__tab-content pcs__tab-content--1 is-active" data-content="1">
        {%- if section.settings.tab1_product_title != blank -%}
          <h3 class="pcs__product-title">{{ section.settings.tab1_product_title }}</h3>
        {%- endif -%}
        {%- if section.settings.tab1_product_desc != blank -%}
          <p class="pcs__product-desc">{{ section.settings.tab1_product_desc }}</p>
        {%- endif -%}

        <div class="pcs__features">
          {%- for i in (1..3) -%}
            {%- liquid
              assign feat_img_key    = 'tab1_feat' | append: i | append: '_image'
              assign feat_title_key  = 'tab1_feat' | append: i | append: '_title'
              assign feat_detail_key = 'tab1_feat' | append: i | append: '_detail'
              assign feat_img        = section.settings[feat_img_key]
              assign feat_title      = section.settings[feat_title_key]
              assign feat_detail     = section.settings[feat_detail_key]
            -%}
            {%- if feat_title != blank -%}
              <div class="pcs__feature">
                <div class="pcs__feature-img">
                  {%- if feat_img != blank -%}
                    <img src="{{ feat_img | image_url: width: 160 }}" alt="{{ feat_img.alt | escape }}" loading="lazy" width="80" height="80">
                  {%- else -%}
                    <div class="pcs__feature-img-placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="pcs__feature-text">
                  <p class="pcs__feature-title">{{ feat_title }}</p>
                  {%- if feat_detail != blank -%}
                    <p class="pcs__feature-detail">{{ feat_detail }}</p>
                  {%- endif -%}
                </div>
                <span class="pcs__feature-badge" aria-hidden="true">{{ i }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.tab1_btn_text != blank -%}
          <a class="pcs__cta" href="{{ section.settings.tab1_btn_url }}">
            {{ section.settings.tab1_btn_text }}
          </a>
        {%- endif -%}
      </div>

      {%- comment -%} TAB 2 CONTENT {%- endcomment -%}
      <div class="pcs__tab-content pcs__tab-content--2" data-content="2" style="display:none;">
        {%- if section.settings.tab2_product_title != blank -%}
          <h3 class="pcs__product-title">{{ section.settings.tab2_product_title }}</h3>
        {%- endif -%}
        {%- if section.settings.tab2_product_desc != blank -%}
          <p class="pcs__product-desc">{{ section.settings.tab2_product_desc }}</p>
        {%- endif -%}

        <div class="pcs__features">
          {%- for i in (1..3) -%}
            {%- liquid
              assign feat_img_key    = 'tab2_feat' | append: i | append: '_image'
              assign feat_title_key  = 'tab2_feat' | append: i | append: '_title'
              assign feat_detail_key = 'tab2_feat' | append: i | append: '_detail'
              assign feat_img        = section.settings[feat_img_key]
              assign feat_title      = section.settings[feat_title_key]
              assign feat_detail     = section.settings[feat_detail_key]
            -%}
            {%- if feat_title != blank -%}
              <div class="pcs__feature">
                <div class="pcs__feature-img">
                  {%- if feat_img != blank -%}
                    <img src="{{ feat_img | image_url: width: 160 }}" alt="{{ feat_img.alt | escape }}" loading="lazy" width="80" height="80">
                  {%- else -%}
                    <div class="pcs__feature-img-placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="pcs__feature-text">
                  <p class="pcs__feature-title">{{ feat_title }}</p>
                  {%- if feat_detail != blank -%}
                    <p class="pcs__feature-detail">{{ feat_detail }}</p>
                  {%- endif -%}
                </div>
                <span class="pcs__feature-badge" aria-hidden="true">{{ i }}</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.tab2_btn_text != blank -%}
          <a class="pcs__cta" href="{{ section.settings.tab2_btn_url }}">
            {{ section.settings.tab2_btn_text }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>

</section>

<style>
  .pcs--{{ section.id }} {
    --pcs-font-heading: '{{ section.settings.font_heading }}', sans-serif;
    --pcs-font-body: '{{ section.settings.font_body }}', sans-serif;
    --pcs-accent: {{ section.settings.accent_color | default: '#f5a623' }};
    --pcs-accent-hover: {{ section.settings.accent_hover_color | default: '#d48f0f' }};
    --pcs-bg: {{ section.settings.section_bg | default: '#ffffff' }};
    --pcs-panel-bg: {{ section.settings.panel_bg | default: '#f5f3ef' }};
    --pcs-feature-bg: {{ section.settings.feature_bg | default: '#ffffff' }};
    --pcs-text: {{ section.settings.text_color | default: '#1a1a1a' }};
    --pcs-text-muted: {{ section.settings.text_muted_color | default: '#000000' }};
    --pcs-step-number-color: {{ section.settings.step_number_color | default: '#e8e3db' }};
    --pcs-tab-active-bg: {{ section.settings.tab_active_bg | default: '#1a1a1a' }};
    --pcs-tab-active-text: {{ section.settings.tab_active_text | default: '#ffffff' }};
    --pcs-tab-inactive-bg: {{ section.settings.tab_inactive_bg | default: '#ffffff' }};
    --pcs-tab-inactive-text: {{ section.settings.tab_inactive_text | default: '#1a1a1a' }};
    --pcs-radius: {{ section.settings.panel_radius | default: 16 }}px;
    --pcs-feature-radius: {{ section.settings.feature_radius | default: 12 }}px;
  }

  .pcs--{{ section.id }} {
    width: 100%;
    background: var(--pcs-bg);
    font-family: var(--pcs-font-body, sans-serif);
    color: var(--pcs-text);
    {% unless section.settings.full_width %}
      max-width: {{ section.settings.section_max_width | default: 1200 }}px;
      margin-inline: auto;
    {% endunless %}
    padding: {{ section.settings.section_padding_top | default: 60 }}px
             {{ section.settings.section_padding_h | default: 24 }}px
             {{ section.settings.section_padding_bottom | default: 60 }}px;
  }

  .pcs--{{ section.id }} .pcs__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: {{ section.settings.header_gap | default: 40 }}px;
    margin-bottom: {{ section.settings.header_mb | default: 40 }}px;
  }

  .pcs--{{ section.id }} .pcs__header-left {
    display: flex;
    align-items: flex-start;
    gap: {{ section.settings.step_gap | default: 20 }}px;
    flex: 1;
  }

  .pcs--{{ section.id }} .pcs__step-number {
    font-family: var(--pcs-font-heading, sans-serif);
    font-size: {{ section.settings.step_number_size | default: 110 }}px;
    font-weight: {{ section.settings.step_number_weight | default: 700 }};
    line-height: 0.85;
    color: var(--pcs-step-number-color);
    letter-spacing: -2px;
    user-select: none;
    flex-shrink: 0;
    font-family: Playfair;
    font-weight: 600;
    font-size: 200px;
    line-height: 50.4px;
    vertical-align: middle;
  }

  .pcs--{{ section.id }} .pcs__header-meta {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: 4px;
  }

  .pcs--{{ section.id }} .pcs__step-label {
    margin: 0 0 4px;
    font-size: {{ section.settings.step_label_size | default: 12 }}px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pcs-text-muted);
    font-family: Montserrat;
    font-weight: 700;
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 0.6px;
    color: #4A5565;
  }

  .pcs--{{ section.id }} .pcs__title {
    margin: 0;
    font-family: var(--pcs-font-heading, sans-serif);
    font-size: {{ section.settings.title_size_desktop | default: 36 }}px;
    font-weight: {{ section.settings.title_weight | default: 700 }};
    line-height: 1.1;
    color: var(--pcs-text);
    font-family: Montserrat;
    font-weight: 500;
    font-size: 30px;
    line-height: 36px;
    letter-spacing: 0.4px;
  }

  .pcs--{{ section.id }} .pcs__header-right {
    max-width: {{ section.settings.header_desc_max_width | default: 300 }}px;
    flex-shrink: 0;
  }

  .pcs--{{ section.id }} .pcs__header-desc {
    margin: 0;
    font-size: {{ section.settings.header_desc_size | default: 15 }}px;
    line-height: 1.6;
    color: var(--pcs-text-muted);
    text-align: left;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.31px;
  }

  .pcs--{{ section.id }} .pcs__tabs-row {
    display: flex;
    align-items: center;
    gap: {{ section.settings.tabs_gap | default: 20 }}px;
    margin-bottom: {{ section.settings.tabs_mb | default: 20 }}px;
  }

  .pcs--{{ section.id }} .pcs__tabs {
    display: flex;
    background: {{ section.settings.tabs_track_bg | default: '#eeebe5' }};
    border-radius: {{ section.settings.tab_radius | default: 50 }}px;
    padding: {{ section.settings.tabs_track_padding | default: 4 }}px;
    gap: 0;
  }

  .pcs--{{ section.id }} .pcs__tab {
    padding: {{ section.settings.tab_padding_v | default: 10 }}px {{ section.settings.tab_padding_h | default: 22 }}px;
    border-radius: {{ section.settings.tab_radius | default: 50 }}px;
    font-family: var(--pcs-font-body, sans-serif);
    font-size: {{ section.settings.tab_font_size | default: 15 }}px;
    font-weight: {{ section.settings.tab_font_weight | default: 500 }};
    background: var(--pcs-tab-inactive-bg);
    color: var(--pcs-tab-inactive-text);
    border: none;
    cursor: pointer;
    transition: background 0.22s ease, color 0.22s ease;
    outline: none;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 13px;
    line-height: 19.5px;
    text-align: center;
  }

  .pcs--{{ section.id }} .pcs__tab[aria-selected="true"],
  .pcs--{{ section.id }} .pcs__tab.is-active {
    background: var(--pcs-tab-active-bg);
    color: var(--pcs-tab-active-text);
  }

  .pcs--{{ section.id }} .pcs__tabs-tagline {
    margin: 0;
    font-size: {{ section.settings.tagline_size | default: 14 }}px;
    color: var(--pcs-text-muted);
    font-family: Montserrat;
    font-weight: 400;
    font-size: 14px;
    line-height: 21.6px;
  }

  .pcs--{{ section.id }} .pcs__panel {
    display: grid;
    grid-template-columns: {{ section.settings.panel_left_width | default: 47 }}% 1fr;
    gap: {{ section.settings.panel_gap | default: 0 }}px;
    background: var(--pcs-panel-bg);
    border-radius: var(--pcs-radius);
    overflow: hidden;
    min-height: {{ section.settings.panel_min_height | default: 560 }}px;
  }

  .pcs--{{ section.id }} .pcs__image-col {
    position: relative;
    background: {{ section.settings.image_col_bg | default: '#e8e4dc' }};
    border-radius: var(--pcs-radius) 0 0 var(--pcs-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .pcs--{{ section.id }} .pcs__slides {
    position: relative;
    flex: 1;
    overflow: hidden;
    margin: 15px 0 15px 15px;
  }

  .pcs--{{ section.id }} .pcs__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .pcs--{{ section.id }} .pcs__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .pcs--{{ section.id }} .pcs__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 10px;
  }

  .pcs--{{ section.id }} .pcs__slide-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: {{ section.settings.slide_placeholder_bg | default: '#ddd8ce' }};
    color: {{ section.settings.slide_placeholder_text | default: '#999' }};
    font-size: 14px;
  }

  .pcs--{{ section.id }} .pcs__hotspot {
    position: absolute;
    width: {{ section.settings.hotspot_size | default: 36 }}px;
    height: {{ section.settings.hotspot_size | default: 36 }}px;
    border-radius: 50%;
    background: var(--pcs-accent);
    color: {{ section.settings.hotspot_text_color | default: '#ffffff' }};
    font-size: {{ section.settings.hotspot_font_size | default: 14 }}px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    transition: transform 0.2s ease, background 0.2s ease;
    transform: translate(-50%, -50%);
  }

  .pcs--{{ section.id }} .pcs__hotspot:hover {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--pcs-accent-hover);
  }

  .pcs--{{ section.id }} .pcs__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.dot_gap | default: 8 }}px;
    padding: {{ section.settings.dot_padding | default: 16 }}px;
    background: transparent;
    flex-shrink: 0;
    position: absolute;
    bottom: 15px;
    left: 0;
    right: 0;
  }

  .pcs--{{ section.id }} .pcs__dot {
    width: {{ section.settings.dot_size | default: 32 }}px;
    height: {{ section.settings.dot_height | default: 4 }}px;
    border-radius: {{ section.settings.dot_radius | default: 4 }}px;
    background: {{ section.settings.dot_inactive_color | default: '#c0bab0' }};
    border: none;
    cursor: pointer;
    transition: background 0.22s ease, width 0.22s ease;
    padding: 0;
  }

  .pcs--{{ section.id }} .pcs__dot.is-active {
    background: var(--pcs-accent);
    width: {{ section.settings.dot_active_width | default: 36 }}px;
  }

  .pcs--{{ section.id }} .pcs__info-col {
    padding: {{ section.settings.info_padding_v | default: 40 }}px {{ section.settings.info_padding_h | default: 40 }}px;
    display: flex;
    flex-direction: column;
  }

  .pcs--{{ section.id }} .pcs__tab-content {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pcs--{{ section.id }} .pcs__product-title {
    margin: 0 0 {{ section.settings.product_title_mb | default: 12 }}px;
    font-family: var(--pcs-font-heading, sans-serif);
    font-size: {{ section.settings.product_title_size | default: 30 }}px;
    font-weight: {{ section.settings.product_title_weight | default: 700 }};
    line-height: 1.15;
    color: var(--pcs-text);
    font-family: Montserrat;
    font-weight: 500;
    font-size: 30px;
    line-height: 36px;
    letter-spacing: 0.4px;
  }

  .pcs--{{ section.id }} .pcs__product-desc {
    margin: 0 0 {{ section.settings.product_desc_mb | default: 24 }}px;
    font-size: {{ section.settings.product_desc_size | default: 15 }}px;
    line-height: 1.6;
    color: var(--pcs-text-muted);
    max-width: 56ch;
    font-family: Montserrat;
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.31px;
  }

  .pcs--{{ section.id }} .pcs__features {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.feature_gap | default: 12 }}px;
    margin-bottom: {{ section.settings.features_mb | default: 28 }}px;
  }

  .pcs--{{ section.id }} .pcs__feature {
    display: grid;
    grid-template-columns: {{ section.settings.feature_img_size | default: 116 }}px 1fr {{ section.settings.badge_size | default: 36 }}px;
    align-items: center;
    gap: {{ section.settings.feature_inner_gap | default: 16 }}px;
    background: var(--pcs-feature-bg);
    border-radius: var(--pcs-feature-radius);
    padding: 0 20px 0 0;
    border: 1px solid {{ section.settings.feature_border_color | default: '#eeebe5' }};
  }

  .pcs--{{ section.id }} .pcs__feature-img {
    width: {{ section.settings.feature_img_size | default: 116 }}px;
    height: {{ section.settings.feature_img_height | default: 116 }}px;
    border-radius: {{ section.settings.feature_img_radius | default: 8 }}px;
    overflow: hidden;
    flex-shrink: 0;
    background: {{ section.settings.feature_img_placeholder_bg | default: '#e8e4dc' }};
  }

  .pcs--{{ section.id }} .pcs__feature-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pcs--{{ section.id }} .pcs__feature-img-placeholder {
    width: 100%;
    height: 100%;
    background: {{ section.settings.feature_img_placeholder_bg | default: '#e8e4dc' }};
  }

  .pcs--{{ section.id }} .pcs__feature-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

