    { "type": "range", "id": "section_max_width", "min": 800, "max": 1800, "step": 50, "label": "Section max width (px)", "default": 1200 },

    { "type": "header", "content": "Padding (desktop)" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding top (px)", "default": 80 },
    { "type": "range", "id": "padding_right_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding right (px)", "default": 20 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding bottom (px)", "default": 80 },
    { "type": "range", "id": "padding_left_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding left (px)", "default": 20 },

    { "type": "header", "content": "Padding (mobile)" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 180, "step": 5, "label": "Padding top (px)", "default": 60 },
    { "type": "range", "id": "padding_right_mobile", "min": 0, "max": 180, "step": 5, "label": "Padding right (px)", "default": 15 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 180, "step": 5, "label": "Padding bottom (px)", "default": 60 },
    { "type": "range", "id": "padding_left_mobile", "min": 0, "max": 180, "step": 5, "label": "Padding left (px)", "default": 15 },

    { "type": "header", "content": "Title" },
    { "type": "text", "id": "title", "label": "Title", "default": "Frequently Asked Questions" },
    {
      "type": "select",
      "id": "title_align",
      "label": "Title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "title_margin_bottom", "min": 0, "max": 80, "step": 2, "label": "Title margin bottom (px)", "default": 34 },
    {
      "type": "select",
      "id": "font_title",
      "label": "Font family: Title",
      "options": [
        { "value": "Montserrat", "label": "Montserrat" },
        { "value": "Roboto", "label": "Roboto" },
        { "value": "Helvetica Neue", "label": "Helvetica Neue" },
        { "value": "Playfair Display", "label": "Playfair Display" }
      ],
      "default": "Montserrat"
    },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#111111" },
    { "type": "range", "id": "title_size_desktop", "min": 18, "max": 70, "step": 2, "label": "Title size desktop (px)", "default": 40 },
    { "type": "range", "id": "title_size_mobile", "min": 16, "max": 48, "step": 2, "label": "Title size mobile (px)", "default": 28 },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    { "type": "range", "id": "title_line_height", "min": 1, "max": 2, "step": 0.1, "label": "Title line height", "default": 1.2 },
    { "type": "range", "id": "title_letter_spacing", "min": -2, "max": 6, "step": 0.1, "label": "Title letter spacing (px)", "default": 0 },

    { "type": "header", "content": "Rows / borders" },
    { "type": "color", "id": "item_border_color", "label": "Border color", "default": "#e6e1d9" },
    { "type": "range", "id": "item_border_width", "min": 0, "max": 4, "step": 1, "label": "Border width (px)", "default": 1 },
    { "type": "range", "id": "row_padding_y_desktop", "min": 10, "max": 40, "step": 1, "label": "Row padding Y desktop (px)", "default": 18 },
    { "type": "range", "id": "row_padding_x_desktop", "min": 0, "max": 60, "step": 1, "label": "Row padding X desktop (px)", "default": 0 },
    { "type": "range", "id": "row_padding_y_mobile", "min": 10, "max": 40, "step": 1, "label": "Row padding Y mobile (px)", "default": 16 },
    { "type": "range", "id": "row_padding_x_mobile", "min": 0, "max": 40, "step": 1, "label": "Row padding X mobile (px)", "default": 0 },
    { "type": "range", "id": "items_gap", "min": 0, "max": 30, "step": 1, "label": "Extra gap between items (px)", "default": 0 },

    { "type": "header", "content": "Question typography" },
    {
      "type": "select",
      "id": "font_question",
      "label": "Font family: Question",
      "options": [
        { "value": "Montserrat", "label": "Montserrat" },
        { "value": "Roboto", "label": "Roboto" },
        { "value": "Helvetica Neue", "label": "Helvetica Neue" },
        { "value": "Playfair Display", "label": "Playfair Display" }
      ],
      "default": "Montserrat"
    },
    { "type": "color", "id": "question_color", "label": "Question color", "default": "#111111" },
    { "type": "range", "id": "question_size_desktop", "min": 12, "max": 24, "step": 1, "label": "Question size desktop (px)", "default": 13 },
    { "type": "range", "id": "question_size_mobile", "min": 12, "max": 22, "step": 1, "label": "Question size mobile (px)", "default": 13 },
    {
      "type": "select",
      "id": "question_weight",
      "label": "Question weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" }
      ],
      "default": "500"
    },
    { "type": "range", "id": "question_line_height", "min": 1, "max": 2.2, "step": 0.1, "label": "Question line height", "default": 1.3 },
    { "type": "range", "id": "question_letter_spacing", "min": -1, "max": 4, "step": 0.1, "label": "Question letter spacing (px)", "default": 0 },

    { "type": "header", "content": "Answer typography" },
    {
      "type": "select",
      "id": "font_answer",
      "label": "Font family: Answer",
      "options": [
        { "value": "Montserrat", "label": "Montserrat" },
        { "value": "Roboto", "label": "Roboto" },
        { "value": "Helvetica Neue", "label": "Helvetica Neue" },
        { "value": "Playfair Display", "label": "Playfair Display" }
      ],
      "default": "Montserrat"
    },
    { "type": "color", "id": "answer_color", "label": "Answer color", "default": "#4b4b4b" },
    { "type": "range", "id": "answer_size_desktop", "min": 12, "max": 22, "step": 1, "label": "Answer size desktop (px)", "default": 13 },
    { "type": "range", "id": "answer_size_mobile", "min": 12, "max": 20, "step": 1, "label": "Answer size mobile (px)", "default": 13 },
    {
      "type": "select",
      "id": "answer_weight",
      "label": "Answer weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    { "type": "range", "id": "answer_line_height", "min": 1, "max": 2.6, "step": 0.1, "label": "Answer line height", "default": 1.6 },
    { "type": "range", "id": "answer_letter_spacing", "min": -1, "max": 4, "step": 0.1, "label": "Answer letter spacing (px)", "default": 0 },
    { "type": "range", "id": "answer_max_width", "min": 300, "max": 1200, "step": 10, "label": "Answer max width (px)", "default": 920 },

    { "type": "header", "content": "Icon" },
    { "type": "checkbox", "id": "show_icon", "label": "Show plus icon", "default": true },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#111111" },
    { "type": "range", "id": "icon_size", "min": 10, "max": 26, "step": 1, "label": "Icon size (px)", "default": 14 },
    { "type": "range", "id": "icon_stroke", "min": 1, "max": 4, "step": 1, "label": "Icon stroke (px)", "default": 2 },

    { "type": "header", "content": "Behavior" },
    { "type": "checkbox", "id": "one_open_only", "label": "Only one open at a time", "default": true },
    { "type": "checkbox", "id": "open_first_item", "label": "Open first item on load", "default": false }
