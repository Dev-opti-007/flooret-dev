{%- liquid
  assign s = section.settings
-%}

<section
  id="FaqAcc-{{ section.id }}"
  class="faqacc"
  style="
    --faq-bg: {{ s.section_bg }};
    --faq-max: {{ s.section_max_width }}px;

    --faq-pt: {{ s.padding_top_desktop }}px;
    --faq-pr: {{ s.padding_right_desktop }}px;
    --faq-pb: {{ s.padding_bottom_desktop }}px;
    --faq-pl: {{ s.padding_left_desktop }}px;

    --faq-pt-m: {{ s.padding_top_mobile }}px;
    --faq-pr-m: {{ s.padding_right_mobile }}px;
    --faq-pb-m: {{ s.padding_bottom_mobile }}px;
    --faq-pl-m: {{ s.padding_left_mobile }}px;

    --faq-title-c: {{ s.title_color }};
    --faq-title-s: {{ s.title_size_desktop }}px;
    --faq-title-s-m: {{ s.title_size_mobile }}px;
    --faq-title-w: {{ s.title_weight }};
    --faq-title-lh: {{ s.title_line_height }};
    --faq-title-ls: {{ s.title_letter_spacing }}px;

    --faq-item-bd: {{ s.item_border_color }};
    --faq-item-bw: {{ s.item_border_width }}px;

    --faq-q-c: {{ s.question_color }};
    --faq-q-s: {{ s.question_size_desktop }}px;
    --faq-q-s-m: {{ s.question_size_mobile }}px;
    --faq-q-w: {{ s.question_weight }};
    --faq-q-lh: {{ s.question_line_height }};
    --faq-q-ls: {{ s.question_letter_spacing }}px;

    --faq-a-c: {{ s.answer_color }};
    --faq-a-s: {{ s.answer_size_desktop }}px;
    --faq-a-s-m: {{ s.answer_size_mobile }}px;
    --faq-a-w: {{ s.answer_weight }};
    --faq-a-lh: {{ s.answer_line_height }};
    --faq-a-ls: {{ s.answer_letter_spacing }}px;

    --faq-row-py: {{ s.row_padding_y_desktop }}px;
    --faq-row-px: {{ s.row_padding_x_desktop }}px;
    --faq-row-py-m: {{ s.row_padding_y_mobile }}px;
    --faq-row-px-m: {{ s.row_padding_x_mobile }}px;

    --faq-gap: {{ s.items_gap }}px;

    --faq-icon-c: {{ s.icon_color }};
    --faq-icon-s: {{ s.icon_size }}px;
    --faq-icon-w: {{ s.icon_stroke }}px;
  "
>
  <div class="faqacc__wrap {% unless s.full_width %}faqacc__wrap--contained{% endunless %}">
    {%- if s.title != blank -%}
      <h2 class="faqacc__title">{{ s.title }}</h2>
    {%- endif -%}

    <div class="faqacc__items" data-faqacc="{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'item' -%}
          <details class="faqacc__item" {{ block.shopify_attributes }}>
            <summary class="faqacc__summary">
              <span class="faqacc__q">{{ block.settings.question }}</span>

              {%- if s.show_icon -%}
                <span class="faqacc__icon" aria-hidden="true"></span>
              {%- endif -%}
            </summary>

            <div class="faqacc__panel">
              <div class="faqacc__a rte">
                {{ block.settings.answer }}
              </div>
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #FaqAcc-{{ section.id }}{
    background: var(--faq-bg);
    padding: var(--faq-pt) var(--faq-pr) var(--faq-pb) var(--faq-pl);
  }
  #FaqAcc-{{ section.id }} .faqacc__wrap--contained{
    max-width: var(--faq-max);
    margin: 0 auto;
  }

  #FaqAcc-{{ section.id }} .faqacc__title{
    margin: 0 0 {{ s.title_margin_bottom }}px;
    text-align: {{ s.title_align }};
    color: var(--faq-title-c);
    font-size: var(--faq-title-s);
    font-weight: var(--faq-title-w);
    line-height: var(--faq-title-lh);
    letter-spacing: var(--faq-title-ls);
    font-family: {{ s.font_title | json }};
  }

  #FaqAcc-{{ section.id }} .faqacc__items{
    border-top: var(--faq-item-bw) solid var(--faq-item-bd);
  }

  #FaqAcc-{{ section.id }} .faqacc__item{
    border-bottom: var(--faq-item-bw) solid var(--faq-item-bd);
    padding: 0;
    margin: 0;
  }

  #FaqAcc-{{ section.id }} .faqacc__summary{
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: var(--faq-row-py) var(--faq-row-px);
  }

  #FaqAcc-{{ section.id }} .faqacc__summary::-webkit-details-marker{ display:none; }

  #FaqAcc-{{ section.id }} .faqacc__q{
    color: var(--faq-q-c);
    font-size: var(--faq-q-s);
    font-weight: var(--faq-q-w);
    line-height: var(--faq-q-lh);
    letter-spacing: var(--faq-q-ls);
    font-family: {{ s.font_question | json }};
  }

  #FaqAcc-{{ section.id }} .faqacc__icon{
    width: var(--faq-icon-s);
    height: var(--faq-icon-s);
    position: relative;
    flex: 0 0 auto;
  }

  /* plus sign */
  #FaqAcc-{{ section.id }} .faqacc__icon::before,
  #FaqAcc-{{ section.id }} .faqacc__icon::after{
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 100%;
    height: var(--faq-icon-w);
    background: var(--faq-icon-c);
    transform: translate(-50%, -50%);
    border-radius: 2px;
  }
  #FaqAcc-{{ section.id }} .faqacc__icon::after{
    transform: translate(-50%, -50%) rotate(90deg);
    transition: transform .18s ease, opacity .18s ease;
  }

  /* open state -> turn plus into minus */
  #FaqAcc-{{ section.id }} details[open] .faqacc__icon::after{
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  #FaqAcc-{{ section.id }} .faqacc__panel{
    padding: 0 var(--faq-row-px) var(--faq-row-py);
  }

  #FaqAcc-{{ section.id }} .faqacc__a{
    color: var(--faq-a-c);
    font-size: var(--faq-a-s);
    font-weight: var(--faq-a-w);
    line-height: var(--faq-a-lh);
    letter-spacing: var(--faq-a-ls);
    font-family: {{ s.font_answer | json }};
    max-width: {{ s.answer_max_width }}px;
  }

  #FaqAcc-{{ section.id }} .faqacc__a p{ margin: 0 0 10px; }
  #FaqAcc-{{ section.id }} .faqacc__a p:last-child{ margin-bottom: 0; }

  @media (max-width: 749px){
    #FaqAcc-{{ section.id }}{
      padding: var(--faq-pt-m) var(--faq-pr-m) var(--faq-pb-m) var(--faq-pl-m);
    }

    #FaqAcc-{{ section.id }} .faqacc__title{ font-size: var(--faq-title-s-m);text-wrap: auto; }

    #FaqAcc-{{ section.id }} .faqacc__summary{
      padding: var(--faq-row-py-m) var(--faq-row-px-m);
    }

    #FaqAcc-{{ section.id }} .faqacc__q{ font-size: var(--faq-q-s-m); }
    #FaqAcc-{{ section.id }} .faqacc__panel{
      padding: 0 var(--faq-row-px-m) var(--faq-row-py-m);
    }
    #FaqAcc-{{ section.id }} .faqacc__a{ font-size: var(--faq-a-s-m); }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var root = document.querySelector('#FaqAcc-{{ section.id }}');
  if (!root) return;

  var container = root.querySelector('[data-faqacc="{{ section.id }}"]');
  if (!container) return;

  {% if s.one_open_only %}
    // Keep only one <details> open at a time
    container.addEventListener('toggle', function (e) {
      if (e.target.tagName !== 'DETAILS') return;
      if (!e.target.open) return;

      container.querySelectorAll('details[open]').forEach(function (el) {
        if (el !== e.target) el.removeAttribute('open');
      });
    }, true);
  {% endif %}

  {% if s.open_first_item %}
    var first = container.querySelector('details');
    if (first) first.setAttribute('open', 'open');
  {% endif %}
});
</script>

{% schema %}
{
  "name": "FAQ (Advanced)",
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full width section", "default": false },

    { "type": "header", "content": "Background & container" },
