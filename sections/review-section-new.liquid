<style>
    @media (max-width:991px){
  /* Hide desktop slider */
  .rating-slide-homepage-new .slider { display: none !important; }
  
  /* Page width = marquee container */
  .rating-slide-homepage-new .page-width {
    padding: 5px 15px;
    min-height: 49px;
    overflow: hidden;
  }
  
  /* Mobile review = scrolling marquee */
  .mobile-review {
    display: block !important;
    overflow: hidden;
    width: 100%;
  }
  
  /* Each marquee-content = full unit (left + reviews + right) */
  .mobile-review .marquee-content {
    display: inline-flex !important;
    align-items: center;
    gap: 20px;
    white-space: nowrap;
    animation: marquee-right-to-left 70s linear infinite;
  }
  
  /* All text prevents wrapping */
  .left-content, .right-content, .mob-r, .no-slide, .person-name {
    white-space: nowrap !important;
    flex-shrink: 0;
  }
  
  /* Mobile typography */
  .page-width .left-content .no-slide { font-size: 10px; }
  .page-width .left-content .no-slide b { font-size: 12px; }
  .page-width .right-content .no-slide.first p { 
    font-weight: 700; font-size: 12px; letter-spacing: -4%; 
  }
  .page-width .right-content .no-slide.last p { 
    font-weight: 400; font-size: 10px; 
  }
  .mobile-review .mob-r p { 
    font-weight: 500; font-size: 12px; letter-spacing: -4%;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }
  .mobile-review .person-name { 
    font-weight: 700; font-size: 12px; letter-spacing: -4%; 
  }
  
  /* Stars spacing */
  .stars { margin-left: 5px; margin-right: 5px; gap: 2px; }
  
  /* Pause on hover */
  .mobile-review:hover .marquee-content {
    {% comment %} animation-play-state: paused; {% endcomment %}
  }
  
  /* CONTINUOUS right→left animation */
  @keyframes marquee-right-to-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-84%); }
  }
}

</style>

