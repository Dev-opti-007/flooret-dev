<div class="rating-slide-homepage-new" style="background:{{ section.settings.bg-color }}">

  <div class="page-width" > 
        <div class="left-content">
                <div class="no-slide">
                {{ section.settings.rating-text }}
            </div>
        </div>
        <div class="slider" id="rmMobile">
            {% for block in section.blocks %}
                <div class="slide" >
                    {{ block.settings.text }}<span class="person-name"> - {{ block.settings.person-name-text }}</span>
                </div>
            {% endfor %}
        </div>
     
          <div class="right-content">
            <div class="no-slide first">
                {{ section.settings.right-text-one }}
            </div>
            <div class="stars">
                      {% render 'star' %}
                      {% render 'star' %}
                      {% render 'star' %}
                      {% render 'star' %}
                      {% render 'star' %}
                    </div>
            <div class="no-slide last">
                {{ section.settings.right-text-two }}
            </div>
          </div>
          <div class="mobile-review">
                {% comment %} FIRST LOOP: left + right + reviews {% endcomment %}
                <div class="marquee-content">
                    <div class="left-content">
                      <div class="no-slide">{{ section.settings.rating-text }}</div>
                      </div>
                      
                    <div class="right-content">
                      <div class="no-slide first">{{ section.settings.right-text-one }}</div>
                      <div class="stars">
                        {% render 'star' %}
                        {% render 'star' %}
                        {% render 'star' %}
                        {% render 'star' %}
                        {% render 'star' %}
                      </div>
                      <div class="no-slide last">{{ section.settings.right-text-two }}</div>
                    </div>

                    {% for block in section.blocks %}
                    <div class="mob-r">{{ block.settings.text }}<span class="person-name"> - {{ block.settings.person-name-text }}</span></div>
                    {% endfor %}
                    
                </div>
                

    
  </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', ()=>{
    $('.slider').slick({
        infinite: true,
        slidesToShow: 1,
        slidesToScroll: 1,
        autoplay: true,
        autoplaySpeed: 8000,
        dots: false,
        arrows:false
      });
  })
</script>

