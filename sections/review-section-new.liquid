{% schema %}
  {
    "name": "Rating Section New",
    "settings": [
      {
        "type": "header",
        "content": "Slider Max Height"
      },
      {
        "type": "range",
        "id": "slider-height-desk",
        "label": "Slider Height Desktop",
        "min": 10,
        "max": 110,
        "step": 1,
        "default": 100
      },
      {
        "type": "range",
        "id": "slider-height-mob",
        "label": "Slider Height Mobile",
        "min": 10,
        "max": 110,
        "step": 1,
        "default": 50
      },
      {
          "type": "html",
          "id": "bg-color",
          "label":"Background-color"
      },
      {
        "type": "header",
        "content": "Left Content"
      },
      {
        "type": "html",
        "id": "rating-text",
        "label": "Rating Text"
      },
      {
        "type": "header",
        "content": "Middle Content"
      },
      {
        "type": "richtext",
        "id": "right-text-one",
        "label": "Right Slide Text One"
      },
      {
        "type": "richtext",
        "id": "right-text-two",
        "label": "Right Slide Text Two"
      },
      {
        "type": "header",
        "content": "Right Content",
        "info": "For right content slider add blocks."
      }
    ],
    "blocks": [
        {
            "type": "slider-text",
            "name":"Slider Text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "Text"
                },
                {
                    "type": "text",
                    "id":"person-name-text",
                    "label":"Person name text"
                }
            ]
        }
    ],
    "presets": [
      {
        "name": "Rating Section New"
      }
    ]
  }
{% endschema %}