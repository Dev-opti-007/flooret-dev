    .mobile-review .mob-r,
    .mobile-review .mob-r p,
    .mobile-review .mob-r .person-name{
      white-space: nowrap;
    }

    /* each slide sizes to its content so the ticker is smooth */
    .mobile-review .slick-slide{
      width: auto !important;
    }

    .mobile-review .mob-r{
      display:inline-flex !important;
      align-items:center;
      gap: 8px;
