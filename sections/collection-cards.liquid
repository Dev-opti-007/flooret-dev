{% assign _settings = section.settings %}
{% assign _cards = section.blocks %}

<style>
  .hide-mobile {
    display: none;
  }

  .collection-cards .collection-card-row .collection-card:last-child {
    margin-top: 0;
  }

  .our-collection-box {
    margin-top: 24px 40px 24px 40px;
  }

  .our-collection-box .gradient {
    background: linear-gradient(0deg, #312727, transparent) !important;
  }

  .shopify-section.bg-section+.shopify-section:not(.bg-section) {
    margin-top: 0px;
  }

  .our-collection-section {
    padding-top: 28px;
  }

  .hide-mobile {
    margin: 0;
    display: block;
    font-size: 64px;
    text-align: center;
    margin-bottom: 28px !important;
    font-family: "Playfair Display";
  }

  .our-collection-container {
    width: 100%;
    height: 440px;
    display: flex;
    position: relative;
    padding-bottom: 0px !important;
  }

  .collection-cards .overlay {
    top: 0;
    height: 65%;
    bottom: auto;
  }

  .our-collection-card-description {
    font-weight: 700;
    font-size: 16px;
    margin-top: 24px;
    line-height: 150%;
    letter-spacing: 0;
    font-family: "Montserrat";
    white-space: nowrap
  }

  .collection-cards .collection-card-row .collection-card__content .h4 {
    font-family: "Playfair Display";
  }

  .our-collection-card-btns .btn {
    white-space: nowrap;
  }

  .our-collection-overlay {
    height: 650px !important;
  }

  {% comment %} Width control when happen hover event {% endcomment %}

  .our-collection-box {
    flex: 1; /* Equal space initially */
    height: 440px;
    overflow: hidden;
    border-radius: 8px;
    transition: flex 0.4s ease-in-out;
  }

  .our-collection-box:hover {
    flex: 1.5; /* Expand on hover */
  }

  .our-collection-container:hover .our-collection-box:not(:hover) {
    flex: 0.75; /* Shrink others */
  }

  {% comment %} Title & Button animation when happen hover event. {% endcomment %}

  .our-collection-card-subscription {
    left: 32px;
    z-index: 2;
    bottom: 32px;
    color: #fff;
    position: absolute;
    transition: bottom 0.3s ease-in-out;
  }

  .our-collection-card-subscription .h4 {
    font-size: 36px;
    font-weight: 800;
    line-height: 100%;
    letter-spacing: 0%;
  }

  .our-collection-card-btns {
    opacity: 0;
    transition-delay: 0.2s;
    transition: opacity 0.3s ease-in-out 0.2s cubic-bezier(1,-0.5,.1,.1);
  }

  .our-collection-container .our-collection-box:hover .our-collection-card-btns {
    opacity: 1;
  }


  .our-collection-container .our-collection-box:not(:hover) .our-collection-card-btns {
    transition: opacity 0s; /* Instant fade-out */
  }

  .our-collection-container .our-collection-box:hover .our-collection-card-subscription {
    bottom: 84px;
  }

  {% comment %} Image scale animation when happen hover event. {% endcomment %}

  .our-collection-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease-in-out;
  }

  /* First Image - Scale in X direction */
  .our-collection-box:first-child img {
    transform-origin: center;
  }

  .our-collection-box:first-child:hover img {
    transform: scaleX(1.2);
  }

  /* Second Image - Scale from center */
  .our-collection-box:nth-child(2) img {
    transform-origin: center center;
  }

  .our-collection-box:nth-child(2):hover img {
    transform: scale(1.2);
  }  

  /* Third Image - Scale focus on right center */
  .our-collection-box:last-child img {
    transform-origin: right center;
  }
  
  .our-collection-box:last-child:hover img {
    transform: scale(1.2);
  }

  @media (max-width: 730px) {
    .our-collection-card-primary-btn, .our-collection-card-btn {
      font-size: 10px !important;
    }
  }

  @media (max-width: 640px) {
    .our-collection-overlay .collection-card__content {
      padding: 8px !important;
    }
  }

  .our-collection-container #our-collection-box {
    width: 44%;
    margin: 0 2vw !important;
  }

  .collection-cards .collection-card-row {
    margin: 0 -2%;
  }

  @media (max-width: 960px) {
    .our-collection-section .container {
      max-width: none !important;
    }
  
    .our-collection-card-primary-btn, .our-collection-card-btn {
      font-size: 12px !important;
    }

    .our-collection-container {
      -ms-overflow-style: none;
      scrollbar-width: none;
      display: grid !important;
      overflow: auto;
      grid-auto-flow:column;
      gap: 4px;
    }
    .our-collection-box {
      aspect-ratio: 3 / 4;
      max-height: 440px;
      min-height: unset !important;
      max-width: 360px !important;
      width: 100% !important;
    }
    .our-collection-container::-webkit-scrollbar {
      display: none;
    }
    .our-collection-section .hide-mobile {
      font-size: 7vw !important;
      text-align: left;
      padding-left: 12px;
    }

    .our-collection-box {
      min-width: 285px;
    }
    .our-collection-card-btn, .our-collection-card-primary-btn {
      width: unset !important;
    }
  }

  @media (max-width: 600px) {
    .our-collection-section .hide-mobile {
      font-size: 44px !important;
    }
    
    .our-collection-container .our-collection-box .our-collection-card-btns {
      opacity: 1 !important;
    }

    .our-collection-container .our-collection-box .our-collection-card-subscription {
      bottom: 84px !important;
    }

    .our-collection-card-subscription {
      left: 1em !important;
    }
  }

  @media (max-width: 600px) {
    .our-collection-section .hide-mobile {
      font-size: 34px !important;
    }

    .our-collection-section .collection-card__content {
      padding: 2em 1em !important;
    }
  }

  @media (max-width: 560px) {
    .our-collection-box {
      width: 340px !important;
    }
  }

  @media (max-width: 450px) {
    .our-collection-box {
      width: 314px !important;
    }
  }
</style>

<section class="our-collection-section">
  <div class="overlay our-collection-overlay"></div>
  <div class="container">
    <h2 class="hide-mobile">{{ _settings.heading }}</h2>
    {% if _cards != blank %}
      <div class="collection-card-row our-collection-container">
        {% for block in _cards %}
          <div id="our-collection-box" class="collection-card our-collection-box f-{{ block.id }}">
            <div class="gradient"></div>

            <div class="positioner">
              {% render 'lazy-image', image: block.settings.image, width: '650' %}
              <div class="collection-card__content">
                <div class="our-collection-card-subscription">
                  <span class="h4">{{ block.settings.card_title }}</span>
                  <span class="our-collection-card-description">{{ block.settings.card_description }}</span>
                </div>
                <div class="our-collection-card-btns collection-card-btns">
                  {% if block.settings.link_text_1 != blank and block.settings.link_url_1 != blank %}
                    <a
                      href="{{ block.settings.link_url_1 }}"
                      class="btn btn--outline-white our-collection-card-btn"
                    >
                      {{- block.settings.link_text_1 -}}
                    </a>
                  {% endif %}

                  {% if block.settings.link_text_2 != blank and block.settings.link_url_2 != blank %}
                    <a
                      href="{{ block.settings.link_url_2 }}"
                      class="btn btn--primary btn--white our-collection-card-primary-btn"
                    >
                      {{- block.settings.link_text_2 -}}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
          <style>
            .collection-cards .f-{{ block.id }} .our-collection-card-subscription span.h4 {
              {% if block.settings.font-selction == 'Playfair Display' %}
                font-family:"Playfair Display";
              {% endif %}
              {% if block.settings.font-selction == 'Montserrat' %}
                font-family:Montserrat;
              {% endif %}
                font-weight:{{ block.settings.font-weight }};
                font-size:{{ block.settings.font-size }}px;
            }
            .collection-cards .f-{{ block.id }} .our-collection-card-description {
              {% if block.settings.font-selction-desc == 'Playfair Display' %}
                font-family:"Playfair Display";
              {% endif %}
              {% if block.settings.font-selction-desc == 'Montserrat' %}
                font-family:Montserrat;
              {% endif %}
                font-weight:{{ block.settings.font-weight-desc }};
                font-size:{{ block.settings.font-size-desc }}px;
            }
            .collection-cards .f-{{ block.id }} .our-collection-card-btns.collection-card-btns a {
              {% if block.settings.font-selction-btn == 'Playfair Display' %}
                font-family:"Playfair Display";
              {% endif %}
              {% if block.settings.font-selction-btn == 'Montserrat' %}
                font-family:Montserrat;
              {% endif %}
                font-weight:{{ block.settings.font-weight-btn }};
                font-size:{{ block.settings.font-size-btn }}px !important;
            }
          </style
        >
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
  {
    "name": "Collection Cards",
    "class": "shopify-block collection-cards",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      }
    ],
    "blocks": [
      {
        "name": "Card",
        "type": "Card",
        "settings": [
          {
            "type": "header",
            "content": "Title Settings"
          },
          {
            "type": "select",
            "id":"font-selction",
            "label": "Font Family for Title",
            "options": [
              {
                "value": "Playfair Display",
                "label": "Playfair Display"
              },
              {
                "value": "Montserrat",
                "label": "Montserrat"
              }
            ],
            "default": "Playfair Display"
          },
          {
            "type": "range",
            "id": "font-weight",
            "min": 100,
            "max": 800,
            "step": 100,
            "label": "Font Weight",
            "default": 800
          },
           {
            "type": "range",
            "id": "font-size",
            "min": 10,
            "max": 100,
            "step": 1,
            "label": "Font Size",
            "default": 36
          },  
          {
            "type": "text",
            "id": "card_title",
            "label": "Title"
          },
          {
            "type": "header",
            "content": "Description Settings"
          },
          {
            "type": "select",
            "id":"font-selction-desc",
            "label": "Font Family for Title",
            "options": [
              {
                "value": "Playfair Display",
                "label": "Playfair Display"
              },
              {
                "value": "Montserrat",
                "label": "Montserrat"
              }
            ],
            "default": "Playfair Display"
          },
          {
            "type": "range",
            "id": "font-weight-desc",
            "min": 100,
            "max": 800,
            "step": 100,
            "label": "Font Weight",
            "default": 700
          },
           {
            "type": "range",
            "id": "font-size-desc",
            "min": 10,
            "max": 100,
            "step": 1,
            "label": "Font Size",
            "default": 16
          },  
          {
            "type": "text",
            "id": "card_description",
            "label": "Description"
          },
          {
            "type": "header",
            "content": "Button Settings"
          },
          {
            "type": "select",
            "id":"font-selction-btn",
            "label": "Font Family for Title",
            "options": [
              {
                "value": "Playfair Display",
                "label": "Playfair Display"
              },
              {
                "value": "Montserrat",
                "label": "Montserrat"
              }
            ],
            "default": "Montserrat"
          },
          {
            "type": "range",
            "id": "font-weight-btn",
            "min": 100,
            "max": 800,
            "step": 100,
            "label": "Font Weight",
            "default": 500
          },
           {
            "type": "range",
            "id": "font-size-btn",
            "min": 10,
            "max": 100,
            "step": 1,
            "label": "Font Size",
            "default": 12
          },
          {
            "type": "text",
            "id": "link_text_1",
            "label": "Link Text 1"
          },
          {
            "type": "url",
            "id": "link_url_1",
            "label": "Link URL 1"
          },
          {
            "type": "text",
            "id": "link_text_2",
            "label": "Link Text 2"
          },
          {
            "type": "url",
            "id": "link_url_2",
            "label": "Link URL 2"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Collection Cards",
        "category": "Cards"
      }
    ]
  }
{% endschema %}
