<section class="flooring-selector-section">
  <div class="page-width">
    <div class="flooring-selector-header">
      {% if section.settings.heading != blank %}
        <h2 class="flooring-selector-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="flooring-selector-subheading">
          {{ section.settings.subheading }}
        </div>
      {% endif %}
    </div>

    <!-- Desktop Selector -->
    <div class="flooring-selector-tabs">
      {% for block in section.blocks %}
        <button
          class="selector-tab {% if forloop.first %}active{% endif %}"
          data-tab="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
          <span class="selector-quote-mark">“</span>

          <div class="selector-tab-text">
            {{ block.settings.selector_text }}
          </div>
        </button>
      {% endfor %}
    </div>

    <!-- Desktop Content -->
    <div class="flooring-selector-content">
      {% for block in section.blocks %}
        <div
          class="selector-content-item {% if forloop.first %}active{% endif %}"
          data-content="{{ block.id }}"
        >
          <div class="selector-hero">
            {% if block.settings.background_image %}
              <img
                src="{{ block.settings.background_image | image_url: width: 2500 }}"
                alt="{{ block.settings.title }}"
                loading="lazy"
              >
            {% endif %}

            <div class="selector-overlay"></div>

            <div class="selector-hero-content">
              <h3 class="selector-title">
                {{ block.settings.title }}
              </h3>

              <div class="selector-description">
                {{ block.settings.description }}
              </div>

              {% if block.settings.characteristics != blank %}
                <div class="selector-characteristics">
                  {{ block.settings.characteristics }}
                </div>
              {% endif %}

              <div class="selector-buttons">
                {% if block.settings.primary_button_text != blank %}
                  <a
                    href="{{ block.settings.primary_button_link }}"
                    class="selector-btn selector-btn-primary"
                  >
                    {{ block.settings.primary_button_text }}
                  </a>
                {% endif %}

                {% if block.settings.secondary_button_text != blank %}
                  <a
                    href="{{ block.settings.secondary_button_link }}"
                    class="selector-btn selector-btn-secondary"
                  >
                    {{ block.settings.secondary_button_text }}
                  </a>
                {% endif %}
              </div>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Mobile Accordion -->

    <!-- Mobile Accordion -->
<div class="mobile-selector-accordion mobile-only">

  {% for block in section.blocks %}

    <div class="mobile-selector-item">

      <button
        class="mobile-selector-trigger {% if forloop.first %}active{% endif %}"
      >

        <span class="mobile-trigger-text">
          {{ block.settings.selector_text }}
        </span>

        <span class="mobile-trigger-icon">
          <svg
            width="12"
            height="7"
            viewBox="0 0 12 7"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M9.66431 1.41418L5.53931 5.53918L1.41431 1.41418"
              stroke="#212121"
              stroke-width="2"
              stroke-miterlimit="10"
              stroke-linecap="square"
            />
          </svg>
        </span>

      </button>

      <div
        class="mobile-selector-panel {% if forloop.first %}active{% endif %}"
      >

        <div class="mobile-selector-card">

          {% if block.settings.background_image %}
            <img
              src="{{ block.settings.background_image | image_url: width: 1200 }}"
              alt="{{ block.settings.title }}"
              loading="lazy"
            >
          {% endif %}

          <div class="mobile-selector-overlay"></div>

          <div class="mobile-selector-card-content">

            <div class="mobile-selector-title">
              {{ block.settings.title }}
            </div>

            <div class="mobile-selector-description">
              {{ block.settings.description }}
            </div>

            {% if block.settings.characteristics != blank %}
              <div class="mobile-selector-characteristics">
                {{ block.settings.characteristics }}
              </div>
            {% endif %}

            {% if block.settings.primary_button_text != blank %}
              <a
                href="{{ block.settings.primary_button_link }}"
                class="mobile-selector-btn"
              >
                {{ block.settings.primary_button_text }}
              </a>
            {% endif %}

            {% if block.settings.secondary_button_text != blank %}
              <a
                href="{{ block.settings.secondary_button_link }}"
                class="mobile-selector-secondary-btn"
              >
                {{ block.settings.secondary_button_text }}
              </a>
            {% endif %}

          </div>

        </div>

      </div>

    </div>

  {% endfor %}

</div>
  </div>
</section>

