<script>
  document.addEventListener('DOMContentLoaded', function () {
    /* =========================
     Desktop Tabs
  ========================= */

    const tabs = document.querySelectorAll('.selector-tab');
    const contents = document.querySelectorAll('.selector-content-item');

    tabs.forEach((tab) => {
      tab.addEventListener('click', function () {
        const target = this.dataset.tab;

        tabs.forEach((item) => {
          item.classList.remove('active');
        });

        contents.forEach((item) => {
          item.classList.remove('active');
        });

        this.classList.add('active');

        const activeContent = document.querySelector(`.selector-content-item[data-content="${target}"]`);

        if (activeContent) {
          activeContent.classList.add('active');
        }
      });
    });

    /* =========================
     Mobile Accordion
  ========================= */

    const mobileTriggers = document.querySelectorAll('.mobile-selector-trigger');

    mobileTriggers.forEach((trigger) => {
      trigger.addEventListener('click', function () {
        const parent = this.closest('.mobile-selector-item');
        const panel = parent.querySelector('.mobile-selector-panel');

        const isOpen = panel.classList.contains('active');

        document.querySelectorAll('.mobile-selector-panel').forEach((item) => {
          item.classList.remove('active');
        });

        document.querySelectorAll('.mobile-selector-trigger').forEach((item) => {
          item.classList.remove('active');
        });

        document.querySelectorAll('.mobile-selector-trigger').forEach((item) => {
          item.classList.remove('active');
        });

        if (!isOpen) {
          panel.classList.add('active');
          this.classList.add('active');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Flooring Selector",
