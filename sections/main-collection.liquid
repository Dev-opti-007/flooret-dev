    .collection-all-floors .slick-list {
      margin: 0 -6px;
    }
  }
  @media (max-width:768px){
      .collection-all-floors .container {
          padding-top: 50px !important;
          padding-bottom: 50px !important;
      }
      ul.slick-dots{
        bottom: 10px;
      }
      button.common-plp-arrows.modin--slider.slick-next.slick-arrow, button.common-plp-arrows.modin--slider.slick-prev.slick-arrow{
        display: none;
      }
      #collection-grid > .container {
          padding-top: 35px !important;
      }
      #collection-grid > .container:first-of-type {
          padding-top: 25px !important;
      }
  }
</style>

{% comment %} <script>
  document.addEventListener('DOMContentLoaded', function () {
  // Only apply on screens below 768px
    
      if (window.matchMedia('(max-width: 768px)').matches) {
        setTimeout(()=>{
          document.querySelectorAll('.ruk-rating-snippet-count').forEach(function (el) {
            // e.g. "(20 Reviews)" -> "(20)"
            const text = el.textContent;
            el.textContent = text.replace(/\s*Reviews?\s*\)?/i, ')').trim();
            el.style.display = 'inline-block'
          });
        }, 2000)
      }
    
  
});

</script> {% endcomment %}

{% else %}

<section class="collection-hero" {{ section_styles }}>
  <div class="container">
    <div class="collection-hero__content">
      {%- render 'breadcrumbs' -%}
      <div class="section__header">
        <h1 class="ss-heading-size">{{ collection.title }}</h1>
        {%- if collection.description -%}
          <p class="ss-text-size">{{ collection.description }}</p>
        {%- endif -%}

        {%- if meta.hero_cta_url != blank -%}
          <a href="{{meta.hero_cta_url  }}" class="btn btn--text">{{ meta.hero_cta_text }}</a>
        {%- endif -%}
      </div>
      <div class="section__content">
        <nav class="collection-hero__nav desk-only">
          {%- for block in section.blocks -%}
            {%- assign _b = block.settings.collection | collection_link: block.settings -%}
            {% if block.settings.button_url == blank %}
              <a class="btn btn--outline btn--squared {% if page_url == _b.url %}active{% endif %}" href="{{ _b.url }}">
                {% if block.settings.text_replace != blank %}
                  {{ block.settings.text_replace }}
                {% else %}
                  {{ _b.title }}
                {% endif %}
              </a>
            {% endif %}
            {% if block.settings.button_url != blank %}
              <a class="btn btn--outline btn--squared" href="{{ block.settings.button_url }}">
                {% if block.settings.text_replace != blank %}
                  {{ block.settings.text_replace }}
                {% endif %}
              </a>
            {% endif %}
          {%- endfor -%}
        </nav>
      </div>
    </div>
  </div>
</section>

<div class="select-menu mob-only mob-hero-nav">
  <select name="" id="">
    {%- for block in section.blocks -%}
      {%- assign _b = block.settings.collection | collection_link: block.settings -%}
      <option
        {% if page_url == _b.url %}
          selected
        {% endif %}
        value="{{ _b.url }}"
      >
        {{ _b.title }}
      </option>
    {%- endfor -%}
  </select>
</div>

<div id="js-collection">
  {%- render 'collection-filter' -%}

  <section
    class="collection-grid"
    id="collection-grid"
  >
    <div class="container">
      <div class="collection-grid__loop">
        {%- paginate collection.products by 100 -%}
          {%- for product in collection.products -%}
            {% render 'product-card-legacy', product: product %}
          {%- endfor -%}
          {% comment %} {{ paginate | default_pagination: next: 'Older', previous: 'Newer' }} {% endcomment %}
        {%- endpaginate -%}
      </div>
    </div>
  </section>
</div>

<style>
  h1.ss-heading-size{
    font-size: {{ section.settings.hd_m_font_size }}px;
  }
  .section__header p{
    font-size: {{ section.settings.dsc_m_font_size }}px;
  }
  @media screen and (min-width: 960px){
    h1.ss-heading-size{
      font-size: {{ section.settings.hd_d_font_size }}px;
    }
    .section__header p{
      font-size: {{ section.settings.dsc_d_font_size }}px;
    }
  }
  @media (max-width:768px){
    .ruk_rating_snippet.collection {
        display: flex;
        align-items: center;
        gap: 2px;
    }
    .ruk_rating_snippet.collection i.ruk-icon-percentage-star--100 {
        position: relative;
        {% comment %} top: -2px; {% endcomment %}
    }
  }
</style>

{% endif %}

<script>
  var collectionVariantMetafields = {};
  {%- for product in collection.products -%}
    {%- for variant in product.variants -%}
      collectionVariantMetafields["{{ variant.id }}"] = {
        "sqft_price": {% if variant.metafields.custom.sqft_price.value != blank %}{{ variant.metafields.custom.sqft_price.value | json }}{% else %}null{% endif %},
        "sqft_compare_at_price": {% if variant.metafields.custom.sqft_compare_at_price.value != blank %}{{ variant.metafields.custom.sqft_compare_at_price.value | json }}{% else %}null{% endif %}
      };
    {%- endfor -%}
  {%- endfor -%}
</script>

{% schema %}
{
  "name": "Collections",
  "settings": [
    {
      "type": "color",
      "id": "hero_bg_color",
      "label": "Hero Background Color",
      "default": "#F4F3F1"
    },
    {
      "type": "color",
      "id": "hero_text_color",
      "label": "Hero Text Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Heading Font Sizes"
    },
    {
      "type": "number",
      "id": "hd_d_font_size",
      "label": "Desktop Font Size",
      "default": 40
    },
    {
      "type": "number",
      "id": "hd_m_font_size",
      "label": "Mobile Font Size",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text Font Sizes"
    },
    {
      "type": "number",
      "id": "dsc_d_font_size",
      "label": "Desktop Font Size",
      "default": 16
    },
    {
      "type": "number",
      "id": "dsc_m_font_size",
      "label": "Mobile Font Size",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "Block",
      "name": "Block",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
