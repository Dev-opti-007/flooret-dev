        overflow-x: scroll;
        overflow-y: auto;
        scroll-behavior: smooth;
        scrollbar-width: thin; /* Firefox */
        scrollbar-color: #ccc transparent;
    }

    .trim-collection-grid__loop::-webkit-scrollbar,
    .sample-kit-collection-grid__loop::-webkit-scrollbar,
    .silvan-hardwood-collection-grid__loop::-webkit-scrollbar,
    .arista-collection-grid__loop::-webkit-scrollbar,
    .modin-collection-grid__loop::-webkit-scrollbar {
        width: 8px;
    }

    .trim-collection-grid__loop::-webkit-scrollbar-track,
    .sample-kit-collection-grid__loop::-webkit-scrollbar-track,
    .silvan-hardwood-collection-grid__loop::-webkit-scrollbar-track,
    .arista-collection-grid__loop::-webkit-scrollbar-track,
    .modin-collection-grid__loop::-webkit-scrollbar-track {
        background: transparent;
    }

    .trim-collection-grid__loop::-webkit-scrollbar-thumb,
    .sample-kit-collection-grid__loop::-webkit-scrollbar-thumb,
    .silvan-hardwood-collection-grid__loop::-webkit-scrollbar-thumb,
    .arista-collection-grid__loop::-webkit-scrollbar-thumb,
    .modin-collection-grid__loop::-webkit-scrollbar-thumb {
        background: #ccc;
        border-radius: 4px;
    }

    .trim-collection-grid__loop::-webkit-scrollbar-thumb:hover,,
    .sample-kit-collection-grid__loop::-webkit-scrollbar-thumb:hover,,
    .silvan-hardwood-collection-grid__loop::-webkit-scrollbar-thumb:hover,
    .arista-collection-grid__loop::-webkit-scrollbar-thumb:hover,
    .modin-collection-grid__loop::-webkit-scrollbar-thumb:hover {
        background: #999;
    }

    /* Button Styles */
    .scroll-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgba(255,255,255,0.9);
        border: 2px solid #ddd;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        font-size: 18px;
        cursor: pointer;
        z-index: 10;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .scroll-prev {
        left: 10px;
    }

    .scroll-next {
        right: 10px;
    }

    .scroll-btn:hover:not(:disabled) {
        background: white;
        border-color: #333;
        transform: translateY(-50%) scale(1.1);
    }

    .scroll-btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    .collection-grid__loop-container {
        position: relative;
        max-height: 600px; /* Adjust as needed */
    }
    .scroll-btn {
        width: 30px;
        height: 30px;
        line-height: 1;
        padding:0px;
    }
    .col-lvp-header.mb-10 {
        margin-bottom: 25px;
    }
    .filter-option--sample-v2, .filter-option--show-sqft-price-in-product {
        display: none !important;
    }
    @media (min-width:991px) {
      .scroll-prev {
          left: -20px;
      }

      .scroll-next {
          right: -20px;
      }
    }
    @media (max-width:768px){
      .product-card {
          width: 50%;
      }
      .col-lvp-header.mb-10 {
          margin-bottom: 15px;
      }
    }
  </style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var scrollContainers = document.querySelectorAll('.silvan-hardwood-collection-grid__loop, .arista-collection-grid__loop, .modin-collection-grid__loop, .sample-kit-collection-grid__loop, .trim-collection-grid__loop');
    
    // Scroll button event handlers
    document.querySelectorAll('.scroll-btn').forEach(btn => {
      btn.addEventListener('click', function() {
        const targetSelector = this.dataset.target;
        const target = document.querySelector(targetSelector);
        const scrollAmount = target.offsetWidth * 0.8; // 80% of container width
        
        if (this.classList.contains('scroll-prev')) {
          target.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
        } else {
          target.scrollBy({ left: scrollAmount, behavior: 'smooth' });
        }
      });
    });
    
    // Auto-hide buttons based on scroll position
    scrollContainers.forEach(container => {
      const observer = new IntersectionObserver((entries) => {
        const prevBtn = document.querySelector(`[data-target="${container.className.split(' ')[0]}"] + .scroll-prev`);
        const nextBtn = document.querySelector(`[data-target="${container.className.split(' ')[0]}"] + .scroll-next`);
        
        if (container.scrollLeft === 0) {
          prevBtn.style.opacity = '0.3';
          prevBtn.disabled = true;
        } else {
          prevBtn.style.opacity = '1';
          prevBtn.disabled = false;
        }
        
        if (container.scrollLeft + container.clientWidth >= container.scrollWidth - 1) {
          nextBtn.style.opacity = '0.3';
          nextBtn.disabled = true;
        } else {
          nextBtn.style.opacity = '1';
          nextBtn.disabled = false;
        }
      });
      
      observer.observe(container);
    });
  });

</script>

