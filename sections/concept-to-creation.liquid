<section class="concept-creation-section concept-creation-section--{{ section.id }}">
  <div class="concept-creation-container">
    <h2 class="concept-creation-title">{{ section.settings.section_title }}</h2>
    <p class="concept-creation-subtitle">{{ section.settings.section_subtitle }}</p>
    <blockquote class="concept-creation-quote">
      {{ section.settings.quote }}
    </blockquote>
    <div class="concept-creation-media-row">
      {% for block in section.blocks %}
        <div class="concept-creation-media-col">
          {% case block.type %}
            {% when 'image' %}
              <img class="concept-creation-media-img" src="{{ block.settings.media_image | image_url: width:500 }}" alt="{{ block.settings.alt_text | escape }}">

            {% when 'video_picker' %}
              <div class="concept-creation-video-wrapper">
                {% if block.settings.cover_image != blank %}
                  <div class="concept-creation-video-overlay">
                    <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 52 52" fill="none">
                    <rect width="52" height="52" rx="26" fill="white" fill-opacity="0.9"/>
                    <path d="M32.4219 24.7188C33.3906 25.3125 33.3906 26.7188 32.4219 27.3125L21.4219 33.8125C20.4219 34.4062 19.1719 33.6875 19.1719 32.5V19.5C19.1719 18.2188 20.5156 17.6875 21.4219 18.2188L32.4219 24.7188Z" fill="#111111"/>
                    </svg>
                    <img class="concept-creation-cover-img" src="{{ block.settings.cover_image | img_url: '300x' }}" alt="{{ block.settings.cover_image.alt | escape }}">
                  </div>
                {% endif %}
                <video class="concept-creation-video" controls playsinline>
                  {% if block.settings.video != blank %}
                    <source src="{{ block.settings.video.sources[1].url }}" type="video/mp4">
                  {% endif %}
                </video>
              </div>
          {% endcase %}
          {% if block.settings.title != blank %}
          <h4>{{ block.settings.title }}</h4>
          {% endif %}
          {% if block.settings.subtext != blank %}
          <div>{{ block.settings.subtext }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
    {% if section.settings.button_text != blank %}
    <div class="concept-creation-cta">
      <a href="{{ section.settings.button_url | default: '#' }}" class="concept-creation-btn">{{ section.settings.button_text }}</a>
    </div>
    {% endif %}
  </div>
</section>

<style>
