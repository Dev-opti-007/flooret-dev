<script>
  document.addEventListener('DOMContentLoaded', function() {
    const overlays = document.querySelectorAll('.concept-creation-video-overlay');
    overlays.forEach(overlay => {
      overlay.addEventListener('click', function() {
        const wrapper = this.closest('.concept-creation-video-wrapper');
        const video = wrapper.querySelector('.concept-creation-video');
        this.style.display = 'none';
        video.style.display = 'block';
        video.play();
      });
    });
  });

