<script>
document.addEventListener('DOMContentLoaded', function() {
  // Select all video elements on the page
  const allVideos = document.querySelectorAll('video');

  allVideos.forEach(video => {
    // Remove controls if present (ensures no native controls)
    video.removeAttribute('controls');

    // Add click event to toggle play/pause
    video.addEventListener('click', function() {
      if (this.paused) {
        // Pause all other videos before playing this one
        allVideos.forEach(otherVideo => {
          if (otherVideo !== this && !otherVideo.paused) {
            otherVideo.pause();
          }
        });
        // Play the clicked video
        this.play();
      } else {
        // Pause the current video
        this.pause();
      }
    });

    // Optional: Add touchstart for better mobile support
    video.addEventListener('touchstart', function(e) {
      e.preventDefault(); // Prevent double-tap zoom on mobile
      if (this.paused) {
        // Pause all other videos before playing this one
        allVideos.forEach(otherVideo => {
          if (otherVideo !== this && !otherVideo.paused) {
            otherVideo.pause();
          }
        });
        // Play the touched video
        this.play();
      } else {
        // Pause the current video
        this.pause();
      }
    });

    // Optional: Also handle when videos start playing programmatically
    video.addEventListener('play', function() {
      // Pause all other videos when this one starts playing
      allVideos.forEach(otherVideo => {
        if (otherVideo !== this && !otherVideo.paused) {
          otherVideo.pause();
        }
      });
    });
  });
});


</script>

