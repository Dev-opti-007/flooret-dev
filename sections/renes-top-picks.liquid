<link rel="stylesheet" type="text/css" href="//cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
<script src="https://unpkg.com/imagesloaded@4/imagesloaded.pkgd.min.js"></script>

<section class="renes-top-picks-section renes-top-picks-section-{{ section.id }}">
  <div class="renes-top-picks-container">
    <h2 class="renes-top-picks-title">{{ section.settings.section_title }}</h2>
    <p class="renes-top-picks-subtitle">{{ section.settings.section_subtitle }}</p>
    <div class="renes-top-picks-grid">
      {% for block in section.blocks %}
        <div class="renes-top-picks-card">
        <a href="{{ block.settings.link }}" class="overlay-link" ></a>
          {% if block.settings.pick_image != blank %}
            <img class="renes-top-picks-card-image" src="{{ block.settings.pick_image | image_url: width:640 }}" alt="{{ block.settings.pick_name | escape }}">
          {% endif %}
          <div class="renes-top-picks-card-name">{{ block.settings.pick_name }}</div>
        </div>
      {% endfor %}
    </div>
    <div class="renes-top-picks-button-wrapper">
      <a href="{{ section.settings.button_url }}" class="renes-top-picks-button">{{ section.settings.button_text }}</a>
    </div>
  </div>
</section>

<style>
.renes-top-picks-section-{{ section.id }} {
  background: {{ section.settings.section-bg }};
  padding: 100px 0;
}
.renes-top-picks-section-{{ section.id }} .renes-top-picks-card {
  background: {{ section.settings.card-bg }};
}

.renes-top-picks-container {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}
.renes-top-picks-title {
    font-family: Montserrat;
    font-weight: 800;
    font-style: ExtraBold;
    font-size: 42px;
    leading-trim: NONE;
    line-height: 76.8px;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: middle;
    color:#111111;
}
.renes-top-picks-subtitle {
  font-family: Montserrat;
font-weight: 500;
font-style: Medium;
font-size: 18px;
leading-trim: NONE;
line-height: 30.72px;
letter-spacing: 0%;
text-align: center;
vertical-align: middle;
color:#343334;
}
.renes-top-picks-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 40px;
  justify-content: center;
  margin-top:50px;
  width:100%;
}
.renes-top-picks-card {
    max-width: 360px;
    background: #fff;
    {% comment %} border-radius: 8px; {% endcomment %}
    {% comment %} overflow: hidden; {% endcomment %}
    text-align: center;
    box-sizing: border-box;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    width: 100%;
    position:relative;
}
.renes-top-picks-card .overlay-link {
    position:absolute;
    top:0;
    left:0;
    width:100%;
    height:100%;
}
.renes-top-picks-card-image {
  width: 100%;
  height: 250px;
  object-fit: cover;
  display: block;
}
.renes-top-picks-card-name {
  font-size: 1.2rem;
  font-weight: 600;
  padding: 20px 0;
  {% comment %} background: #fff; {% endcomment %}
}
.renes-top-picks-button-wrapper {
  margin-top: 60px;
}
.renes-top-picks-button {
    background: #D6C08C;
    color: #fff;
    padding: 16px 36px;
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
    font-size: 1rem;
    display: inline-block;
    transition: background 0.2s;
    font-family: Montserrat;
    font-weight: 600;
    font-style: SemiBold;
    font-size: 13.3px;
    leading-trim: NONE;
    line-height: 100%;
    letter-spacing: 1px;
    text-align: center;
    vertical-align: middle;
    text-transform: uppercase;
    color: #111111;
}
.renes-top-picks-button:hover,
.renes-top-picks-button:focus {
  background: #bda46d;
}

.renes-top-picks-section-{{ section.id }} .renes-top-picks-title {
      font-family:{{ section.settings.font-heading }};
      font-size:{{ section.settings.font_size_heading_desk }}px;
      {% if section.settings.heading-color != blank %} color:{{ section.settings.heading-color }}; {% endif %}
}

.renes-top-picks-section-{{ section.id }} .renes-top-picks-subtitle {
      font-family:{{ section.settings.font-body }};
      font-size:{{ section.settings.font_size_body_desk }}px;
      {% if section.settings.body-color != blank %} color:{{ section.settings.body-color }}; {% endif %}
}

.renes-top-picks-section-{{ section.id }} .renes-top-picks-card-name {
      font-family:{{ section.settings.font-body }};
      font-size:{{ section.settings.font_size_card_desk }}px;
      {% if section.settings.card-color != blank %} color:{{ section.settings.card-color }}; {% endif %}
}

.renes-top-picks-section-{{ section.id }} .renes-top-picks-button {
      font-family:{{ section.settings.font-button }};
      font-size:{{ section.settings.font_size_button_desk }}px;
      {% if section.settings.button-bg-color != blank %} background:{{ section.settings.button-bg-color }}; {% endif %}
      {% if section.settings.button-font-color != blank %} color:{{ section.settings.button-font-color }}; {% endif %}
}

@media (max-width: 1000px) {
  .renes-top-picks-grid {
    gap: 18px;
  }
  .renes-top-picks-card {
    width: 48%;
    min-width: 260px;
  }
}
@media (max-width:768px){
    
    .renes-top-picks-section {
        padding: 50px 0px 50px 15px !important;
    }
    .renes-top-picks-card {
        max-width: unset !important;
    }
    .renes-top-picks-grid {
        margin-top:35px;
          flex-wrap: unset !important;
    }
    .renes-top-picks-button-wrapper {
        margin-top: 35px;
    }
    {% comment %} .renes-top-picks-grid .slick-track {
        display:block;
    } {% endcomment %}
    .renes-top-picks-grid .slick-slide {
        margin:0px 7.5px;
    }
    .renes-top-picks-grid .slick-list.draggable {
        margin-left: -30px;
    }

    .renes-top-picks-section-{{ section.id }} .renes-top-picks-title {
          font-size:{{ section.settings.font_size_heading_mob }}px;
    }

    .renes-top-picks-section-{{ section.id }} .renes-top-picks-subtitle {
          font-size:{{ section.settings.font_size_body_mob }}px;
    }

    .renes-top-picks-section-{{ section.id }} .renes-top-picks-card-name {
          font-size:{{ section.settings.font_size_body_mob }}px;
    }

    .renes-top-picks-section-{{ section.id }} .renes-top-picks-button {
          font-size:{{ section.settings.font_size_button_mob }}px;
    }



}
@media (max-width: 600px) {
  .renes-top-picks-grid {
    flex-direction: column;
    gap: 18px;
  }
  .renes-top-picks-card {
    width: 100%;
    min-width: unset;
  }
}


</style>

<script>

    document.addEventListener('DOMContentLoaded', ()=>{
        setTimeout(()=>{
            if(window.innerWidth < 770){
                $('.renes-top-picks-grid').slick({
                        arrows: false,
                        dots: false,
                        infinite: false,
                        {% comment %} slidesToShow: 1,
                        slidesToScroll: 1, {% endcomment %}
                        centerMode: true,
                        centerPadding: '30px',
                        responsive: [
                            {
                              breakpoint: 770,
                              settings: {
                                slidesToShow: 2,
                                slidesToScroll: 1,
                                initialSlide:1
                              }
                            },
                            {
                              breakpoint: 550,
                              settings: {
                                slidesToShow: 1,
                                slidesToScroll: 1,
                              }
                            }
                          ]
                });
            }
        }, 1000)
    })
    
		

</script>

{% schema %}
{
  "name": "René's Top Picks",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "René's Top Picks"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Our most-loved styles, handpicked by René for their versatility and timelessness."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "GET $1 SAMPLES"
    },
    {
        "type": "url",
        "id": "button_url",
        "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Font family"
    },
    {
      "type": "select",
      "id": "font-heading",
      "label": "Font Family Heading",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        }
      ],
      "default": "Montserrat"
    },
    {
      "type": "select",
      "id": "font-body",
      "label": "Font Family Subtext",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        }
      ],
      "default": "Montserrat"
    },
    {
      "type": "select",
      "id": "font-button",
      "label": "Font Family Button",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        }
      ],
      "default": "Montserrat"
    },
    {
      "type": "header",
      "content": "Font Sizes Desktop"
    },
    {
      "type": "range",
      "id": "font_size_heading_desk",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Font size Heading Desktop",
      "default": 42
    },
    {
      "type": "range",
      "id": "font_size_body_desk",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Subtext Desktop",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_card_desk",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Card Text Desktop",
      "default": 19
    },
    {
      "type": "range",
      "id": "font_size_button_desk",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Button Desktop",
      "default": 14
    },
    {
      "type": "header",
      "content": "Font Sizes Mobile"
    },
    {
      "type": "range",
      "id": "font_size_heading_mob",
      "min": 1,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Heading Mobile",
      "default": 30
    },
    {
      "type": "range",
      "id": "font_size_body_mob",
      "min": 1,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Subtext Mobile",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_card_mob",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Card Text Mobile",
      "default": 19
    },
    {
      "type": "range",
      "id": "font_size_button_mob",
      "min": 1,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Button Mobile",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section-bg",
      "label": "Section Color",
      "default":"#ededed"
    },
    {
      "type": "color",
      "id": "card-bg",
      "label": "Card Color",
      "default":"#fff"
    },
    {
      "type": "color",
      "id":"heading-color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id":"body-color",
      "label": "Subtext Color"
    },
    {
      "type": "color",
      "id":"card-color",
      "label": "Card Font Color"
    },
    {
      "type": "color",
      "id": "button-bg-color",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button-font-color",
      "label": "Button Font Color"
    }
  ],
  "blocks": [
    {
      "type": "top_pick",
      "name": "Top Pick",
      "settings": [
        {
            "type": "url",
            "id":"link",
            "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "pick_image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "pick_name",
          "label": "Pick Name",
          "default": "Pick Name"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "René's Top Picks Default"
    }
  ]
}
{% endschema %}