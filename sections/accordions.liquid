{% assign _settings = section.settings %}
{% assign blocks = section.blocks %}
<section
  {% if _settings.block_id %}
    id="{{ _settings.block_id }}"
  {% endif %}
>
  <div class="container">
    <div class="accordions-row">
      <div class="accordions-row__col">
        <div class="accordions-content-wrap">
          {% if _settings.heading != blank %}
            <h2 class="h1">{{ _settings.heading }}</h2>
          {% endif %}

          {% if _settings.content != blank %}
            {{ _settings.content }}
          {% endif %}

          {% if _settings.link_text != blank and _settings.link_url != blank %}
            <a
              href="{{ _settings.link_url }}"
              class="btn btn--primary"
            >
              {{- _settings.link_text -}}
            </a>
          {% endif %}
        </div>
      </div>
      <div class="accordions-row__col">
        {% for _b in blocks %}
          {%- assign accordion = _b.settings -%}
          {%- assign is_active = forloop.first -%}
          {% render 'accordion',
            label: accordion.accordion_title,
            content: accordion.accordion_content,
            active: is_active
          %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Accordions",
  "class": "shopify-block accordions",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "block_id",
      "label": "Block ID"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "name": "Accordion",
      "type": "accordion",
      "settings": [
        {
          "type": "text",
          "id": "accordion_title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "accordion_content",
          "label": "Accordion Content"
        },
        {
          "type": "text",
          "id": "accordion_link_text",
          "label": "Accordion Link Text"
        },
        {
          "type": "url",
          "id": "accordion_link_url",
          "label": "Accordion Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordions",
      "category": "Content / Accordions"
    }
  ]
}
{% endschema %}
