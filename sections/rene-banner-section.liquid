
<div class="container-full slide-vi-secid--{{ section.id }}">
  <div class=" imageSlider">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          {% if block.settings.video-enable == true %}
            {%- if block.settings.video_url != blank -%}
            
              <img class="thumb-image-{{ block.id }}" src="{{ block.settings.video_thumbnail | img_url:'1920x' }}" alt="{{ block.settings.video_thumbnail.alt }}" >
    
            {% endif %}
          {% else %}
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1000 | image_tag: alt: block.settings.image.alt }}
            {% else %}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
            {% if block.settings.mobile-image != blank %}
              <img class="mob-img" src="{{ block.settings.mobile-image | image_url: width: 700 }} alt="{{ block.settings.mobile-image.alt }}">
              {% endif %}
          {% endif %}
        <div class="content">
          <h2>{{ block.settings.heading }}</h2>
          <div class='desc'>
            {{ block.settings.desc }}
          </div>
          <div class="btns">
            {% if block.settings.btn-one-text != blank %}
            <a class="btn btn-one" href="{{ block.settings.btn-one-link }}">{{ block.settings.btn-one-text }}</a>
            {% endif %}
            {% if block.settings.btn-two-text != blank %}
            <a class="btn two" href="{{ block.settings.btn-two-link }}">{{ block.settings.btn-two-text }}</a>
            {% endif %}
          </div>
        </div>
          <div class="overlay" {% if block.settings.video-enable == true %}style="background-color: {{ block.settings.color }};width:100%;opacity:{{ block.settings.bg_opacity  }};"{% endif %}></div>
        </div>
         {% comment %} <script>
          setTimeout(()=>{
          
        
            var videoHTML = `<video
              src="{{ block.settings.video_url }}"
              autoplay
              muted
              loop
              playsinline
              class="custom-video"
