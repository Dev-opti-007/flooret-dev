              document.addEventListener(event, loadVideoOnInteraction, { once: true });
            });

              }, 100)
          </script> {% endcomment %}

        <script>
setTimeout(()=>{
  var videoHTML = `<video
    src="{{ block.settings.video_url }}"
    autoplay
    muted
    loop
    playsinline
    class="custom-video"
    width="100%"
    height="100%"
    style="opacity: 0; position: absolute; top: 0; left: 0; z-index: 2; transition: opacity 0.5s ease-in-out;"
  >
    Your browser does not support the video tag.
  </video>`;
  
  function loadVideoOnInteraction() {
    var thumbImage = document.querySelector('.thumb-image-{{ block.id }}');
    
    // **KEY FIX: Check if video already exists for this block**
    var existingVideo = thumbImage ? thumbImage.parentNode.querySelector('.custom-video') : null;
    
    if (thumbImage && !existingVideo) {
      // Insert video first
      thumbImage.insertAdjacentHTML('afterend', videoHTML);
      var video = thumbImage.nextElementSibling;
      
      // Wait for video to be ready, then transition
      if (video && video.tagName === 'VIDEO') {
        video.addEventListener('canplay', function() {
          // Fade in video
          video.style.opacity = '1';
          // Fade out thumbnail
          thumbImage.style.opacity = '0';
          
          // Remove thumbnail after fade completes
          setTimeout(function() {
            if (thumbImage.parentNode) {
              thumbImage.remove();
            }
            // Make video static positioned after image removal
            video.style.position = 'static';
            video.style.zIndex = 'auto';
          }, 500);
        });
        
        // Fallback: if video loads immediately
        video.addEventListener('loadeddata', function() {
          if (video.readyState >= 2) {
            video.style.opacity = '1';
            thumbImage.style.opacity = '0';
            setTimeout(function() {
              if (thumbImage.parentNode) {
                thumbImage.remove();
              }
              video.style.position = 'static';
              video.style.zIndex = 'auto';
            }, 500);
          }
        });
      }
    }
  }

  // **IMPROVED: Block-specific interaction handling**
  var blockInteractionFired = false;
  var userInteractionEvents = ['mousemove', 'mousedown', 'scroll', 'keydown', 'touchstart'];

  function handleBlockInteraction() {
    if (!blockInteractionFired) {
      blockInteractionFired = true;
      loadVideoOnInteraction();
      
      // Remove listeners for this block
      userInteractionEvents.forEach(function(event) {
        document.removeEventListener(event, handleBlockInteraction);
      });
    }
  }

  userInteractionEvents.forEach(function(event) {
    document.addEventListener(event, handleBlockInteraction, { once: true, passive: true });
  });

}, 100)
</script>


          {% if block.settings.video-enable == true %}
            <style>
            .sustain-slider .swiper-slide video.custom-video {
                width: 100%;
                height: 100%;
                display: flex;
            }
            </style>
          {% endif %}
      {% endfor %}
    </div>
    <!-- <div class="swiper-controls">
      <div class="button-prev">{% render 'icon-prev' %}</div>
      <div class="button-next">{% render 'icon-next' %}</div>
    </div> -->
  </div>
</div>



{% style %} 
  .sustain-slider {
    position: relative;
  }
 
  .sustain-slider .swiper-slide .content {
      position: absolute;
      top: 0;
      left: 0;
      transform: 0;
      max-width: 50%;
      z-index: 2;
      padding: 0px 4%;
      display: flex;
      flex-direction: column;
      height: 100%;
      align-items: baseline;
      justify-content: center;
  }
  .sustain-slider .swiper-slide .overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 50%;
      height: 100%;
      opacity: 0.8;
  }
  .sustain-slider .swiper-pagination  .swiper-pagination-bullet {
      width: 13px;
      height: 13px;
      background: #fff;
  }
 
  .sustain-slider .swiper-slide .mob-img {
    display:none;
  }

    .sustain-slider .swiper-slide .content h2 {
        color: #0F2924;
        font-family: Playfair Display;
        font-weight: 400;
        font-size: 48px;
        line-height: 64px;
        letter-spacing: 0%;
        vertical-align: middle;
    }
    .sustain-slider .swiper-slide .content .desc {
        margin-top: 25px;
    }

    .sustain-slider .swiper-slide .content .desc h4 {
        color: #0F2924;
    }

    .sustain-slider .swiper-slide .content .desc p {
        font-family: Montserrat;
        font-weight: 400;
        font-style: Regular;
        font-size: 19.2px;
        leading-trim: NONE;
        line-height: 30.72px;
        letter-spacing: 0%;
        vertical-align: middle;
        color:#FFFFFF;
        max-width:535px;
    }   

    .sustain-slider .swiper-slide .content .btns .btn {
        font-family: Montserrat;
        font-weight: 600;
        font-style: SemiBold;
        font-size: 16px;
        leading-trim: NONE;
        line-height: 25.6px;
        letter-spacing: 1px;
        vertical-align: middle;
        text-transform: uppercase;
        border-radius: 4px;
        margin: 0px;
    }

        .sustain-slider .swiper-slide .content .btns .btn.two {
        border: 1px solid #111;
        background: transparent;
        color: #111;
    }

    .sustain-slider .swiper-slide .content .btns {
        margin-top: 50px;
    }

    .sustain-slider .swiper-slide .content .btns .btn.btn-one {
        margin-right: 10px;
        background: #111;
    }

    .sustain-slider .swiper-slide .content .btns .btn.btn-one:hover {
        background: #fff;
    }

  .sustain-slider .imageSlider {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .sustain-slider .imageSlider img,
 .sustain-slider  .imageSlider svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
 .sustain-slider  .imageSlider .swiper-controls {
    position: absolute;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding: 0 20px;
  }
  .sustain-slider .imageSlider .swiper-controls .button-prev,
  .sustain-slider .imageSlider .swiper-controls .button-next {
    cursor: pointer;
  }


    .sustain-slider .swiper-slide .content h2 > img {
      min-height: unset !important;
  }

    /* Smooth transition styles for video replacement */
  .sustain-slider .swiper-slide {
    position: relative;
    overflow: hidden;
  }

  .sustain-slider .swiper-slide img[class*="thumb-image"] {
    transition: opacity 0.5s ease-in-out;
    position: relative;
    z-index: 1;
  }

  .sustain-slider .swiper-slide video.custom-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    z-index: 2;
    transition: opacity 0.5s ease-in-out;
    animation: videoFadeIn 0.5s ease-in-out forwards;
  }

  @keyframes videoFadeIn {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  /* Ensure video loads smoothly */
  .sustain-slider .swiper-slide video.custom-video[src] {
    opacity: 1;
  }

  .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content h2 {
    font-family:{{ section.settings.font-heading }};
    font-size:{{ section.settings.font_size_heading_desk }}px;
    {% if section.settings.heading-color != blank %} color:{{ section.settings.heading-color }}; {% endif %}
  }

  .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content .desc p {
    font-family:{{ section.settings.font-body }};
    font-size:{{ section.settings.font_size_body_desk }}px;
    {% if section.settings.body-color != blank %} color:{{ section.settings.body-color }}; {% endif %}
  }

  .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content .btns .btn {
    font-family:{{ section.settings.font-button }};
    font-size:{{ section.settings.font_size_button_desk }}px !important;
  }

  .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content .btns .btn.btn-one {
    {% if section.settings.button-bg-color != blank %} background:{{ section.settings.button-bg-color }}; {% endif %}
    {% if section.settings.button-font-color != blank %} color:{{ section.settings.button-font-color }}; {% endif %}
  }

  .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content .btns .btn.btn-two {
    {% if section.settings.button-bg-color-two != blank %} background:{{ section.settings.button-bg-color-two }}; {% endif %}
    {% if section.settings.button-font-color-two != blank %} color:{{ section.settings.button-font-color-two }}; {% endif %}
  }

  @media (max-width: 1300px) {
    .sustain-slider .imageSlider img {
            min-height:500px;        
        }
  }
  @media (max-width:768px){
    .swiper-slide > img:nth-child(1){
        display:none;
    }
     .swiper-slide .mob-img {
        display:block !important;
    }
  }
  @media (max-width:768px){
    .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content h2 {
      font-size:{{ section.settings.font_size_heading_mob }}px;
    }
    .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content .desc p {
      font-size:{{ section.settings.font_size_body_mob }}px !important;
    }
    .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content .btns .btn {
      font-size:{{ section.settings.font_size_button_mob }}px !important;
    }
    .sustain-slider .slide-vi-secid--{{ section.id }} .swiper-slide .content {
        background: linear-gradient(180.72deg, rgba(208, 173, 129, 0) 0.62%, {{section.settings.mobile-bg}} 72.14%);
    }
  }
{% endstyle %}

{% if section.settings.manual-height == true %}
<style>
.sustain-slider .container-full.slide-vi-secid--{{ section.id }} .swiper-slide > img,
.container-full.slide-vi-secid--template--{{ section.id }} .swiper-slide video.custom-video {
    max-height: {{  section.settings.desktop-height }}vh;
} 
.sustain-slider .container-full.slide-vi-secid--{{ section.id }} .imageSlider img {
  max-height: {{  section.settings.desktop-height }}vh;
  min-height:unset !important;
}
@media (max-width:768px){
  .container-full.slide-vi-secid--template--{{ section.id }} .swiper-slide {
    height: {{  section.settings.mobile-height }}vh;
  }
}
</style>
{% endif %}

