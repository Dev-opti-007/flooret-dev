{% comment %}
  FAQ Section
  Layout:
  — Section title (left-aligned)
  — Filter tag pills: All | TrueStep | TruePlank | Installation (+ any custom tags)
  — Full-width accordion list — each item: question (left) + plus/minus icon (right)
    → expanded shows answer below with smooth height animation
  — Each FAQ block has a "tag" that matches filter pills
  — Filtering hides non-matching rows instantly
{% endcomment %}

<section class="faq faq--{{ section.id }}{% if section.settings.full_width %} faq--full-width{% endif %}">

  {%- comment -%} ══ HEADER ══ {%- endcomment -%}
  {%- if section.settings.section_title != blank -%}
    <h2 class="faq__title">{{ section.settings.section_title }}</h2>
  {%- endif -%}

  {%- comment -%} ══ FILTER PILLS ══ {%- endcomment -%}
  {%- assign raw_tags = section.settings.filter_tags | default: 'All,TrueStep,TruePlank,Installation' -%}
  {%- assign tag_list = raw_tags | split: ',' -%}

  {%- if tag_list.size > 1 -%}
    <div class="faq__filters" role="group" aria-label="Filter FAQs by category">
      {%- for tag in tag_list -%}
        {%- assign tag_trimmed = tag | strip -%}
        <button
          class="faq__filter-pill{% if forloop.first %} is-active{% endif %}"
          type="button"
          data-filter="{{ tag_trimmed | downcase }}"
          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
          {% if tag_trimmed == "TrueStep" %}
            TrueStep™
            {% elsif tag_trimmed == "TruePlank" %}
              TruePlank™
            {% else %}
            {{ tag_trimmed }}
          {% endif %}
        </button>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} ══ ACCORDION LIST ══ {%- endcomment -%}
  <div class="faq__list" role="list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_item' -%}
        {%- assign item_tag = block.settings.tag | strip | downcase | default: 'all' -%}
        <div
          class="faq__item"
          data-tag="{{ item_tag }}"
          role="listitem"
          {{ block.shopify_attributes }}>

          <button
            class="faq__question"
            type="button"
            aria-expanded="false"
            aria-controls="faq-answer-{{ section.id }}-{{ forloop.index }}">
            <span class="faq__question-text">{{ block.settings.question }}</span>
            <span class="faq__icon" aria-hidden="true">
              <svg class="faq__icon-plus"  width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              <svg class="faq__icon-minus" width="20" height="20" viewBox="0 0 20 20" fill="none" style="display:none"><path d="M4 10h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </span>
          </button>

          <div
            class="faq__answer"
            id="faq-answer-{{ section.id }}-{{ forloop.index }}"
            role="region"
            aria-hidden="true"
            hidden>
            <div class="faq__answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>

        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

</section>

<style>

/* ══ CUSTOM PROPERTIES ══ */
.faq--{{ section.id }} {
  --faq-accent:          {{ section.settings.accent_color | default: '#f5a623' }};
  --faq-accent-hover:    {{ section.settings.accent_hover_color | default: '#d48f0f' }};
  --faq-bg:              {{ section.settings.section_bg | default: '#f5f3ef' }};
  --faq-text:            {{ section.settings.text_color | default: '#1a1a1a' }};
  --faq-text-muted:      {{ section.settings.text_muted | default: '#6b6b6b' }};
  --faq-divider:         {{ section.settings.divider_color | default: '#d8d4cc' }};
  --faq-pill-bg:         {{ section.settings.pill_inactive_bg | default: 'transparent' }};
  --faq-pill-text:       {{ section.settings.pill_inactive_text | default: '#1a1a1a' }};
  --faq-pill-border:     {{ section.settings.pill_border_color | default: '#c8c3bb' }};
  --faq-pill-active-bg:  {{ section.settings.pill_active_bg | default: '#f5a623' }};
  --faq-pill-active-text:{{ section.settings.pill_active_text | default: '#111111' }};
  --faq-answer-bg:       {{ section.settings.answer_bg | default: 'transparent' }};
  --faq-icon-color:      {{ section.settings.icon_color | default: '#1a1a1a' }};
  --faq-font-heading:    '{{ section.settings.font_heading | default: 'system-ui' }}', sans-serif;
  --faq-font-body:       '{{ section.settings.font_body | default: 'system-ui' }}', sans-serif;
}

/* ══ WRAPPER ══ */
.faq--{{ section.id }} {
  width: 100%;
  background: var(--faq-bg);
  font-family: var(--faq-font-body);
  color: var(--faq-text);
  {% unless section.settings.full_width %}
    max-width: {{ section.settings.section_max_width | default: 1200 }}px;
    margin-inline: auto;
  {% endunless %}
  padding: {{ section.settings.padding_top | default: 60 }}px
           {{ section.settings.padding_h | default: 24 }}px
           {{ section.settings.padding_bottom | default: 60 }}px;
  box-sizing: border-box;
}

/* ══ TITLE ══ */
.faq--{{ section.id }} .faq__title {
  margin: 0 0 {{ section.settings.title_mb | default: 24 }}px;
  font-family: var(--faq-font-heading);
  font-size: {{ section.settings.title_size | default: 36 }}px;
  font-weight: {{ section.settings.title_weight | default: 700 }};
  line-height: 1.15;
  color: var(--faq-text);
  font-family: Montserrat;
  font-weight: 500;
  font-style: Medium;
  font-size: 30px;
  leading-trim: NONE;
  line-height: 36px;
  letter-spacing: 0.4px;
  color:#000;
}

/* ══ FILTER PILLS ══ */
.faq--{{ section.id }} .faq__filters {
  display: flex;
  flex-wrap: wrap;
  gap: {{ section.settings.pill_gap | default: 8 }}px;
  margin-bottom: {{ section.settings.filters_mb | default: 32 }}px;
}

.faq--{{ section.id }} .faq__filter-pill {
  display: inline-flex;
  align-items: center;
  justify-content:center;
  height: {{ section.settings.pill_height | default: 36 }}px;
  padding: 0 {{ section.settings.pill_padding_h | default: 18 }}px;
  border-radius: {{ section.settings.pill_radius | default: 50 }}px;
  border: {{ section.settings.pill_border_width | default: 1 }}px solid #000000;
  background: transparent;
  color: var(--faq-pill-text);
  font-family: var(--faq-font-body);
  font-size: {{ section.settings.pill_font_size | default: 14 }}px;
  font-weight: {{ section.settings.pill_font_weight | default: 400 }};
  cursor: pointer;
  transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  white-space: nowrap;
  min-height: 44px;
  font-family: Inter;
  font-weight: 500;
    font-style: Medium;
    font-size: 14px;
    leading-trim: NONE;
    line-height: 20px;
    letter-spacing: -0.15px;
    text-align: center;
    color:#000000;
    min-width:80px;
}

.faq--{{ section.id }} .faq__filter-pill:hover {
  border-color: var(--faq-accent);
  color: var(--faq-text);
}

.faq--{{ section.id }} .faq__filter-pill.is-active {
  {% comment %} background: var(--faq-pill-active-bg);
  color: var(--faq-pill-active-text);
  border-color: var(--faq-pill-active-bg); {% endcomment %}
    background: #FAAF4F;
  color: #000000;
  border-color: #FAAF4F;
}

/* ══ ACCORDION LIST ══ */
.faq--{{ section.id }} .faq__list {
  border-top: {{ section.settings.divider_width | default: 1 }}px solid #000;
}

/* ══ ITEM ══ */
.faq--{{ section.id }} .faq__item {
  border-bottom: {{ section.settings.divider_width | default: 1 }}px solid #000;
  transition: opacity 0.18s ease;
}

.faq--{{ section.id }} .faq__item.is-hidden {
  display: none;
}

/* ══ QUESTION BUTTON ══ */
.faq--{{ section.id }} .faq__question {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  padding: {{ section.settings.item_padding_v | default: 22 }}px 0;
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  color: var(--faq-text);
  font-family: var(--faq-font-body);
  outline: none;
  min-height: 44px;
}

.faq--{{ section.id }} .faq__question:focus-visible {
  outline: 2px solid var(--faq-accent);
  outline-offset: 2px;
  border-radius: 4px;
}

.faq--{{ section.id }} .faq__question-text {
  font-size: {{ section.settings.question_size | default: 16 }}px;
  font-weight: {{ section.settings.question_weight | default: 400 }};
  line-height: 1.45;
  flex: 1;
  font-family: Montserrat;
  font-weight: 500;
  font-style: Medium;
  font-size: 16px;
  leading-trim: NONE;
  line-height: 24px;
  letter-spacing: 0px;
  color:#000000;
}

{% comment %} .faq--{{ section.id }} .faq__question[aria-expanded="true"] .faq__question-text {
  font-weight: {{ section.settings.question_weight_open | default: 600 }};
} {% endcomment %}

/* Icon */
.faq--{{ section.id }} .faq__icon {
  flex-shrink: 0;
  color: var(--faq-icon-color);
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease;
}

/* ══ ANSWER PANEL — smooth height animation via max-height ══ */
.faq--{{ section.id }} .faq__answer {
  overflow: hidden;
  max-height: 0;
  transition: max-height {{ section.settings.anim_duration | default: 340 }}ms cubic-bezier(0.4, 0, 0.2, 1);
}

.faq--{{ section.id }} .faq__answer:not([hidden]) {
  max-height: 1000px;
}

/* Override hidden to allow animation */
.faq--{{ section.id }} .faq__answer[hidden] {
  display: block !important;
  max-height: 0;
}

.faq--{{ section.id }} .faq__answer-inner {
  padding: 0 0 {{ section.settings.answer_padding_bottom | default: 20 }}px;
  font-size: {{ section.settings.answer_size | default: 15 }}px;
  line-height: {{ section.settings.answer_line_height | default: 1.65 }};
  color: {{ section.settings.answer_text_color | default: '#4a4a4a' }};
  background: var(--faq-answer-bg);
  max-width: {{ section.settings.answer_max_width | default: 80 }}ch;
}

.faq--{{ section.id }} .faq__answer-inner p { margin: 0 0 0.75em; }
.faq--{{ section.id }} .faq__answer-inner p:last-child { margin-bottom: 0; }
.faq--{{ section.id }} .faq__answer-inner a { color: var(--faq-accent); text-decoration: underline; }
.faq--{{ section.id }} .faq__answer-inner ul,
.faq--{{ section.id }} .faq__answer-inner ol { margin: 0 0 0.75em 1.25em; }

/* ══ MOBILE ══ */
@media (max-width: 768px) {
  .faq--{{ section.id }} {
    padding: {{ section.settings.padding_top_mob | default: 32 }}px
             {{ section.settings.padding_h_mob | default: 16 }}px
             {{ section.settings.padding_bottom_mob | default: 32 }}px;
  }

  .faq--{{ section.id }} .faq__title {
    font-size: {{ section.settings.title_size_mob | default: 26 }}px !important;
  }

  .faq--{{ section.id }} .faq__question-text {
    font-size: {{ section.settings.question_size_mob | default: 15 }}px !important;
  }

  .faq--{{ section.id }} .faq__answer-inner {
    font-size: {{ section.settings.answer_size_mob | default: 14 }}px !important;
  }
}

</style>

<script>
(function () {
  var sec = document.querySelector('.faq--{{ section.id }}');
  if (!sec) return;

  var items   = sec.querySelectorAll('.faq__item');
  var pills   = sec.querySelectorAll('.faq__filter-pill');

  /* ── Filtering ── */
  function applyFilter(tag) {
    pills.forEach(function(p) {
      var active = p.dataset.filter === tag;
      p.classList.toggle('is-active', active);
      p.setAttribute('aria-pressed', active ? 'true' : 'false');
    });

    items.forEach(function(item) {
      var itemTag = item.dataset.tag || 'all';
      var show = tag === 'all' || itemTag === tag;
      item.classList.toggle('is-hidden', !show);
    });
  }

  pills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      applyFilter(pill.dataset.filter);
    });
  });

  /* ── Accordion ── */
  function closeAll(except) {
    items.forEach(function(item) {
      var btn    = item.querySelector('.faq__question');
      var answer = item.querySelector('.faq__answer');
      var plus   = item.querySelector('.faq__icon-plus');
      var minus  = item.querySelector('.faq__icon-minus');
      if (item === except) return;
      if (btn && btn.getAttribute('aria-expanded') === 'true') {
        btn.setAttribute('aria-expanded', 'false');
        answer.setAttribute('aria-hidden', 'true');
        answer.setAttribute('hidden', '');
        if (plus)  plus.style.display  = '';
        if (minus) minus.style.display = 'none';
      }
    });
  }

  items.forEach(function(item) {
    var btn    = item.querySelector('.faq__question');
    var answer = item.querySelector('.faq__answer');
    var plus   = item.querySelector('.faq__icon-plus');
    var minus  = item.querySelector('.faq__icon-minus');
    if (!btn || !answer) return;

    btn.addEventListener('click', function() {
      var isOpen = btn.getAttribute('aria-expanded') === 'true';

      if ({{ section.settings.close_others | default: true }}) {
        closeAll(item);
      }

      if (isOpen) {
        btn.setAttribute('aria-expanded', 'false');
        answer.setAttribute('aria-hidden', 'true');
        answer.setAttribute('hidden', '');
        if (plus)  plus.style.display  = '';
        if (minus) minus.style.display = 'none';
      } else {
        btn.setAttribute('aria-expanded', 'true');
        answer.removeAttribute('hidden');
        answer.setAttribute('aria-hidden', 'false');
        if (plus)  plus.style.display  = 'none';
        if (minus) minus.style.display = '';
      }
    });
  });

  /* ── Open item if URL hash matches ── */
  if (window.location.hash) {
    var target = sec.querySelector(window.location.hash);
    if (target && target.classList.contains('faq__item')) {
      var btn = target.querySelector('.faq__question');
      if (btn) btn.click();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  // Init — apply 'all' filter
  applyFilter('all');
})();
</script>

