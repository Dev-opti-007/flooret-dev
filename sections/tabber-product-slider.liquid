</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabsContainer = document.getElementById('tps-tabs');
  if (!tabsContainer) return;
  
  const tabs = tabsContainer.querySelectorAll('.tabbed-product-slider__tab');
  const productsContainers = document.querySelectorAll('.tabbed-product-slider__products');
  const slidesDesktop = {{ section.settings.slides_desktop | default: 5 }};
  
  let currentSwiper = null;
   
  function initializeSwiper(sliderElement) {
  if (currentSwiper) {
    currentSwiper.destroy(true, true);
    currentSwiper = null;
  }
  if (!sliderElement) return;

  currentSwiper = new Swiper(sliderElement, {
    slidesPerView: 6,
    slidesPerGroup: 1,
    initialSlide: 0,
    spaceBetween: 16,
    autoHeight: false,
    centeredSlides: false,
    watchOverflow: true,
    // optional: prevent extra tail space when not enough slides
    // normalizeSlideIndex: true,

    navigation: {
      nextEl: sliderElement.querySelector('.swiper-button-next'),
      prevEl: sliderElement.querySelector('.swiper-button-prev'),
    },
    breakpoints: {
      320:  { slidesPerView: 2.5, spaceBetween: 8, centeredSlides: false, initialSlide: 0 },
      480:  { slidesPerView: 2.6, spaceBetween: 8, centeredSlides: false, initialSlide: 0 },
      768:  { slidesPerView: 3,   spaceBetween: 12, centeredSlides: false, initialSlide: 0 },
      1024: { slidesPerView: 5.5,   spaceBetween: 16, centeredSlides: false, initialSlide: 0 }
    }
  });
}


  tabs.forEach((tab) => {
    tab.addEventListener('click', function() {
      const targetId = this.dataset.tab;
      
      // Update active tab
      tabs.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
      
      // Hide all products, show target
      productsContainers.forEach(pc => pc.classList.remove('active'));
      const targetProducts = document.getElementById(`tps-products-${targetId}`);
      if (targetProducts) {
        targetProducts.classList.add('active');
        
        // Reinit CSS widths after timeout for responsive calc
        setTimeout(() => {
          const sliderElement = targetProducts.querySelector('.tps-product-grid');
          const slides = sliderElement.querySelectorAll('.swiper-slide');
          slides.forEach(slide => {
            // Trigger reflow for CSS calc
            slide.style.width = '';
            void slide.offsetWidth;
          });
          initializeSwiper(sliderElement);
        }, 150);
      }
    });
  });
  
  // Initialize first slider
  const firstProducts = document.querySelector('.tabbed-product-slider__products.active');
  if (firstProducts) {
    const firstSlider = firstProducts.querySelector('.tps-product-grid');
    setTimeout(() => {
      initializeSwiper(firstSlider);
    }, 100);
  }
  
  // AJAX Add to Cart
  const addToCartForms = document.querySelectorAll('.product-form');
  addToCartForms.forEach(form => {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      const formData = new FormData(this);
      fetch('/cart/add.js', {
        method: 'POST',
        body: formData
      })
      .then(response => response.json())
      .then(data => {
        console.log('Added to cart:', data);
      })
      .catch(error => console.error('Error:', error));
    });
  });
});
</script>


<script>
document.addEventListener('DOMContentLoaded', function() {
  if (!window.gsap || !window.ScrollTrigger) return;
  
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector('.tabbed-product-slider--{{ section.id }}');
  if (!root) return;

  // Mid-page refresh guard for common targets
  scrollTriggerManager.revealIfInViewAll(
    '.tabbed-product-slider--{{ section.id }} .tabbed-product-slider__heading, ' +
    '.tabbed-product-slider--{{ section.id }} .tabbed-product-slider__tabs .tabbed-product-slider__tab, ' +
    '.tabbed-product-slider--{{ section.id }} .tabbed-product-slider__section-btn'
  );

  const heading = root.querySelector('.tabbed-product-slider__heading');
  const tabsRow = root.querySelector('.tabbed-product-slider__tabs');
  const secBtn  = root.querySelector('.tabbed-product-slider__section-btn');

  // Helper: animate a NodeList with stagger when container scrolls into view
  function animateListOnScroll(container, nodes, opts = {}) {
    const elements = Array.from(nodes).filter(Boolean);
    if (!container || !elements.length) return null;

    return gsap.to(elements, {
      scrollTrigger: {
        trigger: container,
        start: 'clamp(top 70%)',
        toggleActions: 'play none none none',
        once: true,
        markers: false
      },
      y: 0,
      opacity: 1,
      duration: opts.duration || 0.8,
      ease: opts.ease || 'power3.out',
      stagger: opts.stagger || 0.08
    });
  }

  // 1) Heading
  if (heading) {
    gsap.to(heading, {
      scrollTrigger: {
        trigger: root,
        start: 'clamp(top 80%)',
        toggleActions: 'play none none none',
        once: true,
        markers: false
      },
      y: 0,
      opacity: 1,
      duration: 0.9,
      ease: 'power3.out'
    });
  }

  // 2) Tabs row: animate all tabs as a batch
  if (tabsRow) {
    const tabs = tabsRow.querySelectorAll('.tabbed-product-slider__tab');
    animateListOnScroll(tabsRow, tabs, { stagger: 0.06 });
  }

  // 3) Section button
  if (secBtn) {
    gsap.to(secBtn, {
      scrollTrigger: {
        trigger: secBtn,
        start: 'clamp(top 85%)',
        toggleActions: 'play none none none',
        once: true,
        markers: false
      },
      y: 0,
      opacity: 1,
      duration: 0.8,
      ease: 'power3.out'
    });
  }

  // 4) Active products: titles + forms (stagger) per active tab
  function animateActiveProducts() {
    const activeWrap = root.querySelector('.tabbed-product-slider__products.active');
    if (!activeWrap) return;

    const titles = activeWrap.querySelectorAll('.tabbed-product-slider__product-title');
    const forms  = activeWrap.querySelectorAll('.product-form');

    animateListOnScroll(activeWrap, titles, { stagger: 0.05 });
    animateListOnScroll(activeWrap, forms, { stagger: 0.05, duration: 0.7 });
  }

  animateActiveProducts();

  // Hook into your existing tab logic to re-animate on activation
  const tabsContainer = root.querySelector('#tps-tabs');
  if (tabsContainer) {
    tabsContainer.addEventListener('click', function(e) {
      const tabBtn = e.target.closest('.tabbed-product-slider__tab');
      if (!tabBtn) return;

      setTimeout(() => {
        animateActiveProducts();
        ScrollTrigger.refresh(true);
      }, 200);
    });
  }

  // Safe refresh sequence
  window.addEventListener('load', () => {
    setTimeout(() => {
      scrollTriggerManager.safeRefresh();
    }, 100);
  });
});
</script>




