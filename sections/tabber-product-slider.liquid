                {% comment %} <p class="tabbed-product-slider__product-price" style="font-family: '{{ section.settings.font_body }}', sans-serif; font-size: {{ section.settings.price_size_d }}px; color: {{ section.settings.price_color }}; @media (max-width: 768px) { font-size: {{ section.settings.price_size_m }}px; }">
