<style>

/* Prevent flash and set baseline */
.tabbed-product-slider--{{ section.id }} .tabbed-product-slider__heading,
.tabbed-product-slider--{{ section.id }} .tabbed-product-slider__tabs .tabbed-product-slider__tab,
.tabbed-product-slider--{{ section.id }} .tabbed-product-slider__section-btn,
.tabbed-product-slider--{{ section.id }} .tabbed-product-slider__product-title,
.tabbed-product-slider--{{ section.id }} .product-form {
  opacity: 0;
  transform: translateY(50px);
  will-change: transform, opacity;
}

.tabbed-product-slider {
  padding: var(--tps-padding, 40px 20px);
  background: var(--tps-bg-color, #ffffff);
  max-width: var(--tps-max-width, 1200px);
  margin: 0 auto;
}

.tabbed-product-slider__tabs {
  display: flex;
  justify-content: start;
  gap: 33px;
  margin-bottom: 40px;
  flex-wrap: wrap;
}

.tabbed-product-slider__tab {
  padding: var(--tps-tab-padding, 12px 24px);
  background: var(--tps-tab-inactive-bg, #f5f5f5);
  color: var(--tps-tab-inactive-color, #666666);
  border: none;
  cursor: pointer;
  border-radius: 35px;
  font-family: var(--tps-tab-font-family, system-ui, sans-serif);
  font-size: var(--tps-tab-size-d, 16px);
  transition: all 0.3s ease;
  white-space: nowrap;
  font-weight: 600;
  min-width: 216px;
}

.tabbed-product-slider__tab:hover,
.tabbed-product-slider__tab.active {
  background: var(--tps-tab-active-bg, #000000);
  color: var(--tps-tab-active-color, #ffffff);
}

.tabbed-product-slider__slider {
  margin-bottom: var(--tps-slider-margin, 40px);
  position: relative;
  {% comment %} margin-left: -120px; {% endcomment %}
}

.tabbed-product-slider__products {
  display: none;
}

.tabbed-product-slider__products.active {
  display: block;
}

.tabbed-product-slider__product {
  text-align: center;
  padding: 0 10px;
  flex: 0 0 auto;
  width: auto;
}

.tabbed-product-slider__product-image-container {
  position: relative;
  width: 100%;
  {% comment %} max-width: 240px; {% endcomment %}
  margin: 0 auto;
  height: 350px;
  border-radius: 0px;
  overflow: hidden;
  margin-bottom: 16px;
}

.tabbed-product-slider__product-image-container .go-to-link-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 99;
}

.tabbed-product-slider__product-title > a {text-decoration: none;}
.tabbed-product-slider__product-image-container img:nth-child(3) {
  position: relative;
}
.tabbed-product-slider__product-image-container img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.3s ease;
}

.tabbed-product-slider__product-image-container .featured-image {
  opacity: 0;
  z-index: 2;
}

.tabbed-product-slider__product-image-container:hover .variant-image {
  opacity: 0;
}

.tabbed-product-slider__product-image-container:hover .featured-image {
  opacity: 1;
}

.tabbed-product-slider__product-title {
  font-family: var(--tps-title-font-family, Montserrat, sans-serif);
  font-size: var(--tps-title-size-d, 18px);
  color: var(--tps-title-color, #000000);
  margin: 0 0 8px;
  line-height: 1.3;
}

.tabbed-product-slider__product-price {
  font-family: var(--tps-body-font-family, Roboto, sans-serif);
  font-size: var(--tps-price-size-d, 16px);
  color: var(--tps-price-color, #000000);
  margin: 0 0 16px;
}

.tabbed-product-slider__add-to-cart {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--tps-btn-padding, 10px 20px);
  background: var(--tps-btn-bg, #000000);
  color: var(--tps-btn-color, #ffffff);
  border: none;
  border-radius: 30px;
  font-family: var(--tps-btn-font-family, Montserrat, sans-serif);
  font-size: var(--tps-btn-size-d, 14px);
  cursor: pointer;
  transition: all 0.3s ease;
  text-decoration: none;
  width: 100%;
  margin-top: 0px;
  max-width: 180px;
  margin: 0px;
  border: 1px solid var(--tps-btn-color, #ffffff);
  margin-top:6px;
  font-weight:600;
  line-height:24px;
}

.tabbed-product-slider__add-to-cart:hover {
  background: var(--tps-btn-hover-bg, #333333) !important;
  color: var(--tps-btn-hover-color, #ffffff) !important;
}

.tabbed-product-slider__section-btn {
  display: block;
  margin: 0 60px 0 auto;
  padding: var(--tps-section-btn-padding, 14px 28px);
  background: var(--tps-section-btn-bg, #000000);
  color: var(--tps-section-btn-color, #ffffff);
  text-align: center;
  border-radius: 4px;
  font-family: var(--tps-section-btn-font-family, system-ui, sans-serif);
  font-size: var(--tps-section-btn-size, 16px);
  text-decoration: none;
  max-width: fit-content;
  border: 1px solid var(--tps-section-btn-color, #ffffff);
  border-radius: 35px;
  font-weight: 600;
  min-width: 216px;
}

.tabbed-product-slider__section-btn:hover {
  background: var(--tps-section-btn-hover-bg, #333333) !important;
  color: var(--tps-section-btn-hover-color, #ffffff) !important;
}

/* Swiper Styles */
.tps-product-grid {
  overflow: hidden;
  margin: 0;
  padding: 0 10px;
}

.tps-product-grid .swiper-wrapper {
  padding: 0;
}

.tps-product-grid .swiper-slide {
  padding: 0;
  height: auto;
  {% comment %} width: calc((100% / {{ section.settings.slides_desktop | default: 5 }}) - 20px); {% endcomment %}
  margin-right: 20px;
}

.tps-product-grid .swiper-slide:last-child {
  margin-right: 0;
}

.tps-product-grid .swiper-button-prev,
.tps-product-grid .swiper-button-next {
  color: var(--tps-arrow-color, #333333) !important;
  width: 44px;
  margin-top: -22px;
  z-index: 50;
  top:41%;
}

.tps-product-grid .swiper-button-prev {
  left: 0%;
}

.tps-product-grid .swiper-button-next {
  right: 0;
}

.tps-product-grid .swiper-button-prev:after,
.tps-product-grid .swiper-button-next:after {
  font-size: 24px;
  font-weight: bold;
}

.tabbed-product-slider__products .tps-product-grid.swiper .swiper-wrapper {
    padding-bottom: 10px;
}
.tps-product-grid {
    opacity: 0;
    transition: opacity 200ms ease;
}

.tps-product-grid.swiper-initialized {
    opacity: 1;
}

/* Mobile adjustments */
@media (max-width: 768px) {
  .tabbed-product-slider {
    padding: var(--tps-mobile-padding, 20px 15px);
  }
  .tabbed-product-slider__product-image-container {
      height: 220px;
  }
  .tabbed-product-slider__tabs {
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
  }
  
  .tabbed-product-slider__tab {
    font-size: var(--tps-tab-size-m, 14px) !important;
    width: fit-content;
    min-width:unset;
    max-width: 300px;
    text-align: center;
    padding: 12px 20px !important;
  }
  
  .tabbed-product-slider__slider {
    margin-left: 0px;
  }

  .tps-product-grid {
    padding:0px;
  }

  .tps-product-grid .swiper-button-prev, .tps-product-grid .swiper-button-next {
    width: 25px;
    height: 25px;
  }
  .tps-product-grid .swiper-button-prev:after, .tps-product-grid .swiper-button-next:after {
      font-size: 10px;
      font-weight: bold;
  }

  .tabbed-product-slider__slider {
    margin-bottom:0px !important;
  }

  {% comment %} .tabbed-product-slider__slider .tps-product-grid .swiper-wrapper {
      margin-left: -120px;
  } {% endcomment %}

  .tabbed-product-slider__section-btn {
      padding: 10px 16px !important;
      min-width: unset;
      margin: 0px;
      line-height:normal;
      font-size: var(--tps-section-btn-size-m, 13px) !important;
  }

  .tabbed-product-slider__product-title {
    font-size: var(--tps-title-size-m, 16px) !important;
  }
  
  .tabbed-product-slider__product-price {
    font-size: var(--tps-price-size-m, 14px) !important;
  }
  
  .tabbed-product-slider__add-to-cart {
    font-size: var(--tps-btn-size-m, 12px) !important;
  }
  
  /* .tabbed-product-slider__product-image-container {
    height: 180px;
  } */
}

@media (max-width:400px){

.tabbed-product-slider__tabs {
  gap: 4px;
}

}

@media (min-width: 769px) and (max-width: 1023px) {
  .tps-product-grid .swiper-slide {
    width: calc((100% / 4) - 20px);
  }
}

@media (min-width: 1024px) and (max-width: 1199px) {
  .tps-product-grid .swiper-slide {
    width: calc((100% / 5) - 20px);
  }
}

@media (min-width: 1200px) {
  .tps-product-grid .swiper-slide {
    width: calc((100% / 6) - 20px);
  }
}
</style>

<style>
  .tabbed-product-slider--{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    padding-left: {{ section.settings.padding-left }}px;
    padding-right: {{ section.settings.padding-right }}px;
  }
  .tabbed-product-slider__heading {
    font-family: '{{ section.settings.font_heading }}', sans-serif;
    font-weight:{{ section.settings.heading_weight }};
    font-size: {{ section.settings.heading_size_d }}px;
    color: {{ section.settings.heading_color }};
    text-align: start;
    margin-bottom: 40px;
  }
  .tabbed-product-slider__tab.active {
    background: {{ section.settings.tab_active_bg }} !important;
    color: {{ section.settings.tab_active_color }} !important;
  }
  .tabbed-product-slider__product-image-container .tags {
      position: absolute;
      z-index: 99;
      right: 0;
      top: 0;
      padding: 5px 10px;
  }

  .tags .dark {
      font-family: Montserrat;
      font-weight: 500;
      font-style: Medium;
      font-size: 12px;
      leading-trim: NONE;
      line-height: 100%;
      letter-spacing: 0%;
      vertical-align: middle;
      color: #FFFFFF;
      background: #000000;
      padding: 3px 7px;
      border-radius: 5px;
  }

  .tags .light {
      font-family: Montserrat;
      font-weight: 500;
      font-style: Medium;
      font-size: 12px;
      leading-trim: NONE;
      line-height: 100%;
      letter-spacing: 0%;
      vertical-align: middle;
      color: #000000;
      background: #FFFFFF;
      padding: 3px 7px;
      border-radius: 5px;
  }

  .tabbed-product-slider__section-btn span.desk-text {
        display:block;
  }
  .tabbed-product-slider__section-btn span.mob-text {
      display:none;
  }

  .tabbed-product-slider__slider .swiper-button-prev.swiper-button-disabled, .tabbed-product-slider__slider .swiper-button-next.swiper-button-disabled {
        pointer-events: all;
        cursor: not-allowed;
  }

  @media (max-width:768px){
      .tabbed-product-slider__section-btn span.desk-text {
            display:none;
      }
      .tabbed-product-slider__section-btn span.mob-text {
          display:block;
      }
  }
  @media (max-width: 768px) {
    .tabbed-product-slider--{{ section.id }} {
      padding-top: {{ section.settings.padding-top-mob }}px;
      padding-bottom: {{ section.settings.padding-bottom-mob }}px;
      padding-left: {{ section.settings.padding-left-mob }}px;
      padding-right: {{ section.settings.padding-right-mob }}px;
    }
    .tabbed-product-slider__heading {
      font-size: {{ section.settings.heading_size_m }}px;
      margin-bottom: 16px;
    }
  }
</style>

