<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize all rugs slider sections with unique selectors
  document.querySelectorAll('[data-rugs-slider]').forEach(function(section) {
    var sectionId = section.getAttribute('data-section-id');
    var tabsWrap = document.getElementById('tabs-' + sectionId);
    
    if (!tabsWrap) {
      console.warn('Tabs container not found for section:', sectionId);
      return;
    }

    var tabs = tabsWrap.querySelectorAll('.tab-btn--' + sectionId);
    var panels = section.querySelectorAll('.tab-panel--' + sectionId);
    var currentMainSwiper = null;
    var cardSwipers = [];
    var slidesDesktop = parseInt(section.getAttribute('data-slides-desktop') || '4', 10);
    var activeClass = 'is-active--' + sectionId;

    // Initialize card image sliders in a panel
    function initCardSliders(panel) {
      var cardSliderEls = panel.querySelectorAll('[data-card-image-slider]');
      cardSliderEls.forEach(function(sliderEl) {
        if (sliderEl.swiper) return;
        
        try {
          var cardSwiper = new Swiper(sliderEl, {
            slidesPerView: 1,
            spaceBetween: 0,
            loop: true,
            // keep swipe for inner slider
            allowTouchMove: true,

            navigation: {
              nextEl: sliderEl.querySelector('.card-media-arrow-next'),
              prevEl: sliderEl.querySelector('.card-media-arrow-prev')
            },

            pagination: {
              el: sliderEl.querySelector('.swiper-pagination'),
              clickable: true,
              dynamicBullets: false
            },
            speed: 400,
            effect: 'slide'
          });

          cardSwipers.push(cardSwiper);
        } catch (e) {
          console.error('Error initializing card slider:', e);
        }
      });
    }

    // Destroy all card sliders
    function destroyCardSliders() {
      cardSwipers.forEach(function(swiper) {
        if (swiper && swiper.destroy) {
          swiper.destroy(true, true);
        }
      });
      cardSwipers = [];
    }

    // Create main product grid swiper
    function createMainSwiper(gridEl) {
  if (!gridEl) return null;
  
  if (currentMainSwiper) {
    currentMainSwiper.destroy(true, true);
    currentMainSwiper = null;
  }

  // Find arrows inside this specific grid
  var nextBtn = gridEl.querySelector('.outer-arrow-next');
  var prevBtn = gridEl.querySelector('.outer-arrow-prev');

  if (!nextBtn || !prevBtn) {
    console.warn('Main swiper nav elements not found for section:', sectionId, { nextBtn, prevBtn });
  }

  try {
    currentMainSwiper = new Swiper(gridEl, {
      slidesPerView: Math.max(2, slidesDesktop),
      spaceBetween: 16,

      // Only arrows, no drag/scroll
      {% comment %} allowTouchMove: false,
      simulateTouch: false,
      grabCursor: false, {% endcomment %}

      navigation: {
        nextEl: nextBtn,
        prevEl: prevBtn
      },

      // If Swiper thinks there is no overflow, it disables arrows;
      // set to false to keep arrows clickable.
      watchOverflow: false,

      breakpoints: {
        0:    { slidesPerView: 1.2, spaceBetween: 12 },
        480:  { slidesPerView: 1.4, spaceBetween: 12 },
        768:  { slidesPerView: 2.4, spaceBetween: 14 },
        1024: { slidesPerView: Math.max(3, slidesDesktop - 1), spaceBetween: 16 },
        1200: { slidesPerView: Math.max(3, slidesDesktop), spaceBetween: 16 }
      }
    });

    console.log('Main swiper initialized for section:', sectionId, { nextBtn, prevBtn });
  } catch (e) {
    console.error('Error initializing main swiper:', e);
  }
  
  return currentMainSwiper;
}


    // Initialize the active panel
    function initActivePanel() {
      var activePanel = section.querySelector('.tab-panel--' + sectionId + '.' + activeClass);
      if (!activePanel) return;
      
      var activeGrid = activePanel.querySelector('[data-main-grid]');
      if (activeGrid && activeGrid.querySelector('.swiper-slide')) {
        createMainSwiper(activeGrid);
        
        setTimeout(function() {
          initCardSliders(activePanel);
        }, 100);
      }
    }

    // Tab click handlers
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        var targetTabId = this.getAttribute('data-tab-target');
        var tabSectionId = this.getAttribute('data-section');
        
        console.log('Tab clicked:', targetTabId, 'for section:', tabSectionId);

        // Update active tab
        tabs.forEach(function(t) { 
          t.classList.remove(activeClass); 
        });
        this.classList.add(activeClass);

        // Hide all panels
        panels.forEach(function(p) { 
          p.classList.remove(activeClass); 
        });

        // Show target panel
        var panelId = 'panel-' + tabSectionId + '-' + targetTabId;
        var targetPanel = document.getElementById(panelId);
        
        if (targetPanel) {
          targetPanel.classList.add(activeClass);
          
          // Destroy old card sliders
          destroyCardSliders();
          
          // Initialize new panel
          var grid = targetPanel.querySelector('[data-main-grid]');
          if (grid) {
            createMainSwiper(grid);
            
            setTimeout(function() {
              initCardSliders(targetPanel);
            }, 150);
          }
        } else {
          console.warn('Panel not found:', panelId);
        }
      });
    });

    // Initial load
    setTimeout(function() {
      initActivePanel();
    }, 100);
  });
});
</script>

