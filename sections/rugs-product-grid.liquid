}
.inner-slider > .swiper-button-next {
     width: 26px !important;
    height: 26px !important;
    
}
.inner-slider .swiper-button-prev::after {
    font-size:12px !important;
}
.inner-slider .swiper-button-next::after {
  font-size:12px !important;
}
