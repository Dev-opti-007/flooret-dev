<div class="tabbed-product-slider--{{ section.id }}" data-rugs-slider data-section-id="{{ section.id }}" data-slides-desktop="{{ section.settings.slidesdesktop }}"
style="--tps-bg-color: {{ section.settings.bgcolor }};">
  <div
    class="tabbed-product-slider--{{ section.id }}__inner"
    style="
      --tps-padding: 20px;
      --tps-bg-color: {{ section.settings.bgcolor }};
      --tps-max-width: {{ section.settings.maxwidth }}px;
      --tps-arrow-color: #333333;
    "
  >

    <div class="section-wrap--{{ section.id }}">
      {% if section.settings['section-logo'] != blank %}
        <img src="{{ section.settings['section-logo'] | img_url: '300x' }}" alt="{{ section.settings['section-logo'].alt | escape }}">
      {% endif %}
      {% if section.settings.sectionheading != blank %}
        <h2 class="heading--{{ section.id }}">{{ section.settings.sectionheading }}</h2>
      {% endif %}
    </div>

    {% if section.settings.subtext != blank %}
      <div class="subtext--{{ section.id }}">{{ section.settings.subtext }}</div>
    {% endif %}

    {% assign tabblocks = section.blocks | where: 'type', 'tab' %}
    {% assign cardblocks = section.blocks | where: 'type', 'product_card' %}

    {% if tabblocks.size > 0 %}
      {% assign initial_tab_id = tabblocks.first.settings.tab_id | default: tabblocks.first.id | strip | handleize %}
      <div class="btns-wrap tabs-wrap--{{ section.id }}" id="tabs-{{ section.id }}" data-initial-tab="{{ initial_tab_id }}">
        {% for block in tabblocks %}
          {% assign tabid_raw = block.settings.tab_id | default: block.id | strip %}
          {% assign tabid_safe = tabid_raw | handleize %}
          <button class="tab-btns tab-btn--{{ section.id }} {% if forloop.first %}is-active--{{ section.id }}{% endif %}" 
                  data-tab-target="{{ tabid_safe }}" 
                  data-section="{{ section.id }}"
                  type="button">
            {{ block.settings.tabtitle | default: tabid_raw | escape }}
          </button>
        {% endfor %}
        {% if section.settings.sectionbuttonlabel != blank and section.settings.sectionbuttonurl != blank %}
        <a class="shop-btns section-btn--{{ section.id }}" href="{{ section.settings.sectionbuttonurl }}">
          {{ section.settings.sectionbuttonlabel }}
        </a>
      {% endif %}
      </div>

      <div class="slider-wrap--{{ section.id }}">
        {% for tabblock in tabblocks %}
          {% assign tabid_raw = tabblock.settings.tab_id | default: tabblock.id | strip %}
          {% assign tabid_safe = tabid_raw | handleize %}
          {% assign hascards = false %}

          <div id="panel-{{ section.id }}-{{ tabid_safe }}" 
               class="tab-panel--{{ section.id }} {% if forloop.first %}is-active--{{ section.id }}{% endif %}"
               data-panel-id="{{ tabid_safe }}">
            <div class="product-grid--{{ section.id }} swiper outer-slider" data-main-grid>
              <div class="swiper-wrapper">
                {% for cardblock in cardblocks %}
                  {% assign link_raw = cardblock.settings.tab_link | default: '' | strip %}
                  {% if link_raw == tabid_raw %}
                    {% assign hascards = true %}
                    {% assign url = cardblock.settings.url %}
                    {% assign newtab = cardblock.settings['open-in-new-page'] %}
                    {% assign img1 = cardblock.settings.image1 %}
                    {% assign img2 = cardblock.settings.image2 %}
                    {% assign img3 = cardblock.settings.image3 %}
                    {% assign title_text = cardblock.settings['product-title'] %}
                    
                    {% assign image_count = 0 %}
                    {% if img1 != blank %}{% assign image_count = image_count | plus: 1 %}{% endif %}
                    {% if img2 != blank %}{% assign image_count = image_count | plus: 1 %}{% endif %}
                    {% if img3 != blank %}{% assign image_count = image_count | plus: 1 %}{% endif %}

                    <div class="swiper-slide">
                      <div class="product-card--{{ section.id }}">
                        <div class="card-media--{{ section.id }}">
                          {% if image_count > 1 %}
                            {%comment%} Multiple images - use slider showing 1 at a time {%endcomment%}
                            <div class="swiper card-slider-{{ section.id }}-{{ forloop.index }} inner-slider" data-card-image-slider>
                              <div class="swiper-wrapper">
                                {% if img1 != blank %}
                                  <div class="swiper-slide">
                                    <a href="{{ url }}" {% if newtab %}target="_blank" rel="noopener"{% endif %}>
                                      <img src="{{ img1 | image_url: width: 800 }}" alt="{{ title_text | default: tabid_raw | escape }}">
                                    </a>
                                  </div>
                                {% endif %}
                                {% if img2 != blank %}
                                  <div class="swiper-slide">
                                    <a href="{{ url }}" {% if newtab %}target="_blank" rel="noopener"{% endif %}>
                                      <img src="{{ img2 | image_url: width: 800 }}" alt="{{ title_text | default: tabid_raw | escape }}">
                                    </a>
                                  </div>
                                {% endif %}
                                {% if img3 != blank %}
                                  <div class="swiper-slide">
                                    <a href="{{ url }}" {% if newtab %}target="_blank" rel="noopener"{% endif %}>
                                      <img src="{{ img3 | image_url: width: 800 }}" alt="{{ title_text | default: tabid_raw | escape }}">
                                    </a>
                                  </div>
                                {% endif %}
                              </div>
                              <div class="swiper-pagination"></div>
                              <div class="swiper-button-prev card-media-arrow-prev"></div>
                              <div class="swiper-button-next card-media-arrow-next"></div>
                            </div>
                          {% else %}
                            {%comment%} Single image - no slider needed {%endcomment%}
                            <a href="{{ url }}" {% if newtab %}target="_blank" rel="noopener"{% endif %}>
                              {% if img1 != blank %}
                                <img src="{{ img1 | image_url: width: 800 }}" alt="{{ title_text | default: tabid_raw | escape }}">
                              {% endif %}
                            </a>
                          {% endif %}
                        </div>
                        
                        {% if title_text != blank %}
                          <a class="card-title--{{ section.id }}" href="{{ url }}" {% if newtab %}target="_blank" rel="noopener"{% endif %}>
                            {{ title_text }}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>

             <div class="swiper-button-prev outer-arrow-prev"></div>
            <div class="swiper-button-next outer-arrow-next"></div>
            </div>

            {% unless hascards %}
              <div style="text-align:center; color:#777; padding:20px 0;">No cards linked to this tab.</div>
            {% endunless %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
  <div class="usps" >
    <div class="usp" >
      <img src="https://cdn.shopify.com/s/files/1/0698/3761/9475/files/ec0557816b4d0b1b4a1db3f946d3dcca4c653121.png?v=1764250325" width="50" height="50">
      <span>Machine Washable</span>
    </div>
    <div class="usp" >
     <img src="https://cdn.shopify.com/s/files/1/0698/3761/9475/files/c5cce037be9a7f5a7ab8c5af9a5d154f3878b89c.png?v=1764250328" width="50" height="50">
      <span>Non-Slip</span>
    </div>
     <div class="usp" >
     <img src="https://cdn.shopify.com/s/files/1/0698/3761/9475/files/dc61a956a75b62488318f39858485c6bf7525555.png?v=1764250330" width="50" height="50">
      <span>Pet-Friendly</span>
    </div>
    <div class="usp" >
     <img src="https://cdn.shopify.com/s/files/1/0698/3761/9475/files/1ca2cbf6f34a77ea59e5c2d7b45b451f5a319cda.png?v=1764250332" width="50" height="50">
      <span>Spill-proof</span>
    </div>
  </div>
</div>

