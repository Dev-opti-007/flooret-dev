<style>
/* Scope everything to this section instance */
.tabbed-product-slider--{{ section.id }} {
  padding-top: {{ section.settings['padding-top'] }}px;
  padding-bottom: {{ section.settings['padding-bottom'] }}px;
  padding-left: {{ section.settings['padding-left'] }}px;
  padding-right: {{ section.settings['padding-right'] }}px;
  background: var(--tps-bg-color, #ffffff);
}

.tabbed-product-slider--{{ section.id }} .tabbed-product-slider--{{ section.id }}__inner {
  padding: var(--tps-padding, 40px 20px);
  background: var(--tps-bg-color, #ffffff);
  max-width: var(--tps-max-width, 1200px);
  margin: 0 auto;
}

/* Header */
.tabbed-product-slider--{{ section.id }} .section-wrap--{{ section.id }} {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.tabbed-product-slider--{{ section.id }} .section-wrap--{{ section.id }} img {
  max-height: 48px;
  width: auto;
  display: inline-block;
}
.tabbed-product-slider--{{ section.id }} .heading--{{ section.id }} {
  margin: 0;
  font-family: {{ section.settings.fontheading }}, sans-serif;
  font-weight: {{ section.settings.headingweight }};
  font-size: {{ section.settings.headingsized }}px;
  color: {{ section.settings.headingcolor }};
      {% comment %} margin-left: 15px; {% endcomment %}
}

/* Subtext */
.tabbed-product-slider--{{ section.id }} .subtext--{{ section.id }} {
  color: {{ section.settings.subtextcolor }};
  font-size: {{ section.settings.subtextsized }}px;
  font-family: {{ section.settings.fontsubtext }};
  margin: 6px 0 20px;
}

/* Tabs */
.tabbed-product-slider--{{ section.id }} .tabs-wrap--{{ section.id }} {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 20px;
}
.tabbed-product-slider--{{ section.id }} .tab-btn--{{ section.id }} {
  padding: {{ section.settings.tabpadding }}px 20px;
  background: {{ section.settings.tabinactivebg }};
  color: {{ section.settings.tabinactivecolor }};
  border: none;
  border-radius: 30px;
  cursor: pointer;
  font-family: {{ section.settings.fonttab }}, sans-serif;
  font-size: {{ section.settings.tabsized }}px;
  font-weight: 600;
  transition: background .2s ease, color .2s ease;
}
.tabbed-product-slider--{{ section.id }} .tab-btn--{{ section.id }}:hover,
.tabbed-product-slider--{{ section.id }} .tab-btn--{{ section.id }}.is-active--{{ section.id }} {
  background: {{ section.settings.tabactivebg }};
  color: {{ section.settings.tabactivecolor }};
}

/* Slider area / tab panels */
.tabbed-product-slider--{{ section.id }} .tab-panel--{{ section.id }} { 
  display: none; 
}
.tabbed-product-slider--{{ section.id }} .tab-panel--{{ section.id }}.is-active--{{ section.id }} { 
  display: block; 
}

/* Swiper essentials for main product grid */
.tabbed-product-slider--{{ section.id }} .product-grid--{{ section.id }} { 
  position: relative; 
  overflow: hidden; 
}
.tabbed-product-slider--{{ section.id }} .product-grid--{{ section.id }} .swiper-wrapper { 
  align-items: stretch; 
}
.tabbed-product-slider--{{ section.id }} .product-grid--{{ section.id }} .swiper-slide { 
  height: auto; 
}

/* Card */
.tabbed-product-slider--{{ section.id }} .product-card--{{ section.id }} {
  background: {{ section.settings['product-card-bg'] | default: 'transparent' }};
  border-radius: 5px;
  overflow: hidden;
}

/* Card media slider - 1 image at a time */
.tabbed-product-slider--{{ section.id }} .card-media--{{ section.id }} {
  position: relative;
  width: 100%;
  overflow: hidden;
}
.tabbed-product-slider--{{ section.id }} .card-media--{{ section.id }} .swiper {
  width: 100%;
}
.tabbed-product-slider--{{ section.id }} .card-media--{{ section.id }} .swiper-slide {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f9f9f9;
  width: 100%;
}
.tabbed-product-slider--{{ section.id }} .card-media--{{ section.id }} img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
    max-height: 410px;
}

/* Card media pagination dots */
.tabbed-product-slider--{{ section.id }} .card-media--{{ section.id }} .swiper-pagination {
  bottom: 0px !important;
  left: 0;
  width: 100%;
  text-align: center;
  z-index: 10;
  background:{{ section.settings.product-card-bg }};
}
.tabbed-product-slider--{{ section.id }} .card-media--{{ section.id }} .swiper-pagination-bullet {
  background: #D9D9D9;
  opacity: 0.6;
  width: 8px;
  height: 8px;
  margin: 0 4px;
  border-radius: 50%;
  transition: all 0.3s ease;
}
.tabbed-product-slider--{{ section.id }} .card-media--{{ section.id }} .swiper-pagination-bullet-active {
  opacity: 1;
  background: #000;
  width: 10px;
  height: 10px;
}

.tabbed-product-slider--{{ section.id }} .card-title--{{ section.id }} {
  display: block;
  margin: 10px 10px 14px;
  font-family: {{ section.settings.fonttitle }}, sans-serif;
  font-size: {{ section.settings.titlesized }}px;
  font-weight:{{ section.settings.titleweight }};
  color: {{ section.settings.titlecolor }};
  text-decoration: none;
  line-height: 1.3;
  text-align:center;
}

/* Section button */
.tabbed-product-slider--{{ section.id }} .section-btn--{{ section.id }} {
  display: inline-block;
  margin-left: auto;
  padding: {{ section.settings.sectionbtnpadding }}px 20px;
  border-radius: 30px;
  text-decoration: none;
  font-family: {{ section.settings.fontsectionbtn }}, sans-serif;
  font-size: {{ section.settings.sectionbtnsize }}px;
  color: {{ section.settings.sectionbtncolor }};
  background: {{ section.settings.sectionbtnbg }};
  border: 1px solid {{ section.settings.sectionbtncolor }};
}

/* Arrows for main grid */
.tabbed-product-slider--{{ section.id }} .product-grid--{{ section.id }} .swiper-button-prev,
.tabbed-product-slider--{{ section.id }} .product-grid--{{ section.id }} .swiper-button-next {
  color: var(--tps-arrow-color, #333);
  width: 40px;
  height: 40px;
}
.tabbed-product-slider--{{ section.id }} .product-grid--{{ section.id }} .swiper-button-prev:after,
.tabbed-product-slider--{{ section.id }} .product-grid--{{ section.id }} .swiper-button-next:after {
  font-size: 20px;
}

.outer-slider > .swiper-button-prev {
    width: 32px !important;
    height: 32px !important;
    left:0px;
        z-index: 999;
    border-radius: 10px;
}

.outer-slider > .swiper-button-next {
      width: 32px !important;
      height: 32px !important;
      right: 0px;
          z-index: 999;
      border-radius: 10px;
}

.outer-slider .swiper-button-prev::after {
    font-size:12px !important;
}
.outer-slider .swiper-button-next::after {
  font-size:12px !important;
}
.inner-slider > .swiper-button-prev {
     width: 26px !important;
