<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('Image Text Hero GSAP Script - DOMContentLoaded triggered');
  
  if (!window.gsap || !window.ScrollTrigger) {
    console.error('Image Text Hero GSAP Script - GSAP or ScrollTrigger not loaded');
    console.log('window.gsap:', !!window.gsap);
    console.log('window.ScrollTrigger:', !!window.ScrollTrigger);
    return;
  }

  console.log('Image Text Hero GSAP Script - GSAP and ScrollTrigger are available');
  gsap.registerPlugin(ScrollTrigger);
  console.log('Image Text Hero GSAP Script - ScrollTrigger plugin registered');

  // Check for scrollTriggerManager availability
  if (typeof scrollTriggerManager === 'undefined') {
    console.warn('Image Text Hero GSAP Script - scrollTriggerManager is not available');
  } else {
    console.log('Image Text Hero GSAP Script - scrollTriggerManager is available');
    console.log('scrollTriggerManager methods:', Object.keys(scrollTriggerManager));
  }

  // Mid-page refresh guard (already exists globally)
  console.log('Image Text Hero GSAP Script - Attempting scrollTriggerManager.revealIfInViewAll');
  const revealTargets = '.image-text-hero .image-text-hero__heading, ' +
                        '.image-text-hero .image-text-hero__subheading, ' +
                        '.image-text-hero .image-text-hero__button';
  
  console.log('Image Text Hero GSAP Script - Reveal targets string:', revealTargets);
  
  const revealElements = document.querySelectorAll(revealTargets);
  console.log('Image Text Hero GSAP Script - Reveal target elements found:', revealElements.length);
  
  revealElements.forEach((el, index) => {
    console.log(`Image Text Hero GSAP Script - Reveal target ${index + 1}:`, el.tagName, 'Classes:', el.className, 'ID:', el.id);
  });

  if (typeof scrollTriggerManager !== 'undefined' && scrollTriggerManager.revealIfInViewAll) {
    try {
      scrollTriggerManager.revealIfInViewAll(revealTargets);
      console.log('Image Text Hero GSAP Script - scrollTriggerManager.revealIfInViewAll executed successfully');
    } catch (error) {
      console.error('Image Text Hero GSAP Script - Error in revealIfInViewAll:', error);
    }
  } else {
    console.warn('Image Text Hero GSAP Script - scrollTriggerManager.revealIfInViewAll not available, skipping');
  }

  // Use matchMedia for responsive animations
  console.log('Image Text Hero GSAP Script - Setting up matchMedia for responsive animations');
  
  const mm = gsap.matchMedia();
  
  mm.add('(min-width: 769px)', () => {
    console.log('Image Text Hero GSAP Script - Desktop matchMedia activated (min-width: 769px)');
    
    // Find all image-text-hero sections
    const heroSections = document.querySelectorAll('.image-text-hero');
    console.log('Image Text Hero GSAP Script - Desktop: Found hero sections:', heroSections.length);
    
    heroSections.forEach((hero, heroIndex) => {
      console.log(`Image Text Hero GSAP Script - Desktop: Processing hero ${heroIndex + 1}:`, hero.className, hero.id);
      
      const heading = hero.querySelector('.image-text-hero__heading');
      const sub = hero.querySelector('.image-text-hero__subheading');
      const button = hero.querySelector('.image-text-hero__button');
      
      console.log(`Image Text Hero GSAP Script - Desktop Hero ${heroIndex + 1}:`, {
        heading: !!heading,
        sub: !!sub,
        button: !!button
      });
      
      if (!heading && !sub && !button) {
        console.warn(`Image Text Hero GSAP Script - Desktop Hero ${heroIndex + 1}: No target elements found, skipping`);
        console.log(`Hero ${heroIndex + 1} available elements:`, hero.innerHTML.substring(0, 200) + '...');
        return;
      }

      // Debug initial state
      if (heading) {
        console.log(`Hero ${heroIndex + 1} heading initial state:`, {
          opacity: window.getComputedStyle(heading).opacity,
          transform: window.getComputedStyle(heading).transform
        });
      }

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'clamp(top 75%)',
          end: 'bottom 20%',
          toggleActions: 'play none none reverse',
          once: true,
          markers: false,
          id: `hero-${heroIndex + 1}-desktop`,
          onEnter: () => console.log(`Hero ${heroIndex + 1} desktop ScrollTrigger onEnter`),
          onLeave: () => console.log(`Hero ${heroIndex + 1} desktop ScrollTrigger onLeave`),
          onToggle: (self) => console.log(`Hero ${heroIndex + 1} desktop ScrollTrigger toggled, isActive:`, self.isActive),
          onRefresh: (self) => console.log(`Hero ${heroIndex + 1} desktop ScrollTrigger refreshed, progress:`, self.progress)
        }
      });

      console.log(`Hero ${heroIndex + 1} desktop timeline created:`, tl);

      let hasAnimations = false;
      
      if (heading) {
        tl.to(heading, { 
          y: 0, 
          opacity: 1, 
          duration: 0.8, 
          ease: 'power3.out',
          onStart: () => console.log(`Hero ${heroIndex + 1} desktop heading animation started`),
          onComplete: () => console.log(`Hero ${heroIndex + 1} desktop heading animation completed`)
        }, 0);
        hasAnimations = true;
      }
      
      if (sub) {
        tl.to(sub, { 
          y: 0, 
          opacity: 1, 
          duration: 0.8, 
          ease: 'power3.out',
          onStart: () => console.log(`Hero ${heroIndex + 1} desktop subheading animation started`),
          onComplete: () => console.log(`Hero ${heroIndex + 1} desktop subheading animation completed`)
        }, 0.15);
        hasAnimations = true;
      }
      
      if (button) {
        tl.to(button, { 
          y: 0, 
          opacity: 1, 
          duration: 0.8, 
          ease: 'power3.out',
          onStart: () => console.log(`Hero ${heroIndex + 1} desktop button animation started`),
          onComplete: () => console.log(`Hero ${heroIndex + 1} desktop button animation completed`)
        }, 0.30);
        hasAnimations = true;
      }
      
      if (!hasAnimations) {
        console.warn(`Hero ${heroIndex + 1} desktop: No animations created, timeline is empty`);
      }
    });
    
    console.log('Image Text Hero GSAP Script - Desktop matchMedia setup complete');
  });

  mm.add('(max-width: 768px)', () => {
    console.log('Image Text Hero GSAP Script - Mobile matchMedia activated (max-width: 768px)');
    
    // Find all image-text-hero sections
    const heroSections = document.querySelectorAll('.image-text-hero');
    console.log('Image Text Hero GSAP Script - Mobile: Found hero sections:', heroSections.length);
    
    heroSections.forEach((hero, heroIndex) => {
      console.log(`Image Text Hero GSAP Script - Mobile: Processing hero ${heroIndex + 1}:`, hero.className, hero.id);
      
      const heading = hero.querySelector('.image-text-hero__heading');
      const sub = hero.querySelector('.image-text-hero__subheading');
      const button = hero.querySelector('.image-text-hero__button');
      
      console.log(`Image Text Hero GSAP Script - Mobile Hero ${heroIndex + 1}:`, {
        heading: !!heading,
        sub: !!sub,
        button: !!button
      });
      
      if (!heading && !sub && !button) {
        console.warn(`Image Text Hero GSAP Script - Mobile Hero ${heroIndex + 1}: No target elements found, skipping`);
        return;
      }

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: 'clamp(top 50%)', // Earlier trigger on mobile
          end: 'bottom 10%',
          toggleActions: 'play none none reverse',
          once: true,
          markers: false,
          id: `hero-${heroIndex + 1}-mobile`,
          onEnter: () => console.log(`Hero ${heroIndex + 1} mobile ScrollTrigger onEnter`),
          onLeave: () => console.log(`Hero ${heroIndex + 1} mobile ScrollTrigger onLeave`),
          onToggle: (self) => console.log(`Hero ${heroIndex + 1} mobile ScrollTrigger toggled, isActive:`, self.isActive),
          onRefresh: (self) => console.log(`Hero ${heroIndex + 1} mobile ScrollTrigger refreshed, progress:`, self.progress)
        }
      });

      console.log(`Hero ${heroIndex + 1} mobile timeline created:`, tl);

      let hasAnimations = false;
      
      if (heading) {
        tl.to(heading, { 
          y: 0, 
          opacity: 1, 
          duration: 0.7, // Slightly faster on mobile
          ease: 'power3.out',
          onStart: () => console.log(`Hero ${heroIndex + 1} mobile heading animation started`),
          onComplete: () => console.log(`Hero ${heroIndex + 1} mobile heading animation completed`)
        }, 0);
        hasAnimations = true;
      }
      
      if (sub) {
        tl.to(sub, { 
          y: 0, 
          opacity: 1, 
          duration: 0.7, 
          ease: 'power3.out',
          onStart: () => console.log(`Hero ${heroIndex + 1} mobile subheading animation started`),
          onComplete: () => console.log(`Hero ${heroIndex + 1} mobile subheading animation completed`)
        }, 0.12);
        hasAnimations = true;
      }
      
      if (button) {
        tl.to(button, { 
          y: 0, 
          opacity: 1, 
          duration: 0.7, 
          ease: 'power3.out',
          onStart: () => console.log(`Hero ${heroIndex + 1} mobile button animation started`),
          onComplete: () => console.log(`Hero ${heroIndex + 1} mobile button animation completed`)
        }, 0.24);
        hasAnimations = true;
      }
      
      if (!hasAnimations) {
        console.warn(`Hero ${heroIndex + 1} mobile: No animations created, timeline is empty`);
      }
    });
    
    console.log('Image Text Hero GSAP Script - Mobile matchMedia setup complete');
  });

  // Add cleanup for matchMedia
  mm.add('all', () => {
    // This runs on every breakpoint change
    console.log('Image Text Hero GSAP Script - matchMedia breakpoint changed');
  });

  console.log('Image Text Hero GSAP Script - matchMedia setup complete');

  // Robust refresh sequence
  console.log('Image Text Hero GSAP Script - Setting up refresh sequence');
  window.addEventListener('load', () => {
    console.log('Image Text Hero GSAP Script - Window load event fired');
    setTimeout(() => {
      if (typeof scrollTriggerManager !== 'undefined' && scrollTriggerManager.safeRefresh) {
        scrollTriggerManager.safeRefresh(50);
        console.log('Image Text Hero GSAP Script - scrollTriggerManager.safeRefresh called');
      } else {
        // Fallback refresh
        if (ScrollTrigger) {
          ScrollTrigger.refresh();
          console.log('Image Text Hero GSAP Script - Fallback ScrollTrigger.refresh called');
        }
      }
    }, 50);
  });

  // Additional refresh on resize
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (ScrollTrigger) {
        ScrollTrigger.refresh();
        console.log('Image Text Hero GSAP Script - ScrollTrigger refreshed on resize');
      }
    }, 250);
  });

  // Debug all ScrollTriggers
  console.log('Image Text Hero GSAP Script - Initial ScrollTriggers count:', ScrollTrigger ? ScrollTrigger.getAll().length : 0);

  // Log all image-text-hero elements found
  const allHeroes = document.querySelectorAll('.image-text-hero');
  console.log('Image Text Hero GSAP Script - All hero sections found:', allHeroes.length);
  allHeroes.forEach((hero, index) => {
    console.log(`Hero ${index + 1}:`, hero.className, 'ID:', hero.id);
    console.log(`  Structure:`, Array.from(hero.children).map(child => `${child.tagName}.${child.className || 'no-class'}`));
  });
});
</script>




{% schema %}
{
  "name": "Image Text Hero",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_bleed",
      "label": "Full-bleed width (extends edge to edge)",
      "default": false
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Desktop image position",
