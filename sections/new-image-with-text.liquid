{% stylesheet %}

.image-text-hero {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--hero-gap, 48px);
  align-items: center;
  min-height: 500px;
  padding: 40px 20px;
  background-color: var(--hero-bg-color, #ffffff);
}


@media (max-width: 768px) {
  .image-text-hero {
    flex-direction: column;
    gap: var(--hero-gap-mobile, 32px);
    min-height: auto;
    padding: 30px 15px;
  }
}


@media (min-width: 769px) {
  .image-text-hero {
    flex-direction: row;
    flex-wrap: nowrap;
  }
  .image-text-hero__content,
  .image-text-hero__image-wrapper {
    flex: 1;
  }
}


.image-text-hero__content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
  max-width: var(--hero-text-max-width, 100%);
  order: 1;
}


.image-text-hero__image-wrapper {
  width: 100%;
  height: var(--hero-image-height, 500px);
  position: relative;
  /* border-radius: 8px; */
  overflow: hidden;
  order: 2;
  flex: 1;
}


.image-text-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}


.image-text-hero__image-overlay {
  position: absolute;
  inset: 0;
  background-color: var(--hero-image-overlay-color, transparent);
  opacity: var(--hero-image-overlay-opacity, 0);
}


/* Image on left - default (content right, image left) */
.image-text-hero--image-left .image-text-hero__content {
  order: 2;
}


.image-text-hero--image-left .image-text-hero__image-wrapper {
  order: 1;
}


/* Mobile: Order based on setting */
@media (max-width: 768px) {
  .image-text-hero--mobile-text-first .image-text-hero__content {
    order: 1 !important;
  }
  .image-text-hero--mobile-text-first .image-text-hero__image-wrapper {
    order: 2 !important;
  }
  .image-text-hero--mobile-image-first .image-text-hero__content {
    order: 2 !important;
  }
  .image-text-hero--mobile-image-first .image-text-hero__image-wrapper {
    order: 1 !important;
  }
  .image-text-hero__image-wrapper {
    height: var(--hero-image-height-mobile, 300px);
  }
}


.image-text-hero__heading {
  margin: 0;
  font-family: var(--hero-head-font-family);
  font-size: var(--hero-head-size-d);
  color: var(--hero-head-color);
  line-height: 1.2;
  font-weight: var(--hero-head-font-weight);
}


.image-text-hero__subheading {
  margin: 0;
  font-family: var(--hero-body-font-family);
  font-size: var(--hero-sub-size-d);
  color: var(--hero-sub-color);
  line-height: 1.4;
}


.image-text-hero__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0px;
  /* padding: var(--hero-btn-padding-d, 14px 28px); */
  font-family: var(--hero-btn-font-family);
  font-size: var(--hero-btn-size-d);
  color: var(--hero-btn-color);
  background: none;
  /* background: var(--hero-btn-bg); */
  border:0px;
  /* border: 1px solid var(--hero-btn-border); */
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s ease;
  max-width: fit-content;
  font-weight: 600;
  text-decoration: underline;
}


.image-text-hero__button:hover {
  color: var(--hero-btn-color-hover);
  background: none;
  border-color:none;
  /* background: var(--hero-btn-bg-hover); */
  /* border-color: var(--hero-btn-border-hover); */
}


/* Text alignment */
.image-text-hero__content--left { text-align: left; }
.image-text-hero__content--center { text-align: center; }
.image-text-hero__content--right { text-align: right; }


/* Mobile typography */
@media (max-width: 768px) {
  .image-text-hero__heading {
    font-family: var(--hero-head-font-family);
    font-size: var(--hero-head-size-m);
  }
  
  .image-text-hero__subheading {
    font-family: var(--hero-body-font-family);
    font-size: var(--hero-sub-size-m);
  }
  
  .image-text-hero__button {
    font-family: var(--hero-btn-font-family);
    font-size: var(--hero-btn-size-m);
    padding: 0px;
    justify-content: start;
    width: 100%;
    max-width: none;
  }
}


/* Full bleed */
.image-text-hero--fullbleed {
  width: 100vw;
  margin-left: 50%;
  transform: translateX(-50%);
  padding-left: 20px;
  padding-right: 20px;
}


@media (max-width: 768px) {
  .image-text-hero--fullbleed {
    padding-left: 15px;
    padding-right: 15px;
  }
}
{% endstylesheet %}


<style>
  /* Prevent initial flash and set baseline */
{% comment %} .image-text-hero .image-text-hero__heading,
.image-text-hero .image-text-hero__subheading,
.image-text-hero .image-text-hero__button {
  opacity: 0;
  transform: translateY(60px);
  will-change: transform, opacity;
} {% endcomment %}

.image-text-hero--{{ section.id }} .image-text-hero__heading,
.image-text-hero--{{ section.id }} .image-text-hero__subheading,
.image-text-hero--{{ section.id }} .image-text-hero__button {
  opacity: 0 ;
  transform: translateY(60px) ;
  will-change: transform, opacity;
}


.image-text-hero--{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    padding-left: {{ section.settings.padding-left }}px;
    padding-right: {{ section.settings.padding-right }}px;
}
@media (max-width:768px){
    .image-text-hero--{{ section.id }} {
      padding-top: {{ section.settings.padding-top-mob }}px;
      padding-bottom: {{ section.settings.padding-bottom-mob }}px;
      padding-left: {{ section.settings.padding-left-mob }}px;
      padding-right: {{ section.settings.padding-right-mob }}px;
    }
}
</style>


<div class="image-text-hero--{{ section.id }} image-text-hero{% if section.settings.full_bleed %} image-text-hero--fullbleed{% endif %}{% if section.settings.image_position == 'left' %} image-text-hero--image-left{% endif %}{% if section.settings.mobile_order == 'text_first' %} image-text-hero--mobile-text-first{% else %} image-text-hero--mobile-image-first{% endif %}{% if section.settings.image_position == 'right' %} image-text-hero--image-right{% endif %}" 
     style="--hero-gap: {{ section.settings.gap | default: 48 }}px; 
             --hero-gap-mobile: {{ section.settings.gap_mobile | default: 32 }}px;
             --hero-bg-color: {{ section.settings.bg_color | default: '#ffffff' }};">
  
  <div class="image-text-hero__content image-text-hero__content--{{ section.settings.text_alignment | default: 'left' }}" 
       style="
         --hero-head-font-family: '{{ section.settings.font_heading | default: 'system-ui' }}', sans-serif;
         --hero-head-font-weight: {{ section.settings.heading_weight }};
         --hero-body-font-family: '{{ section.settings.font_body | default: 'system-ui' }}', sans-serif;
         --hero-btn-font-family: '{{ section.settings.font_buttons | default: 'system-ui' }}', sans-serif;
         
         --hero-head-size-d: {{ section.settings.heading_size_d }}px;
         --hero-head-size-m: {{ section.settings.heading_size_m }}px;
         --hero-sub-size-d: {{ section.settings.subtext_size_d }}px;
         --hero-sub-size-m: {{ section.settings.subtext_size_m }}px;
         --hero-btn-size-d: {{ section.settings.button_size_d }}px;
         --hero-btn-size-m: {{ section.settings.button_size_m }}px;
         
         --hero-head-color: {{ section.settings.heading_color }};
         --hero-sub-color: {{ section.settings.subtext_color }};
         --hero-btn-color: {{ section.settings.button_text_color }};
         --hero-btn-bg: {{ section.settings.button_bg_color }};
         --hero-btn-color-hover: {{ section.settings.button_text_hover }};
         --hero-btn-bg-hover: {{ section.settings.button_bg_hover }};
         --hero-btn-border: {{ section.settings.button_bg_color }};
         --hero-btn-border-hover: {{ section.settings.button_bg_hover }};
         --hero-btn-padding-d: {{ section.settings.button_size_d | times: 0.875 }}px {{ section.settings.button_size_d | times: 1.75 }}px;
         --hero-btn-padding-m: {{ section.settings.button_size_m | times: 0.857 }}px {{ section.settings.button_size_m | times: 1.714 }}px;
         --hero-text-max-width: {{ section.settings.text_max_width }}%;
       ">
    
    {% if section.settings.heading != blank %}
      <h2 class="image-text-hero__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.settings.subheading != blank %}
      <div class="image-text-hero__subheading">{{ section.settings.subheading }}</div>
    {% endif %}
    
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="image-text-hero__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>


  <div class="image-text-hero__image-wrapper" >
    
    {% assign hero_image = section.settings.image %}
    {% if section.settings.image_mobile and request.page_type == 'index' %}
      {% assign hero_image = section.settings.image_mobile %}
    {% endif %}
    
    {% if hero_image != blank %}
      <img src="{{ hero_image | image_url: width: 800 }}" 
           alt="{{ section.settings.heading | escape | default: 'Hero image' }}" 
           class="image-text-hero__image"
           loading="lazy"
           width="600" 
           height="400"
           srcset="{{ hero_image | image_url: width: 400 }} 400w, 
                   {{ hero_image | image_url: width: 600 }} 600w, 
                   {{ hero_image | image_url: width: 800 }} 800w, 
                   {{ hero_image | image_url: width: 1200 }} 1200w"
           sizes="(min-width: 769px) 50vw, 100vw">
    {% else %}
      <div class="image-text-hero__image" style="background: #f5f5f5; height: 100%;"></div>
    {% endif %}
  </div>
</div>


