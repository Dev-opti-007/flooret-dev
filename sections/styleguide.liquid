<div class="shopify-section">
	<section class="fifty-fifty">
		<div class="container">
			<div class="fifty-fifty__wrap">
			
				<div class="fifty-fifty__content">
					<div class="content-fifty__wrap">
						<span class="preheading">Preheading content</span>
						<h2>This section doesnt have a background color</h2>
						<p>Since this section comes after a bg-section it creates extra margin between it and the section above it</p>
						<p>This is done with the default class shopify adds to all sections</p>
					</div>
				</div>
				
				<div class="fifty-fifty__image">
					<img src="https://placebear.com/3000/2000" alt="">
				</div>

			</div>
		</div>
	</section>
</div>
