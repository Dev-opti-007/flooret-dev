{% comment %}
  Section: Find Your Perfect Floor
  File: sections/find-your-perfect-floor.liquid
{% endcomment %}

{%- assign bg_image = section.settings.background_image -%}
{%- assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0 -%}
{%- assign heading_letter_spacing = section.settings.heading_letter_spacing | divided_by: 100.0 -%}
{%- assign subheading_letter_spacing = section.settings.subheading_letter_spacing | divided_by: 100.0 -%}
{%- assign heading_line_height = section.settings.heading_line_height | divided_by: 100.0 -%}
{%- assign subheading_line_height = section.settings.subheading_line_height | divided_by: 100.0 -%}

<!-- ========== DESKTOP: Full Hero Banner ========== -->
<div
  class="fpf-section fpf-desktop-banner"
  style="
    --fpf-min-height: {{ section.settings.section_height }}px;
    --fpf-overlay-color: {{ section.settings.overlay_color }};
    --fpf-overlay-opacity: {{ overlay_opacity }};
    --fpf-content-align: {{ section.settings.content_alignment }};
    --fpf-padding-top: {{ section.settings.padding_top }}px;
    --fpf-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- if bg_image != blank -%}
    <div class="fpf-bg">
      <img
        src="{{ bg_image | image_url: width: 1920 }}"
        srcset="
          {{ bg_image | image_url: width: 750 }} 750w,
          {{ bg_image | image_url: width: 1100 }} 1100w,
          {{ bg_image | image_url: width: 1500 }} 1500w,
          {{ bg_image | image_url: width: 1920 }} 1920w
        "
        sizes="100vw"
        alt="{{ bg_image.alt | escape }}"
        loading="lazy"
        width="{{ bg_image.width }}"
        height="{{ bg_image.height }}"
        class="fpf-bg-img"
      >
    </div>
  {%- else -%}
    <div class="fpf-bg fpf-bg--placeholder" style="background-color: {{ section.settings.fallback_bg_color }};"></div>
  {%- endif -%}

  <div class="fpf-overlay"></div>

  <div class="fpf-container" style="max-width: {{ section.settings.container_max_width }}px; padding-inline: {{ section.settings.container_padding }}px;">

    {%- if section.settings.show_back_button -%}
      <a
        href="{{ section.settings.back_button_url }}"
        class="fpf-back-btn"
        style="
          font-family: {{ section.settings.back_btn_font_family }};
          font-size: {{ section.settings.back_btn_font_size }}px;
          font-weight: {{ section.settings.back_btn_font_weight }};
          color: {{ section.settings.back_btn_text_color }};
          background-color: {{ section.settings.back_btn_bg_color }};
          border-radius: {{ section.settings.back_btn_border_radius }}px;
        "
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        {{ section.settings.back_button_text }}
      </a>
    {%- endif -%}

    <div class="fpf-content">
      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }}
          class="fpf-heading"
          style="
            font-family: {{ section.settings.heading_font_family }};
            font-size: {{ section.settings.heading_font_size }}px;
            font-weight: {{ section.settings.heading_font_weight }};
            color: {{ section.settings.heading_color }};
            line-height: {{ heading_line_height }};
            letter-spacing: {{ heading_letter_spacing }}em;
            text-transform: {{ section.settings.heading_text_transform }};
            max-width: {{ section.settings.heading_max_width }}px;
          "
        >{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
      {%- endif -%}

      <div class="fpf-right">
        {%- if section.settings.subheading != blank -%}
          <p
            class="fpf-subheading"
            style="
              font-family: {{ section.settings.subheading_font_family }};
              font-size: {{ section.settings.subheading_font_size }}px;
              font-weight: {{ section.settings.subheading_font_weight }};
              color: {{ section.settings.subheading_color }};
              line-height: {{ subheading_line_height }};
              letter-spacing: {{ subheading_letter_spacing }}em;
              max-width: {{ section.settings.subheading_max_width }}px;
            "
          >{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="fpf-links" style="
            font-family: {{ section.settings.links_font_family }};
            font-size: {{ section.settings.links_font_size }}px;
            font-weight: {{ section.settings.links_font_weight }};
            --fpf-link-color: {{ section.settings.links_color }};
            --fpf-link-hover-color: {{ section.settings.links_hover_color }};
            --fpf-separator-color: {{ section.settings.links_separator_color }};
            text-transform: {{ section.settings.links_text_transform }};
          ">
            {%- for block in section.blocks -%}
              {%- if block.type == 'floor_card' -%}
                <a href="{{ block.settings.card_url }}" class="fpf-link-item" {{ block.shopify_attributes }}>{{ block.settings.title_desktop }}</a>
                {%- unless forloop.last -%}<span class="fpf-separator" aria-hidden="true">·</span>{%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

<!-- ========== MOBILE: Header + Cards ========== -->
<div class="fpf-mobile-section" style="background-color: {{ section.settings.mobile_bg_color }}; padding: {{ section.settings.mobile_padding_top }}px {{ section.settings.mobile_padding_x }}px {{ section.settings.mobile_padding_bottom }}px;">

  <!-- Mobile Heading & Subheading -->
  <div class="fpf-mobile-header">
    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }}
        class="fpf-mobile-heading"
        style="
          font-family: {{ section.settings.heading_font_family }};
          font-size: {{ section.settings.mobile_heading_font_size }}px;
          font-weight: {{ section.settings.heading_font_weight }};
          color: {{ section.settings.mobile_heading_color }};
          line-height: {{ heading_line_height }};
          letter-spacing: {{ heading_letter_spacing }}em;
          text-transform: {{ section.settings.heading_text_transform }};
        "
      >{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p
        class="fpf-mobile-subheading"
        style="
          font-family: {{ section.settings.subheading_font_family }};
          font-size: {{ section.settings.mobile_subheading_font_size }}px;
          font-weight: {{ section.settings.subheading_font_weight }};
          color: {{ section.settings.mobile_subheading_color }};
          line-height: {{ subheading_line_height }};
        "
      >{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  <!-- Mobile Cards -->
  {%- if section.blocks.size > 0 -%}
    <div class="fpf-cards">
      {%- for block in section.blocks -%}
        {%- if block.type == 'floor_card' -%}
          {%- assign card_letter_spacing = block.settings.card_title_letter_spacing | divided_by: 100.0 -%}
          <a
            href="{{ block.settings.card_url }}"
            class="fpf-card"
            style="background-color: {{ section.settings.card_bg_color }}; border-radius: {{ section.settings.card_border_radius }}px;"
            {{ block.shopify_attributes }}
          >
            <!-- Card Image -->
            {%- if block.settings.card_image != blank -%}
              <div class="fpf-card__image">
                <img
                  src="{{ block.settings.card_image | image_url: width: 300 }}"
                  alt="{{ block.settings.card_image.alt | default: block.settings.card_title | escape }}"
                  loading="lazy"
                  width="300"
                  height="200"
                >
              </div>
            {%- else -%}
              <div class="fpf-card__image fpf-card__image--placeholder" style="background-color: {{ section.settings.card_image_placeholder_color }};"></div>
            {%- endif -%}

            <!-- Card Body -->
            <div class="fpf-card__body">
              <!-- Title -->
              <div class="fpf-card__title-row">
                <span
                  class="fpf-card__title"
                  style="
                    font-family: {{ section.settings.card_title_font_family }};
                    font-size: {{ section.settings.card_title_font_size }}px;
                    font-weight: {{ section.settings.card_title_font_weight }};
                    color: {{ block.settings.card_title_color }};
                    letter-spacing: {{ card_letter_spacing }}em;
                    text-transform: {{ section.settings.card_title_text_transform }};
                  "
                >{{ block.settings.card_title }}</span>
                <span class="fpf-card__arrow" style="color: {{ block.settings.card_title_color }};">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </span>
              </div>

              <!-- Tagline -->
              {%- if block.settings.card_tagline != blank -%}
                <p
                  class="fpf-card__tagline"
                  style="
                    font-family: {{ section.settings.card_tagline_font_family }};
                    font-size: {{ section.settings.card_tagline_font_size }}px;
                    font-weight: {{ section.settings.card_tagline_font_weight }};
                    color: {{ section.settings.card_tagline_color }};
                  "
                >{{ block.settings.card_tagline }}</p>
              {%- endif -%}

              <!-- Install Method (hidden on mobile per design) -->
              {%- if block.settings.card_install_method != blank -%}
                <div class="fpf-card__install fpf-hide-mobile" style="color: {{ section.settings.card_meta_color }};">
                  <svg xmlns="http://www.w3.org/2000/svg" width="10" height="21" viewBox="0 0 10 21" fill="none"> <g clip-path="url(#clip0_4374_493)"> <path d="M4.65972 15.8761L0.291504 13.2252V0.291687L4.65972 2.94257V15.8761Z" stroke="#231F20" stroke-width="0.583466" stroke-linecap="round" stroke-linejoin="round"/> <path d="M9.03008 19.937L4.65991 17.2861V4.35454L9.03008 7.00542V19.937Z" stroke="#231F20" stroke-width="0.583466" stroke-linecap="round" stroke-linejoin="round"/> </g> <defs> <clipPath id="clip0_4374_493"> <rect width="9.32211" height="20.2295" fill="white"/> </clipPath> </defs> </svg>
                  <span
                    style="
                      font-family: {{ section.settings.card_meta_font_family }};
                      font-size: {{ section.settings.card_meta_font_size }}px;
                      font-weight: {{ section.settings.card_meta_font_weight }};
                    "
                  >{{ block.settings.card_install_method }}</span>
                </div>
              {%- endif -%}

              <!-- Price Range -->
              {%- if block.settings.card_price_range != blank -%}
                <p
                  class="fpf-card__price"
                  style="
                    font-family: {{ section.settings.card_meta_font_family }};
                    font-size: {{ section.settings.card_price_font_size }}px;
                    font-weight: {{ section.settings.card_price_font_weight }};
                    color: {{ section.settings.card_meta_color }};
                  "
                >{{ block.settings.card_price_range }}</p>
              {%- endif -%}
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

</div>

<style>
  /* ===== DESKTOP BANNER ===== */
  .fpf-desktop-banner {
    display: flex;
    position: relative;
    min-height: var(--fpf-min-height, 440px);
    align-items: center;
    overflow: hidden;
    padding-top: var(--fpf-padding-top, 48px);
    padding-bottom: var(--fpf-padding-bottom, 48px);
  }

  .fpf-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .fpf-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .fpf-bg--placeholder {
    width: 100%;
    height: 100%;
  }

  .fpf-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-color: var(--fpf-overlay-color, #000000);
    opacity: var(--fpf-overlay-opacity, 0.35);
    pointer-events: none;
  }

  .fpf-container {
    position: relative;
    z-index: 2;
    width: 100%;
    margin: 0 auto;
  }

  .fpf-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    padding: 8px 16px;
    margin-bottom: 32px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: opacity 0.2s ease;
  }

  .fpf-back-btn:hover { opacity: 0.8; }

  .fpf-content {
    display: flex;
    align-items: flex-end;
    justify-content: var(--fpf-content-align, space-between);
    gap: 40px;
    flex-wrap: wrap;
  }

  .fpf-heading {
    margin: 0;
    flex: 0 1 auto;
    white-space: pre-line;
  }

  .fpf-right {
    flex: 0 1 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .fpf-subheading { margin: 0; }

  .fpf-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 0;
  }

  .fpf-link-item {
    color: var(--fpf-link-color, rgba(255,255,255,0.75));
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .fpf-link-item:hover {
    color: var(--fpf-link-hover-color, #ffffff);
    text-decoration: underline;
  }

  .fpf-separator {
    color: var(--fpf-separator-color, rgba(255,255,255,0.4));
    padding: 0 8px;
    user-select: none;
  }

  /* ===== MOBILE SECTION ===== */
  .fpf-mobile-section {
    display: none;
  }

  .fpf-mobile-header {
    margin-bottom: 24px;
  }

  .fpf-mobile-heading {
    margin: 0 0 12px;
    white-space: pre-line;
  }

  .fpf-mobile-subheading {
    margin: 0;
  }

  /* ===== CARDS ===== */
  .fpf-cards {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fpf-card {
    display: flex;
    align-items: stretch;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .fpf-card:hover {
    box-shadow: 0 4px 16px rgba(0,0,0,0.12);
    transform: translateY(-1px);
  }

  .fpf-card__image {
    flex: 0 0 120px;
    width: 120px;
    overflow: hidden;
  }

  .fpf-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .fpf-card__image--placeholder {
    min-height: 120px;
  }

  .fpf-card__body {
    flex: 1;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    justify-content: center;
  }

  .fpf-card__title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .fpf-card__title {
    display: block;
    line-height: 1.2;
  }

  .fpf-card__arrow {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .fpf-card__tagline {
    margin: 0;
    line-height: 1.4;
  }

  .fpf-card__install {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
  }

  .fpf-card__price {
    margin: 4px 0 0;
  }

  /* ===== RESPONSIVE ===== */
  @media screen and (max-width: 768px) {
    .fpf-desktop-banner {
      display: none !important;
    }
    .fpf-mobile-section {
      display: block;
      padding-top: 60px !important;
    }
    .fpf-hide-mobile {
      display: none !important;
    }
    .fpf-card__install.fpf-hide-mobile {
        display: flex !important;
    }
    .fpf-card__body {
      position:relative;
    }
    .fpf-card__arrow {
        position: absolute;
      right: 8px;
      top: 50%;
      transform: translateY(-50%);
    }
  }

  @media screen and (min-width: 769px) {
    .fpf-mobile-section {
      display: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "Find Your Perfect Floor",
  "class": "fpf-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "── DESKTOP BANNER ──────────────"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "fallback_bg_color",
      "label": "Fallback Background Color",
      "default": "#b0a895"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Desktop Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section Min Height",
      "min": 300,
      "max": 700,
      "step": 5,
      "unit": "px",
      "default": 440
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "container_max_width",
      "label": "Container Max Width",
      "min": 800,
      "max": 2000,
      "step": 40,
      "unit": "px",
      "default": 1360
    },
    {
      "type": "range",
      "id": "container_padding",
      "label": "Container Side Padding",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "space-between", "label": "Space Between (Left + Right)" },
        { "value": "flex-start", "label": "Left Aligned" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right Aligned" }
      ],
      "default": "space-between"
    },
    {
      "type": "header",
      "content": "Back Button (Desktop Only)"
    },
    {
      "type": "checkbox",
      "id": "show_back_button",
      "label": "Show Back Button",
      "default": true
    },
    {
      "type": "text",
      "id": "back_button_text",
      "label": "Back Button Text",
      "default": "All Floors"
    },
    {
      "type": "url",
      "id": "back_button_url",
      "label": "Back Button URL"
    },
    {
      "type": "color",
      "id": "back_btn_text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "back_btn_bg_color",
      "label": "Background Color",
      "default": "#ffffff26"
    },
    {
      "type": "range",
      "id": "back_btn_border_radius",
      "label": "Border Radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 100
    },
    {
      "type": "select",
      "id": "back_btn_font_family",
      "label": "Font Family",
      "options": [
        { "value": "'Playfair Display', serif", "label": "Playfair Display" },
        { "value": "Montserrat, sans-serif", "label": "Montserrat" },
        { "value": "Roboto, sans-serif", "label": "Roboto" },
        { "value": "'Helvetica Neue', sans-serif", "label": "Helvetica Neue" }
      ],
      "default": "Roboto, sans-serif"
    },
    {
      "type": "range",
      "id": "back_btn_font_size",
      "label": "Font Size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "back_btn_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading Text",
      "default": "Find Your\nPerfect Floor"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "HTML Tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "select",
      "id": "heading_font_family",
      "label": "Font Family",
      "options": [
        { "value": "'Playfair Display', serif", "label": "Playfair Display" },
        { "value": "Montserrat, sans-serif", "label": "Montserrat" },
        { "value": "Roboto, sans-serif", "label": "Roboto" },
        { "value": "'Helvetica Neue', sans-serif", "label": "Helvetica Neue" }
      ],
      "default": "'Playfair Display', serif"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "Font Size (Desktop)",
      "min": 24,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "mobile_heading_font_size",
      "label": "Font Size (Mobile)",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "Font Weight",
      "options": [
        { "value": "300", "label": "Light (300)" },
        { "value": "400", "label": "Regular (400)" },
        { "value": "500", "label": "Medium (500)" },
        { "value": "600", "label": "Semi Bold (600)" },
        { "value": "700", "label": "Bold (700)" },
        { "value": "800", "label": "Extra Bold (800)" },
        { "value": "900", "label": "Black (900)" }
      ],
      "default": "800"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color (Desktop)",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "mobile_heading_color",
      "label": "Color (Mobile)",
      "default": "#1a1a1a"
    },
