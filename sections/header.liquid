<script>
  document.addEventListener("DOMContentLoaded", function () {
    console.log('%c=== DOMContentLoaded: Starting dropdown hover initialization ===', 'color: blue; font-weight: bold;'); // Highlighted start log

    // Vanilla JS for hover dropdown functionality
    const menuDropdowns = document.querySelectorAll('.menu-dropdown');
    console.log('%cFound ' + menuDropdowns.length + ' menu-dropdown elements', 'color: purple;'); // Log number of menus found

    menuDropdowns.forEach(function(menu, index) {
      const mainItem = menu.querySelector('.main-menu-item');
      const dropdown = menu.querySelector('.dropdown-menu');

      if (!mainItem) {
        console.log('%cWarning: No .main-menu-item found in menu-dropdown #' + (index + 1), 'color: orange; font-weight: bold;'); // Warning if missing
        return; // Skip if no main item
      }
      if (!dropdown) {
        console.log('%cWarning: No .dropdown-menu found in menu-dropdown #' + (index + 1), 'color: orange; font-weight: bold;'); // Warning if missing
        return; // Skip if no dropdown
      }

      // Log dropdown details even if empty
      console.log('%cMenu-dropdown #' + (index + 1) + ' has ' + dropdown.children.length + ' sub-items.', 'color: cyan;'); // Log sub-item count

      let hideTimeout; // For adding a slight delay on hide

      // Mouse enter on the entire menu container: Show dropdown with animation
      menu.addEventListener('mouseenter', function() {
        console.log('%cMouseenter: Showing dropdown for menu-dropdown #' + (index + 1), 'color: teal; font-weight: bold;'); // Highlighted event log
        clearTimeout(hideTimeout); // Cancel any pending hide
        dropdown.style.display = 'block';  // Make visible
        dropdown.style.opacity = '1';      // Fade in
        dropdown.style.maxHeight = dropdown.scrollHeight + 'px';  // Slide down
      });

      // Mouse leave on the entire menu container: Hide dropdown with animation (with a short delay for usability)
      menu.addEventListener('mouseleave', function() {
        console.log('%cMouseleave: Preparing to hide dropdown for menu-dropdown #' + (index + 1), 'color: teal; font-weight: bold;'); // Highlighted event log
        hideTimeout = setTimeout(() => {
          dropdown.style.opacity = '0';      // Fade out
          dropdown.style.maxHeight = '0';    // Slide up
          setTimeout(() => { 
            dropdown.style.display = 'none'; 
            console.log('%cDropdown hidden after animation for menu-dropdown #' + (index + 1), 'color: gray;'); // Log after hide
          }, 200);  // Hide after animation
        }, 100);  // 100ms delay to allow moving to dropdown without flicker
      });

      // Optional: Close dropdown if clicking outside (for better UX)
      document.addEventListener('click', function(e) {
        if (!menu.contains(e.target)) {
          console.log('%cClick outside: Closing dropdown for menu-dropdown #' + (index + 1), 'color: teal;'); // Log event trigger
          dropdown.style.opacity = '0';
          dropdown.style.maxHeight = '0';
          setTimeout(() => { 
            dropdown.style.display = 'none'; 
            console.log('%cDropdown closed on outside click for menu-dropdown #' + (index + 1), 'color: gray;'); // Log after close
          }, 200);
        }
      });
    });

    console.log('%c=== Dropdown hover initialization complete ===', 'color: blue; font-weight: bold;'); // Highlighted end log

    // Rest of your existing code...
  });
</script>



