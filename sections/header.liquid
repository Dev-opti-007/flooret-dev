<script>
document.addEventListener('DOMContentLoaded', function() {
  // 1. Select all the target link elements
  const links = document.querySelectorAll('.child .child-link a');

  // 2. Loop through each link found
  links.forEach(link => {
    // 3. Find the first span inside the link
    const textSpan = link.querySelector('span');

    // 4. Proceed only if a span actually exists
    if (textSpan) {
      const textContent = textSpan.textContent.trim();

      // 5. Check if the text is one of the ones you want to target
      if ( textContent === 'Sample Kit') {
        
        // 6. Safety Check: Only add the badge if one doesn't already exist
        if (!link.querySelector('.custom-badge-new')) {
          
          // 7. Create the new badge element
          const newBadge = document.createElement('span');
          newBadge.className = 'custom-badge-new';
          newBadge.textContent = 'new';

          // 8. Append the new badge to the link. It will appear next to the existing span.
          link.appendChild(newBadge);
        }
      }
    }
  });
});
</script>

{% comment %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const header = document.querySelector('.gheader');
      let lastScrollTop = 0;
      const scrollThreshold = 5; // Adjust this value to change sensitivity
      let isScrolled = false;
      let debounceTimer;

      function debounce(func, delay) {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(func, delay);
      }

      function handleScroll() {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

        if (Math.abs(scrollTop - lastScrollTop) > scrollThreshold) {
          if (scrollTop > lastScrollTop && scrollTop > 0) {
            // Scrolling down
            if (!isScrolled) {
              header.classList.add('sticky--scrolled');
              isScrolled = true;
            }
          } else {
            // Scrolling up
            if (scrollTop === 0) {
              header.classList.remove('sticky--scrolled');
              isScrolled = false;
            }
          }
          lastScrollTop = scrollTop;
        }
      }

      window.addEventListener('scroll', function () {
        debounce(handleScroll, 10); // Adjust the debounce delay (in ms) as needed
      });
    });
  </script>
{% endcomment %}

