<script>
  document.addEventListener('DOMContentLoaded', function() {
  const allMegaMenu = document.querySelectorAll('.mega-menu-li .mega-menu-button');
  const allMegaMenuDrop = document.querySelectorAll('.mega-menu.desk-only');
  
  let activeMenuData = null; // Track the currently active menu globally
  let hideTimeout; // Shared timeout for all menus

  // Function to deactivate all menus
  function deactivateAll() {
    allMegaMenu.forEach(button => button.classList.remove('active'));
    allMegaMenuDrop.forEach(drop => drop.classList.remove('active'));
    activeMenuData = null;
    if (hideTimeout) {
      clearTimeout(hideTimeout);
    }
  }

  // Function to activate a specific menu
  function activateMenu(menuData, button) {
    deactivateAll(); // Close others first
    const matchingDrop = document.querySelector(`.mega-menu.desk-only[data-menu="${menuData}"]`);
    if (matchingDrop) {
      button.classList.add('active');
      matchingDrop.classList.add('active');
      activeMenuData = menuData;
    }
  }

  // Click handler (for mobile/accessibility)
  allMegaMenu.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const menuData = this.getAttribute('data-menu');
      if (activeMenuData === menuData) {
        deactivateAll(); // Toggle off if already active
      } else {
        activateMenu(menuData, this);
      }
    });
  });

  // Hover handlers for all buttons
  allMegaMenu.forEach(button => {
    const menuData = button.getAttribute('data-menu');

    button.addEventListener('mouseenter', function() {
      clearTimeout(hideTimeout);
      activateMenu(menuData, this);
    });

    button.addEventListener('mouseleave', function(e) {
      // Start hide timeout, but only if not moving toward dropdown
      hideTimeout = setTimeout(() => {
        if (activeMenuData === menuData) {
          deactivateAll();
        }
      }, 100); // Short delay to allow mouse movement to dropdown
    });
  });

  // Hover handlers for all dropdowns to keep menu open
  allMegaMenuDrop.forEach(drop => {
    const menuData = drop.getAttribute('data-menu');

    drop.addEventListener('mouseenter', function() {
      clearTimeout(hideTimeout);
      if (activeMenuData !== menuData) {
        // Find and activate the corresponding button if not already
        const matchingButton = document.querySelector(`.mega-menu-button[data-menu="${menuData}"]`);
        if (matchingButton) {
          activateMenu(menuData, matchingButton);
        }
      }
    });

    drop.addEventListener('mouseleave', function() {
      // Delay hide to account for mouse leaving the entire area
      hideTimeout = setTimeout(() => {
        deactivateAll();
      }, 150); // Slightly longer delay here for smoother UX
    });
  });

  // Optional: Close all on outside click
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.mega-menu-li')) {
      deactivateAll();
    }
  });
});

</script>
