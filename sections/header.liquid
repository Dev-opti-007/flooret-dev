{% assign module = section.settings %}

{% if section.settings.show_announcement_bar %}
  {% render 'announcement-bar' %}
{% endif %}

<div class="gheader__main">
  <button type="button" class="gheader__burger reset mob-only" title="Menu">
    {% render 'svg-hamburger' %}
  </button>

  <nav class="mob-only gheader__mnav js-adjust-to-header js-header-sticky" aria-label="main navigation">
    <button class="close-btn-drawer" >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"> <path d="M6 18L18 6" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/> <path d="M18 18L6 6" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/> </svg>
    </button>
    <div class="overflow">
      {% render 'menu-list', menu: module.mobile_menu %}
      <div class="gheader__mnav__fixed">
        <a class="" href="/account">My Account</a>
        <a class="" target="_blank" href="https://flooretcommercial.com/">Flooret Commercial</a>
        <a class="" href="/pages/partner-plus">Partner +</a>
      </div>
    </div>
  </nav>

  <a class="gheader__logo" href="/">
    <img style="display:none;"  src="{{ 'logo.svg' | asset_url }}" width="110" height="23" alt="{{ shop.name }}">
    <img src="{{ 'new-logo.svg' | asset_url }}" width="110" height="23" alt="{{ shop.name }}">
  </a>

  {% if section.settings.show_bfcm_button %}
   <li class="singlemenu only-mob">
      <a class="menu__link  pill-menu-active" href="{{ section.settings.featured_btn_link }}">{{  section.settings.featured_btn_text }}</a>
    </li>
  {% endif %}

