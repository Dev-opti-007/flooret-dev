<script>
  // Redirect mega-menu button to its inner <a href="...">
document.addEventListener('click', (e) => {
  const btn = e.target.closest('button.mega-menu-button');
  if (!btn) return;

  const link = btn.querySelector('a[href]');
  if (!link) return;

  // If your mega menu uses this button to toggle a dropdown, this will override that behavior.
  // If you only want redirect in some cases, add conditions here.
  window.location.href = link.href;
});

</script>

