{% assign _settings = section.settings %}


{% schema %}
{
  "name": "Img + Accordion",
  "class": "shopify-block content-video",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#343334"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "row_reverse",
      "label": "Row Reverse",
      "default": false
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "textarea",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "header",
      "content": "Content"
    },              
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }

  ],
  "presets": [
    {
      "name": "Img + Accordion",
      "category": "Content / Video"
    }
  ]
}
{% endschema %}
