{%- assign section_id = 'sample-kit-' | append: section.id -%}

<section
  id="{{ section_id }}"
  class="sample-kit-section"
  style="
    --sk-bg: {{ section.settings.background_color }};
    --sk-accent: {{ section.settings.accent_color }};
    --sk-text: {{ section.settings.text_color }};
    --sk-badge-bg: {{ section.settings.badge_background }};
    --sk-badge-text: {{ section.settings.badge_text_color }};
    --sk-btn-bg: {{ section.settings.button_bg_color }};
    --sk-btn-text: {{ section.settings.button_text_color }};
    --sk-btn-hover: {{ section.settings.button_hover_color }};
    --sk-border-radius: {{ section.settings.border_radius }}px;
  "
>
  <div class="sk-container {% if section.settings.layout == 'full_width' %}sk-container--full{% endif %}">

    {%- comment -%} ── BADGE / EYEBROW ── {%- endcomment -%}
    {%- if section.settings.eyebrow_text != blank -%}
      <div class="sk-eyebrow-wrap">
        <span class="sk-eyebrow">{{ section.settings.eyebrow_text }}</span>
      </div>
    {%- endif -%}

    {%- comment -%} ── MAIN GRID ── {%- endcomment -%}
    <div class="sk-grid sk-grid--{{ section.settings.image_position }}">

      {%- comment -%} ── IMAGE COLUMN ── {%- endcomment -%}
      <div class="sk-media">
        {%- if section.settings.kit_image != blank -%}
          <div class="sk-image-wrap">
            {%- if section.settings.show_image_badge and section.settings.image_badge_text != blank -%}
              <span class="sk-image-badge">{{ section.settings.image_badge_text }}</span>
            {%- endif -%}
            {{
              section.settings.kit_image
              | image_url: width: 800
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'sk-image',
                alt: section.settings.kit_image.alt | default: section.settings.heading
            }}
          </div>
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'sk-image sk-image--placeholder' }}
        {%- endif -%}

        {%- if section.settings.show_trust_badges -%}
          <div class="sk-trust-strip">
            {%- for block in section.blocks -%}
              {%- if block.type == 'trust_badge' -%}
                <div class="sk-trust-item" {{ block.shopify_attributes }}>
                  {%- if block.settings.icon != blank -%}
                    <span class="sk-trust-icon">
                      {{- block.settings.icon | image_url: width: 40 | image_tag: loading: 'lazy', alt: '' -}}
                    </span>
                  {%- else -%}
                    <span class="sk-trust-icon sk-trust-icon--svg">
                      {%- case block.settings.icon_type -%}
                        {%- when 'shield' -%}
                          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.955 11.955 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.249-8.25-3.285z"/></svg>
                        {%- when 'truck' -%}
                          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12"/></svg>
                        {%- when 'star' -%}
                          <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
                        {%- when 'leaf' -%}
                          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12.75 3.03v.568c0 .334.148.65.405.864l1.068.89c.442.369.535 1.01.216 1.49l-.51.766a2.25 2.25 0 01-1.161.886l-.143.048a1.107 1.107 0 00-.57 1.664c.369.555.169 1.307-.427 1.605L9 13.125l.423 1.059a.956.956 0 01-1.652.928l-.679-.906a1.125 1.125 0 00-1.906.172L4.5 15.75l-.612.153M12.75 3.031a9 9 0 00-8.862 12.872M12.75 3.031a9 9 0 016.69 14.036m0 0l-.177-.529A2.25 2.25 0 0017.128 15H16.5l-.324-.324a1.453 1.453 0 00-2.328.377l-.036.073a1.586 1.586 0 01-.982.816l-.99.282c-.55.157-.894.702-.8 1.267l.073.438c.08.474.49.821.97.821.846 0 1.598.542 1.865 1.345l.215.643"/></svg>
                        {%- else -%}
                          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      {%- endcase -%}
                    </span>
                  {%- endif -%}
                  <span class="sk-trust-label">{{ block.settings.label }}</span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ── CONTENT COLUMN ── {%- endcomment -%}
      <div class="sk-content">

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="sk-heading">
            {{ section.settings.heading }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="sk-subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- comment -%} ── KIT ITEMS / WHAT'S INCLUDED ── {%- endcomment -%}
        {%- assign kit_items = section.blocks | where: 'type', 'kit_item' -%}
        {%- if kit_items.size > 0 -%}
          <div class="sk-kit-contents">
            {%- if section.settings.kit_contents_heading != blank -%}
              <p class="sk-kit-contents-heading">{{ section.settings.kit_contents_heading }}</p>
            {%- endif -%}
            <ul class="sk-kit-list" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'kit_item' -%}
                  <li class="sk-kit-item" {{ block.shopify_attributes }}>
                    {%- if block.settings.item_image != blank -%}
                      {{
                        block.settings.item_image
                        | image_url: width: 80
                        | image_tag:
                          loading: 'lazy',
                          class: 'sk-kit-item__img',
                          alt: block.settings.item_name
                      }}
                    {%- elsif block.settings.show_checkmark -%}
                      <span class="sk-kit-item__check" aria-hidden="true">
                        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                      </span>
                    {%- endif -%}
                    <div class="sk-kit-item__info">
                      <span class="sk-kit-item__name">{{ block.settings.item_name }}</span>
                      {%- if block.settings.item_description != blank -%}
                        <span class="sk-kit-item__desc">{{ block.settings.item_description }}</span>
                      {%- endif -%}
                    </div>
                    {%- if block.settings.item_qty != blank -%}
                      <span class="sk-kit-item__qty">{{ block.settings.item_qty }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- comment -%} ── PRICING ── {%- endcomment -%}
        {%- if section.settings.show_pricing -%}
          <div class="sk-pricing">
            {%- if section.settings.original_price != blank -%}
              <span class="sk-price-original">{{ section.settings.original_price }}</span>
            {%- endif -%}
            {%- if section.settings.sale_price != blank -%}
              <span class="sk-price-sale">{{ section.settings.sale_price }}</span>
            {%- endif -%}
            {%- if section.settings.savings_text != blank -%}
              <span class="sk-price-savings">{{ section.settings.savings_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- comment -%} ── CTA BUTTONS ── {%- endcomment -%}
        <div class="sk-cta-group">
          {%- if section.settings.primary_button_label != blank -%}
            <a
              href="{{ section.settings.primary_button_link }}"
              class="sk-btn sk-btn--primary"
              {%- if section.settings.primary_button_link == blank -%}aria-disabled="true"{%- endif -%}
            >
              {{ section.settings.primary_button_label }}
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a
              href="{{ section.settings.secondary_button_link }}"
              class="sk-btn sk-btn--secondary"
              {%- if section.settings.secondary_button_link == blank -%}aria-disabled="true"{%- endif -%}
            >
              {{ section.settings.secondary_button_label }}
            </a>
          {%- endif -%}
        </div>

        {%- comment -%} ── FINE PRINT / DISCLAIMER ── {%- endcomment -%}
        {%- if section.settings.fine_print != blank -%}
          <p class="sk-fine-print">{{ section.settings.fine_print }}</p>
        {%- endif -%}

      </div>{%- comment -%} end .sk-content {%- endcomment -%}
    </div>{%- comment -%} end .sk-grid {%- endcomment -%}
  </div>{%- comment -%} end .sk-container {%- endcomment -%}
</section>

{%- comment -%} ───────────────────────────────────── CSS ───────────────────────────────────── {%- endcomment -%}
{% stylesheet %}
.sample-kit-section {
  background-color: var(--sk-bg, #fff);
  color: var(--sk-text, #1a1a1a);
  padding-block: clamp(3rem, 6vw, 6rem);
}

.sk-container {
  max-width: 1200px;
  margin-inline: auto;
  padding-inline: clamp(1rem, 4vw, 2.5rem);
}
.sk-container--full {
  max-width: 100%;
}

/* ── Eyebrow ── */
.sk-eyebrow-wrap {
  text-align: center;
  margin-bottom: 1.5rem;
}
.sk-eyebrow {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--sk-btn-bg, #000);
  background: var(--sk-badge-bg, #f0f0f0);
  color: var(--sk-badge-text, #333);
  padding: 0.35em 0.9em;
  border-radius: 999px;
}

/* ── Grid ── */
.sk-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: clamp(2rem, 5vw, 4rem);
  align-items: center;
}
@media (min-width: 768px) {
  .sk-grid {
    grid-template-columns: 1fr 1fr;
  }
  .sk-grid--right .sk-media {
    order: 2;
  }
  .sk-grid--right .sk-content {
    order: 1;
  }
}

/* ── Media / Image ── */
.sk-image-wrap {
  position: relative;
  border-radius: var(--sk-border-radius, 16px);
  overflow: hidden;
  aspect-ratio: 1 / 1;
}
.sk-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  border-radius: var(--sk-border-radius, 16px);
}
.sk-image--placeholder {
  width: 100%;
  aspect-ratio: 1;
  background: #f0f0f0;
  border-radius: var(--sk-border-radius, 16px);
}
.sk-image-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  z-index: 2;
  background: var(--sk-accent, #000);
  color: #fff;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  padding: 0.3em 0.8em;
  border-radius: 999px;
}

/* ── Trust Strip ── */
.sk-trust-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem 1.5rem;
  margin-top: 1.25rem;
  justify-content: center;
}
.sk-trust-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.78rem;
  font-weight: 600;
  color: var(--sk-text, #1a1a1a);
  opacity: 0.75;
}
.sk-trust-icon {
  display: flex;
  align-items: center;
  color: var(--sk-accent, #000);
}
.sk-trust-icon img {
  width: 20px;
  height: 20px;
  object-fit: contain;
}

/* ── Content Column ── */
.sk-content {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.sk-heading {
  font-size: clamp(1.75rem, 3vw + 1rem, 3rem);
  font-weight: 800;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--sk-text, #1a1a1a);
  margin: 0;
}

.sk-subheading {
  font-size: clamp(1rem, 1.5vw, 1.125rem);
  line-height: 1.6;
  color: var(--sk-text, #1a1a1a);
  opacity: 0.75;
  max-width: 52ch;
  margin: 0;
}

/* ── Kit Contents ── */
.sk-kit-contents {
  background: rgba(0,0,0,0.03);
  border: 1px solid rgba(0,0,0,0.08);
  border-radius: calc(var(--sk-border-radius, 16px) * 0.75);
  padding: 1.25rem;
}
.sk-kit-contents-heading {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.5;
  margin: 0 0 0.875rem;
}
.sk-kit-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.sk-kit-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.sk-kit-item__check {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--sk-accent, #000);
  color: #fff;
}
.sk-kit-item__img {
  width: 44px;
  height: 44px;
  object-fit: cover;
  border-radius: 8px;
  flex-shrink: 0;
}
.sk-kit-item__info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.1rem;
}
.sk-kit-item__name {
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--sk-text, #1a1a1a);
}
.sk-kit-item__desc {
  font-size: 0.78rem;
  opacity: 0.6;
  color: var(--sk-text, #1a1a1a);
}
.sk-kit-item__qty {
  font-size: 0.75rem;
  font-weight: 700;
  background: var(--sk-badge-bg, #f0f0f0);
  color: var(--sk-badge-text, #555);
  padding: 0.2em 0.55em;
  border-radius: 999px;
  flex-shrink: 0;
}

/* ── Pricing ── */
.sk-pricing {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.6rem;
}
.sk-price-original {
  font-size: 1rem;
  text-decoration: line-through;
  opacity: 0.45;
}
.sk-price-sale {
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--sk-text, #1a1a1a);
}
.sk-price-savings {
  font-size: 0.8rem;
  font-weight: 700;
  color: #fff;
  background: var(--sk-accent, #000);
  padding: 0.25em 0.7em;
  border-radius: 999px;
}

/* ── CTA Buttons ── */
.sk-cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}
.sk-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.85em 2em;
  border-radius: calc(var(--sk-border-radius, 16px) * 0.6);
  font-size: 0.95rem;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  transition: background 0.18s ease, transform 0.12s ease, box-shadow 0.18s ease;
  line-height: 1;
  border: 2px solid transparent;
}
.sk-btn--primary {
  background: var(--sk-btn-bg, #000);
  color: var(--sk-btn-text, #fff);
  border-color: var(--sk-btn-bg, #000);
}
.sk-btn--primary:hover {
  background: var(--sk-btn-hover, #333);
  border-color: var(--sk-btn-hover, #333);
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.15);
}
.sk-btn--secondary {
  background: transparent;
  color: var(--sk-btn-bg, #000);
  border-color: var(--sk-btn-bg, #000);
}
.sk-btn--secondary:hover {
  background: var(--sk-btn-bg, #000);
  color: var(--sk-btn-text, #fff);
  transform: translateY(-1px);
}
.sk-btn[aria-disabled="true"] {
  pointer-events: none;
  opacity: 0.5;
}

/* ── Fine Print ── */
.sk-fine-print {
  font-size: 0.75rem;
  opacity: 0.5;
  margin: 0;
  line-height: 1.5;
}

/* ── Mobile ── */
@media (max-width: 767px) {
  .sk-cta-group {
    flex-direction: column;
  }
  .sk-btn {
    width: 100%;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Sample Kit LP",
  "tag": "section",
  "class": "section-sample-kit",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Container width",
      "options": [
        { "value": "boxed", "label": "Boxed (1200px)" },
        { "value": "full_width", "label": "Full width" }
      ],
      "default": "boxed"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Image on left" },
        { "value": "right", "label": "Image on right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Eyebrow / Badge"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "placeholder": "e.g. Limited Time Offer",
      "default": "Try Before You Commit"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Perfect Sample Kit"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading / Description",
      "default": "Discover our bestselling products before committing to a full-size purchase. Free shipping on all sample kits."
    },
    {
      "type": "header",
      "content": "Kit Image"
    },
    {
      "type": "image_picker",
      "id": "kit_image",
      "label": "Kit image"
    },
    {
      "type": "checkbox",
      "id": "show_image_badge",
      "label": "Show image badge",
      "default": true
    },
    {
      "type": "text",
      "id": "image_badge_text",
      "label": "Image badge text",
      "placeholder": "e.g. NEW",
      "default": "Best Seller"
    },
    {
      "type": "header",
      "content": "Kit Contents Label"
    },
    {
      "type": "text",
      "id": "kit_contents_heading",
      "label": "Contents section heading",
      "default": "What's Included"
    },
    {
      "type": "header",
      "content": "Pricing"
    },
    {
      "type": "checkbox",
      "id": "show_pricing",
      "label": "Show pricing",
      "default": true
    },
    {
      "type": "text",
      "id": "original_price",
      "label": "Original price (display only)",
      "placeholder": "e.g. $49.99",
      "default": "$49.99"
    },
    {
      "type": "text",
      "id": "sale_price",
      "label": "Sale price (display only)",
      "placeholder": "e.g. $24.99",
      "default": "$24.99"
    },
    {
      "type": "text",
      "id": "savings_text",
      "label": "Savings badge text",
      "placeholder": "e.g. Save 50%",
      "default": "Save 50%"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Get Your Sample Kit"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "placeholder": "Leave blank to hide"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Fine Print"
    },
    {
      "type": "text",
