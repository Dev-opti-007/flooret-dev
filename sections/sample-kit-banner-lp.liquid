{% comment %}
  ================================================================
  Section: Sample Kit Hero Banner
  File:    sections/sample-kit-hero.liquid
  CSS:     Add sample-kit-hero.css to assets/ and reference below,
           OR keep the <style> block inside this file (both included).
  ================================================================
{% endcomment %}

<style>
    .sample-kit-hero {
        position: relative;
        width: 100%;
        height: var(--hero-height-mobile, 680px);
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      
      .sample-kit-hero__bg {
        position: absolute;
        inset: 0;
        z-index: 0;
      }
      
      .sample-kit-hero__bg img,
      .sample-kit-hero__no-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
        display: block;
      }
      
      .sample-kit-hero__no-image {
        background: #2a2320;
      }
      
      .sample-kit-hero__bg-img--mobile {
        display: block;
        height: 100%;
      }
      
      .sample-kit-hero__bg-img--desktop {
        display: none;
        height: 100%;
      }
      
      .sample-kit-hero__overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
          to top,
          rgba(0, 0, 0, var(--overlay-opacity, 0.55)) 0%,
          rgba(0, 0, 0, calc(var(--overlay-opacity, 0.55) * 0.5)) 50%,
          rgba(0, 0, 0, 0) 100%
        );
        pointer-events: none;
      }
      
      .sample-kit-hero__content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        height: 100%;
        padding: 24px 20px 32px;
      }
      
      .sample-kit-hero__nav {
        display: flex;
        align-items: flex-start;
      }
      
      .sample-kit-hero__back-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--pill-bg, #ffffff);
        color: var(--pill-text, #1a1a1a);
        padding: 8px 16px 8px 12px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 500;
        line-height: 1;
        text-decoration: none;
        white-space: nowrap;
        transition: opacity 180ms ease;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
      }
      
      .sample-kit-hero__back-pill:hover {
        opacity: 0.85;
      }
      
      .sample-kit-hero__chevron {
        font-size: 18px;
        line-height: 1;
        font-style: normal;
        margin-top: -1px;
      }
      
      .sample-kit-hero__text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 18px;
      }
      
      .sample-kit-hero__heading {
        font-family: var(--font-heading-family, Georgia, serif);
        font-size: clamp(28px, 7vw, 36px);
        font-weight: var(--font-heading-weight, 700);
        font-style: italic;
        color: var(--heading-color, #ffffff);
        line-height: 1.15;
        margin: 0;
        text-wrap: balance;
        max-width: 14ch;
      }
      
      .sample-kit-hero__cta {
        color: var(--cta-color, #ffffff);
        font-size: 15px;
        font-weight: 400;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-thickness: 1px;
        letter-spacing: 0.01em;
        transition: opacity 180ms ease;
      }
      
      .sample-kit-hero__cta:hover {
        opacity: 0.75;
      }
      
      @media screen and (min-width: 768px) {
        .sample-kit-hero {
          height: var(--hero-height-desktop, 500px);
        }
      
        .sample-kit-hero__bg-img--mobile {
          display: none;
        }
      
        .sample-kit-hero__bg-img--desktop {
          display: block;
        }
      
        .sample-kit-hero__content {
          padding: 36px 60px 52px;
        }
      
        .sample-kit-hero__heading {
          font-size: clamp(36px, 4vw, 64px);
          max-width: 16ch;
        }
      
        .sample-kit-hero__cta {
          font-size: 16px;
        }
      
        .sample-kit-hero__back-pill {
          font-size: 15px;
          padding: 9px 18px 9px 14px;
        }
      }
      
      @media screen and (min-width: 1024px) {
        .sample-kit-hero__content {
          padding: 44px 80px 64px;
        }
      }
</style>

{%- liquid
  assign bg_image        = section.settings.background_image
  assign bg_image_mobile = section.settings.background_image_mobile
  assign back_label      = section.settings.back_label
  assign back_url        = section.settings.back_url
  assign heading         = section.settings.heading
  assign cta_label       = section.settings.cta_label
  assign cta_url         = section.settings.cta_url
  assign section_height_desktop = section.settings.section_height_desktop
  assign section_height_mobile  = section.settings.section_height_mobile
  assign overlay_opacity        = section.settings.overlay_opacity | divided_by: 100.0
  assign heading_color   = section.settings.heading_color
  assign cta_color       = section.settings.cta_color
  assign pill_bg         = section.settings.pill_bg
  assign pill_text_color = section.settings.pill_text_color
-%}

<div
  id="sample-kit-hero-{{ section.id }}"
  class="sample-kit-hero"
  aria-label="{{ heading | escape }}"
>
  <div class="sample-kit-hero__bg" aria-hidden="true">
    {%- if bg_image_mobile != blank -%}
      <div class="sample-kit-hero__bg-img sample-kit-hero__bg-img--mobile">
        {{
          bg_image_mobile
          | image_url: width: 800
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '375, 430, 600, 800',
            sizes: '100vw',
            alt: heading | escape
        }}
      </div>
    {%- endif -%}

    <div class="sample-kit-hero__bg-img sample-kit-hero__bg-img--desktop">
      {%- if bg_image != blank -%}
        {{
          bg_image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '768, 1024, 1280, 1440, 1600, 1800',
            sizes: '100vw',
            alt: heading | escape
        }}
      {%- else -%}
        <div class="sample-kit-hero__no-image"></div>
      {%- endif -%}
    </div>

    <div class="sample-kit-hero__overlay"></div>
  </div>

  <div class="sample-kit-hero__content">
    {%- if back_label != blank -%}
      <nav class="sample-kit-hero__nav" aria-label="Breadcrumb">
        <a
          href="{{ back_url | default: '#' }}"
          class="sample-kit-hero__back-pill"
        >
          <span class="sample-kit-hero__chevron" aria-hidden="true">&#8249;</span>
          <span>{{ back_label }}</span>
        </a>
      </nav>
    {%- else -%}
      <div></div>
    {%- endif -%}

    <div class="sample-kit-hero__text">
      {%- if heading != blank -%}
        <{{ section.settings.heading_tag }} class="sample-kit-hero__heading">
          {{ heading }}
        </{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- if cta_label != blank and cta_url != blank -%}
        <a href="{{ cta_url }}" class="sample-kit-hero__cta">
          {{- cta_label -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  #sample-kit-hero-{{ section.id }} {
    --hero-height-desktop: {{ section_height_desktop }}px;
    --hero-height-mobile: {{ section_height_mobile }}px;
    --overlay-opacity: {{ overlay_opacity }};
    --heading-color: {{ heading_color }};
    --cta-color: {{ cta_color }};
    --pill-bg: {{ pill_bg }};
    --pill-text: {{ pill_text_color }};
  }
</style>

{% schema %}
{
  "name": "Sample Kit Hero",
  "class": "sample-kit-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image (Desktop)",
      "info": "Recommended size: 1800×700px or wider. Landscape orientation."
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Background Image (Mobile)",
      "info": "Recommended size: 800×700px. Portrait orientation. Falls back to the desktop image if blank."
    },
    {
      "type": "header",
      "content": "Back Navigation Pill"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back Button Label",
      "default": "Sample Kits",
      "info": "Leave blank to hide the back pill entirely."
    },
    {
      "type": "url",
      "id": "back_url",
      "label": "Back Button URL"
    },
    {
      "type": "header",
      "content": "Heading & CTA"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML Tag",
      "options": [
        { "value": "h1", "label": "H1 — Page Title" },
        { "value": "h2", "label": "H2 — Section Heading" },
        { "value": "h3", "label": "H3 — Sub Heading" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h1",
      "info": "Use H1 only if this is the primary heading on the page."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading Text",
      "default": "Discover what's inside every Flooret Sample Kit"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Link Text",
      "default": "Shop Samples",
      "info": "Leave blank to hide the CTA."
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA Link URL"
    },
    {
      "type": "header",
      "content": "Section Height"
    },
    {
      "type": "range",
      "id": "section_height_desktop",
      "label": "Desktop Height",
      "min": 300,
      "max": 900,
      "step": 10,
      "default": 500,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Mobile Height",
      "min": 300,
      "max": 800,
      "step": 10,
      "default": 680,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Overlay & Colors"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Gradient Overlay Strength",
      "min": 0,
      "max": 90,
      "step": 5,
      "default": 55,
      "unit": "%",
      "info": "Darkens the bottom of the image so text is always readable."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "CTA Link Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Back Pill Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "pill_text_color",
      "label": "Back Pill Text Color",
      "default": "#1a1a1a"
    }
  ],
  "presets": [
    {
      "name": "Sample Kit Hero",
      "category": "Hero"
    }
  ]
}
{% endschema %}