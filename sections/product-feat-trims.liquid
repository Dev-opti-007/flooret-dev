{%- liquid
  assign meta = product.metafields.flooret
  assign feat_trims = meta.product_featured_trims.value
  render 'feat-products-slider', module: section.settings, products: feat_trims.trims.value, color_link:product.title
-%}

{% schema %}
{
  "name": "PDP: Feat Trims",
  "class": "prod-feat-trim-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "presets": [
    {
      "name": "PDP: Feat Trims",
      "settings": {}
    }
  ]
}
{% endschema %}
