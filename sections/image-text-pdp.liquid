{% comment %}
  Image with Text PDP Section
  A split layout with image on one side and content on the other
{% endcomment %}

<style>
  .image-text--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    background: {{ section.settings.bg_color }};
  }
  .image-text--{{ section.id }} .page-width {
    max-width:{{ section.settings.max-width }}px;
    margin:0px auto;
  }
  @media (max-width: 768px) {
    .image-text--{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mob }}px;
      padding-bottom: {{ section.settings.padding_bottom_mob }}px;
      padding-left: {{ section.settings.padding_left_mob }}px;
      padding-right: {{ section.settings.padding_right_mob }}px;
    }
  }

  .image-text__container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.gap }}px;
    align-items: {{ section.settings.vertical_align }};
  }

  @media (max-width: 990px) {
    .image-text__container {
      gap: {{ section.settings.gap_tablet }}px;
    }
  }

  @media (max-width: 768px) {
    .image-text__container {
      grid-template-columns: 1fr;
      gap: {{ section.settings.gap_mob }}px;
    }
  }

  /* Image Position - Desktop */
  {% if section.settings.image_position == 'right' %}
  .image-text__media {
    order: 2;
  }
  .image-text__content {
    order: 1;
  }
  {% else %}
  .image-text__media {
    order: 1;
  }
  .image-text__content {
    order: 2;
  }
  {% endif %}

  /* Image Position - Mobile */
  @media (max-width: 768px) {
    {% if section.settings.image_position_mobile == 'bottom' %}
    .image-text__media {
      order: 2;
    }
    .image-text__content {
      order: 1;
    }
    {% else %}
    .image-text__media {
      order: 1;
    }
    .image-text__content {
      order: 2;
    }
    {% endif %}
  }

  .image-text__media {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ section.settings.image_radius }}px;
  }

  .image-text__media img,
  .image-text__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: {{ section.settings.image_ratio }};
    border-radius:10px;
  }

  @media (max-width: 768px) {
    .image-text__media img,
    .image-text__media video {
      aspect-ratio: {{ section.settings.image_ratio_mob }};
    }
  }

  .image-text__content {
    padding: {{ section.settings.content_padding }}px;
    text-align: {{ section.settings.text_align }};
  }

  @media (max-width: 768px) {
    .image-text__content {
      padding: {{ section.settings.content_padding_mob }}px;
      text-align: {{ section.settings.text_align_mob }};
    }
  }
  .image-text__heading.desk-hide {
    display:none;
  }
  .image-text__heading {
    margin: 0 0 {{ section.settings.heading_margin_bottom }}px;
    color: {{ section.settings.heading_color }};
    font-family: {{ section.settings.heading_font }}, sans-serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }};
  }

  @media (max-width: 768px) {
    .image-text__heading.desk-hide {
      display:block;
    }
    .image-text__heading.mob-hide {
      display:none;
    }
    .image-text__heading {
      font-size: {{ section.settings.heading_size_mob }}px;
      margin-bottom: {{ section.settings.heading_margin_bottom_mob }}px;
    }
  }

  .image-text__text {
    margin: 0 0 {{ section.settings.text_margin_bottom }}px;
    color: {{ section.settings.text_color }};
    font-family: {{ section.settings.text_font }}, sans-serif;
    font-size: {{ section.settings.text_size }}px;
    font-weight: {{ section.settings.text_weight }};
    line-height: {{ section.settings.text_line_height }};
  }

  @media (max-width: 768px) {
    .image-text__text {
      font-size: {{ section.settings.text_size_mob }}px;
      margin-bottom: {{ section.settings.text_margin_bottom_mob }}px;
    }
  }

  .image-text__text-2 {
    margin: 0 0 {{ section.settings.text2_margin_bottom }}px;
    color: {{ section.settings.text2_color }};
    font-family: {{ section.settings.text_font }}, sans-serif;
    font-size: {{ section.settings.text2_size }}px;
    font-weight: {{ section.settings.text2_weight }};
    line-height: {{ section.settings.text_line_height }};
  }

  @media (max-width: 768px) {
    .image-text__text-2 {
      font-size: {{ section.settings.text2_size_mob }}px;
      margin-bottom: {{ section.settings.text2_margin_bottom_mob }}px;
    }
  }

  .image-text__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_color }};
    font-family: {{ section.settings.button_font }}, sans-serif;
    font-size: {{ section.settings.button_size }}px;
    font-weight: {{ section.settings.button_weight }};
    text-decoration: none;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: {{ section.settings.button_margin_top }}px;
  }

  .image-text__button:hover {
    background: {{ section.settings.button_bg_hover }};
    color: {{ section.settings.button_color_hover }};
    border-color: {{ section.settings.button_border_color_hover }};
  }

  @media (max-width: 768px) {
    .image-text__button {
      font-size: {{ section.settings.button_size_mob }}px;
      padding: {{ section.settings.button_padding_y_mob }}px {{ section.settings.button_padding_x_mob }}px;
      margin-top: {{ section.settings.button_margin_top_mob }}px;
      {% if section.settings.button_full_width_mob %}
      width: 100%;
      {% endif %}
    }
  }
</style>

<section class="image-text--{{ section.id }}">
  <div class="page-width">
    <div class="image-text__container">
      
      <div class="image-text__media">
        {% if section.settings.heading != blank %}
          <h2 class="image-text__heading desk-hide">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.media_type == 'video' and section.settings.video_url != blank %}
          <video 
            playsinline 
            {% if section.settings.video_autoplay %}autoplay{% endif %} 
            {% if section.settings.video_muted %}muted{% endif %} 
            {% if section.settings.video_loop %}loop{% endif %}
            {% if section.settings.video_controls %}controls{% endif %}
            poster="{{ section.settings.image | image_url: width: 1600 }}"
          >
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {% elsif section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1600 | image_tag: 
            loading: 'lazy', 
            alt: section.settings.image_alt | default: section.settings.heading 
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      <div class="image-text__content">
        {% if section.settings.heading != blank %}
          <h2 class="image-text__heading mob-hide">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="image-text__text">{{ section.settings.text }}</div>
        {% endif %}

        {% if section.settings.text_2 != blank %}
          <div class="image-text__text-2">{{ section.settings.text_2 }}</div>
        {% endif %}

        {% if section.settings.button_label != blank and section.settings.button_url != blank %}
          <a href="{{ section.settings.button_url }}" class="image-text__button">
            {{ section.settings.button_label }}
          </a>
        {% endif %}
      </div>

    </div>
  </div>
</section>

