<style>
  .feature-grid--{{ section.id }} {
    padding-top: {{ section.settings.padding-top }}px;
    padding-bottom: {{ section.settings.padding-bottom }}px;
    padding-left: {{ section.settings.padding-left }}px;
    padding-right: {{ section.settings.padding-right }}px;
    background: {{ section.settings.bg-color }};
  }
  .feature-grid--{{ section.id }} .heading h2 {
    color: {{ section.settings.color_heading }};
    font-family: {{ section.settings.font_heading }};
    font-size: {{ section.settings.font_size_heading }}px;
    font-weight: {{ section.settings.heading_weight | default: 600 }};
    margin-bottom: 40px;
    text-align: center;
  }
  @media (max-width: 768px) {
    .feature-grid--{{ section.id }} {
      padding-top: {{ section.settings.padding-top-mob }}px;
      padding-bottom: {{ section.settings.padding-bottom-mob }}px;
      padding-left: {{ section.settings.padding-left-mob }}px;
      padding-right: {{ section.settings.padding-right-mob }}px;
    }
    .feature-grid--{{ section.id }} .heading h2 {
      font-size: {{ section.settings.font_size_heading_mob }}px;
      margin-bottom: 25px;
    }
  }
</style>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--fg-gap, 16px);
  }

  /* Prevent initial flash for the section heading */
  .feature-grid--{{ section.id }} .heading h2 {
    opacity: 0;
    transform: translateY(60px);
    will-change: transform, opacity;
  }

  /* Initial hidden state to prevent flash before GSAP runs */
  .feature-grid__text .feature-grid__heading,
  .feature-grid__text .feature-grid__sub,
  .feature-grid__text .feature-grid__buttons {
    opacity: 0;
    transform: translateY(60px);
    will-change: transform, opacity;
  }

  @media (min-width: 990px) {
    .feature-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .feature-grid__item {
    position: relative;
    overflow: hidden;
  }

  .feature-grid__item.full {
    grid-column: 1 / -1;
  }

  .feature-grid__media {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 260px;
  }

  .feature-grid__media img,
  .feature-grid__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .feature-grid__overlay {
    position: absolute;
    inset: 0;
  }

  .feature-grid__textwrap {
    position: absolute;
    inset: 0;
    display: grid;
  }

  .feature-grid__text {
    max-width: 560px;
  }

  .feature-grid__heading {
    margin: 0 0 24px;
    color: var(--fg-head-color);
    font-weight: var(--fg-head-weight, 800);
  }

  .feature-grid__sub {
    margin: 0 0 24px;
    color: var(--fg-sub-color);
    font-weight: var(--fg-sub-weight, 600);
    line-height: 24px;
  }

  .feature-grid__buttons {
    display: flex;
    gap: 12px;
    /* flex-wrap: wrap; */
  }

  .feature-grid__buttons .btn {
    padding: 0px;
    border: 1px solid transparent;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--fg-btn-font-family);
    color: var(--fg-btn1-color);
    background: var(--fg-btn1-bg);
    /* margin-top: 14px; */
    font-weight: var(--fg-btn-weight, 700);
    text-decoration: underline;
  }

  .feature-grid__buttons .btn:hover {
    color: var(--fg-btn1-color-h);
    background: var(--fg-btn1-bg-h);
  }

  .feature-grid__buttons .btn--2 {
    color: var(--fg-btn2-color);
    background: var(--fg-btn2-bg);
    margin-left: 15px;
    margin-top: 0px;
  }

  .feature-grid__buttons .btn--2:hover {
    color: var(--fg-btn2-color-h);
    background: var(--fg-btn2-bg-h);
  }

  /* Mobile typography */
  @media (max-width: 768px) {
    .feature-grid.slider-mobile-f-grid {
        max-height: 315px;
    }

    .feature-grid.slider-mobile-f-grid.slick-initialized {
        max-height: unset;
    }
    .feature-grid {
      gap: {{ section.settings.gap_mobile | default: section.settings.gap | default: 16 }}px;
    }

    .feature-grid__buttons .btn {
      margin-top: 0px !important;
    }
    .feature-grid__heading {
      font-family: var(--fg-head-font-family);
      font-size: var(--fg-head-size-m);
    }

    .feature-grid__sub {
      font-family: var(--fg-body-font-family);
      font-size: var(--fg-sub-size-m);
    }

    .feature-grid__buttons .btn {
      font-family: var(--fg-btn-font-family);
      font-size: var(--fg-btn-size-m);
      white-space: nowrap;
      justify-content: start;
      min-width: unset;
      width: auto;
    }

    {% comment %} {% if section.settings.mobile_slider %}
  .feature-grid--{{ section.id }} .feature-grid {
    display: flex !important;
    flex-direction: row;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    gap: {{ section.settings.gap_mobile | default: section.settings.gap | default: 16 }}px;
    padding-bottom: 10px;
    -webkit-overflow-scrolling: touch;
  }
  .feature-grid--{{ section.id }} .feature-grid__item {
    flex: 0 0 70%;
    scroll-snap-align: start;
  }
  {% endif %} {% endcomment %}
  }

  @media (min-width: 769px) {
    .feature-grid__heading {
      font-family: var(--fg-head-font-family);
      font-size: var(--fg-head-size-d);
    }

    .feature-grid__sub {
      font-family: var(--fg-body-font-family);
      font-size: var(--fg-sub-size-d);
    }

    .feature-grid__buttons .btn {
      font-family: var(--fg-btn-font-family);
      font-size: var(--fg-btn-size-d);
    }
  }

  /* Full bleed option */
  .feature-grid--fullbleed {
    width: 100vw;
    margin-left: 50%;
    transform: translateX(-50%);
  }
</style>

<div class="feature-grid--{{ section.id }}">
  {% if section.settings.heading != blank %}
  <div class="heading">
    <h2>{{ section.settings.heading }}</h2>
  </div>
  {% endif %}

  <div class="feature-grid {% if section.settings.mobile_slider %}slider-mobile-f-grid{% endif %} {% if section.settings.full_bleed %}feature-grid--fullbleed{% endif %}" style="--fg-gap: {{ section.settings.gap | default: 16 }}px">
    {% for block in section.blocks %}
      {% assign b = block.settings %}
      <div class="feature-grid__item feature-grid__item--{{ block.id }} {% if b.width == 'full' %}full{% endif %}" {{ block.shopify_attributes }}>
        <div class="feature-grid__media">
          {% if b.media_type == 'video' and b.video_url != blank %}
            <video playsinline muted loop autoplay poster="{{ b.video_thumb | img_url: '1200x' }}">
              <source src="{{ b.video_url }}" type="video/mp4">
            </video>
          {% else %}
            {% if b.image != blank %}
              {{ b.image | image_url: width: 2000 | image_tag:
                alt: b.heading | default: 'Feature image',
                loading: 'lazy',
                width: 1200,
                height: 800,
                class: 'feature-grid__image'
              }}
            {% endif %}
          {% endif %}
          {% if b.overlay_opacity > 0 %}
            <span class="feature-grid__overlay" style="background-color: {{ b.overlay_color }}; opacity: {{ b.overlay_opacity }}"></span>
          {% endif %}
          <style>
            @media (min-width: 769px) {
              .feature-grid__item--{{ block.id }} {
                {% if b.enable_manual_height_desk == true %}
                  max-height: {{ b.height_desk }}px;
                  height: {{ b.height_desk }}px;
                {% endif %}
              }
            }
            @media (max-width: 768px) {
              .feature-grid__item--{{ block.id }} {
                {% if b.enable_manual_height_mob == true %}
                  max-height: {{ b.height_mob }}px;
                  height: {{ b.height_mob }}px;
                
                {% endif %}
              }
            }
          </style>
        </div>

        {% assign vpos = b.vpos_desktop | default: 'center' %}
        {% assign hpos = b.hpos_desktop | default: 'center' %}
        {% assign talign = b.text_align_desktop | default: 'center' %}

        <div class="feature-grid__textwrap" style="
          --fg-head-color: {{ b.heading_color }};
          --fg-sub-color: {{ b.subtext_color }};

          {% comment %} Font family selects with fallback to theme defaults {% endcomment %}
          --fg-head-font-family: '{{ b.font_heading | default: settings.type_header_font | default: 'system-ui' }}', sans-serif;
          --fg-body-font-family: '{{ b.font_body | default: settings.type_body_font | default: 'system-ui' }}', sans-serif;
          --fg-btn-font-family: '{{ b.font_buttons | default: settings.type_body_font | default: 'system-ui' }}', sans-serif;

          --fg-head-size-m: {{ b.heading_size_m | default: 24 }}px;
          --fg-sub-size-m: {{ b.subtext_size_m | default: 16 }}px;
          --fg-btn-size-m: {{ b.button_size_m | default: 14 }}px;

          --fg-head-size-d: {{ b.heading_size_d | default: 40 }}px;
          --fg-sub-size-d: {{ b.subtext_size_d | default: 18 }}px;
          --fg-btn-size-d: {{ b.button_size_d | default: 15 }}px;

          --fg-btn1-color: {{ b.btn1_text_color }};
          --fg-btn1-bg: {{ b.btn1_bg }};
          --fg-btn1-color-h: {{ b.btn1_text_hover }};
          --fg-btn1-bg-h: {{ b.btn1_bg_h }};
          --fg-btn2-color: {{ b.btn2_text_color }};
          --fg-btn2-bg: {{ b.btn2_bg }};
          --fg-btn2-color-h: {{ b.btn2_text_hover }};
          --fg-btn2-bg-h: {{ b.btn2_bg_h }};

          /* ADD: emit font-weight variables with defaults */
          --fg-head-weight: {{ b.heading_weight | default: 800 }};
          --fg-sub-weight: {{ b.subtext_weight | default: 600 }};
          --fg-btn-weight: {{ b.button_weight | default: 700 }};
        ">
          <div class="feature-grid__text">
            {% if b.heading != blank %}
              <h2 class="feature-grid__heading">{{ b.heading }}</h2>
            {% endif %}
            {% if b.subtext != blank %}
              <div class="feature-grid__sub">{{ b.subtext }}</div>
            {% endif %}
            {% if b.btn1_label != blank or b.btn2_label != blank %}
              <div class="feature-grid__buttons">
                {% if b.btn1_label != blank %}
                  <a class="btn" href="{{ b.btn1_url }}">{{ b.btn1_label }}</a>
                {% endif %}
                {% if b.btn2_label != blank %}
                  <a class="btn btn--2" href="{{ b.btn2_url }}">{{ b.btn2_label }}</a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>

        <style>
          @media (min-width: 769px) {
            .feature-grid__item--{{ block.id }} .feature-grid__textwrap {
              padding: {{ b.pad | default: 24 }}px;
            }
            .feature-grid__item--{{ block.id }} .feature-grid__text {
              max-width: {{ b.text_width_desktop | default: 60 }}%;
              justify-self: {{ b.hpos_desktop | default: 'center' }};
              align-self: {{ b.vpos_desktop | default: 'center' }};
              text-align: {{ b.text_align_desktop | default: 'center' }};
            }
          }
          @media (max-width: 768px) {
            .feature-grid__item--{{ block.id }} .feature-grid__textwrap {
              padding: {{ b.pad_mobile | default: 16 }}px;
            }
            .feature-grid__item--{{ block.id }} .feature-grid__text {
              max-width: {{ b.text_width_mobile | default: 100 }}%;
              justify-self: {{ b.hpos_mobile | default: b.hpos_desktop | default: 'center' }};
              align-self: {{ b.vpos_mobile | default: b.vpos_desktop | default: 'center' }};
              text-align: {{ b.text_align_mobile | default: b.text_align_desktop | default: 'center' }};
            }
          }
        </style>
      </div>
    {% endfor %}
  </div>
</div>

{% if section.settings.mobile_slider %}
<script>
document.addEventListener('DOMContentLoaded', function () {
  if(window.innerWidth < 769){
    $('.slider-mobile-f-grid').slick({
      dots: false,
      infinite: false,
      arrows: false,
      speed: 300,
      slidesToShow: 1,
      centerMode: true,
      centerPadding: '{{section.settings.center-padding}}px'
    });
  }
});
</script>
<style>
  @media (max-width: 769px){
    .slider-mobile-f-grid .slick-track .slick-slide {
        margin: 0px {{section.settings.gap-between-slider}}px 0px 0px;
    }
    .slider-mobile-f-grid  .slick-list .slick-track {
        margin-left: -{{section.settings.margin-left-section-slider}}px;
    }
  }
</style>
{% endif %}

