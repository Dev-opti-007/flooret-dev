  if (!sectionRoot) return;

  // Desktop: unchanged behavior
  gsap.matchMedia().add('(min-width: 769px)', () => {
    sectionRoot.querySelectorAll('.feature-grid__item').forEach((item) => {
      const heading = item.querySelector('.feature-grid__text .feature-grid__heading');
      const sub     = item.querySelector('.feature-grid__text .feature-grid__sub');
      const buttons = item.querySelector('.feature-grid__text .feature-grid__buttons');
      
      if (!heading && !sub && !buttons) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: item,
          start: 'clamp(top 10%)',
          toggleActions: 'play none none none',
          once: true,
          markers: false
        }
      });

      if (heading) tl.to(heading, { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out' }, 0);
      if (sub)     tl.to(sub,     { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out' }, 0.15);
      if (buttons) tl.to(buttons, { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out' }, 0.30);
    });
  });

  // Mobile: different start position for bottom
  gsap.matchMedia().add('(max-width: 768px)', () => {
    sectionRoot.querySelectorAll('.feature-grid__item').forEach((item) => {
      const heading = item.querySelector('.feature-grid__text .feature-grid__heading');
      const sub     = item.querySelector('.feature-grid__text .feature-grid__sub');
      const buttons = item.querySelector('.feature-grid__text .feature-grid__buttons');
      
      if (!heading && !sub && !buttons) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: item,
          start: 'clamp(top 70%)',
          toggleActions: 'play none none none',
          once: true,
          markers: false
        }
      });

      if (heading) tl.to(heading, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, 0);
      if (sub)     tl.to(sub,     { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, 0.12);
      if (buttons) tl.to(buttons, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, 0.24);
    });
  });

  // Robust refresh sequence
  window.addEventListener('load', () => {
    setTimeout(() => {
      scrollTriggerManager.safeRefresh(50);
    }, 50);
  });
});
</script>
