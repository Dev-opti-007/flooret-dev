<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('Feature Grid GSAP Script - DOMContentLoaded triggered for section {{ section.id }}');
  
  if (!window.gsap || !window.ScrollTrigger) {
    console.error('Feature Grid GSAP Script - GSAP or ScrollTrigger not loaded');
    console.log('window.gsap:', !!window.gsap);
    console.log('window.ScrollTrigger:', !!window.ScrollTrigger);
    return;
  }

  console.log('Feature Grid GSAP Script - GSAP and ScrollTrigger are available');
  gsap.registerPlugin(ScrollTrigger);
  console.log('Feature Grid GSAP Script - ScrollTrigger plugin registered');

  const sectionRoot = document.querySelector('.feature-grid--{{ section.id }}');
  console.log('Feature Grid GSAP Script - Section ID:', '{{ section.id }}');
  console.log('Feature Grid GSAP Script - Section Root found:', !!sectionRoot);
  
  if (!sectionRoot) {
    console.error('Feature Grid GSAP Script - Section root not found: .feature-grid--{{ section.id }}');
    console.log('Available feature-grid elements:', document.querySelectorAll('.feature-grid').length);
    return;
  }

  console.log('Feature Grid GSAP Script - Section root found successfully');
  console.log('Feature Grid GSAP Script - Section root classes:', sectionRoot.className);

  // Mid-page refresh guard for this section instance
  console.log('Feature Grid GSAP Script - Attempting scrollTriggerManager.revealIfInViewAll');
  
  if (typeof scrollTriggerManager !== 'undefined' && scrollTriggerManager.revealIfInViewAll) {
    console.log('Feature Grid GSAP Script - scrollTriggerManager is available');
    const targetsString = '.feature-grid--{{ section.id }} .heading h2, ' +
                          '.feature-grid--{{ section.id }} .feature-grid__text .feature-grid__heading, ' +
                          '.feature-grid--{{ section.id }} .feature-grid__text .feature-grid__sub, ' +
                          '.feature-grid--{{ section.id }} .feature-grid__text .feature-grid__buttons';
    
    console.log('Feature Grid GSAP Script - Targets string:', targetsString);
    
    const targetElements = document.querySelectorAll(targetsString);
    console.log('Feature Grid GSAP Script - Target elements found:', targetElements.length);
    
    targetElements.forEach((el, index) => {
      console.log(`Feature Grid GSAP Script - Target ${index + 1}:`, el, 'Classes:', el.className);
    });
    
    try {
      scrollTriggerManager.revealIfInViewAll(targetsString);
      console.log('Feature Grid GSAP Script - scrollTriggerManager.revealIfInViewAll executed successfully');
    } catch (error) {
      console.error('Feature Grid GSAP Script - Error in revealIfInViewAll:', error);
    }
  } else {
    console.warn('Feature Grid GSAP Script - scrollTriggerManager not available, skipping revealIfInViewAll');
  }

  // Section heading animation
  const headingEl = sectionRoot.querySelector('.heading h2');
  console.log('Feature Grid GSAP Script - Heading element search: .heading h2');
  console.log('Feature Grid GSAP Script - Heading found:', !!headingEl);
  
  if (headingEl) {
    console.log('Feature Grid GSAP Script - Initial heading state:', {
      opacity: headingEl.style.opacity,
      transform: headingEl.style.transform
    });
    
    console.log('Feature Grid GSAP Script - Setting up heading animation');
    console.log('Feature Grid GSAP Script - Heading target:', headingEl);
    console.log('Feature Grid GSAP Script - Heading classes:', headingEl.className);
    
    const tween = gsap.to(headingEl, {
      scrollTrigger: {
        trigger: sectionRoot,
        start: 'clamp(top 70%)',
        toggleActions: 'play none none none',
        once: true,
        markers: false,
        onEnter: () => console.log('Feature Grid GSAP Script - Heading ScrollTrigger onEnter'),
        onLeave: () => console.log('Feature Grid GSAP Script - Heading ScrollTrigger onLeave'),
        onToggle: (self) => console.log('Feature Grid GSAP Script - Heading ScrollTrigger toggled, isActive:', self.isActive)
      },
      y: 0,
      opacity: 1,
      duration: 0.9,
      ease: 'power3.out',
      onStart: () => console.log('Feature Grid GSAP Script - Heading animation started'),
      onComplete: () => console.log('Feature Grid GSAP Script - Heading animation completed'),
      onUpdate: (self) => {
        if (self.progress > 0 && self.progress < 1) {
          // Optional: Log progress if needed for debugging
        }
      }
    });

    console.log('Feature Grid GSAP Script - Heading tween created:', tween);
  } else {
    console.warn('Feature Grid GSAP Script - Heading element not found');
    console.log('Available heading elements:', document.querySelectorAll('.heading'));
    console.log('Available h2 elements in section:', sectionRoot.querySelectorAll('h2'));
  }

  // Debug section structure
  console.log('Feature Grid GSAP Script - Section structure debug:');
  console.log('- Section root:', sectionRoot);
  console.log('- All children:', sectionRoot.children.length);
  Array.from(sectionRoot.children).forEach((child, index) => {
    console.log(`  Child ${index + 1}:`, child.tagName, child.className);
  });

  console.log('Feature Grid GSAP Script - All ScrollTriggers in page:', ScrollTrigger.getAll().length);
});
</script>


{% if section.settings.animation-position == 'top' %}
<script>
document.addEventListener('DOMContentLoaded', function() {
  if (!window.gsap || !window.ScrollTrigger) return;
  
  gsap.registerPlugin(ScrollTrigger);

  const sectionRoot = document.querySelector('.feature-grid--{{ section.id }}');
  if (!sectionRoot) return;

  // Use matchMedia for responsive animations
  gsap.matchMedia().add('(min-width: 769px)', () => {
    // Desktop: unchanged behavior
    sectionRoot.querySelectorAll('.feature-grid__item').forEach((item) => {
      const heading = item.querySelector('.feature-grid__text .feature-grid__heading');
      const sub     = item.querySelector('.feature-grid__text .feature-grid__sub');
      const buttons = item.querySelector('.feature-grid__text .feature-grid__buttons');
      
      if (!heading && !sub && !buttons) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: item,
          start: 'clamp(top 60%)',
          toggleActions: 'play none none none',
          once: true,
          markers: false
        }
      });

      if (heading) tl.to(heading, { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out' }, 0);
      if (sub)     tl.to(sub,     { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out' }, 0.15);
      if (buttons) tl.to(buttons, { y: 0, opacity: 1, duration: 0.8, ease: 'power3.out' }, 0.30);
    });
  });

  gsap.matchMedia().add('(max-width: 768px)', () => {
    // Mobile: different start position
    sectionRoot.querySelectorAll('.feature-grid__item').forEach((item) => {
      const heading = item.querySelector('.feature-grid__text .feature-grid__heading');
      const sub     = item.querySelector('.feature-grid__text .feature-grid__sub');
      const buttons = item.querySelector('.feature-grid__text .feature-grid__buttons');
      
      if (!heading && !sub && !buttons) return;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: item,
          start: 'clamp(top 80%)',
          toggleActions: 'play none none none',
          once: true,
          markers: false
        }
      });

      if (heading) tl.to(heading, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, 0);
      if (sub)     tl.to(sub,     { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, 0.12);
      if (buttons) tl.to(buttons, { y: 0, opacity: 1, duration: 0.7, ease: 'power3.out' }, 0.24);
    });
  });

  // Robust refresh sequence
  window.addEventListener('load', () => {
    setTimeout(() => {
      scrollTriggerManager.safeRefresh(50);
    }, 50);
  });
});
</script>
