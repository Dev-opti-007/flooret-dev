      {
        "type": "range",
        "id": "padding-top",
        "min": 2,
        "max": 200,
        "step": 2,
        "label": "Padding Top",
        "default": 2
      },
      {
        "type": "range",
        "id": "padding-bottom",
        "min": 2,
        "max": 200,
        "step": 2,
        "label": "Padding Bottom",
        "default": 2
      }
    ],
    "blocks":[
      {
        "type": "pointer",
        "name":"Pointer",
        "settings": [
          {
            "type": "number",
            "id": "number",
            "label": "Pointer Number"
          },
          {
            "type": "html",
            "id": "title",
            "label": "Title"
          },
          {
            "type": "richtext",
            "id": "subtext",
            "label": "Subtext"
          }
        ]
      }
    ],
    "presets": [
      {
        "name":"Image with Pointers"
      }
    ]
  }
{% endschema %}