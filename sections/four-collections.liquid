<section class="four-collections-section">
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <h2 class="fc-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <div class="fc-subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    <div class="fc-cards">

      {% for block in section.blocks %}
        <div class="fc-card" {{ block.shopify_attributes }}>

          {% if block.settings.image %}
            <div class="fc-card-image">
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag:
                  loading: 'lazy',
                  widths: '297,600'
              }}
            </div>
          {% endif %}

          <div class="fc-card-content">

            {% if block.settings.title != blank %}
              <h3 class="fc-card-title">
                {{ block.settings.title }}
              </h3>
            {% endif %}

            {% if block.settings.best_for != blank %}
              <div class="fc-best-for-label">
                BEST FOR
              </div>

              <div class="fc-best-for">
                {{ block.settings.best_for }}
              </div>
            {% endif %}

            {% if block.settings.description != blank %}
              <div class="fc-description">
                {{ block.settings.description }}
              </div>
            {% endif %}

            <div class="fc-divider"></div>

            <div class="fc-icons">

              {% if block.settings.icon_1 %}
                {{
                  block.settings.icon_1
                  | image_url: width: 64
                  | image_tag: loading: 'lazy'
                }}
              {% endif %}

              {% if block.settings.icon_2 %}
                {{
                  block.settings.icon_2
                  | image_url: width: 64
                  | image_tag: loading: 'lazy'
                }}
              {% endif %}

              {% if block.settings.icon_3 %}
                {{
                  block.settings.icon_3
                  | image_url: width: 64
                  | image_tag: loading: 'lazy'
                }}
              {% endif %}

              {% if block.settings.icon_4 %}
                {{
                  block.settings.icon_4
                  | image_url: width: 64
                  | image_tag: loading: 'lazy'
                }}
              {% endif %}

              {% if block.settings.icon_5 %}
                {{
                  block.settings.icon_5
                  | image_url: width: 64
                  | image_tag: loading: 'lazy'
                }}
              {% endif %}

            </div>

            {% if block.settings.button_text != blank %}
              <a
                href="{{ block.settings.button_link }}"
                class="fc-button"
              >
                {{ block.settings.button_text }}
              </a>
            {% endif %}

          </div>

        </div>
      {% endfor %}

    </div>

  </div>
</section>

<style>
.four-collections-section{
  background:#F4F2EC;
  padding:80px 0;
}

.fc-heading{
  font-size:40px;
  font-weight:500;
  line-height:1.2;
  text-align:center;
  margin:0 0 24px;
  color:#000000;
}

.fc-subheading{
  max-width:640px;
  margin:0 auto 50px;
  text-align:center;
  font-size:16px;
  font-weight:500;
  line-height:1.5;
  color:#4A5565;
}

.fc-cards{
  display:flex;
  justify-content:center;
  gap:30px;
  flex-wrap:wrap;
}

.fc-card{
  width:100%;
  max-width:297px;
  flex:1 1 260px;
  min-height:586px;
  background:#FFFFFF;
  border-radius:10px;
  overflow:hidden;
}

.fc-card-image{
  width:100%;
  height:212px;
}

.fc-card-image img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.fc-card-content{
  padding:24px;
}

.fc-card-title{
  font-family: 'Playfair Display';
  color:#000000;
  font-size:30px;
  font-weight:500;
  line-height:1.05;
  margin:0 0 18px;
}

.fc-best-for-label{
  font-size:12px;
  font-weight:700;
  color:#4A5565;
  letter-spacing:.08em;
  margin-bottom:8px;
}

.fc-best-for{
  color:#4A5565;
  font-family: 'Playfair Display';
  font-size:13px;
  font-weight:500;
  line-height: 20px;
}

.fc-best-for ul{
  padding-left:22px;
  margin:0;
}

.fc-description{
  margin-top:20px;
  font-size:12px;
  font-weight:400;
  line-height:1.6;
  color:#000000;
}

.fc-divider{
  width:249px;
  border-top:1px solid #A4A4A4;
  margin:22px 0;
}

.fc-icons{
  width:249px;
  min-height:32px;
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:22px;
}

.fc-icons img{
  width:auto;
  height:32px;
  display:block;
}

.fc-button{
  font-size:14px;
  font-weight:600;
  text-decoration:underline;
  color:#000;
  display:inline-block;
}

@media screen and (max-width: 1279px) and (min-width: 750px) {
  .fc-cards{
    display:grid;
    grid-template-columns:repeat(2, minmax(297px, 297px));
    justify-content:center;
    gap:30px;
  }

  .fc-card{
    width:297px;
    max-width:297px;
  }
}

@media screen and (max-width: 749px){
  .four-collections-section{
    display:none;
  }
}
</style>

{% schema %}
{
  "name": "Four Collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "best_for",
          "label": "Best For List"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "icon_1",
          "label": "Icon 1"
        },
        {
          "type": "image_picker",
          "id": "icon_2",
          "label": "Icon 2"
        },
        {
          "type": "image_picker",
          "id": "icon_3",
          "label": "Icon 3"
        },
        {
          "type": "image_picker",
          "id": "icon_4",
          "label": "Icon 4"
        },
        {
          "type": "image_picker",
          "id": "icon_5",
          "label": "Icon 5"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Four Collections",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}