{% assign _settings = section.settings %}
{% assign _items = section.blocks %}
<section>
  <div class="container">
    <div class="compare-intro">
    {% if _settings.heading != blank %}
      <h2 class="h1">
        {{ _settings.heading }}
      </h2>
    {% endif %}
      <div class="compare-titles">

        {% if _settings.collection_title_1 != blank %}
          <span class="h6">
            {% if _settings.collection_image_1 != blank %}
              {% render 'lazy-image', image: _settings.collection_image_1, width: '20' %}
            {% endif %}
            {{ _settings.collection_title_1 }}
          </span>
        {% endif %}

        {% if _settings.collection_title_2 != blank %}
          <span class="h6">
             {% if _settings.collection_image_2 != blank %}
               {% render 'lazy-image', image: _settings.collection_image_2, width: '20' %}
             {% endif %}
            {{ _settings.collection_title_2 }}
          </span>
        {% endif %}

        {% if _settings.collection_title_3 != blank %}
          <span class="h6">
            {% if _settings.collection_image_3 != blank %}
              {% render 'lazy-image', image: _settings.collection_image_3, width: '20' %}
            {% endif %}
            {{ _settings.collection_title_3 }}
          </span>
        {% endif %}

      </div>
    </div>

    <div class="compare-row">
     {% for block in _items %}
       <div class="compare-row__item">
          <span class="h6">{{ block.settings.compare_title }}</span>
          {{ block.settings.compare_content }}
          {% render 'lazy-image', image: block.settings.compare_image, width: '600' %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Compare Collections",
  "class": "shopify-block compare-block",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Collections"
    },
     {
      "type": "text",
      "id": "collection_title_1",
      "label": "Collection Title 1"
    },
      {
      "type": "image_picker",
      "id": "collection_image_1",
      "label": "Collection Image 1"
    },
     {
      "type": "text",
      "id": "collection_title_2",
      "label": "Collection Title 2"
    },
      {
      "type": "image_picker",
      "id": "collection_image_2",
      "label": "Collection Image 2"
    },
    {
      "type": "text",
      "id": "collection_title_3",
      "label": "Collection Title 3"
    },
    {
      "type": "image_picker",
      "id": "collection_image_3",
      "label": "Collection Image 3"
    }

  ],
  "blocks": [
     {
       "name": "Compare",
       "type": "compare",
       "settings": [
         {
           "type": "text",
           "id": "compare_title",
           "label": "Title"
         },
         {
           "type": "text",
           "id": "compare_content",
           "label": "Content"
         },
          {
          "type": "image_picker",
          "id": "compare_image",
          "label": "Image"
        }
       ]
     }
  ],  
  "presets": [
    {
      "name": "Compare Collections",
      "category": "Hero"
    }
  ]
}
{% endschema %}
