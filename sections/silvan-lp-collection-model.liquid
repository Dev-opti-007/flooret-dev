      const selectedVariant = variantData.find(variant => {
        return selectedOptions.every((optionValue, index) => variant.options[index] === optionValue);
      });

      if (!selectedVariant) return;

      // Your existing updates...
      if (variantIdInput) variantIdInput.value = selectedVariant.id;
      
      if (priceContainer) {
        const price = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(selectedVariant.price / 100);
        let priceHtml = `<span class="actual-price">${price}</span>`;
        
        if (selectedVariant.compare_at_price > selectedVariant.price) {
          const compareAtPrice = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(selectedVariant.compare_at_price / 100);
          const savings = Math.round((selectedVariant.compare_at_price - selectedVariant.price) * 100 / selectedVariant.compare_at_price);
          priceHtml += `<del class="compare-at-price">${compareAtPrice}</del>`;
          priceHtml += `<span class="off_text">${savings}% OFF</span>`;
        }
        
        priceContainer.innerHTML = priceHtml;
      }

      if (addToCartButton) {
        if (selectedVariant.available) {
          addToCartButton.disabled = false;
          addToCartButton.textContent = card.dataset.handle === 'your-special-product-handle' ? 'Add Sample Kit' : 'Add Sample';
        } else {
          addToCartButton.disabled = true;
          addToCartButton.textContent = 'Sold Out';
        }
      }
    };

    // 🔥 UPDATED: Model-driven availability
    const updateModelDrivenAvailability = () => {
      // Reset highlighting
      card.querySelectorAll('.product-card-option__swatch').forEach(swatch => {
        swatch.classList.remove('available', 'unavailable', 'auto-selected');
      });

      // Get current Model selection
      const modelRadios = card.querySelectorAll('input[name$="-Model"]');
      const selectedModelRadio = Array.from(modelRadios).find(radio => radio.checked);
      const selectedModel = selectedModelRadio ? selectedModelRadio.value : null;

      if (!selectedModel) {
        // No model selected → all disabled
        card.querySelectorAll('.product-card-option__swatch:not([name*="-Model"])').forEach(swatch => {
          swatch.classList.add('unavailable');
        });
        return;
      }

      // 🔥 SPECIAL LOGIC: Base/Craftsman/Herringbone → Force Micro
      const limitedModels = ['Base', 'Craftsman', 'Herringbone'];
      const bevelRadios = card.querySelectorAll('input[name$="-Bevel"]');
      const microRadio = Array.from(bevelRadios).find(radio => radio.value === 'Micro');

      if (limitedModels.includes(selectedModel) && microRadio) {
        // Auto-select Micro for limited models
        microRadio.checked = true;
        microRadio.closest('.product-card-option__swatch').classList.add('auto-selected');
        microRadio.dispatchEvent(new Event('change'));
      }

      // Highlight ALL Model options as available (Model never restricted)
      modelRadios.forEach(radio => {
        radio.closest('.product-card-option__swatch').classList.add('available');
      });

      // Highlight Bevel/Type based on selected Model
      const otherGroups = ['Bevel', 'Type'];
      otherGroups.forEach(groupName => {
        const groupRadios = card.querySelectorAll(`input[name$="-${groupName}"]`);
        groupRadios.forEach(radio => {
          // Test if this option works with current Model
          const testSelections = [selectedModel]; // Model fixed
          const groupIndex = groupName === 'Bevel' ? 1 : 2;
          
          // Fill other selections
          const otherRadios = card.querySelectorAll(`input[name$="-${groupName === 'Bevel' ? 'Type' : 'Bevel'}"]:checked`);
          otherRadios.forEach(otherRadio => {
            testSelections[groupIndex === 1 ? 2 : 1] = otherRadio.value;
          });
          testSelections[groupIndex] = radio.value;

          const testVariant = variantData.find(variant => {
            return testSelections.every((optionValue, index) => variant.options[index] === optionValue);
          });

          const swatch = radio.closest('.product-card-option__swatch');
          if (testVariant) {
            swatch.classList.add('available');
          } else {
            swatch.classList.add('unavailable');
          }
        });
      });
    };

    // 🔥 Only Model changes trigger availability update
    const modelRadios = card.querySelectorAll('input[name$="-Model"]');
    modelRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        updateModelDrivenAvailability();
        updateCard(); // Also update price
      });
    });

    // Other groups only update price (no availability change)
    const otherRadios = card.querySelectorAll('input[type="radio"]:not([name$="-Model"])');
    otherRadios.forEach(radio => {
      radio.addEventListener('change', updateCard);
    });

    // 🔥 Initial setup
    updateModelDrivenAvailability();
    updateCard();
  });
