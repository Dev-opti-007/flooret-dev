<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const openBtn = document.getElementById(`open-collection-modal-${sectionId}`);
    const modal = document.getElementById(`collection-products-modal-${sectionId}`);
    if (!openBtn || !modal) return;
    
    const closeModalBtn = modal.querySelector('.collection-products-modal__close');
    let isInitialized = false;

    // --- Pre-load all necessary data for interactivity ---
    const allProductsData = {
      {% for product in collection.products %}
        "{{ product.handle }}": {
          "id": {{ product.id }}, // Add product ID here
          "variants": {{ product.variants | json }},
          "media": {{ product.media | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };
    const allMetaObjectPrices = {
      {% for product in collection.products %}
        "{{ product.handle }}": {
          {%- assign model_option = product.options_with_values | where: "name", "Model" | first -%}
          {% if model_option %}
            {% for value in model_option.values %}
              {%- liquid
                assign value_handle = value | handleize
                assign meta_price = shop.metaobjects.product_model[value_handle].cost_per_sqft.value | default: null
              -%}
              "{{ value | escape }}": {{ meta_price | json }}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          {% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };

    openBtn.addEventListener('click', function() {
      modal.style.display = 'flex';
      document.documentElement.classList.add('collection-modal-is-open');
      if (!isInitialized) {
        initializeAllCards();
        isInitialized = true;
      }
    });

    function initializeAllCards() {
      // Initialize sliders for each card
      $(modal).find('.product-card__images').each(function() {
        if ($(this).find('img').length > 1) {
            $(this).slick({ infinite: false, arrows: true, dots: true, slidesToShow: 1, slidesToScroll: 1 });
        }
      });
      
      // Setup variant selection and forms for each card
      modal.querySelectorAll('.modal-product-wrapper').forEach(cardWrapper => {
        const handle = cardWrapper.dataset.handle;
        if (handle && allProductsData[handle]) {
          setupVariantSelectionForCard(cardWrapper, allProductsData[handle], allMetaObjectPrices[handle] || {});
          setupAddToCartForm(cardWrapper);
        }
      });
    }
    
    function setupVariantSelectionForCard(card, productData, metaObjectPrices) {
      card.querySelectorAll('input[type="radio"]').forEach(radio => {
        radio.addEventListener('change', () => updateCardState(card, productData, metaObjectPrices));
      });
      const firstRadio = card.querySelector('input[type="radio"]');
      if (firstRadio) {
        firstRadio.checked = true;
        firstRadio.dispatchEvent(new Event('change'));
      }
    }

    function updateCardState(card, productData, metaObjectPrices) {
      const selectedOptions = Array.from(card.querySelectorAll('input[type="radio"]:checked')).map(radio => radio.value);
      const selectedVariant = productData.variants.find(variant => variant.options.every((option, index) => option === selectedOptions[index]));

      const priceEl = card.querySelector('.product-card__price');
      const variantIdInput = card.querySelector('input[name="id"]');
      const addToCartBtn = card.querySelector('.add-to-cart-btn');

      if (selectedVariant) {
        variantIdInput.value = selectedVariant.id;
        
        let priceInCents;
        const isBoxVariant = selectedOptions.some(option => option.toLowerCase() === 'box');
        const modelOptionValue = selectedVariant.option1;
        const specialModels = ["7\"", "Craftsman", "Signature", "Herringbone", "Arista", "Base", "Base Glue Down", "Signature Glue Down"];

        if (isBoxVariant && specialModels.includes(modelOptionValue)) {
          priceInCents = (metaObjectPrices && metaObjectPrices[modelOptionValue] !== null) ? metaObjectPrices[modelOptionValue] : selectedVariant.price;
        } else {
          priceInCents = selectedVariant.price;
        }

        if(priceEl) {
          priceEl.innerHTML = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(priceInCents / 100);
        }

        // ===================================================================
        // NEW: Updated button text logic
        // ===================================================================
        if(addToCartBtn){
          addToCartBtn.disabled = !selectedVariant.available;
          if (selectedVariant.available) {
            // Check if the product ID is the special one
            if (productData.id === 8964836262163) {
              addToCartBtn.textContent = 'Add Sample Kit';
            } else {
              addToCartBtn.textContent = 'Add Sample';
            }
          } else {
            addToCartBtn.textContent = 'Sold Out';
          }
        }

        if (selectedVariant.featured_media && selectedVariant.featured_media.id) {
          const targetMediaId = selectedVariant.featured_media.id;
          const imageContainer = card.querySelector('.product-card__images');
          const targetSlide = imageContainer ? imageContainer.querySelector(`[data-media-id="${targetMediaId}"]`)?.parentElement : null;
          if (targetSlide && $(imageContainer).hasClass('slick-initialized')) {
            const slideIndex = $(targetSlide).data('slick-index');
            if (slideIndex !== undefined) {
              $(imageContainer).slick('slickGoTo', slideIndex);
            }
          }
        }
      } else {
        if(addToCartBtn) {
          addToCartBtn.disabled = true;
          addToCartBtn.textContent = 'Unavailable';
        }
      }
    }
    
    {% comment %} function setupAddToCartForm(card) {
      const form = card.querySelector('form[action$="/cart/add"]');
      if (!form) return;

      form.addEventListener('submit', function(event) {
        event.preventDefault();
        const addToCartBtn = form.querySelector('.add-to-cart-btn');
        let originalText = addToCartBtn.textContent;
        
        addToCartBtn.disabled = true;
        addToCartBtn.classList.add('is-adding');
        addToCartBtn.textContent = 'Adding...';

        fetch('/cart/add.js', { method: 'POST', body: new FormData(form) })
        .then(response => response.json())
        .then(data => {
          addToCartBtn.classList.remove('is-adding');
          if (data.status) {
             addToCartBtn.textContent = data.description || 'Error';
             // Revert back to original text on error after a delay
             setTimeout(() => {
                addToCartBtn.disabled = false;
                addToCartBtn.textContent = originalText;
             }, 2000);
          } else {
            addToCartBtn.classList.add('is-added');
            addToCartBtn.textContent = 'Added ✓';
            document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true }));
            // Revert back to original text after success
            setTimeout(() => {
              addToCartBtn.classList.remove('is-added');
              addToCartBtn.disabled = false;
              // Check what the text should be now, in case the variant became unavailable
              const productHandle = card.dataset.handle;
              const productData = allProductsData[productHandle];
              const selectedVariant = productData.variants.find(v => v.id == form.querySelector('input[name="id"]').value);
              if (selectedVariant && selectedVariant.available) {
                  originalText = productData.id === 8964836262163 ? 'Add Sample Kit' : 'Add Sample';
              } else {
                  originalText = 'Sold Out';
              }
              addToCartBtn.textContent = originalText;
            }, 2000);
          }
        });
      });
    } {% endcomment %}

    function closeAndResetModal() {
      $(modal).find('.slick-initialized').slick('unslick');
      modal.style.display = 'none';
      document.documentElement.classList.remove('collection-modal-is-open');
    }

    closeModalBtn.addEventListener('click', closeAndResetModal);
    
    window.addEventListener('click', (event) => {
        if (event.target == modal) {
            closeAndResetModal();
        }
    });
  });
</script>

