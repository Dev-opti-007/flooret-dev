<style>
  .model-collection {
    background:#DDE9D8;
  }
</style>

{%- assign collection = collections[section.settings.featured_collection] -%}
<div class="model-collection model-collection-{{ section.id }}">
<div class="page-width">
  <div class="collection-modal-section__container">
    <div class="heading-wrap"> 
      <h2>{{ section.settings.heading }}</h2>
      <div class="pointers">
        {{ section.settings.pointers }}
      </div>
    </div>
    
    {% if collection != blank %}
        {% if template.suffix == '10-year-anniversary' %}
    
        <a  href="/collections/all-floors" class="j-a-btn button button--primary">
               {{ section.settings.button_text | escape }}
        </a>
        {% else %} 
        <button id="open-collection-modal-{{ section.id }}" type="button" class="button button--primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" fill="none"> <path d="M6.53516 0.131409C6.83594 0.0220337 7.16406 0.0220337 7.4375 0.131409L13.125 2.26422C13.6445 2.45563 13.9727 2.94781 13.9727 3.49469V9.64703C13.9727 10.1392 13.6992 10.6041 13.2617 10.8228L7.57422 13.6666C7.19141 13.858 6.78125 13.858 6.39844 13.6666L0.710938 10.8228C0.273438 10.6041 0 10.1392 0 9.64703V3.49469C0 2.94781 0.328125 2.45563 0.847656 2.26422L6.53516 0.131409ZM7 1.82672L1.75 3.79547V3.82281L7 5.95563L12.25 3.82281V3.79547L7 1.82672ZM7.875 11.5611L12.25 9.3736V5.70953L7.875 7.48688V11.5611Z" fill="white"/> </svg> 
          {{ section.settings.button_text | escape }}
        </button>
        {% endif %}
    {% endif %}
    {% if template.suffix == 'flooret-x-agar-family' %}
      {% comment %} <a class="btn" href="https://www.flooret.com/pages/get-started" >
          Worry-Free Installation
       </a> {% endcomment %}
    {% endif %}
    
  </div>
</div>
</div>
<div id="collection-products-modal-{{ section.id }}" class="collection-products-modal" style="display: none;">
  <div class="collection-products-modal__content">
    <div class="collection-products-modal__header">
      <div>
        <h2>{{ section.settings.model-title }}</h2>
        <div>{{ section.settings.model-subtext }}</div>
        {% if section.settings.additional-text != blank or section.settings.additional-btn-text != blank  %}
        <div class="additional-text-wrap">
          {% if section.settings.additional-text != blank %}
          <div class="additional-text">
            {{ section.settings.additional-text }}
          </div>
          {% endif %}
          {% if section.settings.additional-btn-text != blank %}
          <a class='button buttom-sm' target="_blank" href="{{ section.settings.additional-btn-link }}">{{ section.settings.additional-btn-text }}</a>
          {% endif %}
        </div>
        {% endif %}
      </div>
      <button class="collection-products-modal__close">&times;</button>
    </div>
    <div class="collection-products-grid">
      {%- for product in collection.products -%}
        {%# We render the card-product snippet for each product in the collection. %}
        {%# The outer div helps our JavaScript find and manage each card individually. %}
        <div class="modal-product-wrapper" data-handle="{{ product.handle }}">
          {% if template.suffix == 'silvan-landing-page' or template.suffix == 'flooret-x-rene-ceretto' or template.suffix == 'provence-landing-page' %}
          {% render 'product-card-silvan', product: product %}
          {% endif %}


          {% if template.suffix == 'modin-landing-page' or template.suffix == 'flooret-x-agar-family' or  template.suffix == 'flooret-x-ally-kusznikow' %}
            {% render 'product-card-modin', product: product %}
          {% else %}
               {% render 'product-card-modin', product: product %}
          {% endif %}

          {% if template.suffix == 'farah-merhi' or template.suffix == '10-year-anniversary' %}
            {% if product.tags contains 'Cat--Modin LVP' %}
              {% render 'product-card-modin', product: product %}
            {% else %}
              {% render 'product-card-silvan', product: product %}
            {% endif %}
          {% endif %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  {% if section.settings.section-bg != blank %}
  .model-collection-{{ section.id }} {
    background:{{ section.settings.section-bg }};
  }
  {% endif %}
  .model-collection-{{ section.id }} .collection-modal-section__container .heading-wrap h2 {
    font-family:{{ section.settings.font-heading }};
    font-size:{{ section.settings.font_size_heading_desk }}px;
    {% if section.settings.heading-color != blank %} color:{{ section.settings.heading-color }}; {% endif %}
  }
  .model-collection-{{ section.id }} .collection-modal-section__container .heading-wrap .pointers p {
    font-family:{{ section.settings.font-body }};
    font-size:{{ section.settings.font_size_body_desk }}px;
    {% if section.settings.body-color != blank %} color:{{ section.settings.body-color }}; {% endif %}
  }
  .model-collection-{{ section.id }} .collection-modal-section__container > button {
    font-family:{{ section.settings.font-button }};
    font-size:{{ section.settings.font_size_button_desk }}px;
    {% if section.settings.button-bg-color != blank %} background:{{ section.settings.button-bg-color }}; {% endif %}
    {% if section.settings.button-font-color != blank %} color:{{ section.settings.button-font-color }}; {% endif %}
  }

  @media (max-width:768px){
    .model-collection-{{ section.id }} .collection-modal-section__container .heading-wrap h2 {
      font-size:{{ section.settings.font_size_heading_mob }}px;
    }
    .model-collection-{{ section.id }} .collection-modal-section__container .heading-wrap .pointers p {
      font-size:{{ section.settings.font_size_body_mob }}px;
    }
    .model-collection-{{ section.id }} .collection-modal-section__container > button {
      font-size:{{ section.settings.font_size_button_mob }}px;
    }
  }



</style>

{% schema %}
{
  "name": "Collection Modal",
  "class": "collection-modal-section",
  "settings": [
    {
      "type": "html",
      "id":"heading",
      "label": "Heading"
    },
    {
      "type":"richtext",
      "id": "pointers",
      "label": "Pointer",
      "info": "Use list style"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Select Collection"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop The Collection"
    },
    {
      "type": "header",
      "content": "Model Details"
    },
    {
      "type": "text",
      "id": "model-title",
      "label": "Model Title"
    },
    {
      "type":"richtext",
      "id": "model-subtext",
      "label": "Model Subtext"
    },
    {
      "type": "richtext",
      "id": "additional-text",
      "label":"Additional Text"
    },
    {
      "type": "text",
      "id": "additional-btn-text",
      "label": "Additional Button Text"
    },
    {
      "type": "url",
      "id": "additional-btn-link",
      "label": "Additional Button URL"
    },
    {
      "type": "header",
      "content": "Font family"
    },
    {
      "type": "select",
      "id": "font-heading",
      "label": "Font Family Heading",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        }
      ],
      "default": "Montserrat"
    },
    {
      "type": "select",
      "id": "font-body",
      "label": "Font Family Subtext",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        }
      ],
      "default": "Montserrat"
    },
    {
      "type": "select",
      "id": "font-button",
      "label": "Font Family Button",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        }
      ],
      "default": "Montserrat"
    },
    {
      "type": "header",
      "content": "Font Sizes Desktop"
    },
    {
      "type": "range",
      "id": "font_size_heading_desk",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Font size Heading Desktop",
      "default": 18
    },
    {
      "type": "range",
      "id": "font_size_body_desk",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Body Desktop",
      "default": 13
    },
    {
      "type": "range",
      "id": "font_size_button_desk",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Button Desktop",
      "default": 14
    },
    {
      "type": "header",
      "content": "Font Sizes Mobile"
    },
    {
      "type": "range",
      "id": "font_size_heading_mob",
      "min": 1,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Heading Mobile",
      "default": 15
    },
    {
      "type": "range",
      "id": "font_size_body_mob",
      "min": 1,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Body Mobile",
      "default": 10
    },
    {
      "type": "range",
      "id": "font_size_button_mob",
      "min": 1,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size Button Mobile",
      "default": 10
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section-bg",
      "label": "Section Color"
    },
    {
      "type": "color",
      "id":"heading-color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id":"body-color",
