{%- liquid
  assign text_color = section.settings.text_color
  assign bg_color = section.settings.bg_color
  assign heading_color = section.settings.heading_color
  assign accent_color = section.settings.accent_color
-%}

<style>
  .story-grid-guide-{{ section.id }} {
    --sgg-bg-color: {{ bg_color | default: '#ffffff' }};
    --sgg-text-color: {{ text_color | default: '#2c2c2c' }};
    --sgg-heading-color: {{ heading_color | default: '#000000' }};
    --sgg-accent-color: {{ accent_color | default: '#606060' }};
    --sgg-padding-top: {{ section.settings.padding_top }}px;
    --sgg-padding-bottom: {{ section.settings.padding_bottom }}px;
    --sgg-max-width: {{ section.settings.max_width }}px;
    --sgg-row-gap: {{ section.settings.row_gap }}px;
    --sgg-image-radius: {{ section.settings.image_border_radius }}px;

    background-color: var(--sgg-bg-color);
    padding-top: var(--sgg-padding-top);
    padding-bottom: var(--sgg-padding-bottom);
    color: var(--sgg-text-color);
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__container {
    max-width: var(--sgg-max-width);
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
   @media (min-width: 1300px) {
    .story-grid-guide__container {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__header {
    margin-bottom: calc(var(--sgg-row-gap) * 0.5);
    text-align: {{ section.settings.heading_alignment }};
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__title {
    font-family: 'Montserrat', sans-serif;
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: var(--sgg-heading-color);
    margin: 0;
    line-height: 45px;
    letter-spacing: -0.45px;
    vertical-align: middle;
    max-width: 450px; /* Forces title to wrap elegantly as in mockup */
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__rows {
    display: flex;
    flex-direction: column;
    gap: var(--sgg-row-gap);
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 90px; /* Spacious column gap */
    align-items: center;
  }

  /* Image Column Styling */
  .story-grid-guide-{{ section.id }} .story-grid-guide__image-col {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--sgg-image-radius);
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper {
    position: relative;
    width: 100%;
    display: block;
  }

  /* Handle aspect ratio */
  .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--natural {
    height: auto;
  }
  .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--square {
    aspect-ratio: 1 / 1;
  }
  .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--portrait {
    aspect-ratio: 4 / 5;
  }
  .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--landscape {
    aspect-ratio: 16 / 9;
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Content Column Styling */
  .story-grid-guide-{{ section.id }} .story-grid-guide__content-col {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 480px; /* Premium line-length constraint matching the screenshot */
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__step-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--sgg-accent-color);
    margin-bottom: 25px;
    line-height: 18px;
    display: block;
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__step-number {
    font-family: 'Playfair', serif;
    font-size: 200px;
    font-weight: 600; /* SemiBold weight */
    line-height: 50.4px;
    color: {{ section.settings.number_color | default: '#E9E4E4' }};
    letter-spacing: 0;
    vertical-align: middle;
    margin: 25px 0 40px 0;
    display: block;
    user-select: none;
    pointer-events: none;
  }
  .story-grid-guide-template--27128694341907__sample_kit_guide_mmjEkr 
  .story-grid-guide__row:nth-child(3) 
  .story-grid-guide__step-number {
      margin: 25px 0 60px 0;
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__step-heading {
    font-family: 'Montserrat', sans-serif;
    font-size: {{ section.settings.step_heading_size_desktop }}px;
    font-weight: 500;
    color: var(--sgg-heading-color);
    margin: 0 0 25px 0;
    line-height: 36px;
    letter-spacing: 0.4px;
    vertical-align: middle;
    max-width: 440px; /* Wrap precisely like screenshot1 */
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__description {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: -0.31px;
    color: var(--sgg-text-color);
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__description p {
    margin-top: 0;
    margin-bottom: 24px; /* Spacious gap between paragraphs */
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__description p:last-child {
    margin-bottom: 0;
  }

  /* Optional Secondary Description */
  .story-grid-guide-{{ section.id }} .story-grid-guide__secondary-description {
    font-family: 'Montserrat', sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: -0.31px;
    color: var(--sgg-text-color);
    margin-top: 24px;
  }

  .story-grid-guide-{{ section.id }} .story-grid-guide__secondary-description p {
    margin-top: 0;
    margin-bottom: 0;
  }

  @media (min-width: 769px) {
    .story-grid-guide-{{ section.id }} .story-grid-guide__row {
      grid-template-columns: 555px 1fr;
    }
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-col {
      width: 555px;
      height: 577px;
    }
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper {
      width: 555px;
      height: 577px;
    }
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--square,
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--portrait,
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--landscape,
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--natural {
      aspect-ratio: auto;
      width: 555px;
      height: 577px;
    }
  }

  /* Alternating Zig Zag layout logic on desktop */
  {% if section.settings.alternate_rows %}
    @media (min-width: 769px) {
      .story-grid-guide-{{ section.id }} .story-grid-guide__row:nth-child(even) {
        grid-template-columns: 1fr 555px;
      }
      .story-grid-guide-{{ section.id }} .story-grid-guide__row:nth-child(even) .story-grid-guide__image-col {
        order: 2;
      }
      .story-grid-guide-{{ section.id }} .story-grid-guide__row:nth-child(even) .story-grid-guide__content-col {
        order: 1;
        padding-left: 0;
        padding-right: 90px;
      }
    }
  {% endif %}

  /* Responsive / Mobile styles */
  @media (max-width: 768px) {
    .story-grid-guide-{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mobile | default: 60 }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile | default: 60 }}px;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__header {
      margin-bottom: 20px;
      padding-right: 5px;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__title {
      font-size: {{ section.settings.heading_size_mobile }}px;
      line-height: 30px;
      letter-spacing: -0.45px;
      max-width: 100%;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__rows {
      gap: 80px; /* Space between steps on mobile */
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__row {
      grid-template-columns: 1fr;
      gap: 32px; /* Gap between image and content stacked on mobile */
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__image-col {
      max-width: 344px;
      width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper {
      width: 344px;
      height: 357px;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--square,
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--portrait,
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--landscape,
    .story-grid-guide-{{ section.id }} .story-grid-guide__image-wrapper--natural {
      aspect-ratio: auto;
      width: 344px;
      height: 357px;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__content-col {
      max-width: 100%;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__step-label {
      font-size: 12px;
      line-height: 18px;
      letter-spacing: 0.6px;
      margin-bottom: 0.37px;
      display: block;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__step-number {
      font-size: 125px;
      line-height: 50.4px;
      margin: 5px 0 25px 0;
      display: block;
    }
      .story-grid-guide-template--27128694341907__sample_kit_guide_mmjEkr 
      .story-grid-guide__row:nth-child(3) 
      .story-grid-guide__step-number {
          margin: 5px 0 35px 0;
      }

    .story-grid-guide-{{ section.id }} .story-grid-guide__step-heading {
      font-size: {{ section.settings.step_heading_size_mobile }}px;
      line-height: 26px;
      letter-spacing: 0.37px;
      margin: 0 0 16px 0;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__description {
      font-size: 14px;
      font-weight: 400;
      line-height: 21.6px;
      letter-spacing: 0;
    }

    .story-grid-guide-{{ section.id }} .story-grid-guide__secondary-description {
      font-size: 14px;
      font-weight: 400;
      line-height: 21.6px;
      letter-spacing: 0;
      margin-top: 21.6px;
    }

    /* Stacking direction on mobile */
    {% if section.settings.mobile_image_position == 'above' %}
      .story-grid-guide-{{ section.id }} .story-grid-guide__row .story-grid-guide__image-col {
        order: 1;
      }
      .story-grid-guide-{{ section.id }} .story-grid-guide__row .story-grid-guide__content-col {
        order: 2;
      }
    {% else %}
      .story-grid-guide-{{ section.id }} .story-grid-guide__row .story-grid-guide__image-col {
        order: 2;
      }
      .story-grid-guide-{{ section.id }} .story-grid-guide__row .story-grid-guide__content-col {
        order: 1;
      }
    {% endif %}
  }
</style>

<div class="story-grid-guide-{{ section.id }} story-grid-guide">
  <div class="story-grid-guide__container">
    {% if section.settings.heading != blank %}
      <div class="story-grid-guide__header">
        <h2 class="story-grid-guide__title">{{ section.settings.heading | escape }}</h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="story-grid-guide__rows">
        {% for block in section.blocks %}
          <div class="story-grid-guide__row" {{ block.shopify_attributes }}>
            
            <!-- Image Column -->
            <div class="story-grid-guide__image-col">
              <div class="story-grid-guide__image-wrapper story-grid-guide__image-wrapper--{{ section.settings.image_aspect_ratio }}">
                {% if block.settings.image != blank %}
                  {%- assign img_alt = block.settings.image.alt | default: block.settings.heading | default: 'Sample kit guide step image' -%}
                  <img 
                    srcset="{%- if block.settings.image.width >= 375 -%}{{ block.settings.image | image_url: width: 375 }} 375w,{%- endif -%}
                      {%- if block.settings.image.width >= 550 -%}{{ block.settings.image | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if block.settings.image.width >= 750 -%}{{ block.settings.image | image_url: width: 750 }} 750w,{%- endif -%}
                      {%- if block.settings.image.width >= 1100 -%}{{ block.settings.image | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {{ block.settings.image | image_url }} {{ block.settings.image.width }}w"
                    src="{{ block.settings.image | image_url: width: 750 }}"
                    sizes="(min-width: 769px) 50vw, 100vw"
                    alt="{{ img_alt | escape }}"
                    loading="lazy"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    class="story-grid-guide__image"
                  >
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg story-grid-guide__image' }}
                {% endif %}
              </div>
            </div>

            <!-- Content Column -->
            <div class="story-grid-guide__content-col">
              {% if block.settings.step_label != blank %}
                <span class="story-grid-guide__step-label">{{ block.settings.step_label | escape }}</span>
              {% endif %}

              {%- assign current_step_number = block.settings.step_number | default: forloop.index -%}
              {%- if current_step_number != blank -%}
                {%- comment -%}Ensure single digit numbers are padded with a leading zero to match the editorial style "01", "02", "03"{%- endcomment -%}
                {%- assign number_size = current_step_number | size -%}
                {%- if number_size == 1 -%}
                  {%- assign display_number = '0' | append: current_step_number -%}
                {%- else -%}
                  {%- assign display_number = current_step_number -%}
                {%- endif -%}
                <span class="story-grid-guide__step-number" aria-hidden="true">{{ display_number | escape }}</span>
              {%- endif -%}

              {% if block.settings.heading != blank %}
                <h3 class="story-grid-guide__step-heading">{{ block.settings.heading | escape }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="story-grid-guide__description rte">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.secondary_description != blank %}
                <div class="story-grid-guide__secondary-description rte">
                  {{ block.settings.secondary_description }}
                </div>
              {% endif %}
            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

