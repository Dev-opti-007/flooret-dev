{% assign settings = section.settings %}

<section class="testimonials-block">
  <div class="container">
  {% if settings.heading != blank %}
    <h2 class="h5">{{ settings.heading }}</h2>
  {% endif  %}
	<div class="testimonials-slider swiper">
		<div class="swiper-wrapper">
			{% for block in section.blocks %}	
				<div class="testimonial swiper-slide">
					<div class="testimonial__wrap">
            <span class="h2">{{ block.settings.content }}</span>
            <span class="h6">{{ block.settings.name }}</span>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
  <div class="testimonial-nav">
    <div class="swiper-scrollbar"></div>
    <div class="swiper-button-prev swiper-btn">{% include 'svg-chevron' %}</div>
    <div class="swiper-button-next swiper-btn">{% include 'svg-chevron' %}</div>
  </div>
</div>
</section>


{% schema %}
{
  "name": "Testimonial Slider",
  "class": "shopify-block",
  "settings": [
   
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
       {
      "type": "text",
      "id": "link_text",
      "label": "Link Text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }

  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name & Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonial Slider",
      "blocks": [
      ]
    }
  ]
}
{% endschema %}
