{% include 'section-two-column', _settings : section.settings, _timeline : section.blocks %}


{% schema %}
{
  "name": "Two Column Timeline",
  "class": "shopify-block two-column two-column--timeline bg-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#343334"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "row_reverse",
      "label": "Row Reverse",
      "default": false
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "contain_image",
      "label": "Contain Image",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub-heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }

  ],
  "blocks": [
     {
       "name": "Timeline",
       "type": "slide",
       "settings": [
         {
           "type": "text",
           "id": "timeline_label",
           "label": "Label"
         },
         {
           "type": "textarea",
           "id": "timeline_content",
           "label": "Content"
         }
       ]
     }
  ],
  "presets": [
    {
      "name": "Two Column Timeline",
      "category": "Content / Image"
    }
  ]
}
{% endschema %}
