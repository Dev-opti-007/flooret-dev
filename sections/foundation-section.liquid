      // Infinite loop settings
      loopAdditionalSlides: 2, // Increased for better loop performance
      loopFillGroupWithBlank: false,
      
      on: {
        init: function() {
          const swiper = this;
          // Allow DOM to settle before enabling custom animations
          setTimeout(() => {
            isInitialized = true;
            swiper.update();
            swiper.slideTo(swiper.activeIndex, 0); // Reset without animation
          }, 300);
        },
        
        progress: function(swiper) {
          // Skip custom animations until fully initialized
          if (!isInitialized) return;
          
          const slideCount = swiper.slides.length;
          
          for (let i = 0; i < swiper.slides.length; i += 1) {
            const slide = swiper.slides[i];
            const slideProgress = swiper.slides[i].progress;
            const absProgress = Math.abs(slideProgress);
            
            let modifier = 1;
            if (absProgress > 1) {
              modifier = 0.3 * (absProgress - 1) + 1;
            }
            
            const itemContent = slide.querySelectorAll(".item-content");
            const translateX = slideProgress * modifier * 50 + "%";
            const scale = Math.max(0.8, 1 - 0.2 * absProgress); // Prevent scaling too small
            const zIndex = slideCount - Math.abs(Math.round(slideProgress));
            
            // Apply transforms with error checking
            if (slide && slide.style) {
              slide.style.transform = `translateX(${translateX}) scale(${scale})`;
              slide.style.zIndex = zIndex.toString();
              slide.style.opacity = (absProgress > 3 ? 0 : 1).toString();
            }
            
            itemContent.forEach(function(content) {
              if (content && content.style) {
                content.style.opacity = Math.max(0, 1 - absProgress / 3).toString();
              }
            });
          }
        },
        
        setTransition: function(swiper, duration) {
          // Skip transitions until fully initialized
          if (!isInitialized) return;
          
          for (let i = 0; i < swiper.slides.length; i += 1) {
            const slide = swiper.slides[i];
            const itemContent = slide.querySelectorAll(".item-content");
            
            if (slide && slide.style) {
              slide.style.transitionDuration = `${duration}ms`;
            }
            
            itemContent.forEach(function(content) {
              if (content && content.style) {
                content.style.transitionDuration = `${duration}ms`;
              }
            });
          }
        },
        
        // Additional event to ensure smooth operation
        transitionEnd: function() {
          this.update();
        }
      }
    });
  });
</script> {% endcomment %}

<script>
document.addEventListener('DOMContentLoaded', function () {
  const carouselSlider = new Swiper(".carousel-slider", {
    grabCursor: true,
    loop: true,
    slidesPerView: "auto",
    centeredSlides: true,
    spaceBetween: 30,
    speed: 800,
    
    // Navigation
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    
    // Pagination
    pagination: {
      el: '.swiper-pagination',
      clickable: true,
    },
    
    // Simplified breakpoints for responsive behavior
    breakpoints: {
      320: {
        slidesPerView: 1,
        spaceBetween: 20
      },
      768: {
        slidesPerView: "auto",
        spaceBetween: 30
      }
    }
  });
});
</script>


{% schema %}
{
  "name": "Centered Swiper Carousel",
  "tag": "section",
  "class": "centered-swiper-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Foundation for Every Moment"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subtext",
      "default": "<p>From quiet mornings to incredible achievements, every moment begins on the floor beneath us.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SHOP NAKAN SIGNATURE"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL",
      "default": "/collections/all"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "image_slide",
      "name": "Image Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Centered Swiper Carousel"
    }
  ]
}
{% endschema %}
