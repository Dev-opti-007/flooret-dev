{{ 'custom-richtext.css' | asset_url | stylesheet_tag }}

<section
  id="installation-cta-{{ section.id }}"
  class="installation-cta"
  style="background-color: {{ section.settings.background_color }}; color: {{ section.settings.text_color }};"
>
  <div class="installation-cta__wrapper">
    {% if section.settings.heading != blank %}
      <h2 class="installation-cta__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="installation-cta__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="installation-cta__buttons">
      {% if section.settings.primary_button_label != blank and section.settings.primary_button_url != blank %}
        <a href="{{ section.settings.primary_button_url }}" class="rich-button rich-primary-button">
          {{- section.settings.primary_button_label -}}
        </a>
      {% endif %}

      {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_url != blank %}
        <a
          href="{{ section.settings.secondary_button_url }}"
          class="rich-button rich-secondary-button"
        >
          {{- section.settings.secondary_button_label -}}
        </a>
      {% endif %}
    </div>

    {% if section.settings.link_text != blank and section.settings.link_url != blank %}
      <div class="installation-cta__link">
        <a href="{{ section.settings.link_url }}">{{ section.settings.link_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

<style>
  @media screen and (max-width: 749px) {
    #installation-cta-{{ section.id }} .installation-cta__wrapper {
      padding: 0 10px;
    }

    #installation-cta-{{ section.id }} .installation-cta__heading {
      font-size: 1.75rem;
    }

    #installation-cta-{{ section.id }} .installation-cta__subheading {
      font-size: 1rem;
    }

    #installation-cta-{{ section.id }} .installation-cta__btn {
      display: block;
      width: 100%;
      margin-bottom: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Rich Text Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Install Your Dream Floors?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Experience the simplicity of our integrated installation service with the confidence of a full warranty."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary Button Text",
      "default": "Get Started"
    },
    {
      "type": "url",
      "id": "primary_button_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary Button Text",
      "default": "Explore Floors First"
    },
    {
      "type": "url",
      "id": "secondary_button_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Additional Link Text",
      "default": "Installation Service Terms & Conditions"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Additional Link URL"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1b303d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Custom Rich Text Section",
      "category": "Custom sections"
    }
  ]
}
{% endschema %}
