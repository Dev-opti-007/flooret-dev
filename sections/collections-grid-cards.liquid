{% comment %}
  Collections Grid Cards
  - Block based cards
  - Image background cards with overlay
  - Title, subtitle, 2 buttons
{% endcomment %}

<section
  id="CollectionsGrid-{{ section.id }}"
  class="cgc"
  style="
    --cgc-bg: {{ section.settings.section_bg_color }};
    --cgc-max: {{ section.settings.section_max_width }}px;

    --cgc-pt: {{ section.settings.padding_top_desktop }}px;
    --cgc-pr: {{ section.settings.padding_right_desktop }}px;
    --cgc-pb: {{ section.settings.padding_bottom_desktop }}px;
    --cgc-pl: {{ section.settings.padding_left_desktop }}px;

    --cgc-pt-m: {{ section.settings.padding_top_mobile }}px;
    --cgc-pr-m: {{ section.settings.padding_right_mobile }}px;
    --cgc-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --cgc-pl-m: {{ section.settings.padding_left_mobile }}px;

    --cgc-gap: {{ section.settings.grid_gap_desktop }}px;
    --cgc-gap-m: {{ section.settings.grid_gap_mobile }}px;

    --cgc-cols: {{ section.settings.columns_desktop }};
    --cgc-cols-m: {{ section.settings.columns_mobile }};

    --cgc-card-radius: {{ section.settings.card_radius }}px;
    --cgc-card-h: {{ section.settings.card_height_desktop }}px;
    --cgc-card-h-m: {{ section.settings.card_height_mobile }}px;

    --cgc-content-px: {{ section.settings.content_padding_x_desktop }}px;
    --cgc-content-py: {{ section.settings.content_padding_y_desktop }}px;
    --cgc-content-px-m: {{ section.settings.content_padding_x_mobile }}px;
    --cgc-content-py-m: {{ section.settings.content_padding_y_mobile }}px;

    --cgc-title-c: {{ section.settings.title_color }};
    --cgc-title-s: {{ section.settings.title_size_desktop }}px;
    --cgc-title-s-m: {{ section.settings.title_size_mobile }}px;
    --cgc-title-w: {{ section.settings.title_weight }};
    --cgc-title-lh: {{ section.settings.title_line_height }};
    --cgc-title-ls: {{ section.settings.title_letter_spacing }}px;
    --cgc-title-mb: {{ section.settings.title_margin_bottom }}px;

    --cgc-text-c: {{ section.settings.text_color }};
    --cgc-text-s: {{ section.settings.text_size_desktop }}px;
    --cgc-text-s-m: {{ section.settings.text_size_mobile }}px;
    --cgc-text-w: {{ section.settings.text_weight }};
    --cgc-text-lh: {{ section.settings.text_line_height }};
    --cgc-text-ls: {{ section.settings.text_letter_spacing }}px;
    --cgc-text-mb: {{ section.settings.text_margin_bottom }}px;

    --cgc-btn-gap: {{ section.settings.buttons_gap }}px;
    --cgc-btn-radius: {{ section.settings.button_radius }}px;
    --cgc-btn-py: {{ section.settings.button_padding_y_desktop }}px;
    --cgc-btn-px: {{ section.settings.button_padding_x_desktop }}px;
    --cgc-btn-py-m: {{ section.settings.button_padding_y_mobile }}px;
    --cgc-btn-px-m: {{ section.settings.button_padding_x_mobile }}px;
    --cgc-btn-size: {{ section.settings.button_size_desktop }}px;
    --cgc-btn-size-m: {{ section.settings.button_size_mobile }}px;
    --cgc-btn-weight: {{ section.settings.button_weight }};
    --cgc-btn-lh: {{ section.settings.button_line_height }};
    --cgc-btn-ls: {{ section.settings.button_letter_spacing }}px;
    --cgc-btn-border-width: {{ section.settings.button_border_width }}px;
  "
>
  <div class="cgc__wrap {% unless section.settings.full_width %}cgc__wrap--contained{% endunless %}">
    {% if section.settings.heading != blank %}
      <div class="cgc__head">
        <h2 class="cgc__heading">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="cgc__grid">
      {% for block in section.blocks %}
        <div class="cgc__item" {{ block.shopify_attributes }}>
          <div
            class="cgc__card cgc__card--{{ block.settings.content_position }}"
            style="
              --cgc-overlay: {{ block.settings.overlay_color }};
              --cgc-overlay-op: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
              --cgc-item-radius: {{ block.settings.card_radius | default: section.settings.card_radius }}px;
            "
          >
            {% if block.settings.image != blank %}
              <div class="cgc__media">
                {{ block.settings.image
                  | image_url: width: block.settings.image_render_width
                  | image_tag:
                    loading: 'lazy',
                    class: 'cgc__image',
                    alt: block.settings.image.alt | escape
                }}
              </div>
            {% else %}
              <div class="cgc__placeholder">Add image</div>
            {% endif %}

            <div class="cgc__overlay"></div>

            <div class="cgc__content cgc__content--{{ block.settings.content_alignment }}">
              <div class="cgc__text-wrap">
                {% if block.settings.title != blank %}
                  <h3 class="cgc__title">{{ block.settings.title }}</h3>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="cgc__text">{{ block.settings.text }}</div>
                {% endif %}
              </div>

              {% if block.settings.button_1_label != blank or block.settings.button_2_label != blank %}
                <div class="cgc__buttons cgc__buttons--{{ block.settings.buttons_alignment }}">
                  {% if block.settings.button_1_label != blank %}
                    <a
                      class="cgc__btn cgc__btn--1"
                      {% if block.settings.button_1_link != blank %}href="{{ block.settings.button_1_link }}"{% endif %}
                    >
                      {{ block.settings.button_1_label }}
                    </a>
                  {% endif %}

                  {% if block.settings.button_2_label != blank %}
                    <a
                      class="cgc__btn cgc__btn--2"
                      {% if block.settings.button_2_link != blank %}href="{{ block.settings.button_2_link }}"{% endif %}
                    >
                      {{ block.settings.button_2_label }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #CollectionsGrid-{{ section.id }}{
    background: var(--cgc-bg);
    padding: var(--cgc-pt) var(--cgc-pr) var(--cgc-pb) var(--cgc-pl);
  }

  #CollectionsGrid-{{ section.id }} .cgc__wrap--contained{
    max-width: var(--cgc-max);
    margin: 0 auto;
  }

  #CollectionsGrid-{{ section.id }} .cgc__head{
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
        padding: 0px 58px;
  }

  #CollectionsGrid-{{ section.id }} .cgc__heading{
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    font-family: {{ section.settings.font_heading | json }}, sans-serif;
  }

  #CollectionsGrid-{{ section.id }} .cgc__grid{
    display: grid;
    grid-template-columns: repeat(var(--cgc-cols), minmax(0, 1fr));
    gap: var(--cgc-gap);
  }

  #CollectionsGrid-{{ section.id }} .cgc__item{
    min-width: 0;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card{
    position: relative;
    min-height: var(--cgc-card-h);
    border-radius: var(--cgc-item-radius, var(--cgc-card-radius));
    overflow: hidden;
    display: flex;
  }

  #CollectionsGrid-{{ section.id }} .cgc__media{
    position: absolute;
    inset: 0;
  }

  #CollectionsGrid-{{ section.id }} .cgc__image{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #CollectionsGrid-{{ section.id }} .cgc__placeholder{
    position: absolute;
    inset: 0;
    background: #e9e9e9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    font-size: 14px;
  }

  #CollectionsGrid-{{ section.id }} .cgc__overlay{
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--cgc-overlay) calc(var(--cgc-overlay-op) * 100%), transparent);
    z-index: 1;
  }

  #CollectionsGrid-{{ section.id }} .cgc__content{
    position: relative;
    z-index: 2;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--cgc-content-py) var(--cgc-content-px);
    text-align: left;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--top_left .cgc__content{
    justify-content: space-between;
    align-items: flex-start;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--top_center .cgc__content{
    justify-content: space-between;
    align-items: center;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--top_right .cgc__content{
    justify-content: space-between;
    align-items: flex-end;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--center_left .cgc__content{
    justify-content: center;
    align-items: flex-start;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--center .cgc__content{
    justify-content: center;
    align-items: center;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--center_right .cgc__content{
    justify-content: center;
    align-items: flex-end;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--bottom_left .cgc__content{
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 32px !important;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--bottom_center .cgc__content{
    justify-content: space-between;
    align-items: center;
  }

  #CollectionsGrid-{{ section.id }} .cgc__card--bottom_right .cgc__content{
    justify-content: space-between;
    align-items: flex-end;
  }

  #CollectionsGrid-{{ section.id }} .cgc__content--left{
    text-align: left;
  }

  #CollectionsGrid-{{ section.id }} .cgc__content--center{
    text-align: center;
  }

  #CollectionsGrid-{{ section.id }} .cgc__content--right{
    text-align: right;
  }

  #CollectionsGrid-{{ section.id }} .cgc__title{
    margin: 0 0 var(--cgc-title-mb);
    color: var(--cgc-title-c);
    font-size: var(--cgc-title-s);
    font-weight: var(--cgc-title-w);
    line-height: var(--cgc-title-lh);
    letter-spacing: var(--cgc-title-ls);
    font-family: {{ section.settings.font_title | json }}, sans-serif;
  }

  #CollectionsGrid-{{ section.id }} .cgc__text{
    margin: 0 0 var(--cgc-text-mb);
    color: var(--cgc-text-c);
    font-size: var(--cgc-text-s);
    font-weight: var(--cgc-text-w);
    line-height: var(--cgc-text-lh);
    letter-spacing: var(--cgc-text-ls);
    font-family: {{ section.settings.font_text | json }}, sans-serif;
  }

  #CollectionsGrid-{{ section.id }} .cgc__text p{
    margin: 0;
  }

  #CollectionsGrid-{{ section.id }} .cgc__text p + p{
    margin-top: .6em;
  }

  #CollectionsGrid-{{ section.id }} .cgc__buttons{
    display: flex;
    gap: var(--cgc-btn-gap);
    flex-wrap: wrap;
    width: 100%;
  }

  #CollectionsGrid-{{ section.id }} .cgc__buttons--left{
    justify-content: flex-start;
  }

  #CollectionsGrid-{{ section.id }} .cgc__buttons--center{
    justify-content: center;
  }

  #CollectionsGrid-{{ section.id }} .cgc__buttons--right{
    justify-content: flex-end;
  }

  #CollectionsGrid-{{ section.id }} .cgc__btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: var(--cgc-btn-radius);
    padding: var(--cgc-btn-py) var(--cgc-btn-px);
    font-size: var(--cgc-btn-size);
    font-weight: var(--cgc-btn-weight);
    line-height: var(--cgc-btn-lh);
    letter-spacing: var(--cgc-btn-ls);
    transition: all .2s ease;
    border-style: solid;
    border-width: var(--cgc-btn-border-width);
    font-family: {{ section.settings.font_buttons | json }}, sans-serif;
  }

  #CollectionsGrid-{{ section.id }} .cgc__btn--1{
    background: {{ section.settings.button_1_bg }};
    color: {{ section.settings.button_1_color }};
    border-color: {{ section.settings.button_1_border }};
  }

  #CollectionsGrid-{{ section.id }} .cgc__btn--1:hover{
    background: {{ section.settings.button_1_bg_hover }};
    color: {{ section.settings.button_1_color_hover }};
    border-color: {{ section.settings.button_1_border_hover }};
  }

  #CollectionsGrid-{{ section.id }} .cgc__btn--2{
    background: {{ section.settings.button_2_bg }};
    color: {{ section.settings.button_2_color }};
    border-color: {{ section.settings.button_2_border }};
  }

  #CollectionsGrid-{{ section.id }} .cgc__btn--2:hover{
    background: {{ section.settings.button_2_bg_hover }};
    color: {{ section.settings.button_2_color_hover }};
    border-color: {{ section.settings.button_2_border_hover }};
  }

  @media (max-width: 749px){
    #CollectionsGrid-{{ section.id }} .cgc__head{
        padding: 0px;
        text-align:center;
    }
    #CollectionsGrid-{{ section.id }} .cgc__card--bottom_left .cgc__content {
        align-items: center !important;
        justify-content: center !important;
        text-align: center !important;
    }
    #CollectionsGrid-{{ section.id }} .cgc__buttons--right{
        justify-content: center;
        flex-direction:column;
        max-width: 139px;
    }
    #CollectionsGrid-{{ section.id }}{
      padding: var(--cgc-pt-m) var(--cgc-pr-m) var(--cgc-pb-m) var(--cgc-pl-m);
    }

    #CollectionsGrid-{{ section.id }} .cgc__heading{
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #CollectionsGrid-{{ section.id }} .cgc__grid{
      grid-template-columns: repeat(var(--cgc-cols-m), minmax(0, 1fr));
      gap: var(--cgc-gap-m);
    }

    #CollectionsGrid-{{ section.id }} .cgc__card{
      min-height: var(--cgc-card-h-m);
    }

    #CollectionsGrid-{{ section.id }} .cgc__content{
      padding: var(--cgc-content-py-m) var(--cgc-content-px-m);
    }

    #CollectionsGrid-{{ section.id }} .cgc__title{
      font-size: var(--cgc-title-s-m);
    }

    #CollectionsGrid-{{ section.id }} .cgc__text{
      font-size: var(--cgc-text-s-m);
      max-width: 240px;
    }

    #CollectionsGrid-{{ section.id }} .cgc__btn{
      padding: var(--cgc-btn-py-m) var(--cgc-btn-px-m);
      font-size: var(--cgc-btn-size-m);
    }
  }
</style>

{% schema %}
{
  "name": "Collections grid cards",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "Our collections"
    },

    {
      "type": "header",
      "content": "Section container"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "min": 900,
      "max": 2200,
      "step": 20,
      "label": "Section max width (px)",
      "default": 1440
    },

    {
      "type": "header",
      "content": "Section padding desktop"
    },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 200, "step": 2, "label": "Top", "default": 32 },
    { "type": "range", "id": "padding_right_desktop", "min": 0, "max": 200, "step": 2, "label": "Right", "default": 0 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 200, "step": 2, "label": "Bottom", "default": 0 },
    { "type": "range", "id": "padding_left_desktop", "min": 0, "max": 200, "step": 2, "label": "Left", "default": 0 },

    {
      "type": "header",
      "content": "Section padding mobile"
    },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 150, "step": 2, "label": "Top", "default": 20 },
    { "type": "range", "id": "padding_right_mobile", "min": 0, "max": 100, "step": 2, "label": "Right", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 150, "step": 2, "label": "Bottom", "default": 0 },
    { "type": "range", "id": "padding_left_mobile", "min": 0, "max": 100, "step": 2, "label": "Left", "default": 0 },

    {
      "type": "header",
      "content": "Grid"
    },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 4, "step": 1, "label": "Columns desktop", "default": 2 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns mobile", "default": 1 },
    { "type": "range", "id": "grid_gap_desktop", "min": 0, "max": 40, "step": 1, "label": "Grid gap desktop", "default": 1 },
    { "type": "range", "id": "grid_gap_mobile", "min": 0, "max": 30, "step": 1, "label": "Grid gap mobile", "default": 1 },

    {
      "type": "header",
      "content": "Card"
    },
    { "type": "range", "id": "card_height_desktop", "min": 200, "max": 700, "step": 10, "label": "Card height desktop", "default": 320 },
    { "type": "range", "id": "card_height_mobile", "min": 180, "max": 600, "step": 10, "label": "Card height mobile", "default": 280 },
    { "type": "range", "id": "card_radius", "min": 0, "max": 40, "step": 1, "label": "Card radius", "default": 0 },

    {
      "type": "header",
      "content": "Content spacing"
    },
    { "type": "range", "id": "content_padding_x_desktop", "min": 0, "max": 80, "step": 2, "label": "Padding X desktop", "default": 20 },
    { "type": "range", "id": "content_padding_y_desktop", "min": 0, "max": 80, "step": 2, "label": "Padding Y desktop", "default": 20 },
    { "type": "range", "id": "content_padding_x_mobile", "min": 0, "max": 60, "step": 2, "label": "Padding X mobile", "default": 16 },
    { "type": "range", "id": "content_padding_y_mobile", "min": 0, "max": 60, "step": 2, "label": "Padding Y mobile", "default": 16 },

    {
      "type": "header",
      "content": "Section heading typography"
    },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "range", "id": "heading_size_desktop", "min": 16, "max": 60, "step": 1, "label": "Heading size desktop", "default": 24 },
    { "type": "range", "id": "heading_size_mobile", "min": 14, "max": 40, "step": 1, "label": "Heading size mobile", "default": 18 },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    { "type": "range", "id": "heading_line_height", "min": 1, "max": 2, "step": 0.1, "label": "Heading line height", "default": 1.2 },
    { "type": "range", "id": "heading_letter_spacing", "min": -1, "max": 4, "step": 0.1, "label": "Heading letter spacing", "default": 0 },
    { "type": "range", "id": "heading_margin_bottom", "min": 0, "max": 60, "step": 2, "label": "Heading bottom margin", "default": 24 },
    {
      "type": "select",
      "id": "font_heading",
      "label": "Font family: Heading",
      "options": [
        { "value": "Montserrat", "label": "Montserrat" },
        { "value": "Roboto", "label": "Roboto" },
        { "value": "Helvetica Neue", "label": "Helvetica Neue" },
        { "value": "Playfair Display", "label": "Playfair Display" }
      ],
      "default": "Montserrat"
    },

    {
      "type": "header",
      "content": "Card title typography"
    },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#ffffff" },
    { "type": "range", "id": "title_size_desktop", "min": 14, "max": 60, "step": 1, "label": "Title size desktop", "default": 26 },
    { "type": "range", "id": "title_size_mobile", "min": 14, "max": 40, "step": 1, "label": "Title size mobile", "default": 22 },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Title weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    { "type": "range", "id": "title_line_height", "min": 1, "max": 2, "step": 0.1, "label": "Title line height", "default": 1.1 },
    { "type": "range", "id": "title_letter_spacing", "min": -1, "max": 4, "step": 0.1, "label": "Title letter spacing", "default": 0 },
    { "type": "range", "id": "title_margin_bottom", "min": 0, "max": 30, "step": 1, "label": "Title bottom margin", "default": 6 },
    {
      "type": "select",
      "id": "font_title",
      "label": "Font family: Title",
      "options": [
        { "value": "Montserrat", "label": "Montserrat" },
        { "value": "Roboto", "label": "Roboto" },
        { "value": "Helvetica Neue", "label": "Helvetica Neue" },
        { "value": "Playfair Display", "label": "Playfair Display" }
      ],
      "default": "Montserrat"
    },

    {
      "type": "header",
      "content": "Card text typography"
    },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "text_size_desktop", "min": 12, "max": 24, "step": 1, "label": "Text size desktop", "default": 15 },
    { "type": "range", "id": "text_size_mobile", "min": 12, "max": 22, "step": 1, "label": "Text size mobile", "default": 14 },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" }
      ],
      "default": "400"
    },
    { "type": "range", "id": "text_line_height", "min": 1, "max": 2, "step": 0.1, "label": "Text line height", "default": 1.4 },
    { "type": "range", "id": "text_letter_spacing", "min": -1, "max": 4, "step": 0.1, "label": "Text letter spacing", "default": 0 },
    { "type": "range", "id": "text_margin_bottom", "min": 0, "max": 30, "step": 1, "label": "Text bottom margin", "default": 14 },
    {
      "type": "select",
      "id": "font_text",
