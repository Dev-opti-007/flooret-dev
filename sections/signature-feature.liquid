{% comment %}
  Signature Feature (3-column)
  - Left: stacked images (blocks)
  - Middle: main hero image + overlay (title, text, buttons)
  - Right: quote + author
{% endcomment %}

<section
  id="SignatureFeature-{{ section.id }}"
  class="ssf"
  style="
    --ssf-bg: {{ section.settings.section_bg_color }};
    --ssf-max: {{ section.settings.section_max_width }}px;

    --ssf-pt: {{ section.settings.section_padding_top_desktop }}px;
    --ssf-pr: {{ section.settings.section_padding_right_desktop }}px;
    --ssf-pb: {{ section.settings.section_padding_bottom_desktop }}px;
    --ssf-pl: {{ section.settings.section_padding_left_desktop }}px;

    --ssf-pt-m: {{ section.settings.section_padding_top_mobile }}px;
    --ssf-pr-m: {{ section.settings.section_padding_right_mobile }}px;
    --ssf-pb-m: {{ section.settings.section_padding_bottom_mobile }}px;
    --ssf-pl-m: {{ section.settings.section_padding_left_mobile }}px;

    --ssf-gap: {{ section.settings.grid_gap_desktop }}px;
    --ssf-gap-m: {{ section.settings.grid_gap_mobile }}px;

    --ssf-left-w: {{ section.settings.left_col_width_desktop }}px;
    --ssf-right-w: {{ section.settings.right_col_width_desktop }}px;

    --ssf-left-gap: {{ section.settings.left_stack_gap_desktop }}px;
    --ssf-left-gap-m: {{ section.settings.left_stack_gap_mobile }}px;

    --ssf-hero-radius: {{ section.settings.hero_radius }}px;

    --ssf-overlay-bg: {{ section.settings.overlay_bg_color }};
    --ssf-overlay-op: {{ section.settings.overlay_bg_opacity | divided_by: 100.0 }};
    --ssf-overlay-radius: {{ section.settings.overlay_radius }}px;
    --ssf-overlay-py: {{ section.settings.overlay_padding_y_desktop }}px;
    --ssf-overlay-px: {{ section.settings.overlay_padding_x_desktop }}px;
    --ssf-overlay-py-m: {{ section.settings.overlay_padding_y_mobile }}px;
    --ssf-overlay-px-m: {{ section.settings.overlay_padding_x_mobile }}px;
    --ssf-overlay-max: {{ section.settings.overlay_max_width }}px;

    --ssf-kicker-c: {{ section.settings.kicker_color }};
    --ssf-kicker-s: {{ section.settings.kicker_size_desktop }}px;
    --ssf-kicker-s-m: {{ section.settings.kicker_size_mobile }}px;
    --ssf-kicker-w: {{ section.settings.kicker_weight }};
    --ssf-kicker-lh: {{ section.settings.kicker_line_height }};
    --ssf-kicker-ls: {{ section.settings.kicker_letter_spacing }}px;
    --ssf-kicker-mb: {{ section.settings.kicker_margin_bottom }}px;

    --ssf-title-c: {{ section.settings.title_color }};
    --ssf-title-s: {{ section.settings.title_size_desktop }}px;
    --ssf-title-s-m: {{ section.settings.title_size_mobile }}px;
    --ssf-title-w: {{ section.settings.title_weight }};
    --ssf-title-lh: {{ section.settings.title_line_height }};
    --ssf-title-ls: {{ section.settings.title_letter_spacing }}px;
    --ssf-title-mb: {{ section.settings.title_margin_bottom }}px;

    --ssf-text-c: {{ section.settings.text_color }};
    --ssf-text-s: {{ section.settings.text_size_desktop }}px;
    --ssf-text-s-m: {{ section.settings.text_size_mobile }}px;
    --ssf-text-w: {{ section.settings.text_weight }};
    --ssf-text-lh: {{ section.settings.text_line_height }};
    --ssf-text-ls: {{ section.settings.text_letter_spacing }}px;
    --ssf-text-mb: {{ section.settings.text_margin_bottom }}px;

    --ssf-btn-gap: {{ section.settings.buttons_gap }}px;
    --ssf-btn-radius: {{ section.settings.button_radius }}px;
    --ssf-btn-py: {{ section.settings.button_padding_y }}px;
    --ssf-btn-px: {{ section.settings.button_padding_x }}px;

    --ssf-btn1-bg: {{ section.settings.button_1_bg }};
    --ssf-btn1-c: {{ section.settings.button_1_color }};
    --ssf-btn1-b: {{ section.settings.button_1_border }};
    --ssf-btn2-bg: {{ section.settings.button_2_bg }};
    --ssf-btn2-c: {{ section.settings.button_2_color }};
    --ssf-btn2-b: {{ section.settings.button_2_border }};

    --ssf-quote-c: {{ section.settings.quote_color }};
    --ssf-quote-s: {{ section.settings.quote_size_desktop }}px;
    --ssf-quote-s-m: {{ section.settings.quote_size_mobile }}px;
    --ssf-quote-w: {{ section.settings.quote_weight }};
    --ssf-quote-lh: {{ section.settings.quote_line_height }};
    --ssf-quote-ls: {{ section.settings.quote_letter_spacing }}px;
    --ssf-quote-mb: {{ section.settings.quote_margin_bottom }}px;

    --ssf-author-c: {{ section.settings.author_color }};
    --ssf-author-s: {{ section.settings.author_size_desktop }}px;
    --ssf-author-s-m: {{ section.settings.author_size_mobile }}px;
    --ssf-author-w: {{ section.settings.author_weight }};
    --ssf-author-lh: {{ section.settings.author_line_height }};
    --ssf-author-ls: {{ section.settings.author_letter_spacing }}px;
  "
>
  <div class="ssf__wrap {% unless section.settings.full_width %}ssf__wrap--contained{% endunless %}">
    <div class="ssf__grid">
      {%- comment -%} LEFT STACK {%- endcomment -%}
      {% if section.settings.enable_left_column %}
        <div class="ssf__left">
          {% assign left_blocks = section.blocks | where: "type", "left_image" %}
          {% for block in left_blocks %}
            <div
              class="ssf__left-item {% if block.settings.enable_fixed_height %}ssf__left-item--fixed{% endif %}"
              style="
                --li-radius: {{ block.settings.radius }}px;
                {% if block.settings.enable_fixed_height %}
                  --li-h: {{ block.settings.height_desktop }}px;
                  --li-h-m: {{ block.settings.height_mobile }}px;
                {% endif %}
              "
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image != blank %}
                {% if block.settings.link != blank %}
                  <a class="ssf__left-link" href="{{ block.settings.link }}">
                {% endif %}

                {{ block.settings.image
                  | image_url: width: block.settings.render_width
                  | image_tag:
                    loading: 'lazy',
                    class: 'ssf__left-img',
                    alt: block.settings.image.alt | escape
                }}

                {% if block.settings.link != blank %}
                  </a>
                {% endif %}
              {% else %}
                <div class="ssf__placeholder">Add image</div>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {%- comment -%} MIDDLE HERO {%- endcomment -%}
      <div class="ssf__hero {% if section.settings.enable_custom_hero_height %}ssf__hero--fixed{% endif %}">
        <div
          class="ssf__hero-media"
          style="
            {% if section.settings.enable_custom_hero_height %}
              --hero-h: {{ section.settings.hero_height_desktop }}px;
              --hero-h-m: {{ section.settings.hero_height_mobile }}px;
            {% endif %}
          "
        >
          {% if section.settings.hero_image_desktop != blank %}
            {% if section.settings.hero_image_mobile != blank %}
              <picture>
                <source
                  media="(max-width: 749px)"
                  srcset="{{ section.settings.hero_image_mobile | image_url: width: section.settings.hero_mobile_render_width }}"
                >
                {{ section.settings.hero_image_desktop
                  | image_url: width: section.settings.hero_desktop_render_width
                  | image_tag:
                    loading: 'lazy',
                    class: 'ssf__hero-img',
                    alt: section.settings.hero_image_desktop.alt | escape
                }}
              </picture>
            {% else %}
              {{ section.settings.hero_image_desktop
                | image_url: width: section.settings.hero_desktop_render_width
                | image_tag:
                  loading: 'lazy',
                  class: 'ssf__hero-img',
                  alt: section.settings.hero_image_desktop.alt | escape
              }}
            {% endif %}
          {% else %}
            <div class="ssf__hero-fallback">Select a hero image</div>
          {% endif %}
        </div>

        {% if section.settings.enable_overlay %}
          <div class="ssf__overlay ssf__overlay--{{ section.settings.overlay_position }}">
            <div class="ssf__overlay-inner">
              {% if section.settings.kicker != blank %}
                <div class="ssf__kicker">{{ section.settings.kicker }}</div>
              {% endif %}

              {% if section.settings.title != blank %}
                <div class="ssf__title">{{ section.settings.title }}</div>
              {% endif %}

              {% if section.settings.text != blank %}
                <div class="ssf__text">{{ section.settings.text }}</div>
              {% endif %}

              {% if section.settings.button_1_label != blank or section.settings.button_2_label != blank %}
                <div class="ssf__buttons">
                  {% if section.settings.button_1_label != blank %}
                    <a
                      class="ssf__btn ssf__btn--1"
                      {% if section.settings.button_1_link != blank %}href="{{ section.settings.button_1_link }}"{% endif %}
                    >
                      {{ section.settings.button_1_label }}
                    </a>
                  {% endif %}

                  {% if section.settings.button_2_label != blank %}
                    <a
                      class="ssf__btn ssf__btn--2"
                      {% if section.settings.button_2_link != blank %}href="{{ section.settings.button_2_link }}"{% endif %}
                    >
                      {{ section.settings.button_2_label }}
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>

      {%- comment -%} RIGHT QUOTE {%- endcomment -%}
      {% if section.settings.enable_right_column %}
        <div class="ssf__right" style="text-align: {{ section.settings.right_text_align }};">
          {% if section.settings.quote != blank %}
            <div class="ssf__quote">
              {% if section.settings.enable_quote_marks %}<span class="ssf__qmark">“</span>{% endif %}{{ section.settings.quote }}{% if section.settings.enable_quote_marks %}<span class="ssf__qmark">”</span>{% endif %}
            </div>
          {% endif %}

          {% if section.settings.author != blank %}
            <div class="ssf__author">- {{ section.settings.author }}</div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .ssf{
    background: var(--ssf-bg);
    padding: var(--ssf-pt) var(--ssf-pr) var(--ssf-pb) var(--ssf-pl);
  }
  .ssf__wrap--contained{ max-width: var(--ssf-max); margin: 0 auto; }

  .ssf__grid{
    display: grid;
    grid-template-columns: var(--ssf-left-w) minmax(0, 1fr) var(--ssf-right-w);
    gap: var(--ssf-gap);
    align-items: start;
  }

  .ssf__left{
    display: grid;
    gap: var(--ssf-left-gap);
    align-content: start;
  }
  .ssf__left-item{
    border-radius: var(--li-radius);
    overflow: hidden;
    background: rgba(0,0,0,0.04);
  }
  .ssf__left-item--fixed{ height: var(--li-h); }
  .ssf__left-item--fixed .ssf__left-img{ height: 100%; object-fit: cover; }

  .ssf__left-link{ display:block; }
  .ssf__left-img{ width: 100%; height: auto; display: block; }

  .ssf__placeholder{
    padding: 18px;
    font-size: 14px;
    opacity: .7;
  }

  .ssf__hero{ position: relative;height: 100%;}
  .ssf__hero-media{ border-radius: var(--ssf-hero-radius); overflow: hidden;height: 100%;position:relative; }
  .ssf__hero-media::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #000;
      opacity: 0.5;
  }
  .ssf__hero--fixed .ssf__hero-media{ height: var(--hero-h); }
  .ssf__hero-img{ width: 100%; height: auto; display: block;height:100%; }
  .ssf__hero--fixed .ssf__hero-img{ height: 100%; object-fit: cover; }

  .ssf__hero-fallback{
    border-radius: var(--ssf-hero-radius);
    background: rgba(0,0,0,0.04);
    padding: 18px;
  }

  .ssf__overlay{
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    pointer-events: none;
    display: flex;
    padding: 18px;
  }
  .ssf__overlay--bottom_left{ align-items: flex-end; justify-content: flex-start; }
  .ssf__overlay--bottom_right{ align-items: flex-end; justify-content: flex-end; }
  .ssf__overlay--top_left{ align-items: flex-start; justify-content: flex-start; }
  .ssf__overlay--top_right{ align-items: flex-start; justify-content: flex-end; }

  .ssf__overlay-inner{
    pointer-events: auto;
    max-width: var(--ssf-overlay-max);
    background: color-mix(in srgb, var(--ssf-overlay-bg) calc(var(--ssf-overlay-op) * 100%), transparent);
    border-radius: var(--ssf-overlay-radius);
    padding: var(--ssf-overlay-py) var(--ssf-overlay-px);
    backdrop-filter: saturate(1.1);
  }

  .ssf__kicker{
    color: var(--ssf-kicker-c);
    font-size: var(--ssf-kicker-s);
    font-weight: var(--ssf-kicker-w);
    line-height: var(--ssf-kicker-lh);
    letter-spacing: var(--ssf-kicker-ls);
    margin-bottom: var(--ssf-kicker-mb);
    font-family: {{ section.settings.font_kicker | json }}, sans-serif;
  }
  .ssf__title{
    color: var(--ssf-title-c);
    font-size: var(--ssf-title-s);
    font-weight: var(--ssf-title-w);
    line-height: var(--ssf-title-lh);
    letter-spacing: var(--ssf-title-ls);
    margin-bottom: var(--ssf-title-mb);
    font-family: {{ section.settings.font_title | json }}, sans-serif;
  }
  .ssf__text{
    color: var(--ssf-text-c);
    font-size: var(--ssf-text-s);
    font-weight: var(--ssf-text-w);
    line-height: var(--ssf-text-lh);
    letter-spacing: var(--ssf-text-ls);
    margin-bottom: var(--ssf-text-mb);
    font-family: {{ section.settings.font_text | json }}, sans-serif;
  }
  .ssf__text p{ margin: 0; }
  .ssf__text p + p{ margin-top: .65em; }

  .ssf__buttons{
    display: flex;
    gap: var(--ssf-btn-gap);
    flex-wrap: wrap;
  }
  .ssf__btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: var(--ssf-btn-radius);
    padding: var(--ssf-btn-py) var(--ssf-btn-px);
    font-size: 14px;
    line-height: 1;
    font-weight: 600;
    transition: opacity .18s ease, transform .18s ease;
    will-change: transform;
    font-family: {{ section.settings.font_buttons | json }}, sans-serif;
  }
  .ssf__btn:hover{ opacity: .92; transform: translateY(-1px); }

  .ssf__btn--1{
    background: var(--ssf-btn1-bg);
    color: var(--ssf-btn1-c);
    border: 1px solid var(--ssf-btn1-b);
  }
  .ssf__btn--2{
    background: var(--ssf-btn2-bg);
    color: var(--ssf-btn2-c);
    border: 1px solid var(--ssf-btn2-b);
  }

  .ssf__right{
    padding-top: 6px;
  }
  .ssf__quote{
    color: var(--ssf-quote-c);
    font-size: var(--ssf-quote-s);
    font-weight: var(--ssf-quote-w);
    line-height: var(--ssf-quote-lh);
    letter-spacing: var(--ssf-quote-ls);
    margin-bottom: var(--ssf-quote-mb);
    font-family: {{ section.settings.font_quote | json }}, serif;
  }
  .ssf__qmark{ opacity: .95; }
  .ssf__author{
    color: var(--ssf-author-c);
    font-size: var(--ssf-author-s);
    font-weight: var(--ssf-author-w);
    line-height: var(--ssf-author-lh);
    letter-spacing: var(--ssf-author-ls);
    font-family: {{ section.settings.font_author | json }}, sans-serif;
  }
{% if section.settings.enable_without_bg_btns == true %}
  .ssf__text {
      max-width: 624px;
  }
  .ssf__overlay-inner {
      width: 100%;
      max-width: unset;
  }
  .ssf__buttons {
      justify-content: space-between;
      width: 100%;
  }

  .ssf__buttons a {
      background: none;
      color: #fff;
      border: none;
      padding: 0px;
      cursor: pointer;
  }

  .ssf__buttons a:hover {
      background: none;
      color: #fff;
  }
{% endif %}
  @media (max-width: 989px){
    .ssf__grid{
      grid-template-columns: minmax(0, 1fr);
      gap: var(--ssf-gap-m);
    }
    .ssf__left{ order: {{ section.settings.mobile_order_left }}; }
    .ssf__hero{ order: {{ section.settings.mobile_order_hero }}; }
    .ssf__right{ order: {{ section.settings.mobile_order_right }}; }
  }

@media (min-width: 769px) and (max-width: 1250px) {
.ssf{
      padding: var(--ssf-pt-m) var(--ssf-pr-m) var(--ssf-pb-m) var(--ssf-pl-m);
    }
    .ssf__left{ gap: var(--ssf-left-gap-m); }
    .ssf__left-item--fixed{ height: var(--li-h-m); }

    .ssf__hero--fixed .ssf__hero-media{ height: var(--hero-h-m); }
    .ssf__overlay-inner{
      padding: var(--ssf-overlay-py-m) var(--ssf-overlay-px-m);
    }
    .ssf__grid {
        grid-template-columns: 1fr 1fr;
        gap: var(--ssf-gap-m);
    }
    .ssf__left {
        gap: var(--ssf-left-gap-m);
        grid-column: 1/3;
        grid-template-columns: 1fr 1fr;
        order: 1;
    }
    .ssf__left .ssf__left-item {
        aspect-ratio: 1;
    }
    .ssf__hero {
        grid-column: 1/3;
        aspect-ratio: 1/1;
        order: 2;
    }
    .ssf__right {
        order: 3;
        grid-column: 1/3;
    }
    .ssf__quote {
        margin-bottom: 18px;
    }
    .ssf__hero-img {
      object-fit: cover;
  }
}


/* iOS <15: Padding hack on mobile ONLY */
@supports not (aspect-ratio: 1) {
  @media (max-width: 749px) {
    .ssf__left .ssf__left-item {
      position: relative !important;
      padding-bottom: 100%;
      width: 100% !important;
      height: 0 !important;
    }
    
    .ssf__left .ssf__left-item > * {
      position: absolute !important;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }
}

/* Modern browsers: Native aspect-ratio everywhere */
@supports (aspect-ratio: 1) {
  .ssf__left .ssf__left-item {
    aspect-ratio: 1;
  }
}

/* Fallback for desktop (non-mobile iOS <15) */
@media (min-width: 750px) {
  .ssf__left .ssf__left-item {
    aspect-ratio: 1;
  }
}


  @media (max-width: 749px){
    .ssf{
      padding: var(--ssf-pt-m) var(--ssf-pr-m) var(--ssf-pb-m) var(--ssf-pl-m);
    }
    .ssf__left{ gap: var(--ssf-left-gap-m); }
    .ssf__left-item--fixed{ height: var(--li-h-m); }

    .ssf__hero--fixed .ssf__hero-media{ height: var(--hero-h-m); }
    .ssf__overlay-inner{
      padding: var(--ssf-overlay-py-m) var(--ssf-overlay-px-m);
    }

    .ssf__kicker{ font-size: var(--ssf-kicker-s-m); }
    .ssf__title{ font-size: var(--ssf-title-s-m); }
    .ssf__text{ font-size: var(--ssf-text-s-m); }
    .ssf__quote{ font-size: var(--ssf-quote-s-m); }
    .ssf__author{ font-size: var(--ssf-author-s-m); }
    .ssf__grid {
        grid-template-columns: 1fr 1fr;
        gap: var(--ssf-gap-m);
    }
    .ssf__left {
        gap: var(--ssf-left-gap-m);
        grid-column: 1/3;
        grid-template-columns: 1fr 1fr;
        order: 1;
    }
    .ssf__left .ssf__left-item {
        aspect-ratio: 1;
    }
    .ssf__hero {
        grid-column: 1/3;
        aspect-ratio: 1/1;
        order: 2;
    }
    .ssf__right {
        order: 3;
        grid-column: 1/3;
    }
    .ssf__quote {
        margin-bottom: 18px;
    }
  }
  @media (max-width:350px){
    .ssf__text {
          margin-bottom: 25px;
    }
  }
</style>

{% schema %}
{
  "name": "Signature feature",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width section",
      "default": false
    },
    {
      "type": "header",
      "content": "Section container"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_max_width",
      "min": 900,
      "max": 2000,
      "step": 50,
      "label": "Section max width (px)",
      "default": 1400,
      "info": "Ignored when Full width is enabled."
    },

    {
      "type": "header",
      "content": "Section padding (desktop)"
    },
    { "type": "range", "id": "section_padding_top_desktop", "min": 0, "max": 200, "step": 2, "label": "Padding top (px)", "default": 40 },
    { "type": "range", "id": "section_padding_right_desktop", "min": 0, "max": 200, "step": 2, "label": "Padding right (px)", "default": 20 },
    { "type": "range", "id": "section_padding_bottom_desktop", "min": 0, "max": 200, "step": 2, "label": "Padding bottom (px)", "default": 40 },
    { "type": "range", "id": "section_padding_left_desktop", "min": 0, "max": 200, "step": 2, "label": "Padding left (px)", "default": 20 },

    {
      "type": "header",
      "content": "Section padding (mobile)"
    },
    { "type": "range", "id": "section_padding_top_mobile", "min": 0, "max": 150, "step": 2, "label": "Padding top (px)", "default": 28 },
    { "type": "range", "id": "section_padding_right_mobile", "min": 0, "max": 150, "step": 2, "label": "Padding right (px)", "default": 16 },
    { "type": "range", "id": "section_padding_bottom_mobile", "min": 0, "max": 150, "step": 2, "label": "Padding bottom (px)", "default": 28 },
    { "type": "range", "id": "section_padding_left_mobile", "min": 0, "max": 150, "step": 2, "label": "Padding left (px)", "default": 16 },

    {
      "type": "header",
      "content": "Grid layout"
    },
    { "type": "range", "id": "grid_gap_desktop", "min": 0, "max": 80, "step": 2, "label": "Grid gap desktop (px)", "default": 24 },
    { "type": "range", "id": "grid_gap_mobile", "min": 0, "max": 60, "step": 2, "label": "Grid gap mobile (px)", "default": 18 },

    { "type": "checkbox", "id": "enable_left_column", "label": "Enable left column", "default": true },
    { "type": "range", "id": "left_col_width_desktop", "min": 120, "max": 320, "step": 5, "label": "Left column width (desktop px)", "default": 170 },
