{%- liquid
  assign s = section.settings
  assign bg = s.bg_image
-%}

<section
  id="FooterTopV2-{{ section.id }}"
  class="ftv2"
  style="
    --ftv2-max: {{ s.section_max_width }}px;

    --ftv2-pt: {{ s.padding_top_desktop }}px;
    --ftv2-pr: {{ s.padding_right_desktop }}px;
    --ftv2-pb: {{ s.padding_bottom_desktop }}px;
    --ftv2-pl: {{ s.padding_left_desktop }}px;

    --ftv2-pt-m: {{ s.padding_top_mobile }}px;
    --ftv2-pr-m: {{ s.padding_right_mobile }}px;
    --ftv2-pb-m: {{ s.padding_bottom_mobile }}px;
    --ftv2-pl-m: {{ s.padding_left_mobile }}px;

    --ftv2-minh: {{ s.min_height_desktop }}px;
    --ftv2-minh-m: {{ s.min_height_mobile }}px;

    --ftv2-title-c: {{ s.heading_color }};
    --ftv2-title-s: {{ s.heading_size_desktop }}px;
    --ftv2-title-s-m: {{ s.heading_size_mobile }}px;
    --ftv2-title-w: {{ s.heading_weight }};
    --ftv2-title-lh: {{ s.heading_line_height }};
    --ftv2-title-ls: {{ s.heading_letter_spacing }}px;

    --ftv2-btn-gap: {{ s.buttons_gap }}px;
    --ftv2-btn-mt: {{ s.buttons_margin_top }}px;

    --ftv2-btn1-bg: {{ s.btn1_bg }};
    --ftv2-btn1-c: {{ s.btn1_color }};
    --ftv2-btn1-bd: {{ s.btn1_border_color }};

    --ftv2-btn2-bg: {{ s.btn2_bg }};
    --ftv2-btn2-c: {{ s.btn2_color }};
    --ftv2-btn2-bd: {{ s.btn2_border_color }};

    --ftv2-btn-radius: {{ s.button_radius }}px;
    --ftv2-btn-py: {{ s.button_padding_y }}px;
    --ftv2-btn-px: {{ s.button_padding_x }}px;
    --ftv2-btn-s: {{ s.button_font_size }}px;
    --ftv2-btn-w: {{ s.button_font_weight }};
  "
>
  <div class="ftv2__bg">
    {%- if bg != blank -%}
      <div
        class="ftv2__bg-img"
        style="
          background-image:url('{{ bg | image_url: width: 2400 }}');
          background-position: {{ s.bg_position }};
        "
        role="img"
        aria-label="{{ bg.alt | escape }}"
      ></div>
    {%- else -%}
      <div class="ftv2__bg-img ftv2__bg-img--placeholder"></div>
    {%- endif -%}

    {%- if s.enable_overlay -%}
      <div
        class="ftv2__overlay"
        style="
          {%- if s.overlay_type == 'gradient' and s.overlay_gradient_css != blank -%}
            background: {{ s.overlay_gradient_css }};
          {%- else -%}
            background: {{ s.overlay_color }};
          {%- endif -%}
          opacity: {{ s.overlay_opacity }};
        "
      ></div>
    {%- endif -%}
  </div>

  <div class="ftv2__wrap {% unless s.full_width %}ftv2__wrap--contained{% endunless %}">
    <div class="ftv2__content ftv2__content--{{ s.content_align }}">
      {%- if s.heading != blank -%}
        <h2 class="ftv2__heading">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if s.show_buttons -%}
        <div class="ftv2__buttons">
          {%- if s.btn1_label != blank -%}
            <a class="ftv2__btn ftv2__btn--1" href="{{ s.btn1_link | default: '#' }}">
              {{ s.btn1_label }}
            </a>
          {%- endif -%}

          {%- if s.btn2_label != blank -%}
            <a class="ftv2__btn ftv2__btn--2" href="{{ s.btn2_link | default: '#' }}">
              {{ s.btn2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #FooterTopV2-{{ section.id }}{
    position: relative;
    overflow: hidden;
    min-height: var(--ftv2-minh);
    padding: var(--ftv2-pt) var(--ftv2-pr) var(--ftv2-pb) var(--ftv2-pl);
  }

  #FooterTopV2-{{ section.id }} .ftv2__bg{
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #FooterTopV2-{{ section.id }} .ftv2__bg-img{
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    filter: saturate({{ s.bg_saturation }}) contrast({{ s.bg_contrast }}) brightness({{ s.bg_brightness }});
    transform: scale({{ s.bg_scale }});
  }
  #FooterTopV2-{{ section.id }} .ftv2__bg-img--placeholder{
    background: #111;
  }

  #FooterTopV2-{{ section.id }} .ftv2__overlay{
    position: absolute;
    inset: 0;
    /* background + opacity come from inline style so it can be solid OR gradient */
  }

  #FooterTopV2-{{ section.id }} .ftv2__wrap{
    position: relative;
    z-index: 1;
    height: 100%;
    min-height: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #FooterTopV2-{{ section.id }} .ftv2__wrap--contained{
    max-width: var(--ftv2-max);
    margin: 0 auto;
    width: 100%;
  }

  #FooterTopV2-{{ section.id }} .ftv2__content{
    width: 100%;
    max-width: {{ s.content_max_width }}px;
  }
  #FooterTopV2-{{ section.id }} .ftv2__content--left{ text-align: left; }
  #FooterTopV2-{{ section.id }} .ftv2__content--center{ text-align: center; }
  #FooterTopV2-{{ section.id }} .ftv2__content--right{ text-align: right; }

  #FooterTopV2-{{ section.id }} .ftv2__heading{
    margin: 0;
    color: var(--ftv2-title-c);
    font-size: var(--ftv2-title-s);
    font-weight: var(--ftv2-title-w);
    line-height: var(--ftv2-title-lh);
    letter-spacing: var(--ftv2-title-ls);
    font-family: {{ s.font_heading | json }};
  }

  #FooterTopV2-{{ section.id }} .ftv2__buttons{
    margin-top: var(--ftv2-btn-mt);
    display: inline-flex;
    gap: var(--ftv2-btn-gap);
    flex-wrap: wrap;
    justify-content: center;
  }
  #FooterTopV2-{{ section.id }} .ftv2__content--left .ftv2__buttons{ justify-content: flex-start; }
  #FooterTopV2-{{ section.id }} .ftv2__content--right .ftv2__buttons{ justify-content: flex-end; }

  #FooterTopV2-{{ section.id }} .ftv2__btn{
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: var(--ftv2-btn-radius);
    padding: var(--ftv2-btn-py) var(--ftv2-btn-px);
    font-size: var(--ftv2-btn-s);
    font-weight: var(--ftv2-btn-w);
    font-family: {{ s.font_buttons | json }};
    border: 1px solid transparent;
    transition: transform .15s ease, opacity .15s ease;
    min-width: {{ s.button_min_width }}px;
    text-align: center;
  }
  #FooterTopV2-{{ section.id }} .ftv2__btn:hover{ transform: translateY(-1px); opacity: .95; }

  #FooterTopV2-{{ section.id }} .ftv2__btn--1{
    background: var(--ftv2-btn1-bg);
    color: var(--ftv2-btn1-c);
    border-color: var(--ftv2-btn1-bd);
  }
  #FooterTopV2-{{ section.id }} .ftv2__btn--2{
    background: var(--ftv2-btn2-bg);
    color: var(--ftv2-btn2-c);
    border-color: var(--ftv2-btn2-bd);
  }

  @media (max-width: 749px){
    #FooterTopV2-{{ section.id }}{
      min-height: var(--ftv2-minh-m);
      padding: var(--ftv2-pt-m) var(--ftv2-pr-m) var(--ftv2-pb-m) var(--ftv2-pl-m);
    }
    #FooterTopV2-{{ section.id }} .ftv2__heading{
      font-size: var(--ftv2-title-s-m);
    }
    #FooterTopV2-{{ section.id }} .ftv2__buttons {
        flex-direction: column;
    }

    #FooterTopV2-{{ section.id }} .ftv2__buttons .ftv2__btn {
        min-width: 312px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Footer Top V2",
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full width section", "default": true },

    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Background position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" }
      ],
      "default": "center center"
    },
    { "type": "range", "id": "bg_scale", "min": 1, "max": 2, "step": 0.1, "label": "Background scale", "default": 1 },
    { "type": "range", "id": "bg_brightness", "min": 0, "max": 1, "step": 0.1, "label": "Brightness", "default": 0.9 },
    { "type": "range", "id": "bg_contrast", "min": 0, "max": 1, "step": 0.1, "label": "Contrast", "default": 1 },
    { "type": "range", "id": "bg_saturation", "min": 0, "max": 2, "step": 0.1, "label": "Saturation", "default": 1 },

    { "type": "header", "content": "Overlay" },
    { "type": "checkbox", "id": "enable_overlay", "label": "Enable overlay", "default": true },
    {
      "type": "select",
      "id": "overlay_type",
      "label": "Overlay type",
      "options": [
        { "value": "solid", "label": "Solid color" },
        { "value": "gradient", "label": "Gradient (CSS)" }
      ],
      "default": "solid"
    },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 1, "step": 0.1, "label": "Overlay opacity", "default": 0.2 },
    {
      "type": "textarea",
      "id": "overlay_gradient_css",
      "label": "Overlay gradient CSS",
      "default": "linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.10) 55%, rgba(0,0,0,0.35) 100%)",
      "info": "Paste any valid CSS gradient. Opacity slider still applies."
    },

    { "type": "header", "content": "Container & spacing" },
    { "type": "range", "id": "section_max_width", "min": 800, "max": 1800, "step": 50, "label": "Section max width (px)", "default": 1400, "info": "Used when Full width is disabled." },
    { "type": "range", "id": "content_max_width", "min": 300, "max": 1400, "step": 50, "label": "Content max width (px)", "default": 1100 },
    { "type": "range", "id": "min_height_desktop", "min": 200, "max": 700, "step": 10, "label": "Min height desktop (px)", "default": 420 },
    { "type": "range", "id": "min_height_mobile", "min": 160, "max": 600, "step": 10, "label": "Min height mobile (px)", "default": 260 },

    { "type": "header", "content": "Padding (desktop)" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding top (px)", "default": 80 },
    { "type": "range", "id": "padding_right_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding right (px)", "default": 20 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding bottom (px)", "default": 80 },
    { "type": "range", "id": "padding_left_desktop", "min": 0, "max": 200, "step": 5, "label": "Padding left (px)", "default": 20 },

    { "type": "header", "content": "Padding (mobile)" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 180, "step": 5, "label": "Padding top (px)", "default": 60 },
    { "type": "range", "id": "padding_right_mobile", "min": 0, "max": 180, "step": 5, "label": "Padding right (px)", "default": 15 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 180, "step": 5, "label": "Padding bottom (px)", "default": 60 },
    { "type": "range", "id": "padding_left_mobile", "min": 0, "max": 180, "step": 5, "label": "Padding left (px)", "default": 15 },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Experience the Difference" },
    {
      "type": "select",
      "id": "content_align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Heading typography" },
    {
      "type": "select",
      "id": "font_heading",
      "label": "Font family: Heading",
      "options": [
        { "value": "Montserrat", "label": "Montserrat" },
        { "value": "Roboto", "label": "Roboto" },
        { "value": "Helvetica Neue", "label": "Helvetica Neue" },
        { "value": "Playfair Display", "label": "Playfair Display" }
      ],
      "default": "Playfair Display"
    },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#ffffff" },
    { "type": "range", "id": "heading_size_desktop", "min": 20, "max": 90, "step": 2, "label": "Heading size desktop (px)", "default": 56 },
    { "type": "range", "id": "heading_size_mobile", "min": 18, "max": 60, "step": 2, "label": "Heading size mobile (px)", "default": 34 },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    { "type": "range", "id": "heading_line_height", "min": 1, "max": 2, "step": 0.1, "label": "Heading line height", "default": 1.1 },
    { "type": "range", "id": "heading_letter_spacing", "min": -2, "max": 6, "step": 0.1, "label": "Heading letter spacing (px)", "default": 0 },

    { "type": "header", "content": "Buttons" },
    { "type": "checkbox", "id": "show_buttons", "label": "Show buttons", "default": true },
    { "type": "range", "id": "buttons_gap", "min": 0, "max": 40, "step": 1, "label": "Buttons gap (px)", "default": 14 },
    { "type": "range", "id": "buttons_margin_top", "min": 0, "max": 60, "step": 1, "label": "Buttons margin top (px)", "default": 18 },
    { "type": "range", "id": "button_min_width", "min": 120, "max": 320, "step": 10, "label": "Button min width (px)", "default": 170 },

    {
      "type": "select",
      "id": "font_buttons",
      "label": "Font family: Buttons",
      "options": [
        { "value": "Montserrat", "label": "Montserrat" },
        { "value": "Roboto", "label": "Roboto" },
        { "value": "Helvetica Neue", "label": "Helvetica Neue" },
        { "value": "Playfair Display", "label": "Playfair Display" }
      ],
      "default": "Montserrat"
    },
    { "type": "range", "id": "button_font_size", "min": 12, "max": 22, "step": 1, "label": "Button font size (px)", "default": 13 },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Button font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    { "type": "range", "id": "button_radius", "min": 0, "max": 50, "step": 5, "label": "Button radius (px)", "default": 50 },
    { "type": "range", "id": "button_padding_y", "min": 6, "max": 24, "step": 1, "label": "Button padding Y (px)", "default": 10 },
    { "type": "range", "id": "button_padding_x", "min": 10, "max": 40, "step": 1, "label": "Button padding X (px)", "default": 22 },

    { "type": "header", "content": "Button 1" },
    { "type": "text", "id": "btn1_label", "label": "Label", "default": "Order Samples" },
    { "type": "url", "id": "btn1_link", "label": "Link" },
    { "type": "color", "id": "btn1_bg", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "btn1_color", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "btn1_border_color", "label": "Border color", "default": "#ffffff" },

    { "type": "header", "content": "Button 2" },
    { "type": "text", "id": "btn2_label", "label": "Label", "default": "Shop Collections" },
    { "type": "url", "id": "btn2_link", "label": "Link" },
    { "type": "color", "id": "btn2_bg", "label": "Background", "default": "#000000" },
    { "type": "color", "id": "btn2_color", "label": "Text color", "default": "#ffffff" },
    { "type": "color", "id": "btn2_border_color", "label": "Border color", "default": "#000000" }
  ],
  "presets": [
    { "name": "Footer Top V2" }
  ]
}
{% endschema %}
