{% comment %}
  Inspired Text divider Section
  Layout:
  - Left: heading
  - Right: richtext (top) + richtext (bottom)
  - Bottom: dotted divider + centered X icon
{% endcomment %}

<section
  id="InspiredTextDivider-{{ section.id }}"
  class="itd"
  style="
    --itd-bg: {{ section.settings.section_bg_color }};
    --itd-max: {{ section.settings.section_max_width }}px;

    --itd-pt: {{ section.settings.section_padding_top }}px;
    --itd-pb: {{ section.settings.section_padding_bottom }}px;
    --itd-px: {{ section.settings.section_padding_horizontal }}px;

    --itd-pt-m: {{ section.settings.section_padding_top_mobile }}px;
    --itd-pb-m: {{ section.settings.section_padding_bottom_mobile }}px;
    --itd-px-m: {{ section.settings.section_padding_horizontal_mobile }}px;

    --itd-gap: {{ section.settings.columns_gap }}%;

    --itd-left-w: {{ section.settings.left_col_width }}%;
    --itd-right-w: {{ section.settings.right_col_width }}%;

    --itd-head-color: {{ section.settings.heading_color }};
    --itd-head-size: {{ section.settings.heading_size_desktop }}px;
    --itd-head-size-m: {{ section.settings.heading_size_mobile }}px;
    --itd-head-weight: {{ section.settings.heading_weight }};
    --itd-head-lh: {{ section.settings.heading_line_height }};
    --itd-head-ls: {{ section.settings.heading_letter_spacing }}px;
    --itd-head-mb: {{ section.settings.heading_margin_bottom }}px;
    --itd-head-mb-m: {{ section.settings.heading_margin_bottom_mobile }}px;

    --itd-body-color: {{ section.settings.body_color }};
    --itd-body-size: {{ section.settings.body_size_desktop }}px;
    --itd-body-size-m: {{ section.settings.body_size_mobile }}px;
    --itd-body-weight: {{ section.settings.body_weight }};
    --itd-body-lh: {{ section.settings.body_line_height }};
    --itd-body-ls: {{ section.settings.body_letter_spacing }}px;

    --itd-par-gap: {{ section.settings.paragraph_gap }}px;

    --itd-divider-color: {{ section.settings.divider_color }};
    --itd-divider-thickness: {{ section.settings.divider_thickness }}px;
    --itd-divider-dot: {{ section.settings.divider_dot_size }}px;
    --itd-divider-mt: {{ section.settings.divider_margin_top }}px;
    --itd-divider-mb: {{ section.settings.divider_margin_bottom }}px;

    --itd-x-size: {{ section.settings.x_size }}px;
    --itd-x-stroke: {{ section.settings.x_stroke_width }}px;
    --itd-x-color: {{ section.settings.x_color }};
    --itd-x-bg: {{ section.settings.x_bg_color }};
    --itd-x-pad: {{ section.settings.x_padding }}px;
    --itd-x-radius: {{ section.settings.x_radius }}px;
  "
>
  <div class="itd__wrap {% unless section.settings.full_width %}itd__wrap--contained{% endunless %}">
    <div class="itd__grid">
      <div class="itd__left">
        {% if section.settings.heading != blank %}
          <h2 class="itd__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}
      </div>

      <div class="itd__right">
        {% if section.settings.body_top != blank %}
          <div class="itd__body itd__body--top">
            {{ section.settings.body_top }}
          </div>
        {% endif %}

        {% if section.settings.body_bottom != blank %}
          <div class="itd__body itd__body--bottom">
            {{ section.settings.body_bottom }}
          </div>
        {% endif %}
      </div>
    </div>

  </div>
</section>

<style>
  .itd{
    background: var(--itd-bg);
    padding: var(--itd-pt) var(--itd-px) var(--itd-pb);
  }

  .itd__wrap--contained{
    max-width: var(--itd-max);
    margin: 0 auto;
    padding: 0px 30px;
  }

  .itd__grid{
    display: grid;
    grid-template-columns: minmax(0, var(--itd-left-w)) minmax(0, var(--itd-right-w));
    gap: var(--itd-gap);
    align-items: start;
  }

  .itd__heading{
    margin: 0 0 var(--itd-head-mb);
    color: var(--itd-head-color);
    font-size: var(--itd-head-size);
    font-weight: var(--itd-head-weight);
    line-height: var(--itd-head-lh);
    letter-spacing: var(--itd-head-ls);
  }

  .itd__body{
    color: var(--itd-body-color);
    font-size: var(--itd-body-size);
    font-weight: var(--itd-body-weight);
    line-height: var(--itd-body-lh);
    letter-spacing: var(--itd-body-ls);
  }

  .itd__body p{ margin: 0; }
  .itd__body p + p{ margin-top: var(--itd-par-gap); }

  .itd__body--top{ margin-bottom: var(--itd-par-gap); }

  .itd__divider-row{
    position: relative;
    margin-top: var(--itd-divider-mt);
    margin-bottom: var(--itd-divider-mb);
  }

  /* dotted rule */
  .itd__divider{
    height: var(--itd-divider-thickness);
    background:
      radial-gradient(circle, var(--itd-divider-color) var(--itd-divider-dot), transparent calc(var(--itd-divider-dot) + 0.5px))
      left center / calc(var(--itd-divider-dot) * 4) 100% repeat-x;
    opacity: 1;
  }

  /* centered X */
  .itd__x{
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: calc(var(--itd-x-size) + var(--itd-x-pad) * 2);
    height: calc(var(--itd-x-size) + var(--itd-x-pad) * 2);
    border-radius: var(--itd-x-radius);
    background: var(--itd-x-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .itd__x-svg{
    width: var(--itd-x-size);
    height: var(--itd-x-size);
  }
  .itd__x-svg path{
    stroke: var(--itd-x-color);
    stroke-width: var(--itd-x-stroke);
    stroke-linecap: round;
  }

  @media (max-width: 989px){
    .itd__grid{
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 749px){
    .itd__wrap--contained {
      padding:0px;
    }
    .itd{
      padding: var(--itd-pt-m) var(--itd-px-m) var(--itd-pb-m);
    }
    .itd__heading{
      font-size: var(--itd-head-size-m);
      margin-bottom: var(--itd-head-mb-m);
    }
    .itd__body{
      font-size: var(--itd-body-size-m);
    }
  }
  @media (max-width:1575px){
    .itd__grid {
        gap: calc(var(--itd-gap) / 2 );
    }
    .itd__heading {
        font-size: calc(var(--itd-head-size)/1.1);
    }
}


@media (max-width:1100px){
    .itd__grid {
        gap: calc(var(--itd-gap) / 3 );
    }
    .itd__heading {
        font-size: calc(var(--itd-head-size)/1.2);
    }
}

@media (max-width:768px){
    .itd__grid {
        gap: 10px;
    }
    .itd__heading {
        font-size: calc(var(--itd-head-size-m));
    }
}

</style>

{% schema %}
{
  "name": "Text divider",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "info": "When enabled, the section spans full viewport width (max-width is ignored).",
      "default": false
    },

    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Background color",
      "default": "#f6f1ea"
    },
    { "type": "range", "id": "section_max_width", "label": "Max width (px)", "min": 900, "max": 1800, "step": 10, "default": 1400, "info": "Ignored when Full width is enabled." },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "label": "Padding top desktop (px)",
      "default": 70
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "label": "Padding bottom desktop (px)",
      "default": 70
    },
    {
      "type": "range",
      "id": "section_padding_horizontal",
      "min": 0,
      "max": 140,
      "step": 5,
      "label": "Padding left/right desktop (px)",
      "default": 20,
      "info": "Ignored when Full width is enabled."
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "label": "Padding top mobile (px)",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "min": 0,
      "max": 150,
      "step": 5,
      "label": "Padding bottom mobile (px)",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_horizontal_mobile",
      "min": 0,
      "max": 80,
      "step": 5,
      "label": "Padding left/right mobile (px)",
      "default": 15,
      "info": "Ignored when Full width is enabled."
    },

    {
      "type": "header",
      "content": "Columns"
    },
    {
      "type": "range",
      "id": "left_col_width",
      "min": 20,
      "max": 70,
      "step": 1,
      "label": "Left column width (%)",
      "default": 38
    },
    {
      "type": "range",
      "id": "right_col_width",
      "min": 30,
      "max": 80,
      "step": 1,
      "label": "Right column width (%)",
      "default": 62
    },
    {
      "type": "range",
      "id": "columns_gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "label": "Columns gap (%)",
      "default": 20
    },

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Inspired by the Provencal Landscape"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 18,
      "max": 90,
      "step": 2,
      "label": "Heading size desktop (px)",
      "default": 56
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 16,
      "max": 56,
      "step": 2,
      "label": "Heading size mobile (px)",
      "default": 34
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Heading line height",
      "default": 1
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "min": -2,
      "max": 5,
      "step": 0.1,
      "label": "Heading letter spacing (px)",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "label": "Heading margin bottom desktop (px)",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "label": "Heading margin bottom mobile (px)",
      "default": 10
    },

    {
      "type": "header",
      "content": "Body text"
    },
    {
      "type": "richtext",
      "id": "body_top",
      "label": "Body top",
      "default": "<p>Provence Natural Hardwood brings the beauty of European White Oak to life with wide 10 and 7.5-inch planks, wire brush textures, and sawn veneers that can be refinished for generations.</p>"
    },
    {
      "type": "richtext",
      "id": "body_bottom",
      "label": "Body bottom",
      "default": "<p>Built on a stable, sustainable eucalyptus plywood core and finished in low-gloss tones of tans, honeys, and rich browns, it offers the authenticity of solid wood with greater durability. More than a floor, Provence is a timeless foundation, crafted to be cherished, renewed, and passed down.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body color",
      "default": "#5a5a5a"
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "min": 12,
      "max": 28,
      "step": 1,
      "label": "Body size desktop (px)",
      "default": 15
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "label": "Body size mobile (px)",
      "default": 14
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Body weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "body_line_height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "label": "Body line height",
      "default": 1
    },
    {
      "type": "range",
      "id": "body_letter_spacing",
      "min": -1,
      "max": 4,
      "step": 0.1,
      "label": "Body letter spacing (px)",
      "default": 0
    },
    {
      "type": "range",
      "id": "paragraph_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "label": "Paragraph spacing (px)",
      "default": 18
    }
  ],
  "presets": [
    {
      "name": "Text divider"
    }
  ]
}
{% endschema %}
