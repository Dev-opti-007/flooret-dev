<div class="before-after-slider">
    <div class="page-width">
        <div class="heading-wrap" >
            <h2>{{ section.settings.heading }}</h2>
            <div class="desc" >
                {{ section.settings.subtext }}
            </div>
        </div>
        <div class="slick-slider">
            {% for block in section.blocks %}
            <div class="slide" {{ block.shopify_attributes }} >
                <div class="before-after-container">
                    <div class="before-after ba-container">
                        <img class="after ba-image ba-base" src="{{ block.settings.after_image | img_url: 'master' }}" alt="After">
                        <span class="floating-text after-text">After</span>
                        <div class="before-wrapper ba-overlay">
                            <img class="before ba-image ba-gray" src="{{ block.settings.before_image | img_url: 'master' }}" alt="Before">
                             <span class="floating-text before-text">Before</span>
                        </div>
                        <div class="slider-handle ba-handle"></div>
                    </div>
                    {% if forloop.index == 1 %}
                    <span class="before-pointer before-pointer-one">
                      <span class="line" ><span></span></span>
                      <span class="pointer-text" >{{ block.settings.pointer-one-before }}</span>
                    </span>
                    <span class="before-pointer before-pointer-two">
                      <span class="line" ><span></span></span>
                      <span class="pointer-text" >{{ block.settings.pointer-two-before }}</span>
                    </span>
                    <span class="before-pointer before-pointer-three">
                      <span class="line" ><span></span></span>
                      <span class="pointer-text" >{{ block.settings.pointer-three-before }}</span>
                    </span>
                    <span class="after-pointer after-pointer-one">
                      <span class="line" ><span></span></span>
                      <span class="pointer-text" >{{ block.settings.pointer-one-after }}</span>
                    </span>
                    <span class="after-pointer after-pointer-two">
                      <span class="line" ><span></span></span>
                      <span class="pointer-text" >{{ block.settings.pointer-two-after }}</span>
                    </span>
                    <span class="after-pointer after-pointer-three">
                      <span class="line" ><span></span></span>
                      <span class="pointer-text" >{{ block.settings.pointer-three-after }}</span>
                    </span>
                  {% endif %}
                </div>
            </div>
            {% endfor %}
        </div>

        {% if  section.settings.btn-text != blank %}
          <a class="btn" href="{{ section.settings.btn-url }}" >
            {{ section.settings.btn-text }}
          </a>
        {% endif %}
    </div>
</div>

