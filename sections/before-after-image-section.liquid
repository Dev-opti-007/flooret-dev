<script>
  document.addEventListener('DOMContentLoaded', function() {
    const slickSlider = $('.before-after-slider .slick-slider');

    // Function to toggle pointer visibility based on overlay width
    function togglePointerVisibility(container, percentage) {
      const beforePointers = container.querySelectorAll('.before-pointer');
      const afterPointers = container.querySelectorAll('.after-pointer');
      
      if (percentage < 50) {
        // Hide before pointers, show after pointers
        beforePointers.forEach(pointer => pointer.style.opacity = '0');
        afterPointers.forEach(pointer => pointer.style.opacity = '1');
      } else {
        // Show before pointers, hide after pointers  
        beforePointers.forEach(pointer => pointer.style.opacity = '1');
        afterPointers.forEach(pointer => pointer.style.opacity = '0');
      }
    }

    // Initialize Before-After functionality with improved method
    function attachDragListeners(container) {
      const baContainer = container.querySelector('.ba-container');
      const overlay = baContainer.querySelector('.ba-overlay');
      const handle = baContainer.querySelector('.ba-handle');
      let dragging = false;

      // Set initial position and pointer visibility
      overlay.style.width = '50%';
      handle.style.left = '50%';
      togglePointerVisibility(container, 50); // Initial state

      // Mouse events
      handle.addEventListener('mousedown', (e) => {
        e.preventDefault();
        e.stopPropagation();
        dragging = true;
        handle.style.cursor = 'grabbing';
      });

      document.addEventListener('mouseup', () => {
        dragging = false;
        handle.style.cursor = 'grab';
      });

      document.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        e.preventDefault();
        e.stopPropagation();
        updateSlider(e);
      });

      // Touch events
      handle.addEventListener('touchstart', (e) => {
        e.stopPropagation();
        dragging = true;
      });

      document.addEventListener('touchend', () => {
        dragging = false;
      });

      document.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        e.preventDefault();
        e.stopPropagation();
        updateSlider(e.touches ? e.touches[0] : e);
      });

      function updateSlider(e) {
        const rect = baContainer.getBoundingClientRect();
        let x = (e.clientX || e.pageX) - rect.left;
        x = Math.max(0, Math.min(x, rect.width));
        const percentage = (x / rect.width) * 100;
        overlay.style.width = percentage + '%';
        handle.style.left = percentage + '%';
        
        // Toggle pointer visibility based on percentage
        togglePointerVisibility(container, percentage);
      }
    }

    // Initialize Slick Slider
    slickSlider.slick({
      dots: true,
      infinite: true,
      speed: 1000,
      slidesToShow: 1,
      adaptiveHeight: true,
      arrows: true,
      draggable: false,
      swipe: false,
      touchMove: false,
      swipeToSlide: false,
      touchThreshold: 1000,
      prevArrow: `<button class="slick-prev slick-arrow" aria-label="Previous" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="39" height="39" viewBox="0 0 39 39" fill="none"> <circle cx="19.5" cy="19.5" r="19.5" transform="matrix(-1 0 0 1 39 0)" fill="white"/> <path d="M22 15L17 20L22 25" stroke="black" stroke-width="2"/> </svg></button>`,
      nextArrow: `<button class="slick-next slick-arrow" aria-label="Next" type="button"><svg xmlns="http://www.w3.org/2000/svg" width="39" height="39" viewBox="0 0 39 39" fill="none"> <circle cx="19.5" cy="19.5" r="19.5" fill="white"/> <path d="M16.7289 14.8538L21.7289 19.8538L16.7289 24.8538" stroke="black" stroke-width="2"/> </svg></button>`,
      responsive: [
        {
          breakpoint: 768,
          settings: {
            draggable: false,
            swipe: false,
            touchMove: false,
            swipeToSlide: false,
            arrows: true,
            dots: true
          }
        }
      ]
    });

    // Prevent slider dragging on mobile
    function preventSliderDrag() {
      const sliderList = document.querySelector('.before-after-slider .slick-list');
      const sliderTrack = document.querySelector('.before-after-slider .slick-track');
      
      if (sliderList && sliderTrack && window.innerWidth <= 768) {
        sliderList.style.touchAction = 'none';
        sliderTrack.style.pointerEvents = 'none';
        
        const arrows = document.querySelectorAll('.before-after-slider .slick-arrow');
        const dots = document.querySelectorAll('.before-after-slider .slick-dots button');
        const beforeAfterContainers = document.querySelectorAll('.before-after-container');
        
        arrows.forEach(arrow => arrow.style.pointerEvents = 'auto');
        dots.forEach(dot => dot.style.pointerEvents = 'auto');
        beforeAfterContainers.forEach(container => container.style.pointerEvents = 'auto');
      }
    }

    // Attach listeners on init and after each slide change
    slickSlider.on('init afterChange', function(event, slick) {
      const containers = document.querySelectorAll('.before-after-container');
      containers.forEach(attachDragListeners);
      preventSliderDrag();
    });

    // Secondary trigger after full page load
    window.addEventListener('load', function() {
      const containers = document.querySelectorAll('.before-after-container');
      containers.forEach(attachDragListeners);
      preventSliderDrag();
    });

    window.addEventListener('resize', preventSliderDrag);
  });
</script>

<script>
  // Mobile pointer toggle functionality
  function initMobilePointerToggle() {
      document.addEventListener('click', function(event) {
        var clickedPointer = event.target.closest('span.before-pointer, span.after-pointer');
        var allSecondSpans = document.querySelectorAll('span.before-pointer > span:nth-child(2), span.after-pointer > span:nth-child(2)');
        
        allSecondSpans.forEach(function(span) {
          span.style.display = 'none';
        });
        
        if (clickedPointer) {
          var secondChild = clickedPointer.querySelector('span:nth-child(2)');
          if (secondChild) {
            secondChild.style.display = 'block';
          }
          event.stopPropagation();
        }
      });
  }

  document.addEventListener('DOMContentLoaded', initMobilePointerToggle);
  window.addEventListener('resize', function() {
    setTimeout(initMobilePointerToggle, 100);
  });
</script>

