{% comment %}
  Clickable card slider section
  - Whole card clickable only if block link exists
  - Slick slider based
  - Settings structure kept similar to attached section style
{% endcomment %}

{{ 'https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.css' | stylesheet_tag }}
{{ 'https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick-theme.min.css' | stylesheet_tag }}

<section class="clickable-card-slider clickable-card-slider--{{ section.id }}{% if section.settings.full_width %} full-width-section{% endif %}">
  <div class="clickable-card-slider__inner">
    {% if section.settings.heading != blank %}
      <div class="clickable-card-slider__header">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="clickable-card-slider__track js-card-slider-{{ section.id }}">
      {% for block in section.blocks %}
        {% assign has_link = false %}
        {% if block.settings.card_link != blank %}
          {% assign has_link = true %}
        {% endif %}

        <div class="clickable-card-slider__slide" {{ block.shopify_attributes }}>
          {% if has_link %}
            <a href="{{ block.settings.card_link }}" class="clickable-card-slider__card clickable-card-slider__card--linked">
          {% else %}
            <div class="clickable-card-slider__card">
          {% endif %}

              <div class="clickable-card-slider__media">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | image_url: width: block.settings.image_width | default: 1200 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                    width="auto"
                    height="auto"
                  >
                {% else %}
                  <div class="clickable-card-slider__placeholder">
                    <span>Add image</span>
                  </div>
                {% endif %}
              </div>

              {% if block.settings.title != blank %}
                <div class="clickable-card-slider__content">
                  <h3>{{ block.settings.title }}</h3>
                </div>
              {% endif %}

          {% if has_link %}
            </a>
          {% else %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_arrows %}
      <div class="clickable-card-slider__arrows">
        <button type="button" class="slider-arrow slider-arrow--prev slider-prev-{{ section.id }}" aria-label="Previous slide">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M11.667 5L6.667 10L11.667 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button type="button" class="slider-arrow slider-arrow--next slider-next-{{ section.id }}" aria-label="Next slide">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M8.333 5L13.333 10L8.333 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .clickable-card-slider--{{ section.id }} {
    width: 100%;
    background: {{ section.settings.section_bg_color }};
    {% unless section.settings.full_width %}
      max-width: {{ section.settings.section_max_width }}px;
      margin: 0 auto;
    {% endunless %}
    padding: {{ section.settings.section_padding_top }}px {% unless section.settings.full_width %}{{ section.settings.section_padding_horizontal }}px{% else %}0{% endunless %} {{ section.settings.section_padding_bottom }}px;
    overflow: hidden;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__inner {
    width: 83%;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__inner .clickable-card-slider__header {
    width: calc(100% + 17% );
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__header {
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
    text-align: {{ section.settings.alignment_desktop }};
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__header h2 {
    margin: 0;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: {{ section.settings.heading_weight }};
    line-height: {{ section.settings.heading_line_height }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    font-family: {{ section.settings.font_heading }};
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__track {
    margin-left: -{{ section.settings.card_gap_desktop | divided_by: 2.0 }}px;
    margin-right: -{{ section.settings.card_gap_desktop | divided_by: 2.0 }}px;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__slide {
    padding-left: {{ section.settings.card_gap_desktop | divided_by: 2.0 }}px;
    padding-right: {{ section.settings.card_gap_desktop | divided_by: 2.0 }}px;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__card {
    position: relative;
    display: block;
    text-decoration: none;
    overflow: hidden;
    border-radius: {{ section.settings.card_border_radius }}px;
    background: {{ section.settings.card_bg_color }};
    color: {{ section.settings.card_text_color }};
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__card--linked {
    cursor: pointer;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__media {
    position: relative;
    overflow: hidden;
    border-radius: {{ section.settings.card_border_radius }}px;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,{{ section.settings.overlay_opacity }}), rgba(0,0,0,0.05) 45%, rgba(0,0,0,0));
    pointer-events: none;
    z-index: 1;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__media img,
  .clickable-card-slider--{{ section.id }} .clickable-card-slider__placeholder {
    width: 100%;
    display: block;
    height: {{ section.settings.card_height_desktop }}px;
    object-fit: cover;
    border-radius: {{ section.settings.card_border_radius }}px;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e9e9e9;
    color: #555;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: {{ section.settings.content_bottom_desktop }}px;
    z-index: 2;
    padding-left: {{ section.settings.content_side_padding_desktop }}px;
    padding-right: {{ section.settings.content_side_padding_desktop }}px;
    text-align: {{ section.settings.card_text_alignment_desktop }};
    pointer-events: none;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__content h3 {
    margin: 0;
    color: {{ section.settings.card_text_color }};
    font-size: {{ section.settings.card_title_size_desktop }}px;
    font-weight: {{ section.settings.card_title_weight }};
    line-height: {{ section.settings.card_title_line_height }};
    letter-spacing: {{ section.settings.card_title_letter_spacing }}px;
    font-family: {{ section.settings.font_heading }};
  }

  .clickable-card-slider--{{ section.id }} .slick-list {
    overflow: visible;
  }

  .clickable-card-slider--{{ section.id }} .slick-track {
    display: flex !important;
  }

  .clickable-card-slider--{{ section.id }} .slick-slide {
    height: inherit !important;
  }

  .clickable-card-slider--{{ section.id }} .slick-slide > div {
    height: 100%;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__arrows {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: {{ section.settings.arrows_gap }}px;
    margin-top: {{ section.settings.arrows_margin_top }}px;
    width: calc(100% + 17% );
  }

  .clickable-card-slider--{{ section.id }} .slider-arrow {
    width: {{ section.settings.arrow_size }}px;
    height: {{ section.settings.arrow_size }}px;
    border-radius: 50%;
    border: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }

  .clickable-card-slider--{{ section.id }} .slider-arrow--prev {
    background: {{ section.settings.arrow_prev_bg }};
    color: {{ section.settings.arrow_prev_color }};
  }

  .clickable-card-slider--{{ section.id }} .slider-arrow--next {
    background: {{ section.settings.arrow_next_bg }};
    color: {{ section.settings.arrow_next_color }};
  }

  .clickable-card-slider--{{ section.id }} .slider-arrow.slick-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__card--linked:hover img {
    transform: scale({{ section.settings.image_hover_scale }});
  }

  .clickable-card-slider--{{ section.id }} .clickable-card-slider__media img {
    transition: transform 0.5s ease;
  }

  @media (max-width: 768px) {
    .clickable-card-slider--{{ section.id }} {
      padding: {{ section.settings.section_padding_top_mobile }}px {% unless section.settings.full_width %}{{ section.settings.section_padding_horizontal_mobile }}px{% else %}0{% endunless %} {{ section.settings.section_padding_bottom_mobile }}px;
    }

    .clickable-card-slider--{{ section.id }} .clickable-card-slider__header {
      margin-bottom: {{ section.settings.heading_margin_bottom_mobile }}px;
      text-align: {{ section.settings.alignment_mobile }};
    }

    .clickable-card-slider--{{ section.id }} .clickable-card-slider__header h2 {
      font-size: {{ section.settings.heading_size_mobile }}px;
      text-align: {{ section.settings.alignment_mobile }};
    }

    .clickable-card-slider--{{ section.id }} .clickable-card-slider__track {
      margin-left: -{{ section.settings.card_gap_mobile | divided_by: 2.0 }}px;
      margin-right: -{{ section.settings.card_gap_mobile | divided_by: 2.0 }}px;
    }

    .clickable-card-slider--{{ section.id }} .clickable-card-slider__slide {
      padding-left: {{ section.settings.card_gap_mobile | divided_by: 2.0 }}px;
      padding-right: {{ section.settings.card_gap_mobile | divided_by: 2.0 }}px;
    }

    .clickable-card-slider--{{ section.id }} .clickable-card-slider__media img,
    .clickable-card-slider--{{ section.id }} .clickable-card-slider__placeholder {
      height: {{ section.settings.card_height_mobile }}px;
    }

    .clickable-card-slider--{{ section.id }} .clickable-card-slider__content {
      bottom: {{ section.settings.content_bottom_mobile }}px;
      padding-left: {{ section.settings.content_side_padding_mobile }}px;
      padding-right: {{ section.settings.content_side_padding_mobile }}px;
      text-align: {{ section.settings.card_text_alignment_mobile }};
    }

    .clickable-card-slider--{{ section.id }} .clickable-card-slider__content h3 {
      font-size: {{ section.settings.card_title_size_mobile }}px;
      text-align: {{ section.settings.card_text_alignment_mobile }};
    }

    .clickable-card-slider--{{ section.id }} .clickable-card-slider__arrows {
      margin-top: {{ section.settings.arrows_margin_top_mobile }}px;
    }

    .clickable-card-slider--{{ section.id }} .slider-arrow {
      width: {{ section.settings.arrow_size_mobile }}px;
      height: {{ section.settings.arrow_size_mobile }}px;
    }
  }
</style>

<script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js" defer></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var sliderSelector = '.js-card-slider-{{ section.id }}';
    var prevArrow = '.slider-prev-{{ section.id }}';
    var nextArrow = '.slider-next-{{ section.id }}';

    function initSlider() {
      if (typeof window.jQuery === 'undefined' || typeof jQuery.fn.slick === 'undefined') {
        setTimeout(initSlider, 150);
        return;
      }

      var $slider = jQuery(sliderSelector);

      if ($slider.hasClass('slick-initialized')) return;

      $slider.slick({
        infinite: {{ section.settings.infinite_scroll }},
        slidesToShow: {{ section.settings.slides_to_show_desktop }},
        slidesToScroll: {{ section.settings.slides_to_scroll }},
        speed: {{ section.settings.slider_speed }},
        arrows: {{ section.settings.show_arrows }},
        dots: {{ section.settings.show_dots }},
        prevArrow: jQuery(prevArrow),
        nextArrow: jQuery(nextArrow),
        autoplay: {{ section.settings.autoplay }},
        autoplaySpeed: {{ section.settings.autoplay_speed }},
        centerMode: {{ section.settings.center_mode }},
        {% comment %} centerPadding:'50px', {% endcomment %}
        variableWidth: false,
        responsive: [
          {
            breakpoint: 990,
            settings: {
              slidesToShow: {{ section.settings.slides_to_show_tablet }},
              slidesToScroll: 1,
              {% comment %} centerPadding:'50px', {% endcomment %}
            }
          },
          {
            breakpoint: 768,
            settings: {
              slidesToShow: {{ section.settings.slides_to_show_mobile }},
              slidesToScroll: 1,
              {% comment %} centerPadding:'5px', {% endcomment %}
              initialSlide:0
            }
          }
        ]
      });
    }

    initSlider();
  });
</script>

