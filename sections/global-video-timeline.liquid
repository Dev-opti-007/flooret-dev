{% unless template contains "index" %}
  {{ 'custom-global-video.css' | asset_url | stylesheet_tag }}
{% endunless %}

<style>
  #shopify-section-{{ section.id }} .content-timeline__img img {
    border-radius: {{ section.settings.image_border_radius }}px;
  }
</style>

{%- liquid
  assign module = section.settings
  assign blocks = section.blocks
-%}
{%- capture text_color_styles -%}
  style="color: {{ module.text_color}}"
{%- endcapture -%}

{%- capture bg_color_styles -%}
  style="background-color: {{ module.bg_color}}"
{%- endcapture -%}

<div class="content-timeline-video" {{ text_color_styles }}>
  <div class="overlay" {{ bg_color_styles }}></div>

  <section class="content-timeline">
    <div class="container">
      <div class="row">
        {% if module.image != blank %}
          <div class="col col--left">
            <div class="content-timeline__img">
              {% render 'lazy-image', image: module.image, width: '600' %}
            </div>
          </div>
        {% endif %}
        <div class="col col--right">
          <div class="content-timeline__content">
            <h2>{{ module.heading }}</h2>
            <div class="content-timeline__timeline swiper">
              <div class="swiper-wrapper">
                {% for block in blocks %}
                  <div class="swiper-slide custom__swiper-{{ forloop.index }} {% if forloop.first %}active{% endif %}">
                    <div class="accordion-timeline js-accordion-timeline  {% if forloop.first %}active{% endif %}">
                      <button class="accordion-timeline__label js-accordion-timeline__trigger">
                        <span class="accordion-timeline__number">
                          {% if block.settings.icon != blank %}
                            {{ block.settings.icon | image_url: width: 18 | image_tag }}
                          {% else %}
                            {{ forloop.index }}
                          {% endif %}
                        </span>
                        <h5 class="accordion-timeline__heading">{{ block.settings.heading }}</h5>
                      </button>
                      {% if block.settings.content != blank %}
                        <div class="accordion-timeline__content js-accordion-timeline__content">
                          {{ block.settings.content }}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- if module.video != blank -%}
    <section class="video-content">
      <div class="container">
        <div class="row">
          <div class="col col--left">
            <div class="video-content__video">{{ module.video }}</div>
          </div>
          <div class="col col--right">
            <div class="video-content__content">
              <h2>{{ module.video_heading }}</h2>
              {{ module.video_content }}

              {%- if module.video_link_url != blank and module.video_link_text != blank -%}
                <a href="{{ module.video_link_url }}" class="btn btn--purple">{{ module.video_link_text }}</a>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Content Timeline + Video",
  "class": "content-timeline-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#343334"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Image Border Radius",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "contain_image",
      "label": "Contain Image",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub-heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "checkbox",
      "id": "row_reverse",
      "label": "Row Reverse",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "contain_video",
      "label": "Add container to video block",
      "default": false
    },
    {
      "type": "textarea",
      "id": "video",
      "label": "Video Iframe"
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "video_content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "video_link_text",
      "label": "Link Text"
    },
    {
      "type": "url",
      "id": "video_link_url",
      "label": "Link URL"
    }
  ],
  "blocks": [
    {
      "name": "Content Timeline",
      "type": "content-timeline",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Content Timeline + Video",
      "settings": {}
    }
  ]
}
{% endschema %}
