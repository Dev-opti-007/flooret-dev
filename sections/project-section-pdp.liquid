{% comment %}
  Complete Your Project Section
  A grid of cards showing accessories, services, or related products
{% endcomment %}

<style>
  .complete-project--{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    background: {{ section.settings.bg_color }};
  }
  .complete-project--{{ section.id }} .page-width {
    max-width:{{ section.settings.max-width }}px;
    margin:0px auto;
  }
  @media (max-width: 768px) {
    .complete-project--{{ section.id }} {
      padding-top: {{ section.settings.padding_top_mob }}px;
      padding-bottom: {{ section.settings.padding_bottom_mob }}px;
      padding-left: {{ section.settings.padding_left_mob }}px;
      padding-right: {{ section.settings.padding_right_mob }}px;
    }
  }

  .complete-project__heading {
    text-align: {{ section.settings.heading_align }};
    margin-bottom: 8px;
    color: {{ section.settings.heading_color }};
    font-family: {{ section.settings.heading_font }}, sans-serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
  }

  .complete-project__subheading {
    text-align: {{ section.settings.heading_align }};
    margin-bottom: 40px;
    color: {{ section.settings.subheading_color }};
    font-family: {{ section.settings.subheading_font }}, sans-serif;
    font-size: {{ section.settings.subheading_size }}px;
    font-weight: {{ section.settings.subheading_weight }};
  }

  @media (max-width: 768px) {
    .complete-project__heading {
      font-size: {{ section.settings.heading_size_mob }}px;
      margin-bottom: 4px;
    }
    .complete-project__subheading {
      font-size: {{ section.settings.subheading_size_mob }}px;
      margin-bottom: 24px;
    }
  }

  .complete-project__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ section.settings.card_gap }}px;
  }

  @media (max-width: 990px) {
    .complete-project__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .complete-project__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ section.settings.card_gap_mob }}px;
    }
  }

  .complete-project__card {
    background: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: box-shadow 0.3s ease;
    position:relative;
  }
  .complete-project__card .floating-linkwrap {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
  }

  {% if section.settings.card_shadow_enabled %}
  .complete-project__card:hover {
    box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  }
  {% endif %}

  .complete-project__media {
    position: relative;
    width: 100%;
    aspect-ratio: {{ section.settings.media_ratio }};
    overflow: hidden;
    background: {{ section.settings.media_bg_color }};
  }

  .complete-project__media img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.media_object_fit }};
    transition: transform 0.3s ease;
  }

  {% if section.settings.media_zoom_hover %}
  .complete-project__card:hover .complete-project__media img {
    transform: scale(1.05);
  }
  {% endif %}

  .complete-project__content {
    padding: {{ section.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  @media (max-width: 768px) {
    .complete-project__content {
      padding: {{ section.settings.card_padding_mob }}px;
    }
  }

  .complete-project__title {
    margin: 0 0 4px;
    color: {{ section.settings.card_title_color }};
    font-family: {{ section.settings.card_title_font }}, sans-serif;
    font-size: {{ section.settings.card_title_size }}px;
    font-weight: {{ section.settings.card_title_weight }};
  }

  @media (max-width: 768px) {
    .complete-project__title {
      font-size: {{ section.settings.card_title_size_mob }}px;
    }
  }

  .complete-project__desc {
    margin: 0 0 8px;
    color: {{ section.settings.card_desc_color }};
    font-family: {{ section.settings.card_desc_font }}, sans-serif;
    font-size: {{ section.settings.card_desc_size }}px;
    font-weight: {{ section.settings.card_desc_weight }};
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .complete-project__desc {
      font-size: {{ section.settings.card_desc_size_mob }}px;
    }
  }

  .complete-project__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
  }

  .complete-project__price {
    margin: 0;
    color: {{ section.settings.card_price_color }};
    font-family: {{ section.settings.card_price_font }}, sans-serif;
    font-size: {{ section.settings.card_price_size }}px;
    font-weight: {{ section.settings.card_price_weight }};
    text-decoration:none;
  }

  @media (max-width: 768px) {
    .complete-project__price {
      font-size: {{ section.settings.card_price_size_mob }}px;
    }
  }

  .complete-project__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: {{ section.settings.card_link_bg }};
    color: {{ section.settings.card_link_color }};
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .complete-project__link:hover {
    background: {{ section.settings.card_link_bg_hover }};
    color: {{ section.settings.card_link_color_hover }};
  }

  .complete-project__link svg {
    width: 20px;
    height: 20px;
  }
</style>

<section class="complete-project--{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="complete-project__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="complete-project__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="complete-project__grid">
      {% for block in section.blocks %}
        {% assign b = block.settings %}
        <article class="complete-project__card" {{ block.shopify_attributes }}>
          {% if b.link_url != blank %}
            <a href="{{ b.link_url }}" class="floating-linkwrap"></a>
          {% endif %}
          {% if b.image != blank %}
            <div class="complete-project__media">
              {{ b.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: b.title | default: 'Card image' }}
            </div>
          {% elsif b.placeholder_image %}
            <div class="complete-project__media">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}

          <div class="complete-project__content">
            {% if b.title != blank %}
              <h3 class="complete-project__title">{{ b.title }}</h3>
            {% endif %}

            {% if b.description != blank %}
              <p class="complete-project__desc">{{ b.description }}</p>
            {% endif %}

            <div class="complete-project__price-row">
              {% if b.price_label != blank %}
                <a href="{{ b.link_url }}" class="complete-project__price">{{ b.price_label }}</a>
              {% endif %}

            
                <a href="{{ b.link_url }}" class="complete-project__link" aria-label="{{ b.title | default: 'Learn more' }}">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                <path d="M4.16699 10H15.8337" stroke="#FAAF4F" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M10 4.1665L15.8333 9.99984L10 15.8332" stroke="#FAAF4F" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                </a>
            </div>

            
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

