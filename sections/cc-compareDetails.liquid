<section class="compare-details-section">

  <div class="page-width">

    <div class="compare-table-header">

      {% if section.settings.heading != blank %}
        <h2 class="compare-table-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="compare-table-subheading">
          {{ section.settings.subheading }}
        </div>
      {% endif %}

    </div>

    <div class="compare-table-wrapper">

      <div class="compare-table">

        <div class="compare-table-head">

          <div class="compare-feature-heading">
            FEATURE
          </div>

          <div class="compare-column compare-column-modin">
            {{ section.settings.column_1_title }}
          </div>

          <div class="compare-column compare-column-provence">
            {{ section.settings.column_2_title }}
          </div>

          <div class="compare-column compare-column-silvan">
            {{ section.settings.column_3_title }}
          </div>

          <div class="compare-column compare-column-arista">
            {{ section.settings.column_4_title }}
          </div>

        </div>

        {% for block in section.blocks %}

          <div class="compare-row" {{ block.shopify_attributes }}>

            <div class="compare-feature-cell">
              {{ block.settings.feature }}
            </div>

            <div class="compare-cell compare-cell-modin">
              {{ block.settings.value_1 }}
            </div>

            <div class="compare-cell compare-cell-provence">
              {{ block.settings.value_2 }}
            </div>

            <div class="compare-cell compare-cell-silvan">
              {{ block.settings.value_3 }}
            </div>

            <div class="compare-cell compare-cell-arista">
              {{ block.settings.value_4 }}
            </div>

          </div>

        {% endfor %}

      </div>

    </div>

  </div>

</section>

<style>
.compare-details-section{
  background:#F4F2EC;
  padding:80px 0;
}

.compare-table-header{
  display:flex;
  justify-content:space-around;
  align-items:flex-start;
  gap:60px;
  margin-bottom:70px;
}

.compare-table-heading{
  margin:0;
  width:50%;
  max-width:520px;
  font-size:40px;
  font-weight:500;
  line-height:1.2;
  color:#000000;
}

.compare-table-subheading{
  width:50%;
  max-width:430px;
  text-align:right;
  font-size:16px;
  font-weight:500;
  line-height:1.5;
  color:#4A5565;
}

.compare-table-wrapper{
  width:100%;
}

.compare-table{
  width:1261px;
  margin:0 auto;
}

.compare-table-head,
.compare-row{
  display:grid;
  grid-template-columns:
    minmax(200px,1fr)
    repeat(4,minmax(265px,1fr));
}

.compare-feature-heading{
  display:flex;
  align-items:center;
  padding:0 16px;
  height:86px;

  font-size:18px;
  font-weight:600;
  color:#4A5565;
  text-transform:uppercase;
}

.compare-column{
  height:86px;

  display:flex;
  align-items:center;
  justify-content:center;

  color:#FFFFFF;
  text-align:center;
  text-transform:uppercase;

  font-size:18px;
  font-weight:600;
  line-height:1.3;

  padding:16px;
}

.compare-column-modin{
  background:#313155;
}

.compare-column-provence{
  background:#643230;
}

.compare-column-silvan{
  background:#918055;
}

.compare-column-arista{
  background:#73929B;
}

.compare-feature-cell{
  min-height:56px;

  display:flex;
  align-items:center;

  padding:16px;

  border-bottom:1px solid #4A5565;

  font-size:16px;
  font-weight:400;
  color:#000000;

  background:#FFFFFF;
}

.compare-cell{
  min-height:56px;

  display:flex;
  align-items:center;
  justify-content:center;

  padding:16px;

  border-bottom:1px solid #4A5565;

  text-align:center;

  font-size:16px;
  font-weight:600;
  color:#000000;
}

.compare-cell-modin{
  background:#31315533;
}

.compare-cell-provence{
  background:#DAD0D0;
}

.compare-cell-silvan{
  background:#E7E5E0;
}

.compare-cell-arista{
  background:#73929B33;
}

@media screen and (max-width: 1260px) and (min-width: 750px){

  .compare-table-wrapper{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
  }

  .compare-table{
    width:1261px;
  }

}

@media screen and (max-width:749px){

  .compare-details-section{
    display:none;
  }

}
</style>

{% schema %}
{
  "name": "Compare Details Table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "column_1_title",
      "label": "Column 1 Title"
    },
    {
      "type": "text",
      "id": "column_2_title",
      "label": "Column 2 Title"
    },
    {
      "type": "text",
      "id": "column_3_title",
      "label": "Column 3 Title"
    },
    {
      "type": "text",
      "id": "column_4_title",
      "label": "Column 4 Title"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "Feature"
        },
        {
          "type": "text",
          "id": "value_1",
          "label": "Column 1 Value"
        },
        {
          "type": "text",
          "id": "value_2",
          "label": "Column 2 Value"
        },
        {
          "type": "text",
          "id": "value_3",
          "label": "Column 3 Value"
        },
        {
          "type": "text",
          "id": "value_4",
          "label": "Column 4 Value"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Compare Details Table",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}