{% assign _settings = section.settings %}

<section class="{% if _settings.contain_image %}contain-img{% endif %} {% if _settings.helper_classes %}{{ _settings.helper_classes }}{% endif %}" style="color: {{ _settings.text_color }};">
  <div class="overlay" style="background-color: {{ _settings.bg_color }};"></div>
  <div class="container">
    <div class="cta-row">
      <div class="cta-row__col">
        <div class="cta-content-wrap">
          {% if _settings.sub_heading != blank %}
            <span class="sub-heading h6">{{ _settings.sub_heading }}</span>
          {% endif %}

          {% if _settings.heading != blank %}
            <h2 class="h1">{{ _settings.heading }}</h2>
          {% endif %}

          {% if _settings.content != blank %}
            {{ _settings.content }}
          {% endif %}

          {% if _settings.link_text_1 != blank and _settings.link_url_1 != blank %}
            <a
              href="{{ _settings.link_url_1 }}"
              class="btn {% if _settings.text_color == "#ffffff" %}btn--white {% else %}btn--purple{% endif %}"
            >
              {{- _settings.link_text_1 -}}
            </a>
          {% endif %}

          {% if _settings.link_text_2 != blank and _settings.link_url_2 != blank %}
            <a
              href="{{ _settings.link_url_2 }}"
              class="btn btn--outline btn--outline-white {% if _settings.text_color == "#ffffff" %}btn--white{% endif %}"
            >
              {{- _settings.link_text_2 -}}
            </a>
          {% endif %}
  
        </div> <!-- /.cta-content-wrap -->
      </div>
      <div class="cta-row__col">
        {% if _settings.image != blank %}
          <div class="thumb">
            <div class="positioner">
              {% render 'lazy-image', image: _settings.image, width: '600' %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Two Column - CTA",
  "class": "shopify-block cta-block bg-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#343334"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "text",
      "id": "helper_classes",
      "label": "Helper Classes"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "contain_image",
      "label": "Contain Image",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub-heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "text",
      "id": "link_text_1",
      "label": "Link Text 1"
    },
    {
      "type": "url",
      "id": "link_url_1",
      "label": "Link URL 1"
    },
      {
      "type": "text",
      "id": "link_text_2",
      "label": "Link Text 2"
    },
    {
      "type": "url",
      "id": "link_url_2",
      "label": "Link URL 2"
    }

  ],
  "presets": [
    {
      "name": "Two Column - CTA",
      "category": "Content / CTA"
    }
  ]
}
{% endschema %}
