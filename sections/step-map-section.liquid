<style>
  .step-map-section-{{ section.id }} {
      padding-top:{{ section.settings.padding-top }}px;
      padding-bottom:{{ section.settings.padding-bottom }}px;
      padding-right: {{ section.settings.padding-right }}px;
      padding-left: {{ section.settings.padding-left }}px;
  }
  .step-map-section {
    background: #FFFFFF;
  }

  .step-map-section .heading h2 {
    font-family: {{  section.settings.font_heading }};
    font-weight: 700;
    font-style: Bold;
    font-size: {{  section.settings.heading_size_d }}px;
    line-height: 76px;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: middle;
    margin-bottom:20px;
    color:#111111;
  }

  .step-map-section .heading .desc {
      margin: 10px auto;
      text-align: center;
  }

  .step-map-section .heading .desc p {
      font-family: {{  section.settings.font_body }};
      font-weight: 400;
      font-style: Regular;
      font-size: {{  section.settings.subtext_size_d }}px;
      line-height: 100%;
      letter-spacing: 0%;
      vertical-align: middle;
  }

  .step-map-section .heading .desc p:before {
    content: none;
    color: #2D4A3A;
    position: relative;
    top: 4px;
  }

  .step-map-section .pointer {
    max-width: 300px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .step-map-section .pointer-wrap {
    display: flex;
    margin-top: 170px;
    position: relative;
  }

  .step-map-section .pointer .number {
    font-family: {{  section.settings.font_body }};
    font-weight: 700;
    font-size: {{  section.settings.bullet_size_d }}px;
    line-height: 100%;
    width: 140px;
    height: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #000000;
    border-radius: 50%;
    color:#fff;
  }

  .step-map-section .pointer:nth-child(3) .number {
    background: #000000;
  }

  .step-map-section .pointer:nth-child(4) .number {
    background: #000000;
  }

  .step-map-section .pointer:nth-child(5) .number {
    background: #000000;
  }

  .step-map-section .pointer:nth-child(2) img.img-pointer {
    width: 89px;
    left: -12px;
    position: relative;
  }

  .step-map-section .pointer:nth-child(3) {
    padding-top: 7%;
    position: relative;
  }

  .step-map-section .pointer:nth-child(4) {
    padding-top: 17%;
  }

  .step-map-section .pointer:nth-child(5) {
    padding-top: 28%;
  }

  .step-map-section img.img-pointer {
    width: 89px;
  }

  .step-map-section .pointer:nth-child(4) .text {
    padding: 0px 0px;
    display: block;
  }

  .step-map-section .text p {
    font-family: {{  section.settings.font_heading }};
    font-weight: 300;
    font-size: 18px;
    line-height: 29px;
    text-align: center;
    vertical-align: middle;
  }

  .step-map-section .text {
    max-width: 280px;
    margin-top: 10px;
  }

  .step-map-section img.bg-wrap {
    position: absolute;
    top: -13%;
    left: 11%;
    z-index: 0;
    width: 76%;
  }

  .step-map-section .m-wrap {
    text-align: center;
    margin-top: 15px;
  }

  .step-map-section .pointer:nth-child(3) .m-wrap {
    position: absolute;
    margin: 0px;
    top: 0;
    right: -65%;
  }

  .step-map-section .logos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 60px;
  }

  .step-map-section .logo:nth-child(3) img {
    max-width: 130px;
  }

  .step-map-section .page-width {
      max-width: 1280px;
      margin: auto;
      width: 100%;
      padding: 0px 30px;
  }

  .step-map-section .m-wrap h4 {
      margin: 0px;
      font-family: {{ section.settings.font_bullets }};
      font-weight: 800;
      font-size: 36px;
      line-height: 36px;
      letter-spacing: 0%;
      color:#111111;
      vertical-align: middle;
  }

  .bottom-text-area {
      max-width: 850px;
      margin: auto;
      text-align: center;
  }

  .bottom-text-area .bottom-text {
      font-family: {{ section.settings.font_body }};
      font-weight: 600;
      font-size: 24px;
      line-height: 31px;
      letter-spacing: 0%;
      text-align: center;
  }

  .bottom-text-area a.btn {
      background: #111;
      max-width: 300px;
      width: 100%;
      height: 60px;
      display: inline-flex;
  }
  .bottom-text-area a.btn:hover{
    background: #ffffff;
    color: #111;
  }

  /* Mobile Design */
  @media (max-width:767px) {
    .step-map-section-{{ section.id }} {
        padding-top:{{ section.settings.padding-top-m }}px;
        padding-bottom:{{ section.settings.padding-bottom-m }}px;
        padding-right: {{ section.settings.padding-right-m }}px;
        padding-left: {{ section.settings.padding-left-m }}px;
    }

    .bottom-text-area a.btn {
      width: 160px;
      height: 36px;
      font-family: {{  section.settings.font_body }};
      font-weight: 600;
      font-size: 13px;
      line-height: 100%;
      letter-spacing: 4%;
      vertical-align: middle;
      text-align: center;
    }

    .bottom-text-area a.btn:hover {
      background: #ffffff;
      color: #111;
    }

    .bottom-text-area .bottom-text {
      font-weight: 500;
      font-style: Medium;
      font-size: {{  section.settings.subtext_size_m }}px;
      line-height: 120%;
      letter-spacing: 0%;
      text-align: center;
    }

    .step-map-section .m-wrap h4 {
      font-weight: 800;
      font-style: ExtraBold;
      font-size: 14px;
      line-height: 100%;
      letter-spacing: 0%;
      text-align: center;
      vertical-align: middle;
    }

    .step-map-section .heading .desc p {
      font-weight: 400;
      font-size: {{  section.settings.subtext_size_m }}px;
      line-height: 100%;
      letter-spacing: 0%;
      text-align: center;
      vertical-align: middle;
    }

    .step-map-section img.bg-wrap {
      display: none;
    }

    .step-map-section .pointer-wrap {
      margin-top: 55px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      row-gap: 32px;
    }

    .step-map-section .pointer {
      padding-top: 0px !important;
      position: relative;
    }

    .step-map-section .pointer:nth-child(3) .m-wrap {
      position: relative;
      top: unset;
      right: unset;
    }

    .step-map-section .pointer .number {
      width: 80px;
      height: 80px;
      font-size: {{  section.settings.bullet_size_m }}px;
      line-height: 100%;
      letter-spacing: 0%;
    }

    .step-map-section img.img-pointer {
      width: 40px;
      height: 40px;
      object-fit: contain;
      left: 0px;
    }

    .step-map-section .pointer:nth-child(2) img.img-pointer {
      left: 0px;
    }

    .step-map-section .m-wrap {
      margin-top: 15px !important;
    }

    .step-map-section .heading h2 {
      font-weight: 700;
      font-style: Bold;
      font-size: {{  section.settings.heading_size_m }}px;
      line-height: 120%;
      letter-spacing: 0%;
      text-align: center;
      vertical-align: middle;
      margin-bottom: 30px;
    }

    .step-map-section .text p {
      font-weight: 300;
      font-style: Light;
      font-size: 12px;
      line-height: 100%;
      letter-spacing: 0%;
      text-align: center;
      vertical-align: middle;
    }

    .step-map-section .page-width {
      width: 100%;
      padding: 0px 10px;
    }

    .step-map-section {
      padding-top: 60px;
      padding-bottom: 60px !important;
    }

    .swiper-slide .main-wrap .content h2 span {
      display: block;
      white-space: break-spaces;
    }

    .step-map-section .logos {
      display: grid !important;
      grid-template-columns: repeat(5, 200px);
      overflow-y: auto;
    }

    .step-map-section .logos::-webkit-scrollbar {
      height: 2px;
    }


    .step-map-section .logos::-webkit-scrollbar-track {
      background: #e0e0e0;
      border-radius: 5px;
    }


    .step-map-section .logos::-webkit-scrollbar-thumb {
      background: #888;
      border-radius: 5px;
    }


    .step-map-section .logos::-webkit-scrollbar-thumb:hover {
      background: #555;
    }
  }

  /* Tablet: 768px to 1024px */
  @media (min-width: 768px) and (max-width: 1100px) {
    .step-map-section-{{ section.id }} {
        padding-top:{{ section.settings.padding-top-m }}px;
        padding-bottom:{{ section.settings.padding-bottom-m }}px;
        padding-right: {{ section.settings.padding-right-m }}px;
        padding-left: {{ section.settings.padding-left-m }}px;
    }
    .step-map-section .pointer:nth-child(3) .m-wrap {
        position: absolute;
        margin: 0px;
        top: -20%;
        right: -70%;
      }
      .step-map-section .pointer .number{
        width: 95px;
        height: 95px;
      }
      .step-map-section img.bg-wrap{
        top: -12%;
      }
      .step-map-section .heading h2{
        font-size: 45px;
      }
      .step-map-section .heading .desc p{
        font-size: 16px;
      }
      .step-map-section .m-wrap h4{
        font-size: 33px;
      }

  }
  @media (width: 768px){
    .step-map-section .pointer:nth-child(3) .m-wrap {
        position: absolute;
        margin: 0px;
        top: -20%;
        right: -110%;
    }
  }
  @media (width: 820px){
    .step-map-section .pointer:nth-child(3) .m-wrap {
        position: absolute;
        margin: 0px;
        top: -16%;
        right: -110%;
    }
  }
  @media (width: 1024px){
    .step-map-section .pointer:nth-child(3) .m-wrap {
        position: absolute;
        margin: 0px;
        top: -55px;
        right: -75%;
    }
  }
</style>

<div class="step-map-section step-map-section-{{ section.id }}">
  <div class="page-width">
    <div class="heading">
      <h2>{{ section.settings.heading }}</h2>
      <div class="desc">
        {{ section.settings['sub-text'] }}
      </div>
    </div>
    <div class="pointer-wrap">
      {% if section.blocks.size > 0 %}
        <img
          src="https://cdn.shopify.com/s/files/1/0698/3761/9475/files/Vector_2.png"
          class="bg-wrap"
          width="auto"
          height="auto"
        >
      {% endif %}
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'pointer' %}
            <div class="pointer">
              <span class="number">{{ block.settings.number }}</span>
              <div class="m-wrap">
                <img
                  src="{{ block.settings.image | image_url: width:100 }}"
                  alt="{{ block.settings.image.alt }}"
                  class="img-pointer"
                  width="auto"
                  height="auto"
                >
                <h4>{{ block.settings.title }}</h4>
                <div class="text">
                  {{ block.settings.subtext }}
                </div>
              </div>
            </div>
        {% endcase %}
      {% endfor %}
    </div>
    <div class="logos">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'imgae' %}
            <div class="logo">
              <img
                src="{{ block.settings.image-logo | image_url: width:250 }}"
                alt="{{ block.settings.image-logo.alt }}"
                width="auto"
                height="auto"
              >
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    {% if section.settings['btn-text'] != blank %}
      <div class="bottom-text-area">
        <div class="bottom-text">
          {{ section.settings['sub-text-btm'] }}
        </div>
        <a href="{{ section.settings.btn-url }}" class="btn">{{ section.settings['btn-text'] }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Step Map Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "sub-text",
      "label": "Sub Text"
    },
    {
      "type": "header",
      "content": "Bottom Content"
    },
    {
      "type": "richtext",
      "id": "sub-text-btm",
      "label": "Bottom Text"
    },
    {
      "type": "text",
      "id": "btn-text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "btn-url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_heading",
      "label": "Font Family Heading",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        },
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        }
      ],
      "default": "Montserrat"
    },
    {
      "type": "select",
      "id": "font_body",
      "label": "Font Family Body",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        },
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        }
      ],
      "default": "Montserrat"
    },
    {
      "type": "select",
      "id": "font_bullets",
      "label": "Font Family for Bullets",
      "options": [
        {
          "value": "Montserrat",
          "label": "Montserrat"
        },
        {
          "value": "Roboto",
          "label": "Roboto"
        },
        {
          "value": "Helvetica Neue",
          "label": "Helvetica Neue"
        },
        {
          "value": "Playfair Display",
          "label": "Playfair Display"
        }
      ],
      "default": "Playfair Display"
    },
    {
      "type": "range",
      "id": "heading_size_d",
      "label": "Heading size (desktop px)",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 42
    },
    {
      "type": "range",
      "id": "heading_size_m",
      "label": "Heading size (mobile px)",
      "min": 10,
      "max": 60,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "subtext_size_d",
      "label": "Subheading size (desktop px)",
      "min": 10,
      "max": 64,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "subtext_size_m",
      "label": "Subheading size (mobile px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "bullet_size_d",
      "label": "Bullet Text Size (desktop px)",
      "min": 10,
      "max": 64,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "bullet_size_m",
      "label": "Bullet Text Size (mobile px)",
      "min": 10,
      "max": 40,
      "step": 1,
      "default": 16
    },
    {
      "type": "header",
      "content": "Desktop Padding"
    },
    {
      "type": "range",
      "id": "padding-top",
      "min": 2,
      "max": 200,
      "step": 2,
      "label": "Padding Top",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding-bottom",
      "min": 2,
      "max": 200,
      "step": 2,
      "label": "Padding Bottom",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding-right",
      "min": 2,
      "max": 200,
      "step": 2,
      "label": "Padding Top Right",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding-left",
      "min": 2,
      "max": 200,
      "step": 2,
      "label": "Padding Bottom Left",
      "default": 2
    },
    {
      "type": "header",
      "content": "Mobile Padding"
    },
    {
      "type": "range",
      "id": "padding-top-m",
      "min": 2,
      "max": 200,
      "step": 2,
      "label": "Padding Top Mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding-bottom-m",
      "min": 2,
      "max": 200,
      "step": 2,
      "label": "Padding Bottom Mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding-right-m",
      "min": 2,
      "max": 200,
      "step": 2,
      "label": "Padding Top Right",
      "default": 2
    },
    {
      "type": "range",
      "id": "padding-left-m",
      "min": 2,
      "max": 200,
      "step": 2,
      "label": "Padding Bottom Left",
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "pointer",
      "name": "Pointer",
      "settings": [
        {
          "type": "number",
          "id": "number",
          "label": "Number"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image/Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "title"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext"
        }
      ]
    },
    {
      "type": "imgae",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image-logo",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Step Map Section"
    }
  ]
}
{% endschema %}
