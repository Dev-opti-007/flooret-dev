{%- liquid
  assign module = section.settings
  assign meta = product.metafields.flooret

  assign feat_products_heading = meta.product_featured_products_heading.value
  assign feat_products = meta.product_featured_products.value
-%}
{%- unless feat_products == blank -%}
  <section class="featprods">
    <div class="container">
      <div class="section__header">
        {%- if feat_products_heading != blank -%}
          <h2>{{ feat_products_heading }}</h2>
        {%- endif -%}
      </div>
      <div class="section__content swiper you-may-like">
        <div class="swiper-wrapper">
          {%- for prod in feat_products -%}
            <div class="swiper-slide">
              {%- render 'product-feat-card', product: prod -%}
            </div>
          {%- endfor -%}
        </div>

        <div class="swiper-controls">
          <button class="swiper-button-prev" type="button"></button>
          <div class="swiper-scrollbar"></div>
          <button class="swiper-button-next" type="button"></button>
        </div>
      </div>
    </div>
  </section>
{%- endunless -%}


<script>
  document.addEventListener('DOMContentLoaded', () => {
    var swiper = new Swiper('.you-may-like', {
      slidesPerView: 1,  // Shows partial next slide
      spaceBetween: 16,
      
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
      scrollbar: {
        el: '.swiper-scrollbar',
      },
      breakpoints: {
        // Mobile
        480: {
          slidesPerView: 1,
          spaceBetween: 16,
        },
        // Tablet
        768: {
          slidesPerView: 1,
          spaceBetween: 16,
        },
        // Desktop
        1024: {
          slidesPerView: 3,
          spaceBetween: 16,
        },
      },
    });
  });

</script>

