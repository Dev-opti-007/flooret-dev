{%- style -%}
  .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
          padding-top: {{ section.settings.padding_top }}px;
          padding-bottom: {{ section.settings.padding_bottom }}px;
      }
  }
  body {
    background-color: unset;
  }
  .tabs .tabcontent {
    display: none;
  }
  .tabs .tablinks {
    border-radius: 8px;
    padding: 8px;
    font-size: 14px;
    font-weight: 700;
    color: #313158;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tabs .tablinks.active {
    background: #fff6f3;
    color: #faaf4f;
  }
  .tabs .tablinks.active svg path {
    fill: #faaf4f;
  }
  .tabs .tab {
    display: flex;
    padding-bottom: 8px;
    border-bottom: 1px solid #cecece;
    margin-bottom: 56px;
  }
  .tabs .content p em {
    color: #717171;
    font-size: 14px;
  }
  .tabs .flex-2 {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  @media (min-width: 960px) {
    .tabs .flex-2 {
      flex-direction: row;
    }
    .tabs .flex-2 .content {
      max-width: 534px;
    }
  }
  .tabs .custom-html {
    width: 100%;
  }
  .tabs .custom-html p {
    font-weight: 600;
    width: 100%;
    margin-bottom: 48px;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="tab">
    {% for block in section.blocks %}
      <div
        class="tablinks"
        onclick="openTab(event, 'item{{forloop.index}}')"
        id="defaultOpen"
      >
        {% if block.settings.image != blank %}
          {{ block.settings.image }}
        {% endif %}
        {% if block.settings.title != blank %}
          {{ block.settings.title }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
  {% for block in section.blocks %}
    <div
      id="item{{forloop.index}}"
      class="tabcontent {% if block.settings.text != blank and block.settings.custom_html != blank %}flex-2{% endif %}"
    >
      {% if block.settings.text != blank %}
        <div class="content">
          {{ block.settings.text }}
        </div>
      {% endif %}
      {% if block.settings.custom_html %}
        <div class="custom-html">
          {{ block.settings.custom_html }}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>

<script>
  function openTab(evt, collectionName) {
    var i, tabcontent, tablinks;
    tabcontent = document.getElementsByClassName('tabcontent');
    for (i = 0; i < tabcontent.length; i++) {
      tabcontent[i].style.display = 'none';
    }
    tablinks = document.getElementsByClassName('tablinks');
    for (i = 0; i < tablinks.length; i++) {
      tablinks[i].className = tablinks[i].className.replace(' active', '');
    }
    document.getElementById(collectionName).style.display = 'flex';
    evt.currentTarget.className += ' active';
  }
  if (document.getElementById('defaultOpen')) document.getElementById('defaultOpen').click();
</script>

{% schema %}
{
  "name": "Custom tabs",
  "class": "container container--large tabs",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Padding desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    },
    {
      "type": "header",
      "content": "Padding mobile"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ],
  "blocks": [
    {
      "limit": 2,
      "type": "text",
      "name": "Tabs",
      "settings": [
        {
          "type": "html",
          "id": "image",
          "label": "Icon svg"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Tab title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tab content"
        },
        {
          "type": "html",
          "id": "custom_html",
          "label": "Custom HTML"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom tabs"
    }
  ]
}
{% endschema %}
