<script>
  document.addEventListener('DOMContentLoaded', function() {
   const scrollContainers = document.querySelectorAll('.grid-loop-scroll-product');

    function updateButtons(container) {
      const wrapper = container.closest('[data-scroll-wrapper]') || container.parentElement;
      const prevBtn = wrapper.querySelector('.scroll-btn.scroll-prev');
      const nextBtn = wrapper.querySelector('.scroll-btn.scroll-next');

      const atStart = container.scrollLeft <= 2; // 2px tolerance
      const atEnd = container.scrollLeft + container.offsetWidth >= container.scrollWidth - 2;

      if (prevBtn) {
        prevBtn.disabled = atStart;
        prevBtn.setAttribute('aria-disabled', atStart ? 'true' : 'false');
        prevBtn.classList.toggle('is-hidden', atStart); // optional: hide instead of disable
      }

      if (nextBtn) {
        nextBtn.disabled = atEnd;
        nextBtn.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
        nextBtn.classList.toggle('is-hidden', atEnd);
      }
    }

    scrollContainers.forEach(container => {
      // Update on scroll (covers thumb drag too)
      container.addEventListener('scroll', () => updateButtons(container), { passive: true });

      // Initial state on load
      updateButtons(container);
    });

    document.querySelectorAll('.scroll-btn').forEach(btn => {
      btn.addEventListener('click', function () {
        if (this.disabled) return; // Guard against clicks while disabled

        const targetSelector = this.dataset.target;
        const target = document.querySelector(targetSelector);
        if (!target) return;

        const scrollAmount = target.offsetWidth * 0.8;

        target.scrollBy({
          left: this.classList.contains('scroll-prev') ? -scrollAmount : scrollAmount,
          behavior: 'smooth',
        });
      });
    });
    
    // Auto-hide buttons based on scroll position
    scrollContainers.forEach(container => {
      const observer = new IntersectionObserver((entries) => {
        const prevBtn = document.querySelector(`[data-target="${container.className.split(' ')[0]}"] + .scroll-prev`);
        const nextBtn = document.querySelector(`[data-target="${container.className.split(' ')[0]}"] + .scroll-next`);
        
        if (container.scrollLeft === 0) {
          prevBtn.style.opacity = '0.3';
          prevBtn.disabled = true;
        } else {
          prevBtn.style.opacity = '1';
          prevBtn.disabled = false;
        }
        
        if (container.scrollLeft + container.clientWidth >= container.scrollWidth - 1) {
          nextBtn.style.opacity = '0.3';
          nextBtn.disabled = true;
        } else {
          nextBtn.style.opacity = '1';
          nextBtn.disabled = false;
        }
      });
      
      observer.observe(container);
    });
  });

</script>

