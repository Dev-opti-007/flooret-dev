{%- liquid
  assign module = section.settings
  assign page_url = request.path

  assign meta = collection.metafields.flooret
  assign collection_hero_background_color = meta.collection_hero_background_color
  assign collection_hero_text_color = meta.collection_hero_text_color
-%}

{%- capture section_styles -%}style="
  {%- if collection_hero_background_color != blank and collection_hero_background_color != 'rgba(0,0,0,0)' -%}background-color: {{collection_hero_background_color}};{%- endif -%}
  {%- if collection_hero_text_color != blank and collection_hero_text_color != 'rgba(0,0,0,0)' -%}color: {{collection_hero_text_color}};{%- endif -%}
  {% comment %} background-image:url('{{ collection.image | image_url: width: 2000 }}'); {% endcomment %}
  "
{%- endcapture -%}

{{ 'custom-collection-design.css' | asset_url | stylesheet_tag }}
{% render 'collection-banner', collection: collection, settings: section.settings %}



  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'promo_savings_bar' %}
        {% comment %} {% assign sid = section.id %}
        {% assign bid = block.id %}

        <div class="promo-savings-bar promo-savings-bar--{{ sid }}-{{ bid }}" {{ block.shopify_attributes }}>
          <div class="promo-savings-bar__inner">
            <div class="promo-savings-bar__left">
              {% if block.settings.eyebrow != blank %}
                <div class="promo-savings-bar__eyebrow">{{ block.settings.eyebrow }}</div>
              {% endif %}

              {% if block.settings.heading != blank %}
                <{{ block.settings.heading_tag }} class="promo-savings-bar__heading">
                  {{ block.settings.heading }}
                </{{ block.settings.heading_tag }}>
              {% endif %}
            </div>

            <div class="promo-savings-bar__right">
              {% if block.settings.offer_1_amount != blank or block.settings.offer_1_title != blank or block.settings.offer_1_subtitle != blank %}
                <div class="promo-savings-bar__offer">
                  {% if block.settings.offer_1_amount != blank %}
                    <div class="promo-savings-bar__amount">{{ block.settings.offer_1_amount }}</div>
                  {% endif %}
                  {% if block.settings.offer_1_title != blank %}
                    <div class="promo-savings-bar__title">{{ block.settings.offer_1_title }}</div>
                  {% endif %}
                  {% if block.settings.offer_1_subtitle != blank %}
                    <div class="promo-savings-bar__pill">{{ block.settings.offer_1_subtitle }}</div>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.offer_2_amount != blank or block.settings.offer_2_title != blank or block.settings.offer_2_subtitle != blank %}
                <div class="promo-savings-bar__offer">
                  {% if block.settings.offer_2_amount != blank %}
                    <div class="promo-savings-bar__amount">{{ block.settings.offer_2_amount }}</div>
                  {% endif %}
                  {% if block.settings.offer_2_title != blank %}
                    <div class="promo-savings-bar__title">{{ block.settings.offer_2_title }}</div>
                  {% endif %}
                  {% if block.settings.offer_2_subtitle != blank %}
                    <div class="promo-savings-bar__pill">{{ block.settings.offer_2_subtitle }}</div>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.offer_3_amount != blank or block.settings.offer_3_title != blank or block.settings.offer_3_subtitle != blank %}
                <div class="promo-savings-bar__offer">
                  {% if block.settings.offer_3_amount != blank %}
                    <div class="promo-savings-bar__amount">{{ block.settings.offer_3_amount }}</div>
                  {% endif %}
                  {% if block.settings.offer_3_title != blank %}
                    <div class="promo-savings-bar__title">{{ block.settings.offer_3_title }}</div>
                  {% endif %}
                  {% if block.settings.offer_3_subtitle != blank %}
                    <div class="promo-savings-bar__pill">{{ block.settings.offer_3_subtitle }}</div>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </div>
        </div> {% endcomment %}
        {% assign sid = section.id %}
        {% assign bid = block.id %}

        <div class="promo-savings-bar promo-savings-bar--{{ sid }}-{{ bid }}" {{ block.shopify_attributes }}>
          <div class="promo-savings-bar__inner">
            
            <div class="promo-savings-bar__col promo-savings-bar__col--left">
              {% if block.settings.eyebrow != blank %}
                <div class="promo-savings-bar__eyebrow">{{ block.settings.eyebrow }}</div>
              {% endif %}

              {% if block.settings.heading != blank %}
                <{{ block.settings.heading_tag }} class="promo-savings-bar__heading">
                  {{ block.settings.heading }}
                </{{ block.settings.heading_tag }}>
              {% endif %}
            </div>

            <div class="promo-savings-bar__col promo-savings-bar__col--center">
              {% if block.settings.offer_1_amount != blank %}
                <div class="promo-savings-bar__highlight">
                  <div class="promo-savings-bar__highlight-amount">{{ block.settings.offer_1_amount }}</div>
                  {% if block.settings.offer_1_title != blank %}
                    <div class="promo-savings-bar__highlight-subtext">{{ block.settings.offer_1_title }}</div>
                  {% endif %}
                  <div class="promo-savings-bar__highlight-amount-mob-only">{{ block.settings.offer_1_amount }} {{ block.settings.offer_1_title }}</div>
                </div>
              {% endif %}
            </div>

            <div class="promo-savings-bar__col promo-savings-bar__col--right">
              {% if block.settings.offer_2_amount != blank %}
                <div class="promo-savings-bar__shipping-title">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 60" fill="none" stroke="#333" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="
                        width: 75px;
                        height: 75px;
                    ">
                      <!-- Speed lines (behind truck, on the left) -->
                      <line x1="4" y1="26" x2="18" y2="26"></line>
                      <line x1="8" y1="33" x2="18" y2="33"></line>

                      <!-- Cargo box body -->
                      <rect x="18" y="12" width="42" height="28" rx="1"></rect>

                      <!-- Cab (right side, truck faces right) -->
                      <path d="M60 22 L60 40 L80 40 L80 30 L74 22 Z"></path>

                      <!-- Cab window -->
                      <path d="M63 24 L63 31 L74 31 L74 24 Z" rx="1"></path>

                      <!-- Connector between cab and body -->
                      <line x1="60" y1="40" x2="18" y2="40"></line>

                      <!-- Rear wheel (under cargo box) -->
                      <circle cx="32" cy="43" r="6"></circle>
                      <circle cx="32" cy="43" r="2"></circle>

                      <!-- Front wheel (under cab) -->
                      <circle cx="68" cy="43" r="6"></circle>
                      <circle cx="68" cy="43" r="2"></circle>

                      <!-- Ground line under wheels -->
                      <line x1="18" y1="49" x2="82" y2="49"></line>
                    </svg>
                    <span>{{ block.settings.offer_2_amount }}</span></div>
              {% endif %}
              {% if block.settings.offer_2_title != blank %}
                <div class="promo-savings-bar__shipping-subtext">{{ block.settings.offer_2_title }}</div>
              {% endif %}
            </div>

          </div>
        </div>
        <style>
          .promo-savings-bar__highlight-amount-mob-only {
              display: none;
          }
          .promo-savings-bar--{{ sid }}-{{ bid }} {
            width: 100%;
            background: #f3f0eb;
            border-top: 1px solid rgba(255,255,255,0.08);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding: 0;
            overflow: hidden;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__inner {
            max-width: 1280px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 0.5fr  1fr;
            align-items: stretch;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__col {
            min-height: 100px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 17.01px 32px;
            position: relative;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__col--left,
          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__col--center {
            border-right: 1px solid #E5E7EB;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__eyebrow {
            color: #111111;
            font-size: 12px;
            line-height: 1.2;
            letter-spacing: 2px;
            text-transform: uppercase;
            font-weight: 600;
            margin-bottom: 8px;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__heading {
            margin: 0;
            color: #111;
            font-family: Playfair Display;
            font-size: 36px;
            line-height:40px;
            line-height: 1.1;
            font-weight: 700;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__col--center {
            align-items: center;
            display:none;
          }

          {% comment %} .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__highlight {
            min-width: 316px;
            padding: 8px 28px;
            border: 1px solid rgba(255,255,255,0.18);
            border-radius: 14px;
            background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
            text-align: center;
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
          } {% endcomment %}

          .promo-savings-bar__highlight {
            position: relative;
            min-width: 316px;
            padding: 8px 28px;
            border-radius: 16px;
            background: linear-gradient(180deg, #141414 0%, #101010 100%);
            text-align: center;
            overflow: hidden;

            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), inset 0 -1px 0 rgba(255, 255, 255, 0.7), inset 0 12px 24px rgba(255, 255, 255, 0.015), 0 0 0 1px rgba(255, 255, 255, 0.03), 0 10px 24px rgba(0, 0, 0, 0);
          }

          .promo-savings-bar__highlight::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            pointer-events: none;
            background:
              linear-gradient(to right,
                rgba(255,255,255,0) 0%,
                rgba(255,255,255,0.24) 18%,
                rgba(255,255,255,0.24) 82%,
                rgba(255,255,255,0) 100%) top / 100% 1px no-repeat,
              linear-gradient(to right,
                rgba(255,255,255,0) 0%,
                rgba(255,255,255,0.16) 18%,
                rgba(255,255,255,0.16) 82%,
                rgba(255,255,255,0) 100%) bottom / 100% 1px no-repeat;
          }

          .promo-savings-bar__highlight::after {
            content: "";
            position: absolute;
            inset: 1px;
            border-radius: inherit;
            pointer-events: none;
            box-shadow:
              inset 0 18px 30px rgba(255,255,255,0.02),
              inset 0 -10px 20px rgba(255,255,255,0.01);
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__highlight-amount {
            color: #F59E0B;
            font-size: 32px;
            line-height: 28px;
            font-weight: 800;
            text-transform: uppercase;
            margin-bottom: 4px;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__highlight-subtext {
            color: rgba(255, 255, 255, 1);
            font-size: 24px;
            line-height: 28px;
            font-weight: 600;
            text-transform: uppercase;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__shipping-title {
            color: #ffffff;
            font-size: 24px;
            line-height: 20px;
            font-weight: 600;
            text-transform: uppercase;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            color: #111;
            font-weight: 100;
            justify-content: center;
            font-size: 35px;
          }

          .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__shipping-subtext {
            color: rgba(255,255,255,1);
            font-size: 16px;
            line-height: 16px;
            font-weight: 400;
          }
          .promo-savings-bar__col.promo-savings-bar__col--right {
              padding-left: 80px;
          }
            .promo-savings-bar__shipping-title span {
                line-height: 1.1;
            }
          @media screen and (max-width: 767px) {
            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__shipping-title {
              display:unset;
            }
             .promo-savings-bar__shipping-title svg {
              width: 50px !important;
              height: 50px !important;
              display: inline-block;
              margin-top: 10px;
              margin-right: -4px;
            }
            .promo-savings-bar__shipping-title > span {
                display: inline-block;
                width: calc(100% - 162px);
            }
            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__inner {
              grid-template-columns: 1fr;
            }

            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__col {
              min-height: auto;
              padding: 13.75px 16px;
              text-align: center;
              align-items: center;
            }

            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__col--left,
            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__col--center {
              border-right: none;
              {% comment %} border-bottom: 1px solid rgba(255,255,255,0.14); {% endcomment %}
            }
            .promo-savings-bar__col.promo-savings-bar__col--left {
                padding-bottom: 0px;
            }

            .promo-savings-bar__col.promo-savings-bar__col--right {
                padding-top: 0px;
            }
            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__heading {
              font-size: 24px;
              line-height:32px;
            }

            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__highlight {
                      max-width: 248px !important;
                      max-width: 248px !important;
                width: 100%;
                padding: 0px 10px;
                min-height: 43px;
                display: flex;
                align-items: center;
                justify-content: center;
                min-width: unset;
            }

            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__highlight-amount {
              font-size: 24px;
            }

            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__highlight-subtext,
            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__shipping-subtext {
              font-size: 16px;
            }

            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__shipping-title {
              font-size: 18px;
              line-height:20px;
            }
            .promo-savings-bar__highlight-amount,
            .promo-savings-bar__shipping-subtext,
            .promo-savings-bar__highlight-subtext {
                display: none;
            }
            .promo-savings-bar__highlight-amount-mob-only {
                display: block;
            }
            .promo-savings-bar__highlight-amount-mob-only {
                font-family: Montserrat;
                font-weight: 600;
                font-style: SemiBold;
                font-size: 20px;
                leading-trim: NONE;
                line-height: 32px;
                letter-spacing: -0.75px;
                text-align: center;
                vertical-align: middle;
                color: rgba(245, 158, 11, 1);
            }
            .promo-savings-bar--{{ sid }}-{{ bid }} .promo-savings-bar__eyebrow { 
              font-size:10px;
            }
          }
        </style>
    {% endcase %}
  {% endfor %}


