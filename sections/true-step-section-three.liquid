{% comment %}
  Stair Type Selector Section
  Two block types:
  — stair_card  : the selector card (image + title + desc)
  — result_card : product result row (label + 2 products), linked to a stair_card via data-card-index
  Both blocks carry {{ block.shopify_attributes }} so they are fully editable in the customizer.
{% endcomment %}

<section class="sts sts--{{ section.id }}{% if section.settings.full_width %} sts--full-width{% endif %}">

  {%- comment -%} ══ HEADER ROW ══ {%- endcomment -%}
  <div class="sts__header">
    <div class="sts__header-left">
      {%- if section.settings.step_number != blank -%}
        <span class="sts__step-number" aria-hidden="true">{{ section.settings.step_number }}</span>
      {%- endif -%}
      <div class="sts__header-meta">
        {%- if section.settings.step_label != blank -%}
          <p class="sts__step-label">{{ section.settings.step_label }}</p>
        {%- endif -%}
        {%- if section.settings.section_title != blank -%}
          <h2 class="sts__title">{{ section.settings.section_title }}</h2>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.header_description != blank -%}
      <div class="sts__header-right">
        <p class="sts__header-desc">{{ section.settings.header_description }}</p>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%} ══ STAIR TYPE CARDS GRID ══ {%- endcomment -%}
  <div class="sts__grid" role="radiogroup" aria-label="Select your stair type">
    {%- assign card_i = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'stair_card' -%}
        <button
          class="sts__card{% if card_i == 0 %} is-selected{% endif %}"
          role="radio"
          aria-checked="{% if card_i == 0 %}true{% else %}false{% endif %}"
          data-card-index="{{ card_i }}"
          type="button"
          {{ block.shopify_attributes }}>

          <span class="sts__card-check" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8l3.5 3.5L13 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>

          <div class="sts__card-img">
            {%- if block.settings.card_image != blank -%}
              <img
                src="{{ block.settings.card_image | image_url: width: 500 }}"
                alt="{{ block.settings.card_image.alt | default: block.settings.card_title | escape }}"
                loading="lazy" width="500" height="220">
            {%- elsif block.settings.card_svg != blank -%}
              <div class="sts__card-svg">{{ block.settings.card_svg }}</div>
            {%- else -%}
              <div class="sts__card-img-placeholder"></div>
            {%- endif -%}
          </div>

          <div class="sts__card-body">
            {%- if block.settings.card_title != blank -%}
              <p class="sts__card-title">{{ block.settings.card_title }}</p>
            {%- endif -%}
            {%- if block.settings.card_desc != blank -%}
              <p class="sts__card-desc">{{ block.settings.card_desc }}</p>
            {%- endif -%}
          </div>

        </button>
        {%- assign card_i = card_i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} ══ PRODUCT RESULTS ══ {%- endcomment -%}
  <div class="sts__results" id="sts-results-{{ section.id }}">

    {%- assign result_i = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'result_card' -%}

        <div
          class="sts__result-group{% if result_i == 0 %} is-active{% endif %}"
          data-result-index="{{ result_i }}"
          {% unless result_i == 0 %}style="display:none"{% endunless %}
          {{ block.shopify_attributes }}>

          {%- if block.settings.result_label != blank -%}
            <p class="sts__result-label">{{ block.settings.result_label }}</p>
          {%- endif -%}

          <div class="sts__product-cards">

            {%- comment -%} Product 1 {%- endcomment -%}
            {%- if block.settings.prod1_title != blank -%}
              <a class="sts__product-card" href="{{ block.settings.prod1_url }}" aria-label="{{ block.settings.prod1_title | escape }}">
                <div class="sts__product-img">
                  {%- if block.settings.prod1_image != blank -%}
                    <img
                      src="{{ block.settings.prod1_image | image_url: width: 400 }}"
                      alt="{{ block.settings.prod1_image.alt | default: block.settings.prod1_title | escape }}"
                      loading="lazy" width="400" height="260">
                  {%- else -%}
                    <div class="sts__product-img-placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="sts__product-info">
                  <div class="sts__product-text">
                    {%- if block.settings.prod1_badge != blank -%}
                      <span class="sts__product-badge">{{ block.settings.prod1_badge }}</span>
                    {%- endif -%}
                    <p class="sts__product-title">{{ block.settings.prod1_title }}</p>
                    {%- if block.settings.prod1_subtitle != blank -%}
                      <p class="sts__product-subtitle">{{ block.settings.prod1_subtitle }}</p>
                    {%- endif -%}
                  </div>
                  <span class="sts__product-arrow" aria-hidden="true">
                                      <svg xmlns="http://www.w3.org/2000/svg" width="13" height="22" viewBox="0 0 13 22" fill="none">
                    <path d="M2 19.5L10.75 10.75L2 2" stroke="#FAAF4F" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </a>
            {%- endif -%}

            {%- comment -%} Product 2 {%- endcomment -%}
            {%- if block.settings.prod2_title != blank -%}
              <a class="sts__product-card" href="{{ block.settings.prod2_url }}" aria-label="{{ block.settings.prod2_title | escape }}">
                <div class="sts__product-img">
                  {%- if block.settings.prod2_image != blank -%}
                    <img
                      src="{{ block.settings.prod2_image | image_url: width: 400 }}"
                      alt="{{ block.settings.prod2_image.alt | default: block.settings.prod2_title | escape }}"
                      loading="lazy" width="400" height="260">
                  {%- else -%}
                    <div class="sts__product-img-placeholder"></div>
                  {%- endif -%}
                </div>
                <div class="sts__product-info">
                  <div class="sts__product-text">
                    {%- if block.settings.prod2_badge != blank -%}
                      <span class="sts__product-badge">{{ block.settings.prod2_badge }}</span>
                    {%- endif -%}
                    <p class="sts__product-title">{{ block.settings.prod2_title }}</p>
                    {%- if block.settings.prod2_subtitle != blank -%}
                      <p class="sts__product-subtitle">{{ block.settings.prod2_subtitle }}</p>
                    {%- endif -%}
                  </div>
                  <span class="sts__product-arrow" aria-hidden="true">
                   <svg xmlns="http://www.w3.org/2000/svg" width="13" height="22" viewBox="0 0 13 22" fill="none">
                    <path d="M2 19.5L10.75 10.75L2 2" stroke="#FAAF4F" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </div>
              </a>
            {%- endif -%}

          </div>
        </div>

        {%- assign result_i = result_i | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}

  </div>

</section>

<style>

.sts--{{ section.id }} {
  --sts-accent:             {{ section.settings.accent_color | default: '#f5a623' }};
  --sts-accent-hover:       {{ section.settings.accent_hover_color | default: '#d48f0f' }};
  --sts-bg:                 {{ section.settings.section_bg | default: '#f5f3ef' }};
  --sts-card-bg:            {{ section.settings.card_bg | default: '#ffffff' }};
  --sts-card-bg-hover:      {{ section.settings.card_bg_hover | default: '#fdfcfa' }};
  --sts-card-border:        {{ section.settings.card_border_color | default: '#e0dbd4' }};
  --sts-card-border-sel:    {{ section.settings.card_border_selected | default: '#f5a623' }};
  --sts-card-img-bg:        {{ section.settings.card_img_bg | default: '#f0ede8' }};
  --sts-text:               {{ section.settings.text_color | default: '#1a1a1a' }};
  --sts-text-muted:         {{ section.settings.text_muted | default: '#6b6b6b' }};
  --sts-step-number-color:  {{ section.settings.step_number_color | default: '#e4e0d8' }};
  --sts-result-label-color: {{ section.settings.result_label_color | default: '#1a1a1a' }};
  --sts-product-bg:         {{ section.settings.product_card_bg | default: '#ffffff' }};
  --sts-product-border:     {{ section.settings.product_card_border | default: '#e8e4dc' }};
  --sts-product-arrow:      {{ section.settings.product_arrow_color | default: '#f5a623' }};
  --sts-badge-bg:           {{ section.settings.badge_bg | default: '#ffffff' }};
  --sts-badge-text:         {{ section.settings.badge_text_color | default: '#1a1a1a' }};
  --sts-badge-border:       {{ section.settings.badge_border_color | default: '#d0cbc3' }};
  --sts-radius-card:        {{ section.settings.card_radius | default: 12 }}px;
  --sts-radius-product:     {{ section.settings.product_radius | default: 12 }}px;
  --sts-font-heading:       '{{ section.settings.font_heading | default: 'system-ui' }}', sans-serif;
  --sts-font-body:          '{{ section.settings.font_body | default: 'system-ui' }}', sans-serif;
}

.sts--{{ section.id }} {
  width: 100%;
  background: var(--sts-bg);
  font-family: var(--sts-font-body);
  color: var(--sts-text);
  {% unless section.settings.full_width %}
    max-width: {{ section.settings.section_max_width | default: 1200 }}px;
    margin-inline: auto;
  {% endunless %}
  padding: {{ section.settings.padding_top | default: 60 }}px
           {{ section.settings.padding_h | default: 24 }}px
           {{ section.settings.padding_bottom | default: 60 }}px;
  box-sizing: border-box;
}

/* ══ HEADER ══ */
.sts--{{ section.id }} .sts__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: {{ section.settings.header_gap | default: 40 }}px;
  margin-bottom: {{ section.settings.header_mb | default: 40 }}px;
}

.sts--{{ section.id }} .sts__header-left {
  display: flex;
  align-items: flex-start;
  gap: {{ section.settings.step_gap | default: 16 }}px;
  flex: 1;
}

.sts--{{ section.id }} .sts__step-number {
  font-family: var(--sts-font-heading);
  font-size: {{ section.settings.step_number_size | default: 110 }}px;
  font-weight: {{ section.settings.step_number_weight | default: 700 }};
  line-height: 0.85;
  color: var(--sts-step-number-color);
  letter-spacing: -2px;
  user-select: none;
  flex-shrink: 0;
  font-family: Playfair;
font-weight: 600;
font-style: SemiBold;
font-size: 200px;
leading-trim: NONE;
line-height: 50.4px;
letter-spacing: 0%;
vertical-align: middle;
color:#E9E4E4;
}

.sts--{{ section.id }} .sts__header-meta {
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding-bottom: 4px;
}

.sts--{{ section.id }} .sts__step-label {
  margin: 0 0 6px;
  font-size: {{ section.settings.step_label_size | default: 12 }}px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--sts-text-muted);
  font-family: Montserrat;
  font-weight: 700;
  font-style: Bold;
  font-size: 12px;
  leading-trim: NONE;
  line-height: 18px;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color:#4A5565;
}

.sts--{{ section.id }} .sts__title {
  margin: 0;
  font-family: var(--sts-font-heading);
  font-size: {{ section.settings.title_size | default: 36 }}px;
  font-weight: {{ section.settings.title_weight | default: 700 }};
  line-height: 1.15;
  color: var(--sts-text);
  max-width: 14em;
  font-family: Montserrat;
  font-weight: 500;
  font-style: Medium;
  font-size: 30px;
  leading-trim: NONE;
  line-height: 36px;
  letter-spacing: 0.4px;
  color:#000000;
}

.sts--{{ section.id }} .sts__header-right {
  max-width: {{ section.settings.header_desc_max_width | default: 320 }}px;
  flex-shrink: 0;
  padding-top: 6px;
}

.sts--{{ section.id }} .sts__header-desc {
  margin: 0;
  font-size: {{ section.settings.header_desc_size | default: 15 }}px;
  line-height: 1.65;
  color: var(--sts-text-muted);
  font-family: Montserrat;
  font-weight: 500;
  font-style: Medium;
  font-size: 16px;
  leading-trim: NONE;
  line-height: 24px;
  letter-spacing: -0.31px;
  color:#000000;
}

/* ══ GRID ══ */
.sts--{{ section.id }} .sts__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.grid_columns | default: 3 }}, 1fr);
  gap: {{ section.settings.grid_gap | default: 16 }}px;
  margin-bottom: {{ section.settings.grid_mb | default: 32 }}px;
}

/* ══ CARD ══ */
.sts--{{ section.id }} .sts__card {
  position: relative;
  background: var(--sts-card-bg);
  border: {{ section.settings.card_border_width | default: 1 }}px solid var(--sts-card-border);
  border-radius: var(--sts-radius-card);
  padding: 0;
  cursor: pointer;
  text-align: left;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  overflow: hidden;
  outline: none;
}

.sts--{{ section.id }} .sts__card:hover {
  background: var(--sts-card-bg-hover);
  border-color: color-mix(in oklch, var(--sts-card-border-sel) 50%, var(--sts-card-border));
  box-shadow: 0 2px 12px oklch(0.2 0.01 80 / 0.07);
}

.sts--{{ section.id }} .sts__card:focus-visible {
  outline: 2px solid var(--sts-accent);
  outline-offset: 2px;
}

.sts--{{ section.id }} .sts__card.is-selected {
  border-color: var(--sts-card-border-sel);
  border-width: {{ section.settings.card_border_sel_width | default: 2 }}px;
}

/* Checkmark badge */
.sts--{{ section.id }} .sts__card-check {
  position: absolute;
  top: {{ section.settings.check_top | default: 12 }}px;
  right: {{ section.settings.check_right | default: 12 }}px;
  width: {{ section.settings.check_size | default: 28 }}px;
  height: {{ section.settings.check_size | default: 28 }}px;
  border-radius: 50%;
  background: var(--sts-accent);
  color: {{ section.settings.check_icon_color | default: '#ffffff' }};
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(0.6);
  transition: opacity 0.2s ease, transform 0.2s ease;
  z-index: 2;
  pointer-events: none;
}

.sts--{{ section.id }} .sts__card.is-selected .sts__card-check {
  opacity: 1;
  transform: scale(1);
}

/* Card image */
.sts--{{ section.id }} .sts__card-img {
  width: 100%;
  height: {{ section.settings.card_img_height | default: 160 }}px;
  background: var(--sts-card-img-bg);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sts--{{ section.id }} .sts__card-img img {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.card_img_fit | default: 'cover' }};
  display: block;
  padding:25px;
}

.sts--{{ section.id }} .sts__card-img-placeholder {
  width: 100%;
  height: 100%;
  background: var(--sts-card-img-bg);
}

.sts--{{ section.id }} .sts__card-svg {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}

.sts--{{ section.id }} .sts__card-svg svg {
  max-width: 100%;
  max-height: 100%;
}

/* Card body */
.sts--{{ section.id }} .sts__card-body {
  padding: 0px 25px 23px 25px;
}

.sts--{{ section.id }} .sts__card-title {
  margin: 0 0 4px;
  font-size: {{ section.settings.card_title_size | default: 15 }}px;
  font-weight: {{ section.settings.card_title_weight | default: 600 }};
  line-height: 1.3;
  color: var(--sts-text);
  font-family: Montserrat;
  font-weight: 700;
  font-style: Bold;
  font-size: 16.05px;
  leading-trim: NONE;
  line-height: 22.92px;
  letter-spacing: -0.17px;
  color:#0A0A0A;
}

.sts--{{ section.id }} .sts__card-desc {
  margin: 0;
  font-size: {{ section.settings.card_desc_size | default: 13 }}px;
  line-height: 1.5;
  color: var(--sts-text-muted);
  font-family: Montserrat;
  font-weight: 400;
  font-style: Regular;
  font-size: 13.75px;
  leading-trim: NONE;
  line-height: 17.19px;
  letter-spacing: 0px;
  color:#4A5565;
}

/* ══ RESULTS ROW ══ */
.sts--{{ section.id }} .sts__result-label {
  margin: 0 0 {{ section.settings.result_label_mb | default: 16 }}px;
  font-size: {{ section.settings.result_label_size | default: 11 }}px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--sts-result-label-color);
  font-family: Montserrat;
  font-weight: 700;
  font-style: Bold;
  font-size: 12px;
  leading-trim: NONE;
  line-height: 18px;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color:#4A5565;
}

/* ══ PRODUCT CARDS ══ */
.sts--{{ section.id }} .sts__product-cards {
  display: grid;
  grid-template-columns: repeat({{ section.settings.product_cols | default: 2 }}, 1fr);
  gap: {{ section.settings.product_gap | default: 16 }}px;
}

.sts--{{ section.id }} .sts__product-card {
  display: flex;
  align-items: stretch;
  background: var(--sts-product-bg);
  border: 1px solid var(--sts-product-border);
  border-radius: var(--sts-radius-product);
  overflow: hidden;
  text-decoration: none;
  color: inherit;
  transition: box-shadow 0.2s ease, border-color 0.2s ease;
}

.sts--{{ section.id }} .sts__product-card:hover {
  box-shadow: 0 4px 16px oklch(0.2 0.01 80 / 0.09);
  border-color: color-mix(in oklch, var(--sts-card-border-sel) 40%, var(--sts-product-border));
}

.sts--{{ section.id }} .sts__product-img {
  position: relative;
  width: {{ section.settings.product_img_width | default: 180 }}px;
  flex-shrink: 0;
  background: var(--sts-card-img-bg);
  overflow: hidden;
}

.sts--{{ section.id }} .sts__product-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.sts--{{ section.id }} .sts__product-img-placeholder {
  width: 100%;
  height: 100%;
  min-height: 120px;
  background: var(--sts-card-img-bg);
}

.sts--{{ section.id }} .sts__product-badge {
    background: var(--sts-badge-bg);
    color: var(--sts-badge-text);
    border: 1px solid var(--sts-badge-border);
    border-radius: 50px;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    white-space: nowrap;
    width: fit-content;
    font-family: Inter;
    font-weight: 400;
    font-style: Regular;
    font-size: 12px;
    leading-trim: NONE;
    line-height: 16px;
    letter-spacing: 0px;
    border: 1px solid #000000;
    margin-bottom: 7px;
}

.sts--{{ section.id }} .sts__product-info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: {{ section.settings.product_info_padding_v | default: 20 }}px
           {{ section.settings.product_info_padding_h | default: 24 }}px;
  gap: 12px;
}

.sts--{{ section.id }} .sts__product-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.sts--{{ section.id }} .sts__product-title {
  margin: 0;
  font-size: {{ section.settings.product_title_size | default: 18 }}px;
  font-weight: {{ section.settings.product_title_weight | default: 700 }};
  line-height: 1.25;
  color: var(--sts-text);
  font-family: Montserrat;
  font-weight: 500;
  font-style: Medium;
  font-size: 24px;
  leading-trim: NONE;
  line-height: 26px;
  letter-spacing: 0.4px;
  vertical-align: middle;
  color:#000;
}

.sts--{{ section.id }} .sts__product-subtitle {
  margin: 0;
  font-size: {{ section.settings.product_subtitle_size | default: 13 }}px;
  line-height: 1.4;
  color: var(--sts-text-muted);
  font-family: Montserrat;
  font-weight: 400;
  font-style: Regular;
  font-size: 14px;
  leading-trim: NONE;
  line-height: 16px;
  letter-spacing: 0px;
  color:#4A5565;
  margin-top:11px;
}

.sts--{{ section.id }} .sts__product-arrow {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  {% comment %} background: var(--sts-accent); {% endcomment %}
  color: {{ section.settings.arrow_icon_color | default: '#ffffff' }};
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: background 0.2s ease, transform 0.2s ease;
}

.sts--{{ section.id }} .sts__product-card:hover .sts__product-arrow {
  {% comment %} background: var(--sts-accent-hover); {% endcomment %}
  transform: translateX(2px);
}

/* ══ MOBILE ══ */
@media (max-width: 768px) {
  .sts--{{ section.id }} {
    padding: {{ section.settings.padding_top_mob | default: 32 }}px
             {{ section.settings.padding_h_mob | default: 16 }}px
             {{ section.settings.padding_bottom_mob | default: 32 }}px;
  }

  .sts--{{ section.id }} .sts__header {
    flex-direction: column;
    gap: 12px;
    margin-bottom: 24px;
  }

  .sts--{{ section.id }} .sts__header-right { max-width: 100%; }

  .sts--{{ section.id }} .sts__step-number {
    font-size: {{ section.settings.step_number_size_mob | default: 72 }}px;
  }

  .sts--{{ section.id }} .sts__title {
    font-size: {{ section.settings.title_size_mob | default: 26 }}px !important;
  }

  .sts--{{ section.id }} .sts__grid {
    grid-template-columns: repeat({{ section.settings.grid_columns_mob | default: 2 }}, 1fr);
    gap: {{ section.settings.grid_gap_mob | default: 10 }}px;
  }

  .sts--{{ section.id }} .sts__card-img {
    height: {{ section.settings.card_img_height_mob | default: 110 }}px;
  }

  .sts--{{ section.id }} .sts__product-cards {
    grid-template-columns: 1fr;
  }

  .sts--{{ section.id }} .sts__product-img {
    width: {{ section.settings.product_img_width_mob | default: 120 }}px;
  }

  .sts--{{ section.id }} .sts__product-title {
    font-size: {{ section.settings.product_title_size_mob | default: 15 }}px !important;
  }
}

</style>

<script>
(function () {
  var sec    = document.querySelector('.sts--{{ section.id }}');
  if (!sec) return;

  var cards  = sec.querySelectorAll('.sts__card');
  var groups = sec.querySelectorAll('.sts__result-group');

  function selectCard(index) {
    cards.forEach(function(c, i) {
      var sel = i === index;
      c.classList.toggle('is-selected', sel);
      c.setAttribute('aria-checked', sel ? 'true' : 'false');
    });

    groups.forEach(function(g, i) {
      if (i === index) {
        g.style.display = '';
        g.style.opacity = '0';
        g.style.transform = 'translateY(8px)';
        requestAnimationFrame(function() {
          g.style.transition = 'opacity 0.28s ease, transform 0.28s ease';
          g.style.opacity = '1';
          g.style.transform = 'translateY(0)';
        });
        g.classList.add('is-active');
      } else {
        g.style.display = 'none';
        g.style.opacity = '';
        g.style.transform = '';
        g.classList.remove('is-active');
      }
    });
  }

  cards.forEach(function(card, i) {
    card.addEventListener('click', function() { selectCard(i); });
  });

  selectCard(0);
})();
</script>

