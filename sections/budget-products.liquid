<div class="container" id="budget-products">
  <div class="heading--wrapper">
    {% if section.settings.icon != blank %}
      {{ section.settings.icon | image_url: width: 25 | image_tag: alt: section.settings.icon.alt }}
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="budget-products__heading">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>
  {% if section.settings.subheading != blank %}
    <p class="budget-products__subheading">{{ section.settings.subheading }}</p>
  {% endif %}
  <div class="budget-products__products">
    {% for block in section.blocks %}
      {% render 'product-card', product: block.settings.product %}
    {% endfor %}
  </div>
</div>

{% style %}
  .budget-products__products {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-template-rows: 1fr;
    grid-column-gap: 16px;
    grid-row-gap: 32px;
  }
  @media (min-width: 768px) {
    .budget-products__products {
      grid-template-columns: repeat(3, 1fr);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Budget Products",
  "class": "section-budget-products",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "icon",
      "label": "Icon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Budget Considerations"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add a subheading here"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Budget Products",
      "category": "Products",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
