<script>
document.addEventListener('DOMContentLoaded', function() {
  // Helper: format money safely
  function formatMoney(cents) {
    if (typeof Shopify !== 'undefined' && typeof Shopify.formatMoney === 'function') {
      return Shopify.formatMoney(cents, window.Shopify && window.Shopify.money_format ? window.Shopify.money_format : '${{amount}}');
    }
    return '$' + (cents / 100).toFixed(2);
  }

  // Helper: recalc subtotal from current variant + qty
  function updateSubtotalForCurrentVariant($form) {
    var $qtyInput = $form.find('#quantity');
    var $subtotalEl = $form.find('.js-product__subtotal');
    if (!$qtyInput.length || !$subtotalEl.length) return;

    var qtyRaw = $qtyInput.val();
    var qty = parseInt(qtyRaw, 10);
    if (isNaN(qty) || qty < 1) qty = 1;

    var variant = window.productInfo && window.productInfo.selectedVariant ? window.productInfo.selectedVariant : null;
    if (!variant) return;

    var price = variant.price || 0;               // cents
    var compare = variant.compare_at_price || 0;  // cents

    var subtotalCents = price * qty;
    var compareSubtotalCents = compare * qty;

    var subtotal = formatMoney(subtotalCents);
    var compareSubtotal = (compare && compare > price) ? formatMoney(compareSubtotalCents) : null;

    var savingsHtml = '';
    if (compare && compare > price) {
      var percent = Math.round(((compare - price) / compare) * 100);
      savingsHtml = '<span class="savings" style="font-size:12px;vertical-align: super;">Save ' + percent + '%</span>';
    }

    var finalHtml = subtotal;
    if (compareSubtotal) {
      finalHtml =
        '<span class="compare-at-price" style="text-decoration: line-through;">' + compareSubtotal + '</span>' +
        '<span class="sale-price">' + subtotal + '</span> ' +
        savingsHtml;
    }

    $subtotalEl.html(finalHtml);
    console.log('SUBTOTAL-DEBUG: qty =', qty, ', variant id =', variant.id, ', html =', finalHtml);
  }

  function updateSizeVisibilityForColor() {
    var $colorSelect = $('#option-color');
    if (!$colorSelect.length) return;
    
    var color = $colorSelect.val();
    if (!color || color === 'Please select a color') return;
    
    var $form = $colorSelect.closest('form');
    var handle = $form.data('handle');
    var variants = window.productInfo && handle ? window.productInfo[handle] : [];
    
    if (!variants.length) return;
    
    // Get available sizes - NORMALIZE by removing quotes
    var availableSizes = variants
      .filter(function(v) { return v.option1 === color && v.option2; })
      .map(function(v) { return String(v.option2).replace(/"/g, '').trim(); })
      .filter(Boolean);
    
    console.log('Available sizes for', color, ':', availableSizes);
    
    // Show ALL first
    $form.find('.pdp-atc__group__buttons.Size li').show().removeClass('display-none');
    
    // Hide unavailable sizes
    $form.find('.pdp-atc__group__buttons.Size li').each(function() {
      var $li = $(this);
      var sizeValue = $li.find('input[name="Size"]').val().replace(/"/g, '').trim();
      
      var isAvailable = availableSizes.includes(sizeValue);
      
      if (!isAvailable) {
        $li.addClass('display-none').hide();
        console.log('HIDDEN:', sizeValue);
      } else {
        $li.removeClass('display-none').show();
        console.log('SHOWN:', sizeValue);
      }
    });

    // ✅ AUTO-CLICK if only ONE size available, then update subtotal
    setTimeout(function() {
      var $visibleSizes = $form.find('.pdp-atc__group__buttons.Size li:not(.display-none) input[name="Size"]');
      console.log('Visible sizes count:', $visibleSizes.length);
      
      if ($visibleSizes.length === 1) {
