  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const colorOptionsContainer = document.querySelector('ul.pdp-atc__group__buttons.Color');
      
      if (!colorOptionsContainer) return;
      
      const colorOptions = colorOptionsContainer.querySelectorAll('li');
      const maxVisibleOptions = 8;
      
      // Only proceed if there are more than 8 options
      if (colorOptions.length <= maxVisibleOptions) return;
      
      // Initially hide options beyond the 8th one
      colorOptions.forEach((option, index) => {
        if (index >= maxVisibleOptions) {
          option.style.display = 'none';
          option.classList.add('hidden-color-option');
        }
      });
      
      // Create the View More button
      const viewMoreButton = document.createElement('button');
      viewMoreButton.className = 'color-view-more-btn';
      viewMoreButton.textContent = 'View More';
      viewMoreButton.type = 'button';
      
      // Add the >> arrows after the text
      const arrowSpan = document.createElement('span');
      arrowSpan.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="10" height="20" viewBox="0 0 10 20" fill="none"> <path fill-rule="evenodd" clip-rule="evenodd" d="M8.46415 10.5925L3.74999 15.3067L2.57166 14.1283L6.69666 10.0033L2.57166 5.87835L3.74999 4.70001L8.46415 9.41418C8.62038 9.57045 8.70814 9.78238 8.70814 10.0033C8.70814 10.2243 8.62038 10.4362 8.46415 10.5925Z" fill="#2B5AA0"/> </svg><svg xmlns="http://www.w3.org/2000/svg" width="10" height="20" viewBox="0 0 10 20" fill="none"> <path fill-rule="evenodd" clip-rule="evenodd" d="M8.46415 10.5925L3.74999 15.3067L2.57166 14.1283L6.69666 10.0033L2.57166 5.87835L3.74999 4.70001L8.46415 9.41418C8.62038 9.57045 8.70814 9.78238 8.70814 10.0033C8.70814 10.2243 8.62038 10.4362 8.46415 10.5925Z" fill="#2B5AA0"/> </svg>`;
      arrowSpan.className = 'view-more-arrows';
      viewMoreButton.appendChild(arrowSpan);
      
      // Button click functionality - show all and remove button
      viewMoreButton.addEventListener('click', function() {
        const hiddenOptions = colorOptionsContainer.querySelectorAll('.hidden-color-option');
        
        // Show all hidden options
        hiddenOptions.forEach(option => {
          option.style.display = 'block';
        });
        
        // Remove the button after clicking
        viewMoreButton.remove();
      });
      
      // Insert the button after the color options container
      colorOptionsContainer.parentNode.insertBefore(viewMoreButton, colorOptionsContainer.nextSibling);
    });

  </script>
    
