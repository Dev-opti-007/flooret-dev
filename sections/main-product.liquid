<script>
  document.addEventListener('DOMContentLoaded', function () {
    var reviewBtn = document.querySelector('.product-details__header .review-wrapper');

    if (!reviewBtn) return;

    reviewBtn.addEventListener('click', function (e) {
      e.preventDefault(); // prevent default on click

      // Find / wait for widget when clicked
      waitForReviewsWidget(function (reviewWrap) {
        openReviews(reviewWrap);
      });
    });

    function waitForReviewsWidget(callback) {
      var existing = document.querySelector('reviewsio-product-reviews-widget');
      if (existing) {
        callback(existing);
        return;
      }

      // If not in DOM yet, observe until it appears
      var observer = new MutationObserver(function (mutations, obs) {
        var el = document.querySelector('reviewsio-product-reviews-widget');
        if (el) {
          obs.disconnect();
          callback(el);
        }
      });

      observer.observe(document.documentElement, {
        childList: true,
        subtree: true
      });
    }

    function openReviews(reviewWrap) {
      // Add class to show it
      reviewWrap.classList.add('reviews-open');
      // Lock body scroll
      document.body.classList.add('reviews-open-body');

      // Add close button once
      if (!reviewWrap.querySelector('.reviews-close-btn')) {
        var closeBtn = document.createElement('button');
        closeBtn.type = 'button';
        closeBtn.className = 'reviews-close-btn';
        closeBtn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M17.7727 1.41421L1.41431 17.7726" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="square"/>
          <path d="M17.7727 17.7726L1.41431 1.41421" stroke="black" stroke-width="2" stroke-miterlimit="10" stroke-linecap="square"/>
        </svg>`;

        closeBtn.addEventListener('click', function () {
          reviewWrap.classList.remove('reviews-open');
          document.body.classList.remove('reviews-open-body');
        });

        reviewWrap.prepend(closeBtn);
      }
    }
  });
</script>

