    <script>
      function debounce(func, delay) {
        let timeout;
        return function (...args) {
          clearTimeout(timeout);
          timeout = setTimeout(() => func.apply(this, args), delay);
        };
      }
      
      let isStickyActive = false;
      let ticking = false; // Prevents multiple calls per frame
      
      function stickyBtn() {
        
          let parent = document.querySelector('section.mproduct');
          if(parent){
            let button = parent.querySelector(".atc-wrap .atc-wrap__ctas");
            let atc_btn = button.querySelector('#addtocart');
          
            if (!button || !parent || !atc_btn ) { console.log("Button not found!"); return; }
          
            const rect = parent.querySelector("#product-details .atc-wrap .qty-input ").getBoundingClientRect();
            const windowHeight = window.innerHeight;
            // console.log('rt > 0 ~~~ rb < wh',{rt: parseInt(rect.top) ,rb: parseInt(rect.bottom), wh: parseInt(windowHeight)});
            
            if ( parseInt(rect.top) > 0 && parseInt(rect.bottom) < parseInt(windowHeight)) { 
              if (isStickyActive) { 
                button.classList.remove("cstm_sticky--active");
                atc_btn.type = 'submit';
                isStickyActive = false;
              }
            } else { 
              if (!isStickyActive) {
                button.classList.add("cstm_sticky--active");
                atc_btn.type = 'submit';
                isStickyActive = true;
              }
            }
            ticking = false; // Allow next frame
          }
      }
      let debounce_sticky = debounce(() => { requestAnimationFrame(stickyBtn); ticking = false; }, 200);
      
      window.addEventListener("scroll", () => { if (!ticking) { debounce_sticky(); ticking = true; } });
    </script>
