<script>

document.addEventListener('DOMContentLoaded', function() {
  console.log('%c=== Starting input click listeners ===', 'color: blue; font-weight: bold;'); // Highlighted start log

  /* ------------------------------------------------------------------
     Selectors
  ------------------------------------------------------------------ */
  const typeUL = document.querySelector('ul.pdp-atc__group__buttons.Type');
  if (!typeUL) {
    console.log('%c[Type UL not found - abort]', 'color: red; font-weight: bold;');
    return;
  }

  const sampLis = typeUL.querySelectorAll('li.sample'); // Cut-sample + Plank-sample
  const boxLi = typeUL.querySelector('li.box');         // Box option (single <li>)
  const inputs = typeUL.querySelectorAll('input[type="radio"]');
  const tabs = document.querySelector('.js-tabs.product-orderby');

  // New: Tabs for "Order by Sample" and "Order by Box"
  const sampleTab = document.querySelector('[data-items="sample"]');
  const boxTab = document.querySelector('[data-items="box"]');

  console.log('%cSamples found: ' + sampLis.length + ' | Box found: ' + (!!boxLi), 'color: purple;');
  console.log('%cSample tab found: ' + (!!sampleTab) + ' | Box tab found: ' + (!!boxTab), 'color: purple;');

  /* ------------------------------------------------------------------
     Helper – toggle visibility and active class
  ------------------------------------------------------------------ */
  function toggleDisplay(showSamples) {
    sampLis.forEach(li => { li.style.display = showSamples ? 'block' : 'none'; });
    if (boxLi) { boxLi.style.display = showSamples ? 'none' : 'block'; }

    // Toggle active class on tabs
    if (showSamples) {
      if (sampleTab) {
        sampleTab.classList.add('pdp_tab--active');
        console.log('%cActivated sample tab', 'color: cyan;');
      }
      if (boxTab) {
        boxTab.classList.remove('pdp_tab--active');
        console.log('%cDeactivated box tab', 'color: cyan;');
      }
    } else {
      if (sampleTab) {
        sampleTab.classList.remove('pdp_tab--active');
        console.log('%cDeactivated sample tab', 'color: cyan;');
      }
      if (boxTab) {
        boxTab.classList.add('pdp_tab--active');
        console.log('%cActivated box tab', 'color: cyan;');
      }
    }

    if (tabs) {
      tabs.style.display = showSamples ? '' : 'none';
      console.log('%cTabs ' + (showSamples ? 'shown' : 'hidden'), 'color: cyan;');
    }
  }

  /* ------------------------------------------------------------------
     Click handler
  ------------------------------------------------------------------ */
  function handleClick(e) {
    const input = e.currentTarget;               // radio that was clicked
    const parent = input.parentNode;             // corresponding <li>
    const isBox = parent.classList.contains('box');

    console.log('%cClicked:', 'color: teal; font-weight: bold;', input.value, '| isBox:', isBox);

    // Hide/show whole <li> blocks and toggle tab active class  
    toggleDisplay(!isBox);
  }

  /* ------------------------------------------------------------------
     Wire listeners
  ------------------------------------------------------------------ */
  inputs.forEach(input => {
    input.addEventListener('click', handleClick);
  });

  /* ------------------------------------------------------------------
     One-time run for initial state
  ------------------------------------------------------------------ */
  const initiallyChecked = typeUL.querySelector('input[type="radio"]:checked');
  if (initiallyChecked) {
    console.log('%cInitial checked input:', 'color: green;', initiallyChecked.value);
    toggleDisplay(!initiallyChecked.parentNode.classList.contains('box'));
  } else {
    // No radio pre-selected → default to “samples shown”
    toggleDisplay(true);
  }

  console.log('%c=== Input click listeners initialized ===', 'color: blue; font-weight: bold;'); // Highlighted end log
});


</script>



