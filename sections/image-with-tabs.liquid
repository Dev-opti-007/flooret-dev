{{ 'before-after.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .before-text-content-title {
      color: {{ section.settings.heading_text_color }};
  }
  #shopify-section-{{ section.id }} .before-after-image img{
    {% if section.settings.headline == blank %}
      border-bottom-right-radius: 20px;
      border-bottom-left-radius: 20px;
    {% endif %}
  }
</style>

<section class="before-after-with-text-section">
  <div class="before-after-with-text-container{% if section.settings.reverse %} before-reverse{% endif %}">
    <div class="before-image-container">
      {% if section.settings.before_image != blank %}
        <div class="before-after-image">
          {{ section.settings.before_image | image_url: width: '490' | image_tag }}
        </div>
      {% endif %}
      {% if section.settings.headline != blank %}
        <div class="before-review">
          <h2>{{ section.settings.headline }}</h2>
          <p>{{ section.settings.quote }}</p>
          <div class="review-text-content">
            {% if section.settings.author_image != blank %}
              {{ section.settings.author_image | image_url: width: '32' | image_tag }}
            {% endif %}
            {% if section.settings.author_name != blank %}
              <span>{{ section.settings.author_name }}</span>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
    <div class="before-text-container">
      <h1 class="before-text-content-title">{{ section.settings.heading }}</h1>
      <p class="before-text-content-description">{{ section.settings.section_description }}</p>
      <div class="for-tabs-container">
        {% for block in section.blocks %}
          <div
            class="each-tab-div"
            style="align-items:{% if block.settings.description != blank %} start{% else %} center{% endif %};"
          >
            {{ block.settings.icon | image_url: width: '40' | image_tag }}
            <div>
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.description != blank %}
                <p>{{ block.settings.description }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "What Makes Us Different"
    },
    {
      "type": "color",
      "id": "heading_text_color",
      "label": "Heading text color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Show image on the right",
      "default": false
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Description",
      "default": "We’re the first direct-to-consumer flooring brand to offer fully integrated, fully warrantied installation—added right at checkout. Our service is backed by Flooret, tailored to your needs, and designed for a smooth, flexible experience from start to finish."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Select Image"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Testimonial Title"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Testimonial Text",
      "default": "“We love the fact that the grain is embossed in the register and the thick wear layer,” Megan says, “Oh, and the fact that they are waterproof!”"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author Name",
      "default": "Megan M"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author Image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Box",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Tabs"
    }
  ]
}
{% endschema %}
