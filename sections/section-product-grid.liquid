{%- liquid
  assign module = section.settings
  assign heading = module.heading
  assign info_html = module.info_html
  assign info_html_mob = module.info_html_mob
  assign products = module.products
-%}

{%- unless products == blank -%}
<section
  id="ProductsGrid-{{ section.id }}"
  class="pg"
  style="
    --pg-bg: {{ section.settings.section_bg_color }};
    --pg-max: {{ section.settings.section_max_width }}px;

    --pg-pt: {{ section.settings.padding_top_desktop }}px;
    --pg-pr: {{ section.settings.padding_right_desktop }}px;
    --pg-pb: {{ section.settings.padding_bottom_desktop }}px;
    --pg-pl: {{ section.settings.padding_left_desktop }}px;

    --pg-pt-m: {{ section.settings.padding_top_mobile }}px;
    --pg-pr-m: {{ section.settings.padding_right_mobile }}px;
    --pg-pb-m: {{ section.settings.padding_bottom_mobile }}px;
    --pg-pl-m: {{ section.settings.padding_left_mobile }}px;

    --pg-head-gap: {{ section.settings.header_gap }}px;
    --pg-head-mb: {{ section.settings.header_margin_bottom }}px;

    --pg-title-c: {{ section.settings.heading_color }};
    --pg-title-s: {{ section.settings.heading_size_desktop }}px;
    --pg-title-s-m: {{ section.settings.heading_size_mobile }}px;
    --pg-title-w: {{ section.settings.heading_weight }};
    --pg-title-lh: {{ section.settings.heading_line_height }};
    --pg-title-ls: {{ section.settings.heading_letter_spacing }}px;

    --pg-info-c: {{ section.settings.info_color }};
    --pg-info-s: {{ section.settings.info_size_desktop }}px;
    --pg-info-s-m: {{ section.settings.info_size_mobile }}px;
    --pg-info-w: {{ section.settings.info_weight }};
    --pg-info-lh: {{ section.settings.info_line_height }};
    --pg-info-ls: {{ section.settings.info_letter_spacing }}px;

    --pg-gap: {{ section.settings.grid_gap_desktop }}px;
    --pg-gap-m: {{ section.settings.grid_gap_mobile }}px;
    --pg-item-bg: {{ section.settings.item_bg_color }};
    --pg-item-radius: {{ section.settings.item_radius }}px;
    --pg-item-p: {{ section.settings.item_padding_desktop }}px;
    --pg-item-p-m: {{ section.settings.item_padding_mobile }}px;
  "
>
  <div class="pg__wrap {% unless section.settings.full_width %}pg__wrap--contained{% endunless %}">
    <div class="pg__header">
      <div class="pg__header-left">
        {%- if heading != blank -%}
          <h2 class="pg__heading">{{ heading }}</h2>
        {%- endif -%}
      </div>

      <div class="pg__header-right">
        {%- if info_html != blank -%}
          <div class="pg__info desk">{{ info_html }}</div>
        {%- endif -%}

        {%- if info_html_mob != blank -%}
          <div class="pg__info mob">{{ info_html_mob }}</div>
        {%- endif -%}
      </div>
    </div>

    <div class="pg__grid">
      {%- for prod in products -%}
        <div class="pg__item">
          {%- render 'product-card-provence', product: prod -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.enable_init_active_swatch -%}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var root = document.querySelector('#ProductsGrid-{{ section.id }}');
      if (!root) return;

      // Trigger active swatch once cards are in DOM (keeps variant option text/price in sync)
      setTimeout(function () {
        root.querySelectorAll('.product-card').forEach(function(card){
          var active = card.querySelector('.product-card__swatches button.active');
          if (active) active.click();
        });
      }, 200);
    });
  </script>
  {%- endif -%}
</section>
{%- endunless -%}

<style>
  /* Scoped styles */
  #ProductsGrid-{{ section.id }}{
    background: var(--pg-bg);
    padding: var(--pg-pt) var(--pg-pr) var(--pg-pb) var(--pg-pl);
  }

  #ProductsGrid-{{ section.id }} .pg__wrap--contained{
    max-width: var(--pg-max);
    margin: 0 auto;
  }

  /* Header: left title + right info (like screenshot) */
  #ProductsGrid-{{ section.id }} .pg__header{
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--pg-head-gap);
    align-items: start;
    margin-bottom: var(--pg-head-mb);
  }

  #ProductsGrid-{{ section.id }} .pg__heading{
    margin: 0;
    color: var(--pg-title-c);
    font-size: var(--pg-title-s);
    font-weight: var(--pg-title-w);
    line-height: var(--pg-title-lh);
    letter-spacing: var(--pg-title-ls);
     max-width: 400px;
    word-wrap: break-word;
  }

  #ProductsGrid-{{ section.id }} .pg__info{
    color: var(--pg-info-c);
    font-size: var(--pg-info-s);
    font-weight: var(--pg-info-w);
    line-height: var(--pg-info-lh);
    letter-spacing: var(--pg-info-ls);
  }
  #ProductsGrid-{{ section.id }} .pg__info .d-flex {
        display: flex;
        align-items: center;
        gap: 22px;
        margin-bottom: 10px;
    }

   #ProductsGrid-{{ section.id }} .d-flex img {
        width: 144px;
    }

   #ProductsGrid-{{ section.id }} .d-flex p {
        font-family: Montserrat;
        font-weight: 400;
        font-style: Regular;
        font-size: 23px;
        leading-trim: NONE;
        line-height: 26px;
        letter-spacing: 0.37px;
        color: #000;
    }

   #ProductsGrid-{{ section.id }} .pg__info > b {
        font-family: Montserrat;
        font-weight: 500;
        font-style: Medium;
        font-size: 16px;
        leading-trim: NONE;
        line-height: 24px;
        letter-spacing: -0.31px;
        color: #000000;
        margin-top: 15px;
        display: block;
    }

  #ProductsGrid-{{ section.id }} .pg__info p{ margin: 0; }

  /* Grid: 2x2 like screenshot (controlled by settings) */
  #ProductsGrid-{{ section.id }} .pg__grid{
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    gap: var(--pg-gap);
    align-items: start;
    justify-content: center;
  }

  #ProductsGrid-{{ section.id }} .product-card__image {
        aspect-ratio: 1/0.67;
    }

  /* Optional wrapper around the snippet to allow per-section spacing/background */
  #ProductsGrid-{{ section.id }} .pg__item{
    background: var(--pg-item-bg);
    border-radius: var(--pg-item-radius);
    padding: var(--pg-item-p);
    min-width: 0;
  }

  #ProductsGrid-{{ section.id }} .product-card__meta.has-filter+.sr-btns-wrapper .product-card-swatches {
            display: block;
    }

  @media (max-width: 989px){
    #ProductsGrid-{{ section.id }} .product-card__image {
        aspect-ratio: 1/1;
    }
    #ProductsGrid-{{ section.id }} .sr-btns-wrapper {
        flex-direction: row;
        align-items: end;
    }
    #ProductsGrid-{{ section.id }} .sr-btns-wrapper .sr-add-sample-wrapper {
        max-width: 130px;
    }
    #ProductsGrid-{{ section.id }} .pg__header{
      grid-template-columns: 1fr;
    }
    #ProductsGrid-{{ section.id }} .pg__grid{
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }
.pg__info.desk {
        display: block;
    }
    
    .pg__info.mob {
        display: none;
    }
@media (max-width:768px){
   #ProductsGrid-{{ section.id }} .pg__info > b { 
      font-family: Montserrat;
    font-weight: 500;
    font-style: Medium;
    font-size: 16px;
    leading-trim: NONE;
    line-height: 24px;
    letter-spacing: -0.31px;
    color: #000;
    margin-bottom: 23px;
    }
    .pg__info.desk {
        display: none;
    }
    .pg__heading {
      text-align: center;
      text-wrap: auto;
  }
    .pg__info.mob {
        display: block;
    }
    .pg__info.mob > p {
    padding: 0px 37px;
    text-align: center;
    margin: 0px auto;
    display: inline-block;
    width: 100%;
}

.pg__info.mob {
    text-align: center;
}
}
@media (max-width:1080px){
  .pg__header {
    gap: calc(var(--pg-head-gap)/2) !important;
  }
}
  @media (max-width: 749px){
      #ProductsGrid-{{ section.id }} .pg__info .d-flex  {
          flex-direction: column;
          margin-bottom: 26px;
      }
    #ProductsGrid-{{ section.id }}{
      padding: var(--pg-pt-m) var(--pg-pr-m) var(--pg-pb-m) var(--pg-pl-m);
    }

    #ProductsGrid-{{ section.id }} .pg__heading{
      font-size: var(--pg-title-s-m);
    }

    #ProductsGrid-{{ section.id }} .pg__info{
      font-size: var(--pg-info-s-m);
    }

    #ProductsGrid-{{ section.id }} .pg__grid{
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
      gap: var(--pg-gap-m);
    }

    #ProductsGrid-{{ section.id }} .pg__item{
      padding: var(--pg-item-p-m);
    }
    #ProductsGrid-{{ section.id }}  .product-card {
    width: 100%;
    }
    #ProductsGrid-{{ section.id }} .pg__grid .slick-list.draggable {
        grid-column: 1/3;
    }
  }
</style>


<script>
  // Global variantPrices object for this section
  window.pgVariantPrices = window.pgVariantPrices || {};
  window.pgVariantPrices[{{ section.id | json }}] = {
    {%- for prod in products -%}
      "{{ prod.handle | json }}": {
        {%- for variant in prod.variants -%}
          "{{ variant.id | json }}": {
           "sqft_price": {{ variant.metafields.custom.sqft_price.value.amount | default: 0 | json }},
           "sqft_compare": {{ variant.metafields.custom.sqft_compare_at_price.value.amount | default: 0 | json }},
           "sqft": {{ variant.metafields.custom.sqft.value | default: prod.metafields.custom.default_sqft.value | default: 100 | json }}
          }{%- if forloop.last == false -%},{%- endif -%}
        {%- endfor -%}
      }{%- if forloop.last == false -%},{%- endif -%}
    {%- endfor -%}
  };
  
  console.log('pgVariantPrices loaded for section {{ section.id }}:', window.pgVariantPrices[{{ section.id | json }}]);
</script>


<script>
document.addEventListener('DOMContentLoaded', function () {
  // Helper to extract dollar amount from money object or plain number
  function extractAmount(val) {
    if (val === null || val === undefined || val === '' || val === 0 || val === '0') {
      return 0;
    }
    // If it's already a number
    if (typeof val === 'number') {
      return val;
    }
    // If it's a string that looks like a number
    if (typeof val === 'string' && !val.includes('{')) {
      return parseFloat(val) || 0;
    }
    // If it's a money object (string or parsed object)
    var obj = val;
    if (typeof val === 'string') {
      try { obj = JSON.parse(val); } catch (e) { return 0; }
    }
    if (obj && obj.amount !== undefined) {
      return parseFloat(obj.amount) || 0;
    }
    return 0;
  }

  $('body').on('click', '#ProductsGrid-{{ section.id }} .product-card__swatches button', function () {
    var $this = $(this);
    if ($this.hasClass('disabled')) return false;

    var image = $this.data('image');
    var hover_image = $this.data('imageHover');
    var $card = $this.parents('.product-card');
    var $swatches = $card.find('.product-card__swatches button');
    var $image = $card.find('.product-card__image img');
    var $hover_img = $card.find('.js-product-card-hover-image');
    var $cost_per_sqft = $card.find('.product-card__cost-per-sqft, .js-product-card__cost-per-sqft'); // ✅ BOTH selectors
    var dataPriceCents = Number($this.data('price')) || 0;

    // ✅ USE EXISTING DATA ATTRIBUTES (they're already correct!)
    var rawCost = $this.attr('data-cost-per-sqft');
    var rawCompare = $this.attr('data-compare-cost-per-sqft');
    var sqFtValue = parseFloat($this.attr('data-sqft') || 1); // 1 if already per-sqft

    function normalizeMoneyAmount(value) {
      const num = parseFloat(value);
      if (isNaN(num)) return 0;
      if (!Number.isInteger(num)) return num;
      return num / 100;
    }

    var totalPrice = normalizeMoneyAmount(extractAmount(rawCost));
    var totalComparePrice = normalizeMoneyAmount(extractAmount(rawCompare));
    var sqftPrice = totalPrice / sqFtValue;
    var sqftComparePrice = totalComparePrice / sqFtValue;

    console.log('SWATCH CLICK ---');
    console.log('rawCost:', rawCost);
    console.log('rawCompare:', rawCompare);
    console.log('extractAmount(rawCost):', extractAmount(rawCost));
    console.log('extractAmount(rawCompare):', extractAmount(rawCompare));
    console.log('normalized totalPrice:', normalizeMoneyAmount(extractAmount(rawCost)));
    console.log('normalized totalComparePrice:', normalizeMoneyAmount(extractAmount(rawCompare)));
    console.log('sqFtValue:', sqFtValue);
    console.log('sqftPrice:', sqftPrice);
    console.log('sqftComparePrice:', sqftComparePrice);

    // MAIN PRICE
    var formattedMainPrice = Shopify.formatMoney(dataPriceCents, price_format)
      .replace('$', window.currencySymbol + ' ');
    $card.find('.js-product__price').text(formattedMainPrice);

    // State + images
    $card.find('.js-product__variant').text($this.attr('title'));
    $swatches.removeClass('active');
    $this.addClass('active');

    $image.attr('src', image).attr('srcset', image);
    if (hover_image && hover_image.length && $hover_img.length) {
      $hover_img
        .attr('data-bg', hover_image)
        .css('background-image', 'url("' + hover_image + '")')
        .removeClass('entered loaded')
        .addClass('lazy');
      $hover_img[0].removeAttribute('data-ll-status');
      if (window.LazyLoading && typeof LazyLoading.refresh === 'function') {
        LazyLoading.refresh();
      }
    }

    // COST PER SQ FT
    var savingsPercent = 0;
    if (sqftComparePrice > sqftPrice && sqftComparePrice > 0) {
      savingsPercent = Math.round(((sqftComparePrice - sqftPrice) / sqftComparePrice) * 100);
    }
    console.log('savingsPercent:', savingsPercent);

    var priceHtml = '<span class="p-r-ice">' +
      window.currencySymbol + sqftPrice.toFixed(2);

    if (sqftPrice < sqftComparePrice) {
      priceHtml += ' <del>' + window.currencySymbol + sqftComparePrice.toFixed(2) + '</del>';
    }

    priceHtml += ' <span class="sqft-text">per sq ft</span>';
    if (savingsPercent > 0) {
      priceHtml += ' <span class="off-percent">' + savingsPercent + '% Off</span>';
    }
    priceHtml += '</span>';

    $cost_per_sqft.html(priceHtml);  // ✅ Updates both class names
  });

  // Initial trigger (scoped to this section)
  setTimeout(function () {
    $('#ProductsGrid-{{ section.id }} .product-card').each(function () {
      var $card = $(this);
      var $active = $card.find('.product-card__swatches button.active').first();
      if ($active.length) {
        $active.trigger('click');
      }
    });
  }, 200);
});
</script>





<script>
document.addEventListener('DOMContentLoaded', function () {
  var $slider = $('.pg__grid');
  if (!$slider.length) return;

  var slickSettings = {
    mobileFirst: true,
    dots: false,
    arrows: true,
    infinite: true,
    slidesToScroll: 1,
    slidesToShow: 1, // < 768

    prevArrow: `
      <button type="button" class="iic__arrow iic__arrow--prev" aria-label="Previous">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="18" viewBox="0 0 11 18" fill="none">
          <path d="M6.65597e-05 8.69223L0.970476 7.72169L7.72178 0.970392L8.65012 -1.54285e-05L10.5911 1.94093L9.62066 2.86927L3.83976 8.69223L9.62066 14.473L10.5911 15.4435L8.65012 17.3423L7.72178 16.3719L0.970476 9.62057L6.65597e-05 8.69223Z" fill="black"/>
        </svg>
      </button>
    `,
    nextArrow: `
      <button type="button" class="iic__arrow iic__arrow--next" aria-label="Next">
        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="18" viewBox="0 0 11 18" fill="none">
          <path d="M10.591 8.65005L9.62059 9.62059L2.86929 16.3719L1.94094 17.3423L0 15.4014L0.970408 14.473L6.7513 8.65005L0.970408 2.86929L0 1.89875L1.94094 0L2.86929 0.97041L9.62059 7.72171L10.591 8.65005Z" fill="black"/>
        </svg>
      </button>
    `,

    responsive: [
      {
        breakpoint: 768,          // >= 768 and < 992
        settings: { slidesToShow: 2 }
      },
      {
        breakpoint: 992,          // >= 992 disable
        settings: "unslick"
      }
    ]
  };

  function toggleSlick() {
    var w = window.innerWidth;

    if (w < 992) {
      if (!$slider.hasClass('slick-initialized')) {
        $slider.slick(slickSettings);
      } else {
        $slider.slick('resize');
      }
    } else {
      if ($slider.hasClass('slick-initialized')) {
        $slider.slick('unslick');
      }
    }
  }

  toggleSlick();
  window.addEventListener('resize', toggleSlick);
});
</script>
{% schema %}
{
  "name": "Products Grid",
  "settings": [
    { "type": "checkbox", "id": "full_width", "label": "Full width section", "default": false },

    { "type": "header", "content": "Background & container" },
    { "type": "color", "id": "section_bg_color", "label": "Section background color", "default": "#f6f1ea" },
    { "type": "range", "id": "section_max_width", "min": 800, "max": 1800, "step": 50, "label": "Section max width (px)", "default": 1400, "info": "Ignored when Full width is enabled." },

    { "type": "header", "content": "Padding (desktop)" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 200, "step": 2, "label": "Padding top (px)", "default": 60 },
    { "type": "range", "id": "padding_right_desktop", "min": 0, "max": 200, "step": 2, "label": "Padding right (px)", "default": 20 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 200, "step": 2, "label": "Padding bottom (px)", "default": 60 },
    { "type": "range", "id": "padding_left_desktop", "min": 0, "max": 200, "step": 2, "label": "Padding left (px)", "default": 20 },

    { "type": "header", "content": "Padding (mobile)" },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 150, "step": 2, "label": "Padding top (px)", "default": 40 },
    { "type": "range", "id": "padding_right_mobile", "min": 0, "max": 150, "step": 2, "label": "Padding right (px)", "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 150, "step": 2, "label": "Padding bottom (px)", "default": 40 },
    { "type": "range", "id": "padding_left_mobile", "min": 0, "max": 150, "step": 2, "label": "Padding left (px)", "default": 16 },

    { "type": "header", "content": "Header content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the Provence Collection" },
    { "type": "html", "id": "info_html", "label": "Desktop: Right info HTML", "info": "Desktop: Use this for Flexpay/BNPL content and logo." },
    { "type": "html", "id": "info_html_mob", "label": "Mobile: Right info HTML", "info": "Mobile: Use this for Flexpay/BNPL content and logo." },

    { "type": "header", "content": "Header layout" },
    { "type": "range", "id": "header_gap", "min": 0, "max": 120, "step": 2, "label": "Header gap (px)", "default": 60 },
    { "type": "range", "id": "header_margin_bottom", "min": 0, "max": 120, "step": 2, "label": "Header margin bottom (px)", "default": 24 },

    { "type": "header", "content": "Heading typography" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#111111" },
    { "type": "range", "id": "heading_size_desktop", "min": 18, "max": 90, "step": 2, "label": "Heading size desktop (px)", "default": 46 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 60, "step": 2, "label": "Heading size mobile (px)", "default": 32 },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "500"
    },
    { "type": "range", "id": "heading_line_height", "min": 1, "max": 2, "step": 0.1, "label": "Heading line height", "default": 1 },
    { "type": "range", "id": "heading_letter_spacing", "min": -2, "max": 5, "step": 0.1, "label": "Heading letter spacing (px)", "default": 0 },

    { "type": "header", "content": "Right info typography" },
    { "type": "color", "id": "info_color", "label": "Info text color", "default": "#333333" },
    { "type": "range", "id": "info_size_desktop", "min": 12, "max": 24, "step": 1, "label": "Info size desktop (px)", "default": 13 },
    { "type": "range", "id": "info_size_mobile", "min": 12, "max": 22, "step": 1, "label": "Info size mobile (px)", "default": 13 },
    {
      "type": "select",
      "id": "info_weight",
      "label": "Info weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" }
      ],
      "default": "400"
    },
    { "type": "range", "id": "info_line_height", "min": 1, "max": 2.2, "step": 0.1, "label": "Info line height", "default": 1 },
    { "type": "range", "id": "info_letter_spacing", "min": -1, "max": 4, "step": 0.1, "label": "Info letter spacing (px)", "default": 0 },

    { "type": "header", "content": "Products" },
    { "type": "product_list", "id": "products", "label": "Products" },

    { "type": "header", "content": "Grid layout" },
    { "type": "range", "id": "columns_desktop", "min": 1, "max": 4, "step": 1, "label": "Columns desktop", "default": 2 },
    { "type": "range", "id": "columns_tablet", "min": 1, "max": 3, "step": 1, "label": "Columns tablet", "default": 2 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns mobile", "default": 1 },
    { "type": "range", "id": "grid_gap_desktop", "min": 0, "max": 60, "step": 2, "label": "Grid gap desktop (px)", "default": 24 },
    { "type": "range", "id": "grid_gap_mobile", "min": 0, "max": 50, "step": 2, "label": "Grid gap mobile (px)", "default": 16 },

    { "type": "header", "content": "Item wrapper (optional)" },
    { "type": "color", "id": "item_bg_color", "label": "Item background", "default": "rgba(255,255,255,0)" },
