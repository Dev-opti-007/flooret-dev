<section class="video-hero-split">
  <div class="video-hero__media">
    {% assign desktop_video = section.settings.desktop_video %}
    {% assign mobile_video = section.settings.mobile_video %}

    {%- if desktop_video != blank -%}
      <video
        class="video-hero__video desktop-video"
        autoplay
        muted
        loop
        playsinline
      >
        <source src="{{ desktop_video.sources[1].url }}" type="video/mp4">
      </video>

      <video
        class="video-hero__video mobile-video"
        autoplay
        muted
        loop
        playsinline
      >
        {% if mobile_video != blank %}
          <source src="{{ mobile_video.sources[1].url }}" type="video/mp4">
        {% else %}
          <source src="{{ desktop_video.sources[1].url }}" type="video/mp4">
        {% endif %}
      </video>
    {%- endif -%}

    <div class="video-hero__overlay"></div>
  </div>

  <div class="page-width video-hero__content">
    <div class="video-hero__left">
      {% if section.settings.heading != blank %}
        <h2 class="video-hero__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}
    </div>

    <div class="video-hero__right">
      {% if section.settings.text != blank %}
        <div class="video-hero__text rte">
          {{ section.settings.text }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="video-hero__button"
        >
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

<style>
      .video-hero-split {
        position: relative;
        overflow: hidden;
        min-height: 700px;
        display: flex;
        align-items: center;
      }

      .video-hero__media {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .video-hero__video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      }

      .mobile-video {
        display: none;
      }

      .video-hero__overlay {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,0.35);
      }

      .video-hero__content {
        position: relative;
        z-index: 2;
        width: 100%;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        padding-top: 80px;
        padding-bottom: 80px;
      }

      .video-hero__right {
        max-width: 360px;
        justify-self: end;
        text-align: left;
      }

      .video-hero__heading {
        color: #fff;
        font-size: 36px;
        font-weight: 400;
        line-height: 1.1;
        margin: 0;
        max-width: 500px;
      }

      .video-hero__text {
        color: #fff;
        font-size: 16px;
        line-height: 1.6;
        margin-bottom: 24px;
        max-width: 420px;
      }

      .video-hero__button {
        display: inline-block;
        color: #fff;
        text-decoration: none;
        padding-bottom: 4px;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.5px;
        transition: opacity 0.3s ease;
      }

      .video-hero__button:hover {
        opacity: 0.7;
      }

  /* MOBILE */
  @media screen and (max-width: 749px) {

    .desktop-video {
      display: none;
    }

    .mobile-video {
      display: block;
    }

    .video-hero-split {
      min-height: 85vh;
      align-items: self-start;
    }

    .video-hero__media,
    .video-hero__video {
      height: 100%;
    }

    .video-hero__content {
      position: relative;
      z-index: 2;

      display: flex;
      flex-direction: column;

      align-items: flex-start;
      justify-content: center;

      width: 100%;
      height: 100%;

      padding: 0px 24px;

      gap: 18px;
    }

    .video-hero__left,
    .video-hero__right {
      width: 100%;
      max-width: 100%;
    }

    .video-hero__right {
      justify-self: unset;
    }

    .video-hero__heading {
      font-size: 32px;
      line-height: 1.1;
      max-width: 260px;
      margin: 0 0 10px;
    }

    .video-hero__text {
      font-size: 15px;
      line-height: 1.5;
      margin: 0 0 15px;
      max-width: 290px;
    }

    .video-hero__button {
      font-size: 14px;
      padding-top: 4px;
    }
  }
</style>

{% schema %}
{
  "name": "Video Hero Split",
  "settings": [
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop Video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile Video"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your perfect floor"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Instantly preview any color in your home with our visualizer tool.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "TRY ROOM VISUALIZER"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Video Hero Split",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
