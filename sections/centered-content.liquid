{%- liquid
  assign module = section.settings
-%}
<section class="centered-content">
  <div class="container">
    <div class="section__header">
      <span class="preheading">{{ module.preheading }}</span>
      <h2 class="centered-content__heading">{{ module.heading }}</h2>
    </div>
    {%- if module.content != blank -%}
      <div class="section__content">
        {{ module.content | richtext }}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Centered Content",
  "class": "centered-content-section",
  "settings": [
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "presets": [
    {
      "name": "Centered Content",
      "settings": {}
    }
  ]
}
{% endschema %}
