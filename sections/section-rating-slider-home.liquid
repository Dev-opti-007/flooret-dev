<div class="rating-slide-homepage" style="background:{{ section.settings.bg-color }}">

  <div class="page-width" > 
     <div class="left-content">
        <div class="no-slide">
        {{ section.settings.rating-text }}
      </div>
      <span class="divider" ></span>
       <div class="no-slide">
              {{ section.settings.right-text-one }}
          </div>
          <div class="no-slide">
              {{ section.settings.right-text-two }}
          </div>

    </div>
    
      <div class="right-content">
         
          <div class="slider">
            {% for block in section.blocks %}
                <div class="slide" >
                    {{ block.settings.text }}
                </div>
            {% endfor %}
          </div>
      </div>
     
  </div>
  
</div>

<script>
  document.addEventListener('DOMContentLoaded', ()=>{
    {% comment %} if(window.innerWidth < 768) { {% endcomment %}
    $('.slider').slick({
        infinite: true,
        slidesToShow: 1,
        slidesToScroll: 1,
        {% comment %} autoplay: true,
        autoplaySpeed: 8000, {% endcomment %}
        dots: true,
        arrows:true,
        prevArrow: "<button class='slick-arrow prev'><svg xmlns='http://www.w3.org/2000/svg' width='25' height='25' viewBox='0 0 25 25' fill='none'> <circle cx='12.5' cy='12.5' r='12.5' fill='#D9D9D9' fill-opacity='0.5'/> <path d='M13.5463 8.60463L9.9837 12.2594C9.92113 12.3236 9.88611 12.4097 9.88611 12.4993C9.88611 12.589 9.92113 12.6751 9.9837 12.7393L13.5463 16.3954C13.5755 16.4253 13.6103 16.4491 13.6488 16.4654C13.6873 16.4816 13.7287 16.49 13.7704 16.49C13.8122 16.49 13.8536 16.4816 13.8921 16.4654C13.9306 16.4491 13.9654 16.4253 13.9946 16.3954C14.0545 16.334 14.0881 16.2516 14.0881 16.1658C14.0881 16.0799 14.0545 15.9975 13.9946 15.9361L10.6444 12.4993L13.9946 9.06319C14.0543 9.00183 14.0878 8.91956 14.0878 8.83391C14.0878 8.74825 14.0543 8.66598 13.9946 8.60463C13.9654 8.57469 13.9306 8.5509 13.8921 8.53465C13.8536 8.5184 13.8122 8.51003 13.7704 8.51003C13.7287 8.51003 13.6873 8.5184 13.6488 8.53465C13.6103 8.5509 13.5755 8.57469 13.5463 8.60463Z' fill='white'/> </svg></button>", 
        nextArrow: "<button class='slick-arrow next'><svg xmlns='http://www.w3.org/2000/svg' width='25' height='25' viewBox='0 0 25 25' fill='none'> <circle cx='12.5' cy='12.5' r='12.5' fill='#D9D9D9' fill-opacity='0.5'/> <path d='M11.4537 8.60463L15.0163 12.2594C15.0789 12.3236 15.1139 12.4097 15.1139 12.4993C15.1139 12.589 15.0789 12.6751 15.0163 12.7393L11.4537 16.3954C11.4245 16.4253 11.3897 16.4491 11.3512 16.4654C11.3127 16.4816 11.2713 16.49 11.2296 16.49C11.1878 16.49 11.1464 16.4816 11.1079 16.4654C11.0694 16.4491 11.0346 16.4253 11.0054 16.3954C10.9455 16.334 10.9119 16.2516 10.9119 16.1658C10.9119 16.0799 10.9455 15.9975 11.0054 15.9361L14.3556 12.4993L11.0054 9.06319C10.9457 9.00183 10.9122 8.91956 10.9122 8.83391C10.9122 8.74825 10.9457 8.66598 11.0054 8.60463C11.0346 8.57469 11.0694 8.5509 11.1079 8.53465C11.1464 8.5184 11.1878 8.51003 11.2296 8.51003C11.2713 8.51003 11.3127 8.5184 11.3512 8.53465C11.3897 8.5509 11.4245 8.57469 11.4537 8.60463Z' fill='white'/> </svg></button>"
      });
    {% comment %} } {% endcomment %}
  })
</script>

<style>
  .rating-slide-homepage .slider {
    max-height:{{ section.settings.slider-height-desk }}px;
  }

  @media (max-width:768px){
     .rating-slide-homepage .slider {
      max-height:{{ section.settings.slider-height-mob }}px;
    }
  }
  @media (min-width:1600px) {
    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(4) p {
      width:130px;
    }
  }
  .rating-slide-homepage {
      background: rgb(89 104 107);
  }
  
  .rating-slide-homepage .page-width {
      display: flex;
      align-items: center;
      padding: 4px 30px;
  }
  
  .rating-slide-homepage .page-width .left-content {
        width: 50%;
        text-align: center;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 30px;
    }

  .rating-slide-homepage .page-width .left-content:after {
      {% comment %} content: ""; {% endcomment %}
      position: absolute;
      right: 0;
      top: -20%;
      height: 140%;
      width: 1px;
      background: #fff;
  }

  .rating-slide-homepage .page-width .right-content .slider {
    display: flex;
    align-items: center;
    justify-content: center;
}

.rating-slide-homepage .page-width .right-content .slick-arrow.prev {
    order: 2;
}

.rating-slide-homepage .page-width .right-content .slider .slick-list {
    width: calc(100% - 100px );
    order: 1;
    margin-right: 15px;
    {% comment %} max-width: 465px; {% endcomment %}
}

.rating-slide-homepage .page-width .right-content .slick-arrow.next {
    order: 4;
}

.rating-slide-homepage .page-width .right-content .slider ul.slick-dots {
    order: 3;
    margin: 0px;
    list-style: none;
    display: flex;
    margin: 0px 10px;
    gap:8px;
}

.rating-slide-homepage .page-width .right-content .slider ul.slick-dots {
    display:flex;
    align-items: center;
    justify-content:center;
    position: relative;
    top: unset;
    left: unset;
    right: unset;
    transform: none !important;
    bottom: unset;
}
.rating-slide-homepage .page-width .right-content .slider ul.slick-dots li {
    list-style: none;
    margin: 0px;
    height: auto;
    display:flex;
}

.rating-slide-homepage .page-width .right-content .slider ul.slick-dots li button {color: transparent;height: 7px;width: 7px;padding: 0px;border-radius: 50%;border:none; cursor:pointer; transition:all 300ms ease;}

.rating-slide-homepage .page-width .right-content .slider ul.slick-dots li.slick-active button {
    width:10px;
    height:10px
    
}
.rating-slide-homepage .slider.slick-initialized button {
    cursor: pointer;
}
.rating-slide-homepage .slide p {
    font-family: Playfair Display;
    font-weight: 600;
    {% comment %} font-style: Italic; {% endcomment %}
    font-size: 14px !important;
    line-height:1.3 !important;
    leading-trim: NONE;
    text-align:start;
}

.rating-slide-homepage .page-width .right-content .slick-arrow {
    background: none;
    border: none;
    width: fit-content;
    height: fit-content;
}
  
  .rating-slide-homepage .page-width .left-content .no-slide {
        color: #FFC107;
    }
    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) span {
        color: #fff;
        margin-left: 12px;
        font-weight: 700;
        font-size: 18px;
        line-height: 100%;
    }

    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(3) p {
    font-family: Montserrat;
    font-weight: 600;
    font-size: 18px;
    line-height: 100%;
}

    .divider {
        background: #fff;
        width: 1px;
        height: 39px;
    }

    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(2) p {
    font-family: Montserrat;
    font-weight: 600;
    font-style: SemiBold;
    font-size: 18px;
    leading-trim: NONE;
    line-height: 100%;
    letter-spacing: 0%;
}

.rating-slide-homepage .page-width .left-content .no-slide:nth-child(3) p {
    font-family: Montserrat;
    font-weight: 600;
    font-size: 18px;
    line-height: 100%;
}

.rating-slide-homepage .page-width .left-content .no-slide:nth-child(4) p {font-style:SemiBold;background: #D9D9D933;font-family: Montserrat;font-weight: 600;font-size: 10px;width: 114px;height: 21px;display: flex;align-items: center;justify-content: space-evenly;border-radius: 4px;}

  .rating-slide-homepage .page-width .right-content {
      width: 50%;
      overflow: hidden;
      display: flex;
      align-items: center;
  }

  .rating-slide-homepage .page-width .right-content .no-slide,  .rating-slide-homepage .page-width .right-content .slider {

    position: relative;
    text-align: center;
    }

   .rating-slide-homepage .page-width .right-content .slick-slide {
      display: flex;
      align-items: center;
     justify-content:center;
     margin:0px 0px 0px 1px;
  }
  .rating-slide-homepage .page-width .right-content .slider {
    width:100%;
  }

  .rating-slide-homepage .page-width .left-content p {
      font-size: 16px;
      color: #fff;
  }
  
  .rating-slide-homepage .page-width .right-content .slide p {
    color: #fff;
    font-size: 16px;
  }
  .rating-slide-homepage .page-width .right-content .slide::after {
      content: "";
      position: absolute;
      right: 0;
      top: -20%;
      height: 140%;
      width: 1px;
      background: #fff;
  }
  .rating-slide-homepage .page-width .right-content .slide:nth-last-child(1)::after {
      content: none;
  }
  .rating-slide-homepage .page-width .right-content .slide img {
      width: 65%;
  }

  .rating-slide-homepage .page-width .right-content .slider .slick-list .slick-track {
      display: flex;
      align-items: center;
  }

  .rating-slide-homepage .slider {
    opacity:0;
    transition:all 300ms ease;
  }
  .rating-slide-homepage .slider.slick-initialized  {
    opacity:1;
  }

  @media (max-width:1280px){
  .rating-slide-homepage .page-width .left-content {
    width: fit-content !important;

  }
  .rating-slide-homepage .page-width .right-content .slider ul.slick-dots {
      position: relative;
      top: 3px;
  }
  .rating-slide-homepage .page-width {
      gap:30px;
  }
  .rating-slide-homepage .page-width .left-content {
    
  }
  .rating-slide-homepage .page-width .left-content .no-slide:nth-child(3) p {
    white-space:nowrap;
  }
  .rating-slide-homepage .page-width {
    padding:4px 30px;
  }
  .rating-slide-homepage .page-width .left-content .no-slide:nth-child(3) p,
  .rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) span {
    font-size:16px;
  }
  .rating-slide-homepage .page-width .right-content .slider .slick-list {
    {% comment %} max-width:390px !important; {% endcomment %}
     width:calc(100% - 100px );
  }
  .rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) {
    font-size: 14px;
    text-align: center;
  }
  .rating-slide-homepage .page-width .right-content .slick-arrow {
        width: 20px;
        height: 20px;
        padding: 0px;
  }
  

}

@media (max-width:1100px){
.rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) span {
    display: block;
    margin: 0px;
}

.rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) {white-space: nowrap;}

}

  @media (max-width:1024px){
    .rating-slide-homepage .page-width .right-content .slider .slick-list {
      width:100%;
    }
    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(3) p {
      white-space:unset;
    }

    .rating-slide-homepage .page-width .left-content {
        gap: 2%;
    }
    .rating-slide-homepage .page-width .right-content .slider ul.slick-dots {
      {% comment %} margin: 0px; {% endcomment %}
    }
    .rating-slide-homepage .page-width .right-content .slick-arrow {
        width: 20px;
        height: 20px;
        padding: 0px;
    }
    .rating-slide-homepage .page-width {
      flex-wrap:wrap;
      gap:10px;
     
    }
    .rating-slide-homepage .page-width .left-content,
    .rating-slide-homepage .page-width .right-content  {
      width:100% !important;
    }
    .rating-slide-homepage .page-width .right-content {
     justify-content: center;
    }
    {% comment %} .rating-slide-homepage .page-width .right-content .slider {
      width:100%;
    } {% endcomment %}
       .rating-slide-homepage .page-width .right-content .slider {
        display: grid;
        grid-template-columns: auto 60px auto;
        padding-bottom: 5px;
        row-gap: 8px;
        justify-content:center;
        max-height: 390px;
        max-width: 80%;
    }

    .rating-slide-homepage .page-width .right-content .slider .slick-list {
        grid-column: 1/4;
        margin: 0pc;
    }

    .rating-slide-homepage .page-width .right-content .slick-arrow.prev {
        grid-column: 1/2;
        justify-self: end;
    }

    .rating-slide-homepage .page-width .right-content .slick-arrow.next {
        grid-column: 3/4;
        justify-self: start;
    }

    .rating-slide-homepage .page-width .right-content .slider ul.slick-dots {
        grid-column: 2/3;
        width: fit-content;
        margin: 0px auto;
        align-self: center;
    }
    .rating-slide-homepage .slide p{
      text-align: center;
    }
  }

  @media (max-width:768px){
    .rating-slide-homepage .page-width .right-content .slick-arrow {
      height:15px;
      width:15px;
    }
    .rating-slide-homepage .page-width .right-content .slick-arrow svg {
      height:15px;
      width:15px;
    }
    .rating-slide-homepage .page-width .right-content .slider ul.slick-dots {
      top:0px !important;
    }
    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) span {
        font-family: Montserrat;
        font-weight: 700;
        font-size: 14px;
        line-height: 100%;
        margin: 0px;
        display:inline;
    }

    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(3) p {
        font-family: Montserrat;
        font-weight: 600;
        font-size: 12px;
        line-height: 100%;
        line-height: 1.3;
    }

    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(4) p {
        font-family: Montserrat;
        font-weight: 400;
        font-size: 6px;
        line-height: 100%;
        width: 66px;
        height: 15px;
        
    }

    .divider {
        height: 32px;
    }

    .rating-slide-homepage .slide p {
      text-align:center;
      font-family: Playfair Display;
      font-weight: 600;
      font-style: Italic;
      font-size: 14px;
      text-align: center;
      padding:0px 10px;
      line-height:1.4 !important;
    }

    .rating-slide-homepage .page-width .right-content .slider ul.slick-dots li button {
      height: 6px;
      width: 6px;
    }
    .rating-slide-homepage .page-width .right-content .slider ul.slick-dots li.slick-active button {
            width: 8px;
            height: 8px;
        }
        .rating-slide-homepage .page-width .right-content .slider ul.slick-dots {
          position: relative;
          top: 5px;
      }

      .rating-slide-homepage .page-width {
        padding: 4px 10px;
    }
        

    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) {order:1}

    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(3) {order:4}

    .rating-slide-homepage .page-width .left-content .no-slide:nth-child(4) {order:2}

    .rating-slide-homepage .page-width .left-content .divider:nth-child(2) {order:3}

   .rating-slide-homepage .page-width .right-content .slider {
        display: grid;
        grid-template-columns: auto 60px auto;
        padding-bottom: 5px;
        row-gap: 8px;
        justify-content:center;
    }

    .rating-slide-homepage .page-width .right-content .slider .slick-list {
        grid-column: 1/4;
        margin: 0pc;
    }

    .rating-slide-homepage .page-width .right-content .slick-arrow.prev {
        grid-column: 1/2;
        justify-self: end;
    }

    .rating-slide-homepage .page-width .right-content .slick-arrow.next {
        grid-column: 3/4;
        justify-self: start;
    }

    .rating-slide-homepage .page-width .right-content .slider ul.slick-dots {
        grid-column: 2/3;
        width: fit-content;
        margin: 0px auto;
        align-self: center;
    }
  }
  @media (max-width:550px){
        .rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) span {
          font-family: Montserrat;
          font-weight: 700;
          font-size: 10px;
          line-height: 100%;
          margin: 0px;
          display:inline;
      }

      .rating-slide-homepage .page-width .left-content .no-slide:nth-child(1) {
        font-size: 10px;
      }

      .rating-slide-homepage .page-width .left-content .no-slide:nth-child(3) p {
          font-family: Montserrat;
          font-weight: 600;
          font-size: 10px;
          line-height: 100%;
          line-height: 1.3;
      }

  }
</style>

{% schema %}
  {
    "name": "Rating Slider Homepage",
    "settings": [
      {
        "type": "header",
        "content": "Slider Max Height"
      },
      {
        "type": "range",
        "id": "slider-height-desk",
        "label": "Slider Height Desktop",
        "min": 10,
        "max": 110,
        "step": 1,
        "default": 100
      },
      {
        "type": "range",
        "id": "slider-height-mob",
        "label": "Slider Height Mobile",
        "min": 10,
        "max": 110,
        "step": 1,
        "default": 50
      },
      {
          "type": "html",
          "id": "bg-color",
          "label":"Background-color"
      },
      {
        "type": "header",
        "content": "Left Content"
      },
      {
        "type": "html",
        "id": "rating-text",
        "label": "Rating Text"
      },
      {
        "type": "header",
        "content": "Middle Content"
      },
      {
        "type": "richtext",
        "id": "right-text-one",
        "label": "Right Slide Text One"
      },
      {
        "type": "richtext",
        "id": "right-text-two",
        "label": "Right Slide Text Two"
      },
      {
        "type": "header",
        "content": "Right Content",
        "info": "For right content slider add blocks."
      }
    ],
    "blocks": [
        {
            "type": "slider-text",
            "name":"Slider Text",
            "settings": [
                {
                    "type": "richtext",
                    "id": "text",
                    "label": "Text"
                }
            ]
        }
    ],
    "presets": [
      {
        "name": "Rating Slider Homepage"
      }
    ]
  }
{% endschema %}