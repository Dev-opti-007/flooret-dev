<div class="img-banner--container">
  {% if section.settings.image != blank and section.settings.image_mobile != blank %}
    {{
      section.settings.image
      | image_url: width: 3200
      | image_tag:
        alt: section.settings.image.alt,
        class: 'desktop-img',
        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
    }}
    {{
      section.settings.image_mobile
      | image_url: width: 2000
      | image_tag: alt: section.settings.image_mobile.alt, class: 'mobile-img'
    }}
  {% elsif section.settings.image != blank %}
    {{
      section.settings.image
      | image_url: width: 3200
      | image_tag:
        alt: section.settings.image.alt,
        widths: '50, 75, 100, 150, 200, 300, 400, 500, 750, 1000, 1250, 1500, 1750, 2000, 2250, 2500, 2750, 3000, 3200'
    }}
  {% else %}
    {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {% endif %}
  <div class="text--container">
    {% if section.settings.preheading != blank %}
      <p>{{ section.settings.preheading }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h4>{{ section.settings.heading }}</h4>
    {% endif %}
    {% if block.settings.btn-one-link != blank %}
    <a class="button" href="{{ block.settings.btn-one-link }}">{{ block.settings.btn-one-text }}</a>
    {% endif %}
  </div>
</div>

{% style %}
  .section--img-banner {
    padding: 0;
  }
  .img-banner--container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .img-banner--container .text--container {
    width: fit-content;
    position: absolute;
    background-color: white;
    padding: 24px 40px;
    left: unset;
  }
  .img-banner--container img {
    object-fit: cover;
    height: 27rem;
  }
  .section--img-banner p {
    font-size: 14px;
    font-weight: 700;
  }
  .section--img-banner h4 {
    font-size: 32px;
    font-weight: 700;
    font-family: 'Playfair Display', serif;
  }
  .section--img-banner p,
  .section--img-banner h4 {
    margin: 0;
  }
  .section--img-banner .desktop-img {
    display: none;
  }
  @media (min-width: 768px) {
    .section--img-banner .desktop-img {
      display: block;
    }
    .section--img-banner .mobile-img {
      display: none;
    }
    .img-banner--container .text--container {
      left: 100px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Image Banner",
  "class": "section--img-banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image Desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image Mobile"
    },
    {
      "type": "text",
      "id": "preheading",
      "label": "Preheading",
      "default": "Preheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
          "type": "text",
          "id": "btn-one-text",
          "label": "Button One Text"
        },
        {
          "type": "url",
          "id": "btn-one-link",
          "label": "Button One Link"
        }
  ],
  "presets": [
    {
      "category": "Image",
      "name": "Image Banner"
    }
  ]
}
{% endschema %}
