<div class="container-v2 why-choose-two--{{ section.id }} " >

    <div class="img-vid-wrap" >
        <img class="large_image" src="{{ section.settings.large-image | img_url:'500x' }}" alt="{{ section.settings.large-image.alt }}">
        <img class="small_round_image" src="{{ section.settings.small-round-image | img_url:'200x' }}" alt="{{ section.settings.small-round-image.alt }}">
    </div>

    <div class="text-wrap" >
        {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        <div class="card_wrap_sm" >
            {% for block in section.blocks %}
                <div class="card-sm" >
                    <img src="{{ block.settings.icon | img_url:'50x' }}" alt="{{ block.settings.icon.alt }}">
                    <h5>{{ block.settings.title }}</h5>
                    <div class="subtext" >
                        {{ block.settings.subtext }}
                    </div>
                </div>
                <hr>
            {% endfor %}
        </div>
    </div>



</div>


{% style %} 

.why-choose-two {
    background-color:{{  section.settings.bg-color }};
 }

.why-choose-two .why-choose-two--{{ section.id }} .text-wrap h2 {
    font-family:{{ section.settings.font-heading }};
    font-size:{{ section.settings.font_size_heading_desk }}px;
    {% if section.settings.heading-color != blank %} color:{{ section.settings.heading-color }}; {% endif %}
}

.why-choose-two .why-choose-two--{{ section.id }} .text-wrap .card_wrap_sm .card-sm h5 {
    font-family:{{ section.settings.font-body-title }};
    font-size:{{ section.settings.font_size_body_title_desk }}px;
    {% if section.settings.body-title-color != blank %} color:{{ section.settings.body-title-color }}; {% endif %}
}

.why-choose-two .why-choose-two--{{ section.id }} .text-wrap .card_wrap_sm .card-sm .subtext p {
    font-family:{{ section.settings.font_size_body_subtext_desk }};
    font-size:{{ section.settings.font_size_body_desk_two }}px;
    {% if section.settings.body-subtext-color != blank %} color:{{ section.settings.body-subtext-color }}; {% endif %}
}

.why-choose-two .container-v2 {max-width: 1100px;margin: 0 auto;text-align: center;display: flex;padding: 50px 0px 100px;gap: 100px;}

.why-choose-two .container-v2 .img-vid-wrap {
    width: 45%;
}

.why-choose-two .container-v2 .text-wrap {width: 55%;text-align: start;}

.why-choose-two .container-v2 .img-vid-wrap img.small_round_image {
    top: -6%;
    right: -10%;
    left: unset;
}

.why-choose-two .container-v2 .text-wrap .card_wrap_sm {
    display: flex;
    flex-direction: column;
    gap: 30px;
    margin-top: 50px;
}

.why-choose-two .container-v2 .text-wrap .card_wrap_sm .card-sm {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px;
    align-items:center;
}

.why-choose-two .container-v2 .text-wrap .card_wrap_sm .card-sm img {
    grid-column: 1/2;
    grid-row: 1;
}

.why-choose-two .container-v2 .text-wrap .card_wrap_sm .card-sm h5 {
    grid-column: 2/3;
    grid-row: 1;
    margin: 0px;
    font-family: Montserrat;
    font-weight: 600;
    font-style: SemiBold;
    font-size: 19.2px;
    leading-trim: NONE;
    line-height: 28.8px;
    letter-spacing: 0%;
    vertical-align: middle;
    text-align: start;
    color:#111111;
}

.why-choose-two .container-v2 .text-wrap .card_wrap_sm .card-sm .subtext {
    grid-column: 1 / 3;
    grid-row: 2;
}
.why-choose-two .container-v2 .text-wrap .card_wrap_sm .card-sm .subtext p{
    font-family: Montserrat;
    font-weight: 400;
    font-style: Regular;
    font-size: 17.6px;
    leading-trim: NONE;
    line-height: 28.16px;
    letter-spacing: 0%;
    vertical-align: middle;
    color:#343334;
}
.why-choose-two .container-v2 .text-wrap .card_wrap_sm hr {
    border: 1px dashed #000000;
    margin-bottom: 10px;
}
.why-choose-two .container-v2 .text-wrap .card_wrap_sm hr:last-of-type {
    display: none;
}

@media (max-width:768px){

    .why-choose-two .why-choose-two--{{ section.id }} .text-wrap h2 {
        font-size:{{ section.settings.font_size_heading_mob }}px;
    }

    .why-choose-two .why-choose-two--{{ section.id }} .text-wrap .card_wrap_sm .card-sm h5 {
        font-size:{{ section.settings.font_size_body_title_mob }}px;
    }

    .why-choose-two .why-choose-two--{{ section.id }} .text-wrap .card_wrap_sm .card-sm .subtext p {
        font-size:{{ section.settings.font_size_body_subtext_mob }}px;
    }

}

{% endstyle %}




{% schema %}
{
  "name": "Why Choose Two",
  "class": "shopify-section why-choose-two",
  "settings": [
        {   
            "type": "color",
            "id":"bg-color",
            "label": "Background Color"
        },
        {
            "type": "html",
            "id":"heading",
            "label": "Heading"
        },
        {
            "type": "text",
            "id": "btn-text",
            "label": "Button Text"
        },
        {
            "type": "url",
            "id": "btn-link",
            "label": "Button Link"
        },
        {
            "type": "image_picker",
            "id": "large-image",
            "label": "Large Image"
        },
        {
            "type": "image_picker",
            "id": "small-round-image",
            "label": "Small Round Image"
        },
        {
          "type": "header",
          "content": "Font family"
        },
        {
          "type": "select",
          "id": "font-heading",
          "label": "Font Family Heading",
          "options": [
            {
              "value": "Montserrat",
              "label": "Montserrat"
            },
            {
              "value": "Roboto",
              "label": "Roboto"
            },
            {
              "value": "Helvetica Neue",
              "label": "Helvetica Neue"
            }
          ],
          "default": "Montserrat"
        },
        {
          "type": "select",
          "id": "font-body-title",
          "label": "Font Family Body Title",
          "options": [
            {
              "value": "Montserrat",
              "label": "Montserrat"
            },
            {
              "value": "Roboto",
              "label": "Roboto"
            },
            {
              "value": "Helvetica Neue",
              "label": "Helvetica Neue"
            }
          ],
          "default": "Montserrat"
        },
        {
          "type": "select",
          "id": "font-body-subtext",
          "label": "Font Family Body Subtext",
          "options": [
            {
              "value": "Montserrat",
              "label": "Montserrat"
            },
            {
              "value": "Roboto",
              "label": "Roboto"
            },
            {
              "value": "Helvetica Neue",
              "label": "Helvetica Neue"
            }
          ],
          "default": "Montserrat"
        },
        {
          "type": "select",
          "id": "font-button",
          "label": "Font Family Button",
          "options": [
            {
              "value": "Montserrat",
              "label": "Montserrat"
            },
            {
              "value": "Roboto",
              "label": "Roboto"
            },
            {
              "value": "Helvetica Neue",
              "label": "Helvetica Neue"
            }
          ],
          "default": "Montserrat"
        },
        {
          "type": "header",
          "content": "Font Sizes Desktop"
        },
        {
          "type": "range",
          "id": "font_size_heading_desk",
          "min": 10,
          "max": 100,
          "step": 1,
          "unit": "px",
          "label": "Font size Heading Desktop",
          "default": 42
        },
        {
          "type": "range",
          "id": "font_size_body_title_desk",
          "min": 5,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Font size Title Desktop",
          "default": 19
        },
        {
          "type": "range",
          "id": "font_size_body_subtext_desk",
          "min": 5,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Font size Subtext Desktop",
          "default": 17
        },
        {
          "type": "header",
          "content": "Font Sizes Mobile"
        },
        {
          "type": "range",
          "id": "font_size_heading_mob",
          "min": 1,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Font size Heading Mobile",
          "default": 26
        },
        {
          "type": "range",
          "id": "font_size_body_title_mob",
          "min": 1,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Font size Title Mobile",
          "default": 19
        },
        {
          "type": "range",
          "id": "font_size_body_subtext_mob",
          "min": 1,
          "max": 80,
          "step": 1,
          "unit": "px",
          "label": "Font size Subtext Mobile",
          "default": 17
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id":"heading-color",
          "label": "Heading Color"
        },
        {
          "type": "color",
          "id":"body-title-color",
          "label": "Body Title Color"
        },
        {
          "type": "color",
          "id":"body-subtext-color",
          "label": "Body Subtext Color"
        }
  ],
  "blocks": [
    {
        "type": "text",
        "name":"Text",
        "settings": [
            {
                "type": "image_picker",
                "id": "icon",
                "label": "Icon"
            },
            {
                "type": "text",
                "id": "title",
                "label": "Title"
            },
            {
                "type":"richtext",
                "id": "subtext",
                "label": "Subtext"
            }
        ]
    } 
  ],
  "presets": [
    {
      "name": "Why Choose Two"
    }
  ]
}
{% endschema %}
