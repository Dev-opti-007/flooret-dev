{%- liquid
  assign grid_columns_desktop = section.settings.grid_columns_desktop | default: 3
  assign grid_columns_tablet = section.settings.grid_columns_tablet | default: 2
  assign grid_columns_mobile = section.settings.grid_columns_mobile | default: 1
-%}

<style>
  /* Prevent initial flash for heading and top button */
  .stories-grid--{{ section.id }} .stories-grid__heading,
  .stories-grid--{{ section.id }} .top-heading-wrap .stories-grid__button {
    opacity: 0;
    transform: translateY(50px);
    will-change: transform, opacity;
  }


.stories-grid {
  padding: var(--sg-padding, 60px 20px);
  background: var(--sg-bg-color, #ffffff);
  max-width: var(--sg-max-width, 1200px);
  margin: 0 auto;
  padding-top:var(--sg-padding-top);
  padding-bottom:var(--sg-padding-bottom);
}

.top-heading-wrap {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: var(--sg-heading-margin, 40px);
}

.stories-grid__heading {
  text-align: var(--sg-heading-align, center);
  margin: 0;
  font-family: var(--sg-heading-font-family, 'system-ui'), sans-serif;
  font-size: var(--sg-heading-size-d, 36px);
  color: var(--sg-heading-color, #000000);
  font-weight: var(--sg-heading-weight, 600);
  line-height: 1.2;
  flex: 1;
  min-width: 0;
}

.stories-grid__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin: var(--sg-button-margin, 0);
  padding: var(--sg-button-padding, 12px 24px);
  background: var(--sg-button-bg, #000000);
  color: var(--sg-button-color, #ffffff);
  border: var(--sg-button-border, none);
  border-radius: var(--sg-button-radius, 4px);
  font-family: var(--sg-button-font-family, 'system-ui'), sans-serif;
  font-size: var(--sg-button-size-d, 16px);
  font-weight: var(--sg-button-weight, 500);
  text-decoration: none;
  transition: all 0.3s ease;
  white-space: nowrap;
  flex-shrink: 0;
}

.stories-grid__button:hover {
  background: var(--sg-button-hover-bg, #333333);
  color: var(--sg-button-hover-color, #ffffff);
  transform: translateY(-2px);
}

.stories-grid__grid {
  display: grid;
  grid-template-columns: repeat({{ grid_columns_desktop }}, 1fr);
  gap: var(--sg-grid-gap, 30px);
  margin-top: var(--sg-grid-margin, 0);
}

.stories-grid__story {
  position: relative;
  overflow: hidden;
  border-radius: var(--sg-story-radius, 8px);
  height: var(--sg-story-height, 300px);
  background: var(--sg-story-bg, #f5f5f5);
}

.stories-grid__story-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.stories-grid__story:hover .stories-grid__story-image {
  transform: scale(1.05);
}

.stories-grid__story-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: var(--sg-overlay-height, 60%);
  background: linear-gradient(transparent, var(--sg-overlay-bg, rgba(0,0,0,0.8)));
  color: var(--sg-overlay-text-color, #ffffff);
  padding: var(--sg-overlay-padding, 20px);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transform: translateY(100%);
  transition: transform 0.4s ease;
  box-sizing: border-box;
}

.slick-slide.slick-current.slick-active .stories-grid__story .stories-grid__story-overlay,
.stories-grid__story:hover .stories-grid__story-overlay {
  transform: translateY(0);
}

.stories-grid__story-name {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--sg-name-font-family, 'system-ui'), sans-serif;
  font-size: var(--sg-name-size-d, 18px);
  font-weight: var(--sg-name-weight, 600);
  margin: 0 0 8px 0;
  line-height: 1.3;
}

.stories-grid__customer-img {
  width: var(--sg-customer-img-size, 40px);
  height: var(--sg-customer-img-size, 40px);
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.stories-grid__story-name span {
  flex: 1;
}

.stories-grid__story-quote {
  font-family: var(--sg-quote-font-family, 'system-ui'), sans-serif;
  font-size: var(--sg-quote-size-d, 14px);
  font-weight: var(--sg-quote-weight, 400);
  line-height: 1.4;
  margin: 0;
  opacity: 0.9;
}

.stories-grid__story-link {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  text-decoration: none;
}

.desk-hide.stories-grid__button {
  display:none;
}

/* Responsive Grid */

@media (max-width: 1024px) {


  .top-heading-wrap {
    justify-content: center;
    text-align: center;
  }

  .desk-hide.stories-grid__button {
      display: flex;
      margin-top: 20px;
      margin-left: auto;
      margin-right: auto;
      max-width: 244px;
  }
  
  .stories-grid__grid {
    display:block;
    grid-template-columns: repeat({{ grid_columns_tablet }}, 1fr);
    gap: calc(var(--sg-grid-gap, 30px) * 0.8);
  }
  
  .stories-grid {
    --sg-story-height: 250px;
  }
  
  .stories-grid__heading {
    font-size: var(--sg-heading-size-t, 32px);
  }
  
  .stories-grid__button {
    font-size: var(--sg-button-size-t, 15px);
    padding: var(--sg-button-padding-t, 10px 20px);
  }
  
  .stories-grid__story-name {
    font-size: var(--sg-name-size-t, 16px);
  }
  
  .stories-grid__story-quote {
    font-size: var(--sg-quote-size-t, 13px);
  }
  
  .stories-grid__customer-img {
    --sg-customer-img-size: 35px;
  }
}

@media (max-width: 768px) {

  .stories-grid__story-overlay {
      transform: translateY(130%)
  }
  .stories-grid__grid .slick-track .slick-slide {
      margin: 0px 10px;
  }
  .top-heading-wrap a.stories-grid__button {
      display: none;
  }

  .stories-grid {
    padding: var(--sg-mobile-padding, 40px 15px);
    --sg-story-height: 200px;
  }
  
  .top-heading-wrap {
    flex-direction: column;
    gap: 15px;
  }
  
  .stories-grid__grid {
    grid-template-columns: repeat({{ grid_columns_mobile }}, 1fr);
    gap: calc(var(--sg-grid-gap, 30px) * 0.6);
  }
  
  .stories-grid__heading {
    font-size: var(--sg-heading-size-m, 28px);
   
  }
  .top-heading-wrap { 
   margin-bottom: var(--sg-heading-margin-m, 30px);
  }
  .stories-grid__button {
    font-size: var(--sg-button-size-m, 14px);
    padding: var(--sg-button-padding-m, 10px 18px);
    width: 100%;
    max-width: 300px;
  }
  
  .stories-grid__story-overlay {
    padding: var(--sg-overlay-padding-m, 15px);
    --sg-overlay-height: 75%;
  }
  
  .stories-grid__story-name {
    font-size: var(--sg-name-size-m, 15px);
  }
  
  .stories-grid__story-quote {
    font-size: var(--sg-quote-size-m, 12px);
  }
  
  .stories-grid__customer-img {
    --sg-customer-img-size: 30px;
  }
}

/* Section-specific dynamic styles */
.stories-grid--{{ section.id }} {
  --sg-padding-top:{{ section.settings.padding-top }}px;
  --sg-padding-bottom:{{ section.settings.padding-bottom }}px;
  --sg-padding: {{ section.settings.padding }}px {{ section.settings.padding_horizontal }}px;
  --sg-mobile-padding: {{ section.settings.mobile_padding }}px {{ section.settings.mobile_padding_horizontal }}px;
  --sg-bg-color: {{ section.settings.bg_color }};
  --sg-max-width: {{ section.settings.max_width }}px;
  --sg-heading-align: {{ section.settings.heading_align }};
  --sg-heading-margin: {{ section.settings.heading_margin }}px;
  --sg-heading-margin-m: {{ section.settings.heading_margin_mobile }}px;
  --sg-heading-font-family: '{{ section.settings.heading_font_family }}', sans-serif;
  --sg-heading-size-d: {{ section.settings.heading_size_desktop }}px;
  --sg-heading-size-t: {{ section.settings.heading_size_tablet }}px;
  --sg-heading-size-m: {{ section.settings.heading_size_mobile }}px;
  --sg-heading-color: {{ section.settings.heading_color }};
  --sg-heading-weight: {{ section.settings.heading_weight }};
  --sg-button-margin: {{ section.settings.button_margin }}px;
  --sg-button-padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
  --sg-button-padding-t: {{ section.settings.button_padding_vertical_tablet }}px {{ section.settings.button_padding_horizontal_tablet }}px;
  --sg-button-padding-m: {{ section.settings.button_padding_vertical_mobile }}px {{ section.settings.button_padding_horizontal_mobile }}px;
  --sg-button-font-family: '{{ section.settings.button_font_family }}', sans-serif;
  --sg-button-size-d: {{ section.settings.button_size_desktop }}px;
  --sg-button-size-t: {{ section.settings.button_size_tablet }}px;
  --sg-button-size-m: {{ section.settings.button_size_mobile }}px;
  --sg-button-weight: {{ section.settings.button_weight }};
  --sg-button-bg: {{ section.settings.button_bg }};
  --sg-button-color: {{ section.settings.button_color }};
  --sg-button-hover-bg: {{ section.settings.button_hover_bg }};
  --sg-button-hover-color: {{ section.settings.button_hover_color }};
  --sg-button-border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
  --sg-button-radius: {{ section.settings.button_border_radius }}px;
  --sg-grid-gap: {{ section.settings.grid_gap }}px;
  --sg-grid-margin: {{ section.settings.grid_margin }}px;
  --sg-story-height: {{ section.settings.story_height }}px;
  --sg-story-radius: {{ section.settings.story_border_radius }}px;
  --sg-story-bg: {{ section.settings.story_bg }};
  --sg-overlay-height: {{ section.settings.overlay_height }}%;
  --sg-overlay-bg: {{ section.settings.overlay_bg }};
  --sg-overlay-text-color: {{ section.settings.overlay_text_color }};
  --sg-overlay-padding: {{ section.settings.overlay_padding_vertical }}px {{ section.settings.overlay_padding_horizontal }}px;
  --sg-overlay-padding-m: {{ section.settings.overlay_padding_vertical_mobile }}px {{ section.settings.overlay_padding_horizontal_mobile }}px;
  --sg-customer-img-size: {{ section.settings.customer_img_size }}px;
  --sg-name-font-family: '{{ section.settings.name_font_family }}', sans-serif;
  --sg-name-size-d: {{ section.settings.name_size_desktop }}px;
  --sg-name-size-t: {{ section.settings.name_size_tablet }}px;
  --sg-name-size-m: {{ section.settings.name_size_mobile }}px;
  --sg-name-weight: {{ section.settings.name_weight }};
  --sg-quote-font-family: '{{ section.settings.quote_font_family }}', sans-serif;
  --sg-quote-size-d: {{ section.settings.quote_size_desktop }}px;
  --sg-quote-size-t: {{ section.settings.quote_size_tablet }}px;
  --sg-quote-size-m: {{ section.settings.quote_size_mobile }}px;
  --sg-quote-weight: {{ section.settings.quote_weight }};
}
</style>

<div class="stories-grid--{{ section.id }} stories-grid">
  <div class="top-heading-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="stories-grid__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="stories-grid__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
  {% if section.blocks.size > 0 %}
    <div class="stories-grid__grid">
      {% for block in section.blocks %}
        <div class="stories-grid__story" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img src="{{ block.settings.image | image_url: width: 600 }}" 
                 alt="{{ block.settings.image.alt | escape | default: 'Story image' }}" 
                 class="stories-grid__story-image" 
                 loading="lazy">
          {% endif %}
          
          <a href="{{ block.settings.link | default: '#' }}" class="stories-grid__story-link"></a>
          
          <div class="stories-grid__story-overlay">
            {% if block.settings.name != blank %}
              <h3 class="stories-grid__story-name">
                {% if block.settings.customer-image != blank %}
                  <img src="{{ block.settings.customer-image | image_url: width: 100 }}" 
                       alt="{{ block.settings.customer-image.alt | escape | default: 'Customer image' }}" 
                       class="stories-grid__customer-img">
                {% endif %}
                <span>{{ block.settings.name }}</span>
              </h3>
            {% endif %}
            
            {% if block.settings.quote != blank %}
              <div class="stories-grid__story-quote">
                {{ block.settings.quote }}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div class="stories-grid__grid">
      {% for i in (1..6) %}
        <div class="stories-grid__story">
          <div style="width: 100%; height: 100%; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #999;">Add a story block</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
  {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="desk-hide stories-grid__button">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
</div>

<style>
  .stories-grid__story-quote > p > a {
      font-size: 18.5px;
  }

  @media (max-width:768px){
      .stories-grid__story-quote > p > a {
          font-size: 14.8px;
      }
  }
</style>

{% if section.settings.enable-mob-slider != blank %}
<script>
  document.addEventListener("DOMContentLoaded", (event) => { 
    if(window.innerWidth < 768){
      $('.stories-grid__grid').slick({
        infinite: true,
        arrows:false,
        dots:false,
        slidesToShow: 1,
        slidesToScroll:1,
        centerMode: true,
        centerPadding: '40px'
      });
    }
  })
  
    
</script>
{% endif %}


