<script>
document.addEventListener('DOMContentLoaded', function() {
  console.log('Stories Grid GSAP Script - DOMContentLoaded triggered for section {{ section.id }}');
  
  if (!window.gsap || !window.ScrollTrigger) {
    console.error('Stories Grid GSAP Script - GSAP or ScrollTrigger not loaded');
    console.log('window.gsap:', !!window.gsap);
    console.log('window.ScrollTrigger:', !!window.ScrollTrigger);
    return;
  }

  console.log('Stories Grid GSAP Script - GSAP and ScrollTrigger are available');
  gsap.registerPlugin(ScrollTrigger);
  console.log('Stories Grid GSAP Script - ScrollTrigger plugin registered');

  const root = document.querySelector('.stories-grid--{{ section.id }}');
  console.log('Stories Grid GSAP Script - Section ID:', '{{ section.id }}');
  console.log('Stories Grid GSAP Script - Section Root selector used:', '.stories-grid--{{ section.id }}');
  console.log('Stories Grid GSAP Script - Section Root found:', !!root);
  
  if (!root) {
    console.error('Stories Grid GSAP Script - Section root not found');
    console.log('Available stories-grid elements:', document.querySelectorAll('.stories-grid').length);
    console.log('Available sections with similar patterns:', document.querySelectorAll('[class*="stories-grid"]').length);
    return;
  }

  console.log('Stories Grid GSAP Script - Section root found successfully');
  console.log('Stories Grid GSAP Script - Section root classes:', root.className);
  console.log('Stories Grid GSAP Script - Section root children count:', root.children.length);

  // Check for scrollTriggerManager availability
  if (typeof scrollTriggerManager === 'undefined') {
    console.warn('Stories Grid GSAP Script - scrollTriggerManager is not available');
  } else {
    console.log('Stories Grid GSAP Script - scrollTriggerManager is available');
    console.log('scrollTriggerManager methods:', Object.keys(scrollTriggerManager));
  }

  // Mid-page refresh guard
  console.log('Stories Grid GSAP Script - Attempting scrollTriggerManager.revealIfInViewAll');
  const revealTargets = '.stories-grid--{{ section.id }} .stories-grid__heading, ' +
                        '.stories-grid--{{ section.id }} .top-heading-wrap .stories-grid__button';
  
  console.log('Stories Grid GSAP Script - Reveal targets string:', revealTargets);
  
  const revealElements = document.querySelectorAll(revealTargets);
  console.log('Stories Grid GSAP Script - Reveal target elements found:', revealElements.length);
  
  revealElements.forEach((el, index) => {
    console.log(`Stories Grid GSAP Script - Reveal target ${index + 1}:`, {
      tagName: el.tagName,
      className: el.className,
      id: el.id,
      text: el.textContent.substring(0, 50) + (el.textContent.length > 50 ? '...' : '')
    });
  });

  if (typeof scrollTriggerManager !== 'undefined' && scrollTriggerManager.revealIfInViewAll) {
    try {
      scrollTriggerManager.revealIfInViewAll(revealTargets);
      console.log('Stories Grid GSAP Script - scrollTriggerManager.revealIfInViewAll executed successfully');
    } catch (error) {
      console.error('Stories Grid GSAP Script - Error in revealIfInViewAll:', error);
    }
  } else {
    console.warn('Stories Grid GSAP Script - scrollTriggerManager.revealIfInViewAll not available, skipping');
  }

  // 1) Top heading + optional button
  console.log('Stories Grid GSAP Script - Setting up top heading and button animations');
  const heading = root.querySelector('.stories-grid__heading');
  const topBtn = root.querySelector('.top-heading-wrap .stories-grid__button');
  
  console.log('Stories Grid GSAP Script - Top elements found:', {
    heading: !!heading,
    topButton: !!topBtn
  });

  const topTargets = [heading, topBtn].filter(Boolean);
  console.log('Stories Grid GSAP Script - Top targets after filtering:', topTargets.length);

  topTargets.forEach((target, index) => {
    console.log(`Stories Grid GSAP Script - Top target ${index + 1}:`, {
      selector: target.matches('.stories-grid__heading') ? '.stories-grid__heading' : '.top-heading-wrap .stories-grid__button',
      className: target.className,
      text: target.textContent.substring(0, 30) + (target.textContent.length > 30 ? '...' : '')
    });
  });

  if (topTargets.length > 0) {
    console.log('Stories Grid GSAP Script - Creating top targets animation');
    console.log('Stories Grid GSAP Script - Top targets initial state:');
    topTargets.forEach((target, index) => {
      console.log(`  Target ${index + 1}:`, {
        opacity: window.getComputedStyle(target).opacity,
        transform: window.getComputedStyle(target).transform
      });
    });

    const topTween = gsap.to(topTargets, {
      scrollTrigger: {
        trigger: root,
        start: 'clamp(top 80%)',
        toggleActions: 'play none none none',
        once: true,
        markers: false,
        id: `stories-grid-top-{{ section.id }}`,
        onEnter: () => console.log('Stories Grid GSAP Script - Top animation ScrollTrigger onEnter'),
        onLeave: () => console.log('Stories Grid GSAP Script - Top animation ScrollTrigger onLeave'),
        onToggle: (self) => console.log('Stories Grid GSAP Script - Top animation ScrollTrigger toggled, isActive:', self.isActive),
        onRefresh: (self) => console.log('Stories Grid GSAP Script - Top animation ScrollTrigger refreshed, progress:', self.progress)
      },
      y: 0,
      opacity: 1,
      duration: 0.9,
      ease: 'power3.out',
      stagger: 0.12,
      onStart: () => console.log('Stories Grid GSAP Script - Top animation started'),
      onComplete: () => console.log('Stories Grid GSAP Script - Top animation completed')
    });

    console.log('Stories Grid GSAP Script - Top tween created:', topTween);
  } else {
    console.warn('Stories Grid GSAP Script - No top targets found, skipping animation');
    console.log('Available elements in section root:');
    const allElements = root.querySelectorAll('*');
    console.log('Total elements:', allElements.length);
    Array.from(allElements).slice(0, 10).forEach((el, index) => {
      if (el.classList.contains('stories-grid__heading') || 
          el.classList.contains('stories-grid__button') || 
          el.closest('.top-heading-wrap')) {
        console.log(`Potentially relevant element ${index + 1}:`, {
          tagName: el.tagName,
          className: el.className,
          text: el.textContent.substring(0, 30)
        });
      }
    });
  }

  // 2) OPTIONAL: Per-card overlay/name/quote animations (uncomment to enable)
  console.log('Stories Grid GSAP Script - Checking for per-card animations');
  const storyCards = root.querySelectorAll('.stories-grid__story');
  console.log('Stories Grid GSAP Script - Story cards found:', storyCards.length);
  
  if (storyCards.length === 0) {
    console.warn('Stories Grid GSAP Script - No .stories-grid__story elements found');
    console.log('Available story elements with similar selectors:', root.querySelectorAll('[class*="story"], [class*="card"]'));
  } else {
    console.log('Stories Grid GSAP Script - Per-card animations are commented out (OPTIONAL section)');
    console.log('Stories Grid GSAP Script - To enable, uncomment the per-card animation code block');
    
    // For debugging, log what would be animated if enabled
    storyCards.forEach((card, cardIndex) => {
      const overlay = card.querySelector('.stories-grid__story-overlay');
      const name = card.querySelector('.stories-grid__story-name');
      const quote = card.querySelector('.stories-grid__story-quote');
      
      console.log(`Card ${cardIndex + 1} potential elements:`, {
        overlay: !!overlay,
        name: !!name,
        quote: !!quote
      });
      
      if (overlay || name || quote) {
        console.log(`Card ${cardIndex + 1} would have animations if uncommented`);
      }
    });
  }

  // 3) Safe refresh sequence
  console.log('Stories Grid GSAP Script - Setting up safe refresh sequence');
  window.addEventListener('load', () => {
    console.log('Stories Grid GSAP Script - Window load event fired');
    setTimeout(() => {
      if (typeof scrollTriggerManager !== 'undefined' && scrollTriggerManager.safeRefresh) {
        scrollTriggerManager.safeRefresh();
        console.log('Stories Grid GSAP Script - scrollTriggerManager.safeRefresh executed');
      } else {
        // Fallback refresh
        if (ScrollTrigger) {
          ScrollTrigger.refresh();
          console.log('Stories Grid GSAP Script - Fallback ScrollTrigger.refresh executed');
        }
      }
      
      console.log('Stories Grid GSAP Script - Post-refresh ScrollTriggers count:', ScrollTrigger ? ScrollTrigger.getAll().length : 0);
    }, 100);
  });

  // 4) If mobile slick slider is enabled, refresh after init
  console.log('Stories Grid GSAP Script - Checking mobile slider setting');
  {% if section.settings.enable-mob-slider != blank %}
  console.log('Stories Grid GSAP Script - Mobile slider is enabled in schema');
  if (window.innerWidth < 768) {
    console.log('Stories Grid GSAP Script - Mobile view detected, setting up slider refresh');
    // Slick initializes on DOMContentLoaded; refresh after it lays out
    setTimeout(() => {
      if (ScrollTrigger) {
        ScrollTrigger.refresh(true);
        console.log('Stories Grid GSAP Script - Mobile slider ScrollTrigger.refresh executed');
      }
    }, 300);
  } else {
    console.log('Stories Grid GSAP Script - Desktop view, no mobile slider refresh needed');
  }
  {% else %}
  console.log('Stories Grid GSAP Script - Mobile slider is disabled in schema');
  {% endif %}

  // Additional refresh on resize with debouncing
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      if (ScrollTrigger) {
        ScrollTrigger.refresh();
        console.log('Stories Grid GSAP Script - ScrollTrigger refreshed on resize');
      }
    }, 250);
  });

  // Final debug summary
  console.log('Stories Grid GSAP Script - Final debug summary:');
  console.log('- Section root:', !!root);
  console.log('- Reveal targets found:', revealElements.length);
  console.log('- Top animation targets:', topTargets.length);
  console.log('- Story cards found:', storyCards.length);
  console.log('- Total ScrollTriggers created:', ScrollTrigger ? ScrollTrigger.getAll().filter(st => st.vars.id && st.vars.id.includes('stories-grid')).length : 0);
  
  if (ScrollTrigger) {
    const allTriggers = ScrollTrigger.getAll();
    console.log('- All ScrollTriggers in page:', allTriggers.length);
    allTriggers.slice(0, 5).forEach((st, index) => {
      console.log(`  Trigger ${index + 1}: ID=${st.vars.id}, Trigger=${st.vars.trigger?.className || 'no-trigger'}, Active=${st.isActive}`);
    });
  }
});
